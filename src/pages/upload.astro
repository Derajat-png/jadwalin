---
// src/pages/upload.astro
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { Image } from 'astro:assets';
import mascotImg from '../assets/craiyon.png';
---

<DashboardLayout title="Upload Dokumen Jadwal" activeNav="jadwal">
  <div class="upload-page-wrap">
    <!-- Header with 3-Step Breadcrumb Progress (Figma Frame 117:755, High Polish) -->
    <div class="upload-header-row">
      <div>
        <h1 class="page-title">Tambah Tugas & Jadwal</h1>
        <p class="page-subtitle">Upload silabus, dokumen PDF, atau screenshot jadwal kuliah untuk diekstrak otomatis oleh AI.</p>
      </div>

      <!-- Step Indicator from Figma -->
      <div class="step-indicator-bar">
        <div class="step-item active" id="step-tab-1">
          <span class="step-num">1</span>
          <span class="step-lbl">Upload File</span>
        </div>
        <div class="step-line"></div>
        <div class="step-item" id="step-tab-2">
          <span class="step-num">2</span>
          <span class="step-lbl">Ekstraksi AI</span>
        </div>
        <div class="step-line"></div>
        <div class="step-item" id="step-tab-3">
          <span class="step-num">3</span>
          <span class="step-lbl">Verifikasi</span>
        </div>
      </div>
    </div>

    <!-- Desktop 2-Column: Upload Zone (Left) + File Queue & Scope Settings (Right) -->
    <div class="upload-desktop-grid" id="upload-stage-1">
      <!-- Left Column: Dropzone & 4 Upload Mode Buttons -->
      <div class="dropzone-col">
        <!-- Big Drag & Drop Area -->
        <div class="big-dropzone" id="dropzone-area">
          <div class="dropzone-icon">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="17 8 12 3 7 8"></polyline>
              <line x1="12" y1="3" x2="12" y2="15"></line>
            </svg>
          </div>
          <h3 class="dropzone-title">Tarik & Lepas File ke Sini</h3>
          <p class="dropzone-sub">Mendukung format PDF, PNG, JPG, atau WebP (hingga 25 MB)</p>
          <input type="file" id="file-input" style="display: none;" multiple accept="image/*,.pdf" />
          <button type="button" class="btn-browse-file" onclick="document.getElementById('file-input').click();">Pilih dari Komputer</button>
        </div>

        <!-- 4 Upload Modes (Clean Vector SVGs, No Emojis) -->
        <div class="upload-modes-grid">
          <button class="mode-card active" data-mode="foto">
            <div class="mode-icon-box">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
            </div>
            <span class="mode-title">Foto / Gambar</span>
            <span class="mode-sub">Screenshot portal akademik</span>
          </button>

          <button class="mode-card" data-mode="pdf">
            <div class="mode-icon-box">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            </div>
            <span class="mode-title">Dokumen PDF</span>
            <span class="mode-sub">Silabus & modul kuliah</span>
          </button>

          <button class="mode-card" data-mode="text">
            <div class="mode-icon-box">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg>
            </div>
            <span class="mode-title">Salin Teks</span>
            <span class="mode-sub">Tempel pengumuman tugas</span>
          </button>

          <button class="mode-card" data-mode="voice">
            <div class="mode-icon-box">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" y1="19" x2="12" y2="23"></line><line x1="8" y1="23" x2="16" y2="23"></line></svg>
            </div>
            <span class="mode-title">Dikte Suara</span>
            <span class="mode-sub">Bicara langsung ke Beavy</span>
          </button>
        </div>
      </div>

      <!-- Right Column: Selected Files & AI Scope (From Figma Frame 117:755) -->
      <div class="settings-col">
        <!-- Selected Files List -->
        <div class="panel-box">
          <h4 class="panel-box-title">File Terlampir (2)</h4>

          <div class="selected-files-list">
            <!-- File 1 from Figma -->
            <div class="file-item">
              <div class="file-icon-box">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
              </div>
              <div class="file-info">
                <span class="file-name">jadwal-kuliah.jpg</span>
                <span class="file-size">1.4 MB • Gambar Jadwal Semester 5</span>
              </div>
              <button class="btn-remove-file" title="Hapus" aria-label="Hapus berkas" onclick="this.closest('.file-item').remove(); (window).jadwalinToast('File Dihapus', 'jadwal-kuliah.jpg dihapus dari antrean.', 'info');">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </div>

            <!-- File 2 from Figma -->
            <div class="file-item">
              <div class="file-icon-box">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
              </div>
              <div class="file-info">
                <span class="file-name">daftar-tugas.pdf</span>
                <span class="file-size">2.8 MB • Dokumen Silabus Pemrograman</span>
              </div>
              <button class="btn-remove-file" title="Hapus" aria-label="Hapus berkas" onclick="this.closest('.file-item').remove(); (window).jadwalinToast('File Dihapus', 'daftar-tugas.pdf dihapus.', 'info');">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </div>
          </div>
        </div>

        <!-- AI Extraction Scope (From Figma Frame 117:755) -->
        <div class="panel-box">
          <h4 class="panel-box-title">Lingkup Ekstraksi AI</h4>
          <p class="panel-box-sub">Tentukan target data yang ingin diolah:</p>

          <div class="scope-options-list">
            <label class="scope-option">
              <input type="radio" name="scope" value="jadwal" />
              <div>
                <strong>Jadwal Kuliah / Rutin</strong>
                <p>Jam pertemuan kelas mingguan dan lokasi ruang.</p>
              </div>
            </label>

            <label class="scope-option">
              <input type="radio" name="scope" value="tugas" />
              <div>
                <strong>Daftar Tenggat Tugas</strong>
                <p>Deadline tugas besar, praktikum, dan kuis.</p>
              </div>
            </label>

            <label class="scope-option selected">
              <input type="radio" name="scope" value="keduanya" checked />
              <div>
                <strong>Semua (Jadwal & Tugas)</strong>
                <p>Ekstrak jadwal tetap sekaligus cocokkan slot pengerjaan tugas.</p>
              </div>
            </label>
          </div>

          <button id="btn-start-ai-analysis" class="btn-analyze-ai">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            <span>Mulai Analisis Dokumen</span>
          </button>
        </div>
      </div>
    </div>

    <!-- AI Reading & Review State (From Figma Frame 57:2810 & 115:52) -->
    <div class="ai-processing-state" id="ai-processing-view" style="display: none;">
      <div class="ai-process-card">
        <div class="beavy-scanning-halo">
          <Image src={mascotImg} alt="Beavy AI" class="beavy-process-img" />
        </div>
        <h3 class="process-title" id="process-status-text">Beavy sedang membedah dokumenmu...</h3>
        <p class="process-desc">
          Mengekstrak mata kuliah, jam pertemuan, tanggal tenggat, dan tingkat kesulitan secara otomatis.
        </p>

        <div class="process-progress-bar">
          <div class="ppb-fill" id="ppb-fill-el"></div>
        </div>

        <div class="extracted-preview-box" id="extracted-preview" style="display: none;">
          <h4 class="ep-title">Ekstraksi AI Berhasil Ditemukan</h4>
          <ul class="ep-list">
            <li>
              <span class="ep-check">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </span>
              <div>
                <strong>Laporan Praktikum Pemrograman</strong>
                <p>Tenggat: Hari ini 17.00 • Estimasi: 2 jam fokus</p>
              </div>
            </li>
            <li>
              <span class="ep-check">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </span>
              <div>
                <strong>Slide Presentasi Kelompok</strong>
                <p>Tenggat: Besok 09.00 • Estimasi: 1.5 jam</p>
              </div>
            </li>
            <li>
              <span class="ep-check">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </span>
              <div>
                <strong>Kuliah Basis Data</strong>
                <p>Jadwal Tetap: Kamis 10.00 - 12.00 • Ruang Lab 3</p>
              </div>
            </li>
          </ul>

          <div style="display: flex; gap: 0.8rem; margin-top: 1.2rem;">
            <a href="/beranda" class="btn-confirm-all">Terapkan ke Kalender & Kembali ke Beranda</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    .upload-page-wrap {
      display: flex;
      flex-direction: column;
      gap: 1.6rem;
    }

    .upload-header-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1.2rem;
    }

    .page-title {
      font-size: 1.85rem;
      font-weight: 800;
      color: var(--color-text-main);
      letter-spacing: -0.02em;
    }

    .page-subtitle {
      font-size: 0.88rem;
      color: var(--color-text-muted);
      margin-top: 0.25rem;
    }

    /* Step Indicator Bar */
    .step-indicator-bar {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      background: #ffffff;
      padding: 0.45rem 1rem;
      border-radius: var(--radius-md);
      border: 1px solid var(--color-border);
      box-shadow: var(--shadow-xs);
    }

    .step-item {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      opacity: 0.45;
    }

    .step-item.active {
      opacity: 1;
    }

    .step-num {
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: var(--color-primary);
      color: white;
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .step-lbl {
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--color-text-main);
    }

    .step-line {
      width: 18px;
      height: 1.5px;
      background: var(--color-border);
    }

    /* Desktop 2-Column */
    .upload-desktop-grid {
      display: grid;
      grid-template-columns: 1.25fr 0.85fr;
      gap: 1.8rem;
      align-items: start;
    }

    .dropzone-col, .settings-col {
      display: flex;
      flex-direction: column;
      gap: 1.4rem;
    }

    /* Big Dropzone */
    .big-dropzone {
      background: #ffffff;
      border: 1.5px dashed #c4b5fd;
      border-radius: var(--radius-xl);
      padding: 3rem 2rem;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.2s;
      box-shadow: var(--shadow-xs);
    }

    .big-dropzone:hover {
      border-color: var(--color-primary);
      background: #fbf9fe;
      transform: translateY(-1px);
    }

    .dropzone-icon {
      width: 60px;
      height: 60px;
      border-radius: var(--radius-lg);
      background: var(--color-primary-light);
      color: var(--color-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1rem;
    }

    .dropzone-title {
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--color-text-main);
      margin-bottom: 0.25rem;
    }

    .dropzone-sub {
      font-size: 0.82rem;
      color: var(--color-text-muted);
      margin-bottom: 1.2rem;
    }

    .btn-browse-file {
      padding: 0.65rem 1.3rem;
      border-radius: var(--radius-md);
      border: none;
      background: var(--color-primary);
      color: white;
      font-weight: 700;
      font-size: 0.84rem;
      cursor: pointer;
      transition: background 0.15s;
    }

    .btn-browse-file:hover {
      background: var(--color-primary-dark);
    }

    /* 4 Upload Modes */
    .upload-modes-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.75rem;
    }

    .mode-card {
      background: #ffffff;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: 0.9rem 0.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      cursor: pointer;
      transition: all 0.15s;
    }

    .mode-card:hover {
      border-color: var(--color-border-focus);
      transform: translateY(-1px);
    }

    .mode-card.active {
      border-color: var(--color-primary);
      background: #fbf9fe;
    }

    .mode-icon-box {
      width: 34px;
      height: 34px;
      border-radius: 8px;
      background: #f4f0fa;
      color: var(--color-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 0.4rem;
    }

    .mode-title {
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--color-text-main);
    }

    .mode-sub {
      font-size: 0.68rem;
      color: var(--color-text-muted);
      margin-top: 0.1rem;
    }

    /* Settings Panel */
    .panel-box {
      background: #ffffff;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
      padding: 1.4rem;
      box-shadow: var(--shadow-xs);
    }

    .panel-box-title {
      font-size: 1rem;
      font-weight: 800;
      color: var(--color-text-main);
      margin-bottom: 0.2rem;
    }

    .panel-box-sub {
      font-size: 0.78rem;
      color: var(--color-text-muted);
      margin-bottom: 0.9rem;
    }

    /* File List */
    .selected-files-list {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }

    .file-item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      background: #fbf9fe;
      border: 1px solid var(--color-border-subtle);
      padding: 0.7rem 0.85rem;
      border-radius: var(--radius-md);
    }

    .file-icon-box {
      width: 32px;
      height: 32px;
      border-radius: 6px;
      background: #ffffff;
      border: 1px solid var(--color-border);
      color: var(--color-primary);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .file-info {
      flex: 1;
    }

    .file-name {
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--color-text-main);
      display: block;
    }

    .file-size {
      font-size: 0.7rem;
      color: var(--color-text-muted);
    }

    .btn-remove-file {
      background: none;
      border: none;
      color: var(--color-text-subtle);
      font-size: 0.85rem;
      padding: 0.25rem;
      cursor: pointer;
    }

    .btn-remove-file:hover {
      color: #dc2626;
    }

    /* Scope Options */
    .scope-options-list {
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      margin-bottom: 1.4rem;
    }

    .scope-option {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      padding: 0.75rem 0.85rem;
      border-radius: var(--radius-md);
      background: #fbf9fe;
      border: 1px solid var(--color-border-subtle);
      cursor: pointer;
      transition: all 0.15s;
    }

    .scope-option.selected {
      border-color: var(--color-primary);
      background: #fcfaff;
    }

    .scope-option input {
      accent-color: var(--color-primary);
      margin-top: 0.2rem;
    }

    .scope-option strong {
      font-size: 0.84rem;
      color: var(--color-text-main);
      display: block;
    }

    .scope-option p {
      font-size: 0.74rem;
      color: var(--color-text-muted);
      margin-top: 0.1rem;
      line-height: 1.35;
    }

    .btn-analyze-ai {
      width: 100%;
      padding: 0.85rem;
      border-radius: var(--radius-md);
      border: none;
      background: var(--color-primary);
      color: white;
      font-size: 0.9rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.55rem;
      box-shadow: 0 2px 8px rgba(124, 58, 237, 0.25);
      cursor: pointer;
      transition: background 0.15s;
    }

    .btn-analyze-ai:hover {
      background: var(--color-primary-dark);
    }

    /* AI Processing View */
    .ai-processing-state {
      padding: 2.5rem 1.5rem;
      display: flex;
      justify-content: center;
    }

    .ai-process-card {
      background: white;
      border-radius: var(--radius-xl);
      border: 1px solid var(--color-border);
      padding: 2.5rem 2rem;
      max-width: 580px;
      width: 100%;
      text-align: center;
      box-shadow: var(--shadow-sm);
    }

    .beavy-scanning-halo {
      width: 90px;
      height: 90px;
      border-radius: 50%;
      background: #faf6fe;
      border: 1px solid #ebdff5;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.4rem;
    }

    .beavy-process-img {
      width: 65px;
      height: 65px;
      object-fit: contain;
    }

    .process-title {
      font-size: 1.3rem;
      font-weight: 800;
      color: var(--color-text-main);
      margin-bottom: 0.4rem;
    }

    .process-desc {
      font-size: 0.85rem;
      color: var(--color-text-muted);
      line-height: 1.45;
      margin-bottom: 1.6rem;
    }

    .process-progress-bar {
      width: 100%;
      height: 6px;
      background: #f0ecf6;
      border-radius: var(--radius-full);
      overflow: hidden;
      margin-bottom: 1.6rem;
    }

    .ppb-fill {
      width: 0%;
      height: 100%;
      background: var(--color-primary);
      transition: width 0.3s ease;
    }

    .extracted-preview-box {
      text-align: left;
      background: #f8f6fc;
      border-radius: var(--radius-md);
      padding: 1.2rem;
      border: 1px solid var(--color-border);
    }

    .ep-title {
      font-size: 0.95rem;
      font-weight: 800;
      color: #047857;
      margin-bottom: 0.8rem;
    }

    .ep-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }

    .ep-list li {
      display: flex;
      align-items: flex-start;
      gap: 0.65rem;
    }

    .ep-check {
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: #dcfce7;
      color: #15803d;
      font-size: 0.68rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-top: 0.1rem;
    }

    .ep-list strong {
      font-size: 0.85rem;
      color: var(--color-text-main);
      display: block;
    }

    .ep-list p {
      font-size: 0.75rem;
      color: var(--color-text-muted);
    }

    .btn-confirm-all {
      width: 100%;
      padding: 0.8rem;
      border-radius: var(--radius-md);
      border: none;
      background: var(--color-primary);
      color: white;
      font-weight: 700;
      font-size: 0.88rem;
      text-align: center;
      cursor: pointer;
      display: block;
    }

    @media (max-width: 960px) {
      .upload-desktop-grid {
        grid-template-columns: 1fr;
      }
      .upload-modes-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
  </style>

  <script>
    const btnAnalyze = document.getElementById('btn-start-ai-analysis');
    const stage1 = document.getElementById('upload-stage-1');
    const processView = document.getElementById('ai-processing-view');
    const fillEl = document.getElementById('ppb-fill-el');
    const previewBox = document.getElementById('extracted-preview');
    const statusText = document.getElementById('process-status-text');

    const step1 = document.getElementById('step-tab-1');
    const step2 = document.getElementById('step-tab-2');
    const step3 = document.getElementById('step-tab-3');

    btnAnalyze?.addEventListener('click', () => {
      if (stage1 && processView) {
        stage1.style.display = 'none';
        processView.style.display = 'flex';

        step1?.classList.remove('active');
        step2?.classList.add('active');

        // Simulate progress
        let p = 0;
        const interval = setInterval(() => {
          p += 25;
          if (fillEl) fillEl.style.width = p + '%';

          if (p === 50 && statusText) {
            statusText.textContent = 'Mendeteksi silabus dan tenggat tugas...';
          }

          if (p >= 100) {
            clearInterval(interval);
            if (statusText) statusText.textContent = 'Ekstraksi Jadwal Selesai';
            if (previewBox) previewBox.style.display = 'block';
            step2?.classList.remove('active');
            step3?.classList.add('active');
            (window as any).jadwalinToast('Analisis Dokumen Berhasil', '3 tugas dan 1 jadwal rutin siap diverifikasi.', 'success');
          }
        }, 300);
      }
    });
  </script>
</DashboardLayout>
