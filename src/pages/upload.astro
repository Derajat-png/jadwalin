---
// src/pages/upload.astro
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { Image } from 'astro:assets';
import mascotImg from '../assets/craiyon.png';
---

<DashboardLayout title="Upload Dokumen Jadwal" activeNav="jadwal">
  <div class="upload-page-layout">

    <!-- Header & Step Indicator -->
    <header class="upload-header-row">
      <div class="header-titles">
        <h1 class="page-title">Ekstraksi Dokumen</h1>
        <p class="page-subtitle">Unggah silabus, dokumen PDF, atau screenshot jadwal kuliah untuk diekstrak otomatis oleh AI.</p>
      </div>

      <div class="step-progress-strip" role="navigation" aria-label="Tahapan Ekstraksi">
        <div class="step-badge active" id="step-tab-1">
          <span class="step-idx">1</span>
          <span class="step-text">Unggah Berkas</span>
        </div>
        <div class="step-divider" aria-hidden="true"></div>
        <div class="step-badge" id="step-tab-2">
          <span class="step-idx">2</span>
          <span class="step-text">Ekstraksi AI</span>
        </div>
        <div class="step-divider" aria-hidden="true"></div>
        <div class="step-badge" id="step-tab-3">
          <span class="step-idx">3</span>
          <span class="step-text">Verifikasi</span>
        </div>
      </div>
    </header>

    <!-- Main 2-Column Upload Workspace -->
    <div class="upload-workspace-grid" id="upload-stage-1">
      
      <!-- Left: Dropzone & Upload Mode Selection -->
      <section class="dropzone-surface">
        <div class="dropzone-box" id="dropzone-area">
          <div class="dropzone-icon-wrap">
            <svg aria-hidden="true" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="17 8 12 3 7 8"></polyline>
              <line x1="12" y1="3" x2="12" y2="15"></line>
            </svg>
          </div>
          <h2 class="dropzone-heading">Tarik dan Lepas Berkas ke Sini</h2>
          <p class="dropzone-hint">Mendukung format PDF, PNG, JPG, atau WebP hingga 25 MB</p>
          <input type="file" id="file-input" style="display: none;" multiple accept="image/*,.pdf" />
          <button type="button" class="btn-browse-action" onclick="document.getElementById('file-input')?.click();">
            Pilih Berkas dari Komputer
          </button>
        </div>

        <!-- 4 Upload Method Tiles -->
        <div class="upload-modes-strip">
          <button type="button" class="mode-item active" data-mode="foto">
            <div class="mode-icon">
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
            </div>
            <div class="mode-info">
              <span class="mode-name">Foto atau Gambar</span>
              <span class="mode-sub">Screenshot portal akademik</span>
            </div>
          </button>

          <button type="button" class="mode-item" data-mode="pdf">
            <div class="mode-icon">
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            </div>
            <div class="mode-info">
              <span class="mode-name">Dokumen PDF</span>
              <span class="mode-sub">Silabus dan modul kuliah</span>
            </div>
          </button>

          <button type="button" class="mode-item" data-mode="text">
            <div class="mode-icon">
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect></svg>
            </div>
            <div class="mode-info">
              <span class="mode-name">Salin Teks</span>
              <span class="mode-sub">Tempel pengumuman tugas</span>
            </div>
          </button>

          <button type="button" class="mode-item" data-mode="voice">
            <div class="mode-icon">
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" y1="19" x2="12" y2="23"></line><line x1="8" y1="23" x2="16" y2="23"></line></svg>
            </div>
            <div class="mode-info">
              <span class="mode-name">Dikte Suara</span>
              <span class="mode-sub">Bicara langsung ke Beavy</span>
            </div>
          </button>
        </div>
      </section>

      <!-- Right: Queue & Scope Selection -->
      <aside class="sidebar-surface">
        
        <!-- Attached Files -->
        <div class="surface-card">
          <div class="card-header-row">
            <h2 class="card-title">Berkas Terlampir</h2>
            <span class="card-counter">2 Berkas</span>
          </div>

          <ul class="file-queue-list">
            <li class="file-card-row">
              <div class="file-badge-icon">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
              </div>
              <div class="file-meta">
                <span class="file-title">jadwal-kuliah.jpg</span>
                <span class="file-detail">1.4 MB - Screenshot Portal</span>
              </div>
              <button type="button" class="btn-discard" aria-label="Hapus jadwal-kuliah.jpg" onclick="this.closest('.file-card-row')?.remove(); window.jadwalinToast?.('Berkas Dihapus', 'jadwal-kuliah.jpg dikeluarkan dari antrean.', 'info');">
                <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </li>

            <li class="file-card-row">
              <div class="file-badge-icon">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
              </div>
              <div class="file-meta">
                <span class="file-title">silabus-pemrograman.pdf</span>
                <span class="file-detail">2.8 MB - Dokumen Mata Kuliah</span>
              </div>
              <button type="button" class="btn-discard" aria-label="Hapus silabus-pemrograman.pdf" onclick="this.closest('.file-card-row')?.remove(); window.jadwalinToast?.('Berkas Dihapus', 'silabus-pemrograman.pdf dikeluarkan dari antrean.', 'info');">
                <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </li>
          </ul>
        </div>

        <!-- Scope Setting -->
        <div class="surface-card">
          <h2 class="card-title">Cakupan Ekstraksi AI</h2>
          <p class="card-desc">Tentukan sasaran data yang ingin diekstrak:</p>

          <div class="scope-options-group" role="radiogroup" aria-label="Cakupan ekstraksi data">
            <label class="scope-choice">
              <input type="radio" name="scope" value="jadwal" />
              <div class="choice-text">
                <strong class="choice-name">Jadwal Kuliah Rutin</strong>
                <span class="choice-sub">Jam pertemuan mingguan dan lokasi ruangan</span>
              </div>
            </label>

            <label class="scope-choice">
              <input type="radio" name="scope" value="tugas" />
              <div class="choice-text">
                <strong class="choice-name">Daftar Tenggat Tugas</strong>
                <span class="choice-sub">Tenggat tugas besar, praktikum, dan kuis</span>
              </div>
            </label>

            <label class="scope-choice active">
              <input type="radio" name="scope" value="keduanya" checked />
              <div class="choice-text">
                <strong class="choice-name">Semua (Jadwal dan Tugas)</strong>
                <span class="choice-sub">Ekstrak jadwal tetap dan cocokkan slot belajar tugas</span>
              </div>
            </label>
          </div>

          <button type="button" id="btn-start-ai-analysis" class="btn-primary-action">
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
            <span>Mulai Analisis Dokumen</span>
          </button>
        </div>

      </aside>
    </div>

    <!-- AI Processing State Surface -->
    <div class="ai-processing-overlay" id="ai-processing-view" style="display: none;">
      <div class="process-card">
        <div class="process-avatar-wrap">
          <Image src={mascotImg} alt="Beavy" class="process-avatar-img" />
        </div>
        
        <h2 class="process-title" id="process-status-text">Beavy sedang membedah dokumen Anda...</h2>
        <p class="process-desc">
          Mengekstrak mata kuliah, jam pertemuan, tanggal tenggat, dan estimasi waktu belajar secara otomatis.
        </p>

        <div class="progress-track" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
          <div class="progress-bar-fill" id="ppb-fill-el"></div>
        </div>

        <div class="extracted-review-box" id="extracted-preview" style="display: none;">
          <h3 class="review-title">Hasil Ekstraksi Ditemukan</h3>
          
          <ul class="review-list">
            <li class="review-item">
              <div class="review-check-badge">
                <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <div class="review-info">
                <strong class="item-name">Laporan Praktikum Pemrograman</strong>
                <span class="item-meta">Tenggat: Hari ini 17.00 - Estimasi: 2 jam</span>
              </div>
            </li>

            <li class="review-item">
              <div class="review-check-badge">
                <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <div class="review-info">
                <strong class="item-name">Slide Presentasi Kelompok</strong>
                <span class="item-meta">Tenggat: Besok 09.00 - Estimasi: 1.5 jam</span>
              </div>
            </li>

            <li class="review-item">
              <div class="review-check-badge">
                <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </div>
              <div class="review-info">
                <strong class="item-name">Kuliah Basis Data</strong>
                <span class="item-meta">Jadwal Tetap: Kamis 10.00 - 12.00 di Lab 3</span>
              </div>
            </li>
          </ul>

          <div class="review-actions">
            <a href="/beranda" class="btn-confirm-all">Terapkan ke Kalender dan Kembali</a>
          </div>
        </div>

      </div>
    </div>

  </div>

  <style>
    /* =========================================================
       AWWWARDS UPLOAD & EXTRACTION CANVAS: Minimalist & Clean
       ========================================================= */

    :focus-visible {
      outline: 2px solid var(--color-primary);
      outline-offset: 2px;
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }

    .upload-page-layout {
      max-width: 1180px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 2rem;
      padding-bottom: 3.5rem;
    }

    /* Header & Steps */
    .upload-header-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 1.5rem;
      padding: 1rem 0 0.5rem;
      border-bottom: 1px solid var(--color-border-subtle);
    }

    .page-title {
      font-size: 2.2rem;
      font-weight: 800;
      color: var(--color-text-main);
      letter-spacing: -0.03em;
      line-height: 1.15;
    }

    .page-subtitle {
      font-size: 0.92rem;
      color: var(--color-text-muted);
      margin-top: 0.4rem;
      line-height: 1.5;
    }

    .step-progress-strip {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-full);
      padding: 0.35rem 0.9rem;
      box-shadow: var(--shadow-xs);
    }

    .step-badge {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      opacity: 0.45;
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--color-text-main);
    }

    .step-badge.active {
      opacity: 1;
    }

    .step-idx {
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: var(--color-primary);
      color: var(--color-surface);
      font-family: var(--font-mono);
      font-size: 0.7rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .step-divider {
      width: 14px;
      height: 1px;
      background: var(--color-border);
    }

    /* Workspace Grid */
    .upload-workspace-grid {
      display: grid;
      grid-template-columns: 1.35fr 0.85fr;
      gap: 2.2rem;
      align-items: start;
    }

    /* Left Surface */
    .dropzone-surface {
      display: flex;
      flex-direction: column;
      gap: 1.4rem;
    }

    .dropzone-box {
      background: var(--color-surface);
      border: 1.5px dashed var(--color-border-focus);
      border-radius: var(--radius-xl);
      padding: 3.5rem 2rem;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      box-shadow: var(--shadow-xs);
      transition: border-color 0.15s ease, background-color 0.15s ease;
    }

    .dropzone-box:hover {
      border-color: var(--color-primary);
      background: var(--color-primary-light);
    }

    .dropzone-icon-wrap {
      width: 56px;
      height: 56px;
      border-radius: var(--radius-lg);
      background: var(--color-primary-light);
      border: 1px solid var(--color-border-focus);
      color: var(--color-primary-dark);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1.2rem;
    }

    .dropzone-heading {
      font-size: 1.2rem;
      font-weight: 800;
      color: var(--color-text-main);
      margin-bottom: 0.35rem;
      letter-spacing: -0.01em;
    }

    .dropzone-hint {
      font-size: 0.82rem;
      color: var(--color-text-muted);
      margin-bottom: 1.4rem;
    }

    .btn-browse-action {
      display: inline-flex;
      align-items: center;
      padding: 0.75rem 1.4rem;
      border-radius: var(--radius-full);
      border: none;
      background: var(--color-primary);
      color: var(--color-surface);
      font-size: 0.86rem;
      font-weight: 700;
      cursor: pointer;
      box-shadow: var(--shadow-xs);
      transition: background-color 0.15s ease, transform 0.15s ease;
    }

    .btn-browse-action:hover {
      background: var(--color-primary-dark);
      transform: translateY(-1px);
    }

    /* 4 Modes */
    .upload-modes-strip {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0.9rem;
    }

    .mode-item {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: 1rem 1.1rem;
      text-align: left;
      cursor: pointer;
      transition: border-color 0.15s ease, background-color 0.15s ease;
    }

    .mode-item:hover {
      border-color: var(--color-border-focus);
      background: var(--color-primary-light);
    }

    .mode-item.active {
      border-color: var(--color-primary);
      background: var(--color-primary-light);
    }

    .mode-icon {
      width: 38px;
      height: 38px;
      border-radius: var(--radius-md);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      color: var(--color-primary-dark);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .mode-info {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }

    .mode-name {
      font-size: 0.84rem;
      font-weight: 700;
      color: var(--color-text-main);
    }

    .mode-sub {
      font-size: 0.72rem;
      color: var(--color-text-muted);
    }

    /* Right Sidebar */
    .sidebar-surface {
      display: flex;
      flex-direction: column;
      gap: 1.4rem;
    }

    .surface-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
      padding: 1.8rem;
      box-shadow: var(--shadow-xs);
    }

    .card-header-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }

    .card-title {
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--color-text-main);
      letter-spacing: -0.01em;
    }

    .card-counter {
      font-family: var(--font-mono);
      font-size: 0.74rem;
      font-weight: 700;
      color: var(--color-text-muted);
      background: var(--color-primary-light);
      border: 1px solid var(--color-border-focus);
      padding: 0.2rem 0.55rem;
      border-radius: var(--radius-full);
    }

    .card-desc {
      font-size: 0.8rem;
      color: var(--color-text-muted);
      margin-top: 0.2rem;
      margin-bottom: 1rem;
    }

    /* File Queue */
    .file-queue-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.7rem;
    }

    .file-card-row {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      background: var(--color-surface);
      border: 1px solid var(--color-border-subtle);
      padding: 0.75rem 0.9rem;
      border-radius: var(--radius-md);
    }

    .file-badge-icon {
      width: 32px;
      height: 32px;
      border-radius: var(--radius-sm);
      background: var(--color-primary-light);
      border: 1px solid var(--color-border-focus);
      color: var(--color-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .file-meta {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }

    .file-title {
      font-size: 0.84rem;
      font-weight: 700;
      color: var(--color-text-main);
      word-break: break-all;
    }

    .file-detail {
      font-size: 0.72rem;
      color: var(--color-text-muted);
    }

    .btn-discard {
      background: none;
      border: none;
      color: var(--color-text-muted);
      padding: 0.35rem;
      border-radius: var(--radius-sm);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: color 0.15s ease, background-color 0.15s ease;
    }

    .btn-discard:hover {
      color: var(--color-text-main);
      background: var(--color-primary-light);
    }

    /* Scope */
    .scope-options-group {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      margin-bottom: 1.4rem;
    }

    .scope-choice {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      padding: 0.8rem 0.95rem;
      border-radius: var(--radius-md);
      border: 1px solid var(--color-border);
      background: var(--color-surface);
      cursor: pointer;
      transition: border-color 0.15s ease, background-color 0.15s ease;
    }

    .scope-choice.active {
      border-color: var(--color-primary);
      background: var(--color-primary-light);
    }

    .scope-choice input {
      margin-top: 0.2rem;
      accent-color: var(--color-primary);
    }

    .choice-text {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }

    .choice-name {
      font-size: 0.84rem;
      font-weight: 700;
      color: var(--color-text-main);
    }

    .choice-sub {
      font-size: 0.74rem;
      color: var(--color-text-muted);
      line-height: 1.4;
    }

    .btn-primary-action {
      width: 100%;
      padding: 0.85rem;
      border-radius: var(--radius-full);
      border: none;
      background: var(--color-primary);
      color: var(--color-surface);
      font-size: 0.9rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      cursor: pointer;
      box-shadow: var(--shadow-sm);
      transition: background-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
    }

    .btn-primary-action:hover {
      background: var(--color-primary-dark);
      transform: translateY(-1px);
      box-shadow: var(--shadow-md);
    }

    /* AI Processing View */
    .ai-processing-overlay {
      display: flex;
      justify-content: center;
      padding: 2.5rem 1rem;
    }

    .process-card {
      background: var(--color-surface);
      border-radius: var(--radius-xl);
      border: 1px solid var(--color-border);
      padding: 2.5rem 2rem;
      max-width: 580px;
      width: 100%;
      text-align: center;
      box-shadow: var(--shadow-sm);
    }

    .process-avatar-wrap {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      background: var(--color-primary-light);
      border: 1px solid var(--color-border-focus);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.4rem;
    }

    .process-avatar-img {
      width: 58px;
      height: 58px;
      object-fit: contain;
    }

    .process-title {
      font-size: 1.25rem;
      font-weight: 800;
      color: var(--color-text-main);
      margin-bottom: 0.4rem;
      letter-spacing: -0.01em;
    }

    .process-desc {
      font-size: 0.85rem;
      color: var(--color-text-muted);
      line-height: 1.5;
      margin-bottom: 1.8rem;
    }

    .progress-track {
      width: 100%;
      height: 6px;
      background: var(--color-border-subtle);
      border-radius: var(--radius-full);
      overflow: hidden;
      margin-bottom: 1.8rem;
    }

    .progress-bar-fill {
      width: 0%;
      height: 100%;
      background: var(--color-primary);
      transition: transform 0.3s ease;
      transform-origin: left;
    }

    .extracted-review-box {
      text-align: left;
      background: var(--color-primary-light);
      border-radius: var(--radius-lg);
      padding: 1.4rem;
      border: 1px solid var(--color-border-focus);
    }

    .review-title {
      font-size: 0.95rem;
      font-weight: 800;
      color: var(--color-text-main);
      margin-bottom: 1rem;
    }

    .review-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
    }

    .review-item {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .review-check-badge {
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: var(--color-primary);
      color: var(--color-surface);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      margin-top: 0.1rem;
    }

    .review-info {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }

    .item-name {
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--color-text-main);
    }

    .item-meta {
      font-size: 0.75rem;
      color: var(--color-text-muted);
    }

    .review-actions {
      margin-top: 1.4rem;
    }

    .btn-confirm-all {
      width: 100%;
      padding: 0.85rem;
      border-radius: var(--radius-full);
      border: none;
      background: var(--color-primary);
      color: var(--color-surface);
      font-weight: 700;
      font-size: 0.88rem;
      text-align: center;
      cursor: pointer;
      display: block;
      transition: background-color 0.15s ease;
    }

    .btn-confirm-all:hover {
      background: var(--color-primary-dark);
    }

    @media (max-width: 960px) {
      .upload-workspace-grid {
        grid-template-columns: 1fr;
      }
      .upload-modes-strip {
        grid-template-columns: 1fr;
      }
      .upload-header-row {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>

  <script>
    declare global {
      interface Window {
        jadwalinToast?: (title: string, msg: string, type?: 'success' | 'info' | 'warning' | 'error') => void;
      }
    }

    const btnAnalyze = document.getElementById('btn-start-ai-analysis');
    const stage1 = document.getElementById('upload-stage-1');
    const processView = document.getElementById('ai-processing-view');
    const fillEl = document.getElementById('ppb-fill-el');
    const previewBox = document.getElementById('extracted-preview');
    const statusText = document.getElementById('process-status-text');

    const step1 = document.getElementById('step-tab-1');
    const step2 = document.getElementById('step-tab-2');
    const step3 = document.getElementById('step-tab-3');

    // Mode Selector
    const modeBtns = document.querySelectorAll('.mode-item');
    modeBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        modeBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
      });
    });

    // Scope Selector
    const scopeLabels = document.querySelectorAll('.scope-choice');
    scopeLabels.forEach(lbl => {
      lbl.addEventListener('click', () => {
        scopeLabels.forEach(l => l.classList.remove('active'));
        lbl.classList.add('active');
      });
    });

    btnAnalyze?.addEventListener('click', () => {
      if (stage1 && processView) {
        stage1.style.display = 'none';
        processView.style.display = 'flex';

        step1?.classList.remove('active');
        step2?.classList.add('active');

        // Simulate progress
        let p = 0;
        const interval = setInterval(() => {
          p += 25;
          if (fillEl) fillEl.style.width = p + '%';

          if (p === 50 && statusText) {
            statusText.textContent = 'Mendeteksi silabus dan tenggat tugas...';
          }

          if (p >= 100) {
            clearInterval(interval);
            if (statusText) statusText.textContent = 'Ekstraksi Jadwal Selesai';
            if (previewBox) previewBox.style.display = 'block';
            step2?.classList.remove('active');
            step3?.classList.add('active');
            window.jadwalinToast?.('Analisis Dokumen Berhasil', '3 tugas dan 1 jadwal rutin siap diverifikasi.', 'success');
          }
        }, 280);
      }
    });
  </script>
</DashboardLayout>
