---
// src/pages/beavy-ai.astro
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { Image } from 'astro:assets';
import mascotImg from '../assets/craiyon.png';
---

<DashboardLayout title="Beavy AI Assistant" activeNav="beavy-ai">
  <div class="sanctuary-wrap">

    <!-- 1. EDITORIAL HEADER -->
    <header class="beavy-hero">
      <div>
        <h1 class="hero-statement">
          Konsultasi Ritme & Beban Belajar:<br />
          <span class="hero-highlight">Bersama Pendamping AI Beavy</span>
        </h1>
        <p class="hero-sub">
          Diskusikan pembagian waktu, alokasi jam praktikum, atau minta saran saat jadwal Anda terasa terlalu padat.
        </p>
      </div>
      <div class="status-pill">
        <span class="pulse-dot"></span>
        <span>Siaga : 5 tugas aktif dipantau</span>
      </div>
    </header>

    <!-- 2. SPLIT CHAT CANVAS -->
    <div class="beavy-grid">

      <!-- LEFT: Profile & Fast Intentions -->
      <aside class="intentions-panel">
        <div class="profile-card">
          <div class="avatar-disc">
            <Image src={mascotImg} alt="Beavy AI" class="avatar-mascot" />
          </div>
          <h2 class="profile-name">Beavy AI</h2>
          <span class="role-badge">Pendamping Jadwal Mahasiswa</span>
          <p class="profile-bio">
            Membantumu tetap rasional menyusun prioritas tanpa stres deadline yang berlebihan.
          </p>
        </div>

        <div class="prompts-card">
          <h3 class="side-title">Topik Pertanyaan Cepat</h3>
          <p class="side-desc">Pilih prompt untuk memulai analisis instan:</p>

          <div class="prompt-chips">
            <button type="button" class="chip-item" data-msg="Kenapa tugas Laporan Praktikum jadi prioritas nomor 1?">
              <span>Kenapa tugas ini nomor 1?</span>
            </button>
            <button type="button" class="chip-item" data-msg="Tolong atur ulang jadwal minggu ini agar tidak ada slot yang bentrok.">
              <span>Atur ulang jadwal minggu ini</span>
            </button>
            <button type="button" class="chip-item" data-msg="Kapan slot waktu luang terbaikku hari ini?">
              <span>Waktu luang terbaik hari ini</span>
            </button>
            <button type="button" class="chip-item" data-msg="Berapa lama estimasi realistis untuk membuat slide presentasi kelompok?">
              <span>Estimasi durasi tugas kelompok</span>
            </button>
          </div>
        </div>
      </aside>

      <!-- RIGHT: Clean Chat Stream & Focused Input -->
      <section class="chat-surface">
        <div class="chat-head-row">
          <div>
            <h3 class="surface-title">Ruang Percakapan</h3>
            <p class="surface-caption">Ketik pertanyaan atau klik salah satu topik cepat di kiri</p>
          </div>
          <button id="btn-clear-chat" type="button" class="btn-clear" title="Bersihkan Percakapan" aria-label="Bersihkan chat">
            <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
          </button>
        </div>

        <!-- Messages Stream -->
        <div class="messages-flow" id="messages-container">
          <!-- Message 1 from Beavy -->
          <div class="message-bubble beavy">
            <div class="msg-avatar">
              <Image src={mascotImg} alt="Beavy" class="msg-avatar-img" />
            </div>
            <div class="msg-body">
              <span class="msg-author">Beavy</span>
              <p>Halo Daffa! Berdasarkan tenggat terdekat, <strong>Laporan Praktikum Pemrograman</strong> harus kamu selesaikan jam 10.00 nanti sebelum jadwal praktikum offline dimulai. Ada yang ingin kamu konsultasikan?</p>
            </div>
          </div>
        </div>

        <!-- Chat Input Bar -->
        <form id="chat-form" class="chat-form-strip">
          <input 
            type="text" 
            id="user-input" 
            placeholder="Tanyakan ritme belajar, durasi tugas, atau minta saran Beavy..." 
            autocomplete="off"
            required 
          />
          <button type="submit" class="btn-send-chat" aria-label="Kirim pesan">
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
          </button>
        </form>
      </section>

    </div>

  </div>

  <style>
    /* =========================================================
       AWWWARDS CHAT COMPANION STYLES
       Spacious Layout, Soft Surfaces, Zero Visual Noise
       ========================================================= */

    :focus-visible {
      outline: 2px solid var(--color-primary);
      outline-offset: 2px;
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }

    .sanctuary-wrap {
      max-width: 1240px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 2.2rem;
      padding-bottom: 3rem;
    }

    /* 1. EDITORIAL HEADER */
    .beavy-hero {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 2rem;
      padding: 1.5rem 0 0.5rem;
      border-bottom: 1px solid var(--color-border-subtle);
    }

    .hero-statement {
      font-size: 2.2rem;
      font-weight: 800;
      color: var(--color-text-main);
      line-height: 1.2;
      letter-spacing: -0.025em;
    }

    .hero-highlight {
      color: var(--color-primary-dark);
    }

    .hero-sub {
      font-size: 0.95rem;
      color: var(--color-text-muted);
      line-height: 1.6;
      margin-top: 0.6rem;
      max-width: 650px;
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--color-text-muted);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      padding: 0.45rem 1rem;
      border-radius: var(--radius-full);
      box-shadow: var(--shadow-xs);
      flex-shrink: 0;
    }

    .pulse-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--color-success);
    }

    /* 2. MAIN GRID */
    .beavy-grid {
      display: grid;
      grid-template-columns: 0.75fr 1.4fr;
      gap: 2rem;
      align-items: start;
    }

    .intentions-panel {
      display: flex;
      flex-direction: column;
      gap: 1.6rem;
    }

    .profile-card, .prompts-card, .chat-surface {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
      padding: 1.8rem;
      box-shadow: var(--shadow-xs);
    }

    /* Profile Box */
    .avatar-disc {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      background: var(--color-primary-light);
      border: 1px solid var(--color-border-focus);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 0.9rem;
    }

    .avatar-mascot {
      width: 44px;
      height: 44px;
      object-fit: contain;
    }

    .profile-name {
      font-size: 1.35rem;
      font-weight: 800;
      color: var(--color-text-main);
    }

    .role-badge {
      display: inline-block;
      font-size: 0.74rem;
      font-weight: 600;
      color: var(--color-primary-dark);
      background: var(--color-primary-light);
      padding: 0.2rem 0.6rem;
      border-radius: var(--radius-full);
      margin-top: 0.2rem;
      margin-bottom: 0.8rem;
    }

    .profile-bio {
      font-size: 0.84rem;
      color: var(--color-text-body);
      line-height: 1.55;
    }

    .side-title {
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--color-text-main);
    }

    .side-desc {
      font-size: 0.78rem;
      color: var(--color-text-muted);
      margin-top: 0.2rem;
      margin-bottom: 1rem;
    }

    .prompt-chips {
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }

    .chip-item {
      display: flex;
      align-items: center;
      text-align: left;
      padding: 0.75rem 0.95rem;
      border-radius: var(--radius-md);
      background: var(--color-surface-subtle);
      border: 1px solid var(--color-border-subtle);
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--color-text-body);
      cursor: pointer;
      transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
    }

    .chip-item:hover {
      background: var(--color-surface);
      border-color: var(--color-border-focus);
      transform: translateX(3px);
    }

    /* Chat Surface */
    .chat-head-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      padding-bottom: 1.2rem;
      border-bottom: 1px solid var(--color-border-subtle);
      margin-bottom: 1.5rem;
    }

    .surface-title {
      font-size: 1.25rem;
      font-weight: 800;
      color: var(--color-text-main);
    }

    .surface-caption {
      font-size: 0.8rem;
      color: var(--color-text-muted);
      margin-top: 0.2rem;
    }

    .btn-clear {
      background: transparent;
      border: 1px solid var(--color-border);
      color: var(--color-text-muted);
      padding: 0.4rem 0.65rem;
      border-radius: var(--radius-sm);
      cursor: pointer;
      transition: color 0.15s ease, border-color 0.15s ease;
    }

    .btn-clear:hover {
      color: var(--color-danger);
      border-color: var(--color-danger-border);
    }

    .messages-flow {
      min-height: 380px;
      max-height: 520px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 1.2rem;
      padding-right: 0.5rem;
      margin-bottom: 1.5rem;
    }

    .message-bubble {
      display: flex;
      gap: 0.85rem;
      max-width: 85%;
    }

    .message-bubble.beavy {
      align-self: flex-start;
    }

    .message-bubble.user {
      align-self: flex-end;
      flex-direction: row-reverse;
    }

    .msg-avatar {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: var(--color-primary-light);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .msg-avatar-img {
      width: 22px;
      height: 22px;
      object-fit: contain;
    }

    .msg-body {
      background: var(--color-surface-subtle);
      border: 1px solid var(--color-border-subtle);
      border-radius: var(--radius-lg);
      padding: 0.95rem 1.15rem;
    }

    .message-bubble.user .msg-body {
      background: var(--color-primary);
      color: var(--color-surface);
      border: none;
    }

    .msg-author {
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--color-primary-dark);
      display: block;
      margin-bottom: 0.2rem;
    }

    .msg-body p {
      font-size: 0.88rem;
      line-height: 1.55;
    }

    /* Chat Form Strip */
    .chat-form-strip {
      display: flex;
      gap: 0.75rem;
      align-items: center;
      background: var(--color-surface-subtle);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-full);
      padding: 0.45rem 0.6rem 0.45rem 1.2rem;
      box-shadow: var(--shadow-xs);
    }

    .chat-form-strip input {
      flex: 1;
      border: none;
      background: transparent;
      font-family: inherit;
      font-size: 0.88rem;
      color: var(--color-text-main);
      outline: none;
    }

    .btn-send-chat {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      border: none;
      background: var(--color-primary);
      color: var(--color-surface);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      flex-shrink: 0;
      transition: background-color 0.15s ease, transform 0.15s ease;
    }

    .btn-send-chat:hover {
      background: var(--color-primary-dark);
      transform: scale(1.06);
    }

    @media (max-width: 1040px) {
      .beavy-grid {
        grid-template-columns: 1fr;
      }
      .beavy-hero {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>

  <script>
    const form = document.getElementById('chat-form');
    const input = document.getElementById('user-input') as HTMLInputElement;
    const container = document.getElementById('messages-container');
    const clearBtn = document.getElementById('btn-clear-chat');

    function appendMessage(text: string, isUser = false) {
      if (!container) return;
      const wrap = document.createElement('div');
      wrap.className = `message-bubble ${isUser ? 'user' : 'beavy'}`;
      
      wrap.innerHTML = `
        <div class="msg-body">
          ${!isUser ? '<span class="msg-author">Beavy</span>' : ''}
          <p>${text}</p>
        </div>
      `;
      container.appendChild(wrap);
      container.scrollTop = container.scrollHeight;
    }

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const val = input.value.trim();
      if (!val) return;
      appendMessage(val, true);
      input.value = '';

      setTimeout(() => {
        appendMessage('Saran cerdas: Alokasikan tugas ini ke sesi fokus jam 15.00 agar kamu tidak menumpuk beban di malam hari.', false);
      }, 700);
    });

    document.querySelectorAll('.chip-item').forEach((btn) => {
      btn.addEventListener('click', () => {
        const msg = btn.getAttribute('data-msg');
        if (msg) {
          appendMessage(msg, true);
          setTimeout(() => {
            appendMessage('Pertanyaan bagus! Berdasarkan estimasi beban kognitif, slot fokus 90 menit sudah ideal untuk menyelesaikannya.', false);
          }, 600);
        }
      });
    });

    clearBtn?.addEventListener('click', () => {
      if (container) {
        container.innerHTML = `
          <div class="message-bubble beavy">
            <div class="msg-body">
              <span class="msg-author">Beavy</span>
              <p>Percakapan telah direset. Ada rencana belajar atau tugas baru yang ingin kamu diskusikan?</p>
            </div>
          </div>
        `;
      }
    });
  </script>
</DashboardLayout>
