---
// src/pages/beavy-ai.astro
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { Image } from 'astro:assets';
import mascotImg from '../assets/craiyon.png';
---

<DashboardLayout title="Asisten AI Beavy" activeNav="beavy-ai">
  <div class="beavy-page-workspace">

    <!-- 1. EDITORIAL HEADER -->
    <header class="beavy-hero">
      <div class="hero-left">
        <h1 class="hero-statement">
          Konsultasi beban belajar:<br />
          <span class="hero-highlight">Bersama Asisten Cerdas Beavy</span>
        </h1>
        <p class="hero-sub">
          Dapatkan saran rasional mengenai alokasi durasi, pemecahan tugas sulit, dan strategi mengurai kepanikan deadline.
        </p>
      </div>
      <div class="status-pill">
        <span class="pulse-dot"></span>
        <span>Siaga : 5 tugas aktif dipantau</span>
      </div>
    </header>

    <!-- 2. SPLIT CHAT CANVAS -->
    <div class="beavy-grid">

      <!-- LEFT: Profile & Fast Intentions -->
      <aside class="intentions-panel">
        <div class="profile-card">
          <div class="avatar-disc">
            <Image src={mascotImg} alt="Beavy AI" class="avatar-mascot" />
          </div>
          <h2 class="profile-name">Beavy AI</h2>
          <span class="role-badge">Pendamping Jadwal Mahasiswa</span>
          <p class="profile-bio">
            Membantumu tetap rasional menyusun prioritas tanpa stres deadline yang berlebihan.
          </p>
        </div>

        <div class="prompts-card">
          <h3 class="side-title">Topik Pertanyaan Cepat</h3>
          <p class="side-desc">Pilih prompt untuk memulai analisis instan:</p>

          <div class="prompt-chips">
            <button type="button" class="chip-item" data-msg="Kenapa tugas Laporan Praktikum jadi prioritas nomor 1?">
              <span>Kenapa tugas ini nomor 1?</span>
            </button>
            <button type="button" class="chip-item" data-msg="Tolong atur ulang jadwal minggu ini agar tidak ada slot yang bentrok.">
              <span>Atur ulang jadwal minggu ini</span>
            </button>
            <button type="button" class="chip-item" data-msg="Kapan slot waktu luang terbaikku hari ini?">
              <span>Waktu luang terbaik hari ini</span>
            </button>
            <button type="button" class="chip-item" data-msg="Berapa lama estimasi realistis untuk membuat slide presentasi kelompok?">
              <span>Estimasi durasi tugas kelompok</span>
            </button>
          </div>
        </div>
      </aside>

      <!-- RIGHT: Clean Chat Stream & Focused Input -->
      <section class="chat-surface">
        <div class="chat-head-row">
          <div>
            <h3 class="surface-title">Ruang Percakapan</h3>
            <p class="surface-caption">Ketik pertanyaan atau klik salah satu topik cepat di kiri</p>
          </div>
          <div class="chat-head-actions">
            <button id="btn-export-chat" type="button" class="btn-clear" title="Ekspor Ringkasan" aria-label="Ekspor diskusi">
              <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
            </button>
            <button id="btn-clear-chat" type="button" class="btn-clear" title="Bersihkan Percakapan" aria-label="Bersihkan chat">
              <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
            </button>
          </div>
        </div>

        <!-- Messages Stream -->
        <div class="messages-flow" id="messages-container">
          <!-- Message 1 from Beavy -->
          <div class="message-bubble beavy">
            <div class="msg-body">
              <span class="msg-author">Beavy</span>
              <p>
                Halo Daffa! Aku sudah memeriksa agenda dan 5 tugas aktifmu. Hari ini ada sesi pemrograman penting pada pukul 10.00. Apa yang ingin kamu optimalkan?
              </p>
            </div>
          </div>
        </div>

        <!-- Dedicated Message Input Form -->
        <form class="input-form-bar" id="chat-form">
          <input 
            type="text" 
            id="user-input" 
            class="chat-text-input" 
            placeholder="Tanyakan penyesuaian jadwal atau mintai tips pengerjaan..." 
            autocomplete="off"
            required
          />
          <button type="submit" class="btn-send-message" aria-label="Kirim Pesan">
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
          </button>
        </form>
      </section>

    </div>

    <!-- MODAL 1: KONFIRMASI BERSIHKAN PERCAKAPAN -->
    <div id="clear-chat-modal" class="modal-backdrop-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="modal-clear-title">
      <div class="modal-container-card">
        <div class="modal-head-line">
          <h2 class="modal-dialog-title" id="modal-clear-title">Bersihkan Percakapan?</h2>
          <button type="button" class="btn-modal-dismiss" id="btn-close-clear-modal" aria-label="Tutup jendela">
            <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        <p class="modal-context-desc">
          Riwayat obrolan dan tanya jawab strategi belajar sementara ini akan dihapus. Jadwal resmi di kalender Anda tidak akan terpengaruh.
        </p>

        <div class="modal-footer-cluster">
          <button type="button" class="btn-cancel-dialog" id="btn-cancel-clear">Batal</button>
          <button type="button" class="btn-danger-dialog" id="btn-confirm-clear">Ya, Bersihkan Percakapan</button>
        </div>
      </div>
    </div>

    <!-- MODAL 2: EKSPOR RINGKASAN DISKUSI -->
    <div id="export-chat-modal" class="modal-backdrop-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="modal-export-title">
      <div class="modal-container-card">
        <div class="modal-head-line">
          <h2 class="modal-dialog-title" id="modal-export-title">Ekspor Catatan Konsultasi</h2>
          <button type="button" class="btn-modal-dismiss" id="btn-close-export-modal" aria-label="Tutup jendela">
            <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        <p class="modal-context-desc">Salin intisari rekomendasi asistensi Beavy untuk disimpan di aplikasi catatan Anda:</p>

        <div class="export-preview-card">
          <pre class="export-code-block" id="export-text-content"># Intisari Belajar Beavy AI
- Fokus Utama: Laporan Praktikum Pemrograman (10.00 - 12.00)
- Rekomendasi: Bagi tugas menjadi 2 sesi 50 menit
- Waktu Luang: 13.30 - 14.30 (Olahraga / Istirahat Bebas Layar)
- Batas Beban: Optimal (94%)</pre>
        </div>

        <div class="modal-footer-cluster">
          <button type="button" class="btn-cancel-dialog" id="btn-close-export">Tutup</button>
          <button type="button" class="btn-save-dialog" id="btn-copy-export">Salin ke Papan Klip</button>
        </div>
      </div>
    </div>

  </div>

  <style>
    /* =========================================================
       AWWWARDS EDITORIAL BEAVY AI CANVAS
       Clean Split Surface, Quiet Typography, High Contrast
       ========================================================= */

    :root {
      --overlay-scrim: rgba(18, 10, 30, 0.4);
    }

    :focus-visible {
      outline: 2px solid var(--color-primary);
      outline-offset: 2px;
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }

    .beavy-page-workspace {
      max-width: 1240px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 2rem;
      padding-bottom: 3.5rem;
    }

    /* 1. HERO */
    .beavy-hero {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 2rem;
      padding: 1rem 0 0.5rem;
      border-bottom: 1px solid var(--color-border-subtle);
    }

    .hero-statement {
      font-size: 2.2rem;
      font-weight: 800;
      color: var(--color-text-main);
      line-height: 1.2;
      letter-spacing: -0.03em;
    }

    .hero-highlight {
      color: var(--color-primary-dark);
    }

    .hero-sub {
      font-size: 0.92rem;
      color: var(--color-text-muted);
      line-height: 1.5;
      margin-top: 0.5rem;
      max-width: 600px;
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--color-text-body);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      padding: 0.45rem 0.95rem;
      border-radius: var(--radius-full);
      box-shadow: var(--shadow-xs);
    }

    .pulse-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--color-primary);
    }

    /* 2. SPLIT CHAT GRID */
    .beavy-grid {
      display: grid;
      grid-template-columns: 0.8fr 1.4fr;
      gap: 2rem;
      align-items: start;
    }

    /* LEFT ASIDE */
    .intentions-panel {
      display: flex;
      flex-direction: column;
      gap: 1.8rem;
    }

    .profile-card, .prompts-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
      padding: 2rem;
      box-shadow: var(--shadow-xs);
    }

    .profile-card {
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .avatar-disc {
      width: 68px;
      height: 68px;
      border-radius: 50%;
      background: var(--color-primary-light);
      border: 1px solid var(--color-border-focus);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1rem;
    }

    .avatar-mascot {
      width: 48px;
      height: 48px;
      object-fit: contain;
    }

    .profile-name {
      font-size: 1.25rem;
      font-weight: 800;
      color: var(--color-text-main);
    }

    .role-badge {
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--color-primary-dark);
      background: var(--color-primary-light);
      padding: 0.2rem 0.65rem;
      border-radius: var(--radius-full);
      margin-top: 0.35rem;
      margin-bottom: 0.8rem;
    }

    .profile-bio {
      font-size: 0.82rem;
      color: var(--color-text-muted);
      line-height: 1.5;
    }

    .side-title {
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--color-text-main);
      letter-spacing: -0.01em;
    }

    .side-desc {
      font-size: 0.8rem;
      color: var(--color-text-muted);
      margin-top: 0.2rem;
      margin-bottom: 1rem;
    }

    .prompt-chips {
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }

    .chip-item {
      text-align: left;
      padding: 0.75rem 0.95rem;
      border-radius: var(--radius-md);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      color: var(--color-text-main);
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      transition: border-color 0.15s ease, background-color 0.15s ease;
    }

    .chip-item:hover {
      border-color: var(--color-border-focus);
      background: var(--color-primary-light);
    }

    /* RIGHT CHAT SURFACE */
    .chat-surface {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
      padding: 2rem;
      box-shadow: var(--shadow-xs);
      display: flex;
      flex-direction: column;
      height: 600px;
    }

    .chat-head-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--color-border-subtle);
      margin-bottom: 1.5rem;
    }

    .chat-head-actions {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .surface-title {
      font-size: 1.25rem;
      font-weight: 800;
      color: var(--color-text-main);
      letter-spacing: -0.02em;
    }

    .surface-caption {
      font-size: 0.82rem;
      color: var(--color-text-muted);
      margin-top: 0.2rem;
    }

    .btn-clear {
      width: 32px;
      height: 32px;
      border-radius: var(--radius-sm);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      color: var(--color-text-muted);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: color 0.15s ease, border-color 0.15s ease;
    }

    .btn-clear:hover {
      color: var(--color-primary);
      border-color: var(--color-primary);
    }

    /* Messages */
    .messages-flow {
      flex: 1;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 1.2rem;
      padding-right: 0.5rem;
      margin-bottom: 1.5rem;
    }

    .message-bubble {
      display: flex;
      flex-direction: column;
      max-width: 85%;
    }

    .message-bubble.beavy {
      align-self: flex-start;
    }

    .message-bubble.user {
      align-self: flex-end;
    }

    .msg-body {
      padding: 1rem 1.2rem;
      border-radius: var(--radius-lg);
      font-size: 0.88rem;
      line-height: 1.55;
    }

    .message-bubble.beavy .msg-body {
      background: var(--color-primary-light);
      border: 1px solid var(--color-border-focus);
      color: var(--color-text-main);
      border-bottom-left-radius: 4px;
    }

    .message-bubble.user .msg-body {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      color: var(--color-text-main);
      border-bottom-right-radius: 4px;
    }

    .msg-author {
      font-size: 0.72rem;
      font-weight: 800;
      color: var(--color-primary-dark);
      margin-bottom: 0.25rem;
      display: block;
    }

    /* Input Form */
    .input-form-bar {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-full);
      padding: 0.4rem 0.5rem 0.4rem 1.2rem;
      background: var(--color-surface);
      transition: border-color 0.15s ease;
    }

    .input-form-bar:focus-within {
      outline: 2px solid var(--color-primary);
      outline-offset: 1px;
    }

    .chat-text-input {
      flex: 1;
      border: none;
      outline: none;
      background: transparent;
      font-family: inherit;
      font-size: 0.88rem;
      color: var(--color-text-main);
    }

    .btn-send-message {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: none;
      background: var(--color-primary);
      color: var(--color-surface);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background-color 0.15s ease;
    }

    .btn-send-message:hover {
      background: var(--color-primary-dark);
    }

    /* MODAL STYLES */
    .modal-backdrop-overlay {
      position: fixed;
      inset: 0;
      background: var(--overlay-scrim);
      backdrop-filter: blur(8px);
      z-index: 999;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }

    .modal-backdrop-overlay.active {
      display: flex !important;
    }

    .modal-container-card {
      background: var(--color-surface);
      border-radius: var(--radius-xl);
      padding: 2.2rem;
      max-width: 480px;
      width: 100%;
      box-shadow: var(--shadow-lg);
      border: 1px solid var(--color-border);
    }

    .modal-head-line {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.5rem;
    }

    .modal-dialog-title {
      font-size: 1.25rem;
      font-weight: 800;
      color: var(--color-text-main);
    }

    .btn-modal-dismiss {
      background: none;
      border: none;
      color: var(--color-text-muted);
      cursor: pointer;
      padding: 0.35rem;
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: color 0.15s ease;
    }

    .btn-modal-dismiss:hover {
      color: var(--color-text-main);
    }

    .modal-context-desc {
      font-size: 0.82rem;
      color: var(--color-text-muted);
      margin-bottom: 1.4rem;
      line-height: 1.45;
    }

    .export-preview-card {
      background: var(--color-canvas);
      border: 1px solid var(--color-border-subtle);
      border-radius: var(--radius-md);
      padding: 1rem;
      margin-bottom: 1.6rem;
    }

    .export-code-block {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      color: var(--color-text-body);
      line-height: 1.5;
      white-space: pre-wrap;
      word-break: break-all;
    }

    .modal-footer-cluster {
      display: flex;
      gap: 0.85rem;
    }

    .btn-cancel-dialog {
      flex: 1;
      padding: 0.75rem;
      border-radius: var(--radius-full);
      border: 1px solid var(--color-border);
      background: var(--color-surface);
      color: var(--color-text-muted);
      font-weight: 700;
      font-size: 0.88rem;
      cursor: pointer;
      transition: color 0.15s ease, border-color 0.15s ease;
    }

    .btn-cancel-dialog:hover {
      border-color: var(--color-border-focus);
      color: var(--color-text-main);
    }

    .btn-save-dialog {
      flex: 1.5;
      padding: 0.75rem;
      border-radius: var(--radius-full);
      border: none;
      background: var(--color-primary);
      color: var(--color-surface);
      font-weight: 700;
      font-size: 0.88rem;
      cursor: pointer;
      box-shadow: var(--shadow-sm);
      transition: background-color 0.15s ease;
    }

    .btn-save-dialog:hover {
      background: var(--color-primary-dark);
    }

    .btn-danger-dialog {
      flex: 1.5;
      padding: 0.75rem;
      border-radius: var(--radius-full);
      border: none;
      background: var(--color-primary-dark);
      color: var(--color-surface);
      font-weight: 700;
      font-size: 0.88rem;
      cursor: pointer;
      transition: opacity 0.15s ease;
    }

    .btn-danger-dialog:hover {
      opacity: 0.9;
    }

    @media (max-width: 960px) {
      .beavy-grid {
        grid-template-columns: 1fr;
      }
      .beavy-hero {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>

  <script>
    declare global {
      interface Window {
        jadwalinToast?: (title: string, msg: string, type?: 'success' | 'info' | 'warning' | 'error') => void;
      }
    }

    const openModal = (id: string) => document.getElementById(id)?.classList.add('active');
    const closeModal = (id: string) => document.getElementById(id)?.classList.remove('active');

    const form = document.getElementById('chat-form');
    const input = document.getElementById('user-input') as HTMLInputElement;
    const container = document.getElementById('messages-container');
    const clearBtn = document.getElementById('btn-clear-chat');
    const exportBtn = document.getElementById('btn-export-chat');

    function appendMessage(text: string, isUser = false) {
      if (!container) return;
      const wrap = document.createElement('div');
      wrap.className = `message-bubble ${isUser ? 'user' : 'beavy'}`;
      
      wrap.innerHTML = `
        <div class="msg-body">
          ${!isUser ? '<span class="msg-author">Beavy</span>' : ''}
          <p>${text}</p>
        </div>
      `;
      container.appendChild(wrap);
      container.scrollTop = container.scrollHeight;
    }

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const val = input.value.trim();
      if (!val) return;
      appendMessage(val, true);
      input.value = '';

      setTimeout(() => {
        appendMessage('Saran cerdas: Alokasikan tugas ini ke sesi fokus jam 15.00 agar kamu tidak menumpuk beban di malam hari.', false);
      }, 700);
    });

    document.querySelectorAll('.chip-item').forEach((btn) => {
      btn.addEventListener('click', () => {
        const msg = btn.getAttribute('data-msg');
        if (msg) {
          appendMessage(msg, true);
          setTimeout(() => {
            appendMessage('Pertanyaan bagus! Berdasarkan estimasi beban kognitif, slot fokus 90 menit sudah ideal untuk menyelesaikannya.', false);
          }, 600);
        }
      });
    });

    // 1. Clear Chat Modal
    clearBtn?.addEventListener('click', () => openModal('clear-chat-modal'));
    document.getElementById('btn-close-clear-modal')?.addEventListener('click', () => closeModal('clear-chat-modal'));
    document.getElementById('btn-cancel-clear')?.addEventListener('click', () => closeModal('clear-chat-modal'));

    document.getElementById('btn-confirm-clear')?.addEventListener('click', () => {
      if (container) {
        container.innerHTML = `
          <div class="message-bubble beavy">
            <div class="msg-body">
              <span class="msg-author">Beavy</span>
              <p>Percakapan telah direset. Ada rencana belajar atau tugas baru yang ingin kamu diskusikan?</p>
            </div>
          </div>
        `;
      }
      closeModal('clear-chat-modal');
      window.jadwalinToast?.('Percakapan Direset', 'Riwayat obrolan telah dibersihkan.', 'info');
    });

    // 2. Export Chat Modal
    exportBtn?.addEventListener('click', () => openModal('export-chat-modal'));
    document.getElementById('btn-close-export-modal')?.addEventListener('click', () => closeModal('export-chat-modal'));
    document.getElementById('btn-close-export')?.addEventListener('click', () => closeModal('export-chat-modal'));

    document.getElementById('btn-copy-export')?.addEventListener('click', () => {
      const code = document.getElementById('export-text-content')?.textContent || '';
      navigator.clipboard?.writeText(code);
      closeModal('export-chat-modal');
      window.jadwalinToast?.('Tersalin ke Papan Klip', 'Ringkasan konsultasi siap ditempel di aplikasi catatan.', 'success');
    });

    // Global ESC
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document.querySelectorAll('.modal-backdrop-overlay.active').forEach(m => m.classList.remove('active'));
      }
    });
  </script>
</DashboardLayout>
