---
// src/pages/tambah-tugas.astro
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { Image } from 'astro:assets';
import mascotImg from '../assets/craiyon.png';
---

<DashboardLayout title="Tambah Tugas Baru" activeNav="prioritas">
  <div class="task-form-layout">

    <!-- Top Breadcrumb & Action Row -->
    <header class="task-header-row">
      <div class="header-titles">
        <h1 class="page-title">Tambah Tugas Baru</h1>
        <p class="page-subtitle">Tugas akan otomatis dikalkulasi dan dialokasikan ke dalam slot produktif oleh Beavy.</p>
      </div>

      <a href="/prioritas" class="btn-back-editorial">
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        <span>Kembali ke Prioritas</span>
      </a>
    </header>

    <!-- 2-Column Grid: Form Left, AI Preview Right -->
    <div class="task-grid-container">
      
      <!-- LEFT: Form Canvas -->
      <section class="form-surface">
        <form id="add-task-full-form" class="editorial-form">
          
          <!-- 1. Task Name -->
          <div class="form-field">
            <label class="field-label" for="task-name">Nama Tugas atau Aktivitas</label>
            <input 
              type="text" 
              id="task-name" 
              class="field-input" 
              placeholder="Contoh: Laporan Praktikum Basis Data" 
              required 
            />
          </div>

          <!-- 2. Category Chips -->
          <div class="form-field">
            <span class="field-label" id="category-group-label">Kategori</span>
            <div class="segmented-chips" role="radiogroup" aria-labelledby="category-group-label">
              <button type="button" class="chip-item active" role="radio" aria-checked="true" data-cat="Kuliah">Kuliah</button>
              <button type="button" class="chip-item" role="radio" aria-checked="false" data-cat="Kerja">Kerja</button>
              <button type="button" class="chip-item" role="radio" aria-checked="false" data-cat="Pribadi">Pribadi</button>
            </div>
          </div>

          <!-- 3. Two Column Row: Deadline + Duration -->
          <div class="form-field-row">
            <div class="form-field flex-1">
              <label class="field-label" for="task-deadline">Tenggat Waktu</label>
              <input 
                type="datetime-local" 
                id="task-deadline" 
                class="field-input" 
                value="2026-10-26T23:59" 
                required 
              />
            </div>

            <div class="form-field">
              <label class="field-label" for="dur-value">Estimasi Durasi</label>
              <div class="duration-stepper" role="group" aria-label="Pengaturan durasi jam">
                <button type="button" id="btn-dec-dur" class="btn-step" aria-label="Kurangi durasi">
                  <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
                <div class="stepper-value-wrap">
                  <span id="dur-value" class="stepper-num">2</span>
                  <span class="stepper-unit">jam</span>
                </div>
                <button type="button" id="btn-inc-dur" class="btn-step" aria-label="Tambah durasi">
                  <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <!-- 4. Difficulty Selector -->
          <div class="form-field">
            <span class="field-label" id="difficulty-group-label">Tingkat Kesulitan</span>
            <div class="segmented-chips" role="radiogroup" aria-labelledby="difficulty-group-label">
              <button type="button" class="chip-item" role="radio" aria-checked="false" data-diff="Mudah">Mudah</button>
              <button type="button" class="chip-item" role="radio" aria-checked="false" data-diff="Sedang">Sedang</button>
              <button type="button" class="chip-item active" role="radio" aria-checked="true" data-diff="Sulit">Sulit</button>
            </div>
          </div>

          <!-- 5. Dependency Select -->
          <div class="form-field">
            <label class="field-label" for="task-dependency">Prasyarat Tugas (Opsional)</label>
            <select id="task-dependency" class="field-input field-select">
              <option value="">Tidak ada ketergantungan</option>
              <option value="1">Slide Presentasi Kelompok</option>
              <option value="2">Riset Pasar dan Referensi Teori</option>
            </select>
          </div>

          <!-- 6. Additional Notes -->
          <div class="form-field">
            <label class="field-label" for="task-notes">Catatan Tambahan</label>
            <textarea 
              id="task-notes" 
              class="field-input field-textarea" 
              rows="3" 
              placeholder="Instruksi khusus, format berkas, atau tautan materi kuliah..."
            ></textarea>
          </div>

          <!-- Form Actions -->
          <div class="form-actions-cluster">
            <a href="/prioritas" class="btn-cancel-secondary">Batal</a>
            <button type="submit" class="btn-submit-primary" id="btn-submit-task">
              <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span>Simpan Tugas</span>
            </button>
          </div>
        </form>
      </section>

      <!-- RIGHT: AI Horizon Prediction -->
      <aside class="impact-surface">
        <div class="impact-inner-header">
          <div class="impact-avatar-wrap">
            <Image src={mascotImg} alt="Beavy" class="impact-avatar-img" />
          </div>
          <div>
            <h2 class="impact-heading">Prediksi Dampak Beavy</h2>
            <p class="impact-subheading">Kalkulasi real-time penyesuaian kalender</p>
          </div>
        </div>

        <div class="impact-metric-row">
          <div class="impact-metric">
            <span class="impact-lbl">Status Prioritas</span>
            <span class="impact-val priority-urgent">Peringkat 1 (Kritis)</span>
          </div>
          <p class="impact-detail">
            Karena tingkat kesulitan <strong>Sulit</strong> dan tenggat <strong>26 Oktober</strong>, tugas ini dialokasikan di urutan teratas jadwal.
          </p>
        </div>

        <div class="impact-metric-row">
          <div class="impact-metric">
            <span class="impact-lbl">Rekomendasi Waktu</span>
            <span class="impact-val time-slot">Hari ini, 15.00 - 17.00</span>
          </div>
          <p class="impact-detail">
            Slot fokus terbaik sebelum rapat koordinasi tim sore hari.
          </p>
        </div>

        <div class="recommendation-callout">
          <div class="callout-header">
            <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
            <h3 class="callout-title">Strategi Pengerjaan</h3>
          </div>
          <p class="callout-text">
            Tugas dengan beban kognitif tinggi lebih optimal jika dibagi menjadi 2 sesi pengerjaan masing-masing 60 menit dengan jeda istirahat 10 menit.
          </p>
        </div>
      </aside>

    </div>
  </div>

  <style>
    /* =========================================================
       AWWWARDS EDITORIAL FORM: Minimalist, Airy, Crisp Tokens
       ========================================================= */

    :focus-visible {
      outline: 2px solid var(--color-primary);
      outline-offset: 2px;
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }

    .task-form-layout {
      max-width: 1140px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 2rem;
      padding-bottom: 3.5rem;
    }

    /* Header */
    .task-header-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 1.5rem;
      padding: 1rem 0 0.5rem;
      border-bottom: 1px solid var(--color-border-subtle);
    }

    .page-title {
      font-size: 2.2rem;
      font-weight: 800;
      color: var(--color-text-main);
      letter-spacing: -0.03em;
      line-height: 1.15;
    }

    .page-subtitle {
      font-size: 0.92rem;
      color: var(--color-text-muted);
      margin-top: 0.4rem;
      line-height: 1.5;
    }

    .btn-back-editorial {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      font-size: 0.84rem;
      font-weight: 700;
      color: var(--color-text-muted);
      padding: 0.5rem 0.9rem;
      border-radius: var(--radius-full);
      border: 1px solid var(--color-border);
      background: var(--color-surface);
      transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
    }

    .btn-back-editorial:hover {
      color: var(--color-primary);
      border-color: var(--color-border-focus);
      background: var(--color-primary-light);
    }

    /* Grid */
    .task-grid-container {
      display: grid;
      grid-template-columns: 1.35fr 0.85fr;
      gap: 2.2rem;
      align-items: start;
    }

    /* Left Form Surface */
    .form-surface {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
      padding: 2.4rem;
      box-shadow: var(--shadow-xs);
    }

    .editorial-form {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .form-field {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .form-field-row {
      display: flex;
      gap: 1.4rem;
      align-items: flex-start;
    }

    .flex-1 {
      flex: 1;
    }

    .field-label {
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--color-text-main);
      letter-spacing: -0.01em;
    }

    .field-input {
      width: 100%;
      padding: 0.8rem 1rem;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      font-family: inherit;
      font-size: 0.9rem;
      color: var(--color-text-main);
      background: var(--color-surface);
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .field-input:focus {
      outline: 2px solid var(--color-primary);
      outline-offset: 1px;
    }

    .field-select {
      cursor: pointer;
    }

    .field-textarea {
      resize: vertical;
      min-height: 85px;
      line-height: 1.5;
    }

    /* Segmented Chips */
    .segmented-chips {
      display: flex;
      gap: 0.6rem;
    }

    .chip-item {
      flex: 1;
      padding: 0.65rem 0.8rem;
      border-radius: var(--radius-md);
      border: 1px solid var(--color-border);
      background: var(--color-surface);
      color: var(--color-text-body);
      font-size: 0.84rem;
      font-weight: 600;
      cursor: pointer;
      text-align: center;
      transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    }

    .chip-item:hover {
      border-color: var(--color-border-focus);
      background: var(--color-primary-light);
    }

    .chip-item.active {
      border-color: var(--color-primary);
      background: var(--color-primary);
      color: var(--color-surface);
      font-weight: 700;
    }

    /* Stepper */
    .duration-stepper {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      padding: 0.35rem 0.6rem;
      background: var(--color-surface);
    }

    .btn-step {
      width: 32px;
      height: 32px;
      border-radius: var(--radius-sm);
      border: 1px solid var(--color-border-subtle);
      background: var(--color-surface);
      color: var(--color-text-body);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    }

    .btn-step:hover {
      background: var(--color-primary-light);
      border-color: var(--color-primary);
      color: var(--color-primary-dark);
    }

    .stepper-value-wrap {
      display: flex;
      align-items: baseline;
      gap: 0.3rem;
      padding: 0 0.6rem;
      min-width: 65px;
      justify-content: center;
    }

    .stepper-num {
      font-family: var(--font-mono);
      font-size: 1.35rem;
      font-weight: 800;
      color: var(--color-text-main);
    }

    .stepper-unit {
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--color-text-muted);
    }

    /* Actions */
    .form-actions-cluster {
      display: flex;
      gap: 1rem;
      margin-top: 1rem;
      padding-top: 1.5rem;
      border-top: 1px solid var(--color-border-subtle);
    }

    .btn-cancel-secondary {
      flex: 1;
      padding: 0.8rem 1.2rem;
      border-radius: var(--radius-full);
      border: 1px solid var(--color-border);
      background: var(--color-surface);
      color: var(--color-text-muted);
      font-size: 0.88rem;
      font-weight: 700;
      text-align: center;
      cursor: pointer;
      transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    }

    .btn-cancel-secondary:hover {
      border-color: var(--color-border-focus);
      color: var(--color-text-main);
    }

    .btn-submit-primary {
      flex: 1.6;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.8rem 1.6rem;
      border-radius: var(--radius-full);
      border: none;
      background: var(--color-primary);
      color: var(--color-surface);
      font-size: 0.9rem;
      font-weight: 700;
      cursor: pointer;
      box-shadow: var(--shadow-sm);
      transition: background-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
    }

    .btn-submit-primary:hover {
      background: var(--color-primary-dark);
      transform: translateY(-1px);
      box-shadow: var(--shadow-md);
    }

    /* Right Impact Surface */
    .impact-surface {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
      padding: 2rem;
      box-shadow: var(--shadow-xs);
      display: flex;
      flex-direction: column;
      gap: 1.4rem;
    }

    .impact-inner-header {
      display: flex;
      align-items: center;
      gap: 0.9rem;
      padding-bottom: 1.2rem;
      border-bottom: 1px solid var(--color-border-subtle);
    }

    .impact-avatar-wrap {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--color-primary-light);
      border: 1px solid var(--color-border-focus);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .impact-avatar-img {
      width: 34px;
      height: 34px;
      object-fit: contain;
    }

    .impact-heading {
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--color-text-main);
      letter-spacing: -0.01em;
    }

    .impact-subheading {
      font-size: 0.78rem;
      color: var(--color-text-muted);
      margin-top: 0.15rem;
    }

    .impact-metric-row {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--color-border-subtle);
    }

    .impact-metric {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .impact-lbl {
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--color-text-muted);
    }

    .impact-val {
      font-size: 0.84rem;
      font-weight: 800;
    }

    .impact-val.priority-urgent {
      color: var(--color-text-main);
      background: var(--color-primary-light);
      border: 1px solid var(--color-border-focus);
      padding: 0.2rem 0.55rem;
      border-radius: var(--radius-sm);
    }

    .impact-val.time-slot {
      color: var(--color-primary-dark);
      font-family: var(--font-mono);
      font-size: 0.8rem;
    }

    .impact-detail {
      font-size: 0.8rem;
      color: var(--color-text-body);
      line-height: 1.45;
    }

    .recommendation-callout {
      background: var(--color-primary-light);
      border: 1px solid var(--color-border-focus);
      border-radius: var(--radius-lg);
      padding: 1.1rem;
    }

    .callout-header {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--color-primary-dark);
      margin-bottom: 0.35rem;
    }

    .callout-title {
      font-size: 0.84rem;
      font-weight: 800;
    }

    .callout-text {
      font-size: 0.8rem;
      color: var(--color-text-body);
      line-height: 1.5;
    }

    @media (max-width: 960px) {
      .task-grid-container {
        grid-template-columns: 1fr;
      }
      .task-header-row {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>

  <script>
    declare global {
      interface Window {
        jadwalinToast?: (title: string, msg: string, type?: 'success' | 'info' | 'warning' | 'error') => void;
      }
    }

    // Category Selector
    const catPills = document.querySelectorAll('.segmented-chips[aria-labelledby="category-group-label"] .chip-item');
    catPills.forEach(p => {
      p.addEventListener('click', () => {
        catPills.forEach(c => {
          c.classList.remove('active');
          c.setAttribute('aria-checked', 'false');
        });
        p.classList.add('active');
        p.setAttribute('aria-checked', 'true');
      });
    });

    // Difficulty Selector
    const diffPills = document.querySelectorAll('.segmented-chips[aria-labelledby="difficulty-group-label"] .chip-item');
    diffPills.forEach(p => {
      p.addEventListener('click', () => {
        diffPills.forEach(d => {
          d.classList.remove('active');
          d.setAttribute('aria-checked', 'false');
        });
        p.classList.add('active');
        p.setAttribute('aria-checked', 'true');
      });
    });

    // Duration Stepper
    let currentDur = 2;
    const durVal = document.getElementById('dur-value');
    const btnInc = document.getElementById('btn-inc-dur');
    const btnDec = document.getElementById('btn-dec-dur');

    btnInc?.addEventListener('click', () => {
      currentDur += 0.5;
      if (durVal) durVal.textContent = String(currentDur);
    });

    btnDec?.addEventListener('click', () => {
      if (currentDur > 0.5) {
        currentDur -= 0.5;
        if (durVal) durVal.textContent = String(currentDur);
      }
    });

    import { getCurrentUser, addUserTask } from '../utils/db';

    // Form Submit
    document.getElementById('add-task-full-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const title = (document.getElementById('task-name') as HTMLInputElement)?.value || 'Tugas Baru';
      const deadline = (document.getElementById('task-deadline') as HTMLInputElement)?.value || '';
      const activeCat = (document.querySelector('.segmented-chips[aria-labelledby="category-group-label"] .chip-item.active') as HTMLElement)?.dataset.cat || 'Kuliah';
      const activeDiff = (document.querySelector('.segmented-chips[aria-labelledby="difficulty-group-label"] .chip-item.active') as HTMLElement)?.dataset.diff || 'Sedang';

      const user = getCurrentUser();
      if (user && user.email) {
        addUserTask(user.email, {
          title,
          category: activeCat,
          deadline,
          duration: `${currentDur} jam`,
          difficulty: activeDiff,
          urgent: false
        });
      }

      window.jadwalinToast?.('Tugas Ditambahkan', `Tugas "${title}" berhasil dialokasikan ke dalam jadwal.`, 'success');
      
      setTimeout(() => {
        window.location.href = '/beranda';
      }, 700);
    });
  </script>
</DashboardLayout>
