---
// src/pages/tambah-tugas.astro
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { Image } from 'astro:assets';
import mascotImg from '../assets/craiyon.png';
---

<DashboardLayout title="Tambah Tugas Baru" activeNav="prioritas">
  <div class="add-task-page-wrap">
    <!-- Desktop 2-Column: Form (Left) + AI Real-Time Impact Assessment (Right) -->
    <div class="add-task-grid">
      <!-- Left Column: The Form from Figma Frame 109:272 -->
      <div class="form-card-panel">
        <div class="form-title-row">
          <h1 class="page-title">Tambah Tugas Baru</h1>
          <a href="/prioritas" class="btn-back-link">Kembali</a>
        </div>
        <p class="form-subtitle">Tugas ini akan otomatis dikalkulasi ke dalam prioritas dan jadwal harianmu.</p>

        <form id="add-task-full-form">
          <!-- 1. Nama Tugas -->
          <div class="form-group">
            <label class="form-label" for="task-name">Nama Tugas</label>
            <input 
              type="text" 
              id="task-name" 
              class="form-input" 
              value="Laporan Praktikum Pemrograman" 
              placeholder="Contoh: Laporan Praktikum" 
              required 
            />
          </div>

          <!-- 2. Kategori Chips (Figma Match) -->
          <div class="form-group">
            <label class="form-label">Kategori</label>
            <div class="category-chips-row">
              <button type="button" class="cat-pill active" data-cat="Kuliah">Kuliah</button>
              <button type="button" class="cat-pill" data-cat="Kerja">Kerja</button>
              <button type="button" class="cat-pill" data-cat="Pribadi">Pribadi</button>
            </div>
          </div>

          <!-- 3. Deadline -->
          <div class="form-group">
            <label class="form-label" for="task-deadline">Tenggat Waktu (Deadline)</label>
            <input 
              type="datetime-local" 
              id="task-deadline" 
              class="form-input" 
              value="2026-10-26T23:59" 
              required 
            />
          </div>

          <!-- 4. Estimasi Durasi dengan Counter +/- (Figma Match) -->
          <div class="form-group">
            <label class="form-label">Estimasi Durasi Pengerjaan</label>
            <div class="duration-counter-wrap">
              <button type="button" id="btn-dec-dur" class="btn-counter">−</button>
              <div class="duration-display">
                <span id="dur-value" class="dur-num">2</span>
                <span class="dur-unit">jam</span>
              </div>
              <button type="button" id="btn-inc-dur" class="btn-counter">+</button>
            </div>
            <span class="helper-note">Durasi harus lebih dari 0 jam</span>
          </div>

          <!-- 5. Tingkat Kesulitan (Figma Match) -->
          <div class="form-group">
            <label class="form-label">Tingkat Kesulitan</label>
            <div class="difficulty-chips-row">
              <button type="button" class="diff-pill" data-diff="Mudah">Mudah</button>
              <button type="button" class="diff-pill" data-diff="Sedang">Sedang</button>
              <button type="button" class="diff-pill active" data-diff="Sulit">Sulit</button>
            </div>
          </div>

          <!-- 6. Bergantung Pada (Prerequisite) -->
          <div class="form-group">
            <label class="form-label" for="task-dependency">Bergantung Pada Tugas Lain</label>
            <select id="task-dependency" class="form-input select-input">
              <option value="">Pilih tugas (opsional)</option>
              <option value="1">Slide Presentasi Kelompok</option>
              <option value="2">Riset Pasar & Referensi</option>
            </select>
          </div>

          <!-- 7. Catatan -->
          <div class="form-group">
            <label class="form-label" for="task-notes">Catatan Tambahan</label>
            <textarea 
              id="task-notes" 
              class="form-input textarea-input" 
              rows="3" 
              placeholder="Instruksi khusus, format file, atau link materi..."
            ></textarea>
          </div>

          <!-- Action Buttons (Figma Match) -->
          <div class="form-actions-row">
            <a href="/prioritas" class="btn-cancel-task">Batal</a>
            <button type="submit" class="btn-save-task">Simpan Tugas</button>
          </div>
        </form>
      </div>

      <!-- Right Column: AI Live Prediction & Impact Preview -->
      <div class="ai-impact-col">
        <div class="impact-panel">
          <div class="impact-header">
            <Image src={mascotImg} alt="Beavy" class="impact-beavy-avatar" />
            <div>
              <h3 class="impact-title">Prediksi Jadwal Beavy</h3>
              <p class="impact-sub">Kalkulasi real-time dampak penambahan tugas ini</p>
            </div>
          </div>

          <div class="prediction-box">
            <div class="pred-item">
              <span class="pred-lbl">Peringkat Prioritas:</span>
              <span class="pred-val rank-1">#1 (Kritis)</span>
            </div>
            <p class="pred-desc">
              Karena tingkat kesulitan <strong>Sulit</strong> dan tenggat <strong>26 Okt</strong>, tugas ini akan ditempatkan di urutan teratas.
            </p>

            <div class="pred-item" style="margin-top: 1rem;">
              <span class="pred-lbl">Rekomendasi Waktu:</span>
              <span class="pred-val">Hari ini, 15.00 - 17.00</span>
            </div>
            <p class="pred-desc">
              Slot terbaik setelah makan siang sebelum rapat tim dimulai.
            </p>
          </div>

          <div class="tips-card">
            <h4>💡 Saran dari Beavy:</h4>
            <p>
              Tugas pemrograman lebih efektif jika dibagi 2 sesi masing-masing 60 menit dengan jeda 10 menit.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    .add-task-page-wrap {
      display: flex;
      flex-direction: column;
      gap: 1.8rem;
    }

    .add-task-grid {
      display: grid;
      grid-template-columns: 1.25fr 0.75fr;
      gap: 2rem;
      align-items: start;
    }

    .form-card-panel, .impact-panel {
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.9);
      border-radius: var(--radius-lg);
      padding: 2.2rem;
      box-shadow: var(--shadow-sm);
    }

    .form-title-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.3rem;
    }

    .page-title {
      font-size: 1.85rem;
      font-weight: 800;
      color: #201438;
    }

    .btn-back-link {
      font-size: 0.85rem;
      font-weight: 700;
      color: #7c3aed;
    }

    .form-subtitle {
      font-size: 0.88rem;
      color: #71628a;
      margin-bottom: 2rem;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
      margin-bottom: 1.4rem;
    }

    .form-label {
      font-size: 0.88rem;
      font-weight: 700;
      color: #352650;
    }

    .form-input {
      width: 100%;
      padding: 0.85rem 1.1rem;
      border: 1.5px solid #ded5eb;
      border-radius: 12px;
      font-family: inherit;
      font-size: 0.95rem;
      color: #22143a;
      background: #fdfcff;
      outline: none;
      transition: border-color 0.2s;
    }

    .form-input:focus {
      border-color: #8b5cf6;
      box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.15);
    }

    .select-input, .textarea-input {
      background: white;
    }

    /* Category Chips */
    .category-chips-row, .difficulty-chips-row {
      display: flex;
      gap: 0.7rem;
    }

    .cat-pill, .diff-pill {
      flex: 1;
      padding: 0.7rem;
      border-radius: var(--radius-md);
      border: 1.5px solid #ded4ec;
      background: #fbf9fe;
      color: #5d4d7a;
      font-size: 0.88rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s;
    }

    .cat-pill.active, .diff-pill.active {
      border-color: #8b5cf6;
      background: #8b5cf6;
      color: white;
      box-shadow: 0 4px 12px rgba(139, 92, 246, 0.3);
    }

    /* Duration Counter (From Figma Frame 109:272) */
    .duration-counter-wrap {
      display: flex;
      align-items: center;
      gap: 1rem;
      background: #fbf9fe;
      border: 1.5px solid #ded4ec;
      padding: 0.6rem 1rem;
      border-radius: 14px;
      width: fit-content;
    }

    .btn-counter {
      width: 38px;
      height: 38px;
      border-radius: 10px;
      border: 1px solid #d8cce8;
      background: white;
      font-size: 1.3rem;
      font-weight: 700;
      color: #554472;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.2s;
    }

    .btn-counter:hover {
      background: #8b5cf6;
      color: white;
      border-color: #8b5cf6;
    }

    .duration-display {
      display: flex;
      align-items: baseline;
      gap: 0.3rem;
      padding: 0 1rem;
    }

    .dur-num {
      font-size: 1.6rem;
      font-weight: 800;
      color: #21133c;
    }

    .dur-unit {
      font-size: 0.9rem;
      font-weight: 700;
      color: #796a92;
    }

    .helper-note {
      font-size: 0.75rem;
      color: #8c7e9e;
      margin-top: 0.3rem;
    }

    /* Form Actions */
    .form-actions-row {
      display: flex;
      gap: 1rem;
      margin-top: 2rem;
    }

    .btn-cancel-task {
      flex: 1;
      padding: 0.95rem;
      border-radius: var(--radius-full);
      border: 1.5px solid #d4c8e6;
      background: white;
      color: #5b4a78;
      font-size: 0.95rem;
      font-weight: 700;
      text-align: center;
      cursor: pointer;
    }

    .btn-save-task {
      flex: 1.5;
      padding: 0.95rem;
      border-radius: var(--radius-full);
      border: none;
      background: linear-gradient(135deg, #a855f7 0%, #8b5cf6 100%);
      color: white;
      font-size: 0.98rem;
      font-weight: 800;
      cursor: pointer;
      box-shadow: 0 8px 20px rgba(139, 92, 246, 0.35);
      transition: transform 0.2s;
    }

    .btn-save-task:hover {
      transform: translateY(-2px);
    }

    /* Right Column Impact */
    .impact-header {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding-bottom: 1.2rem;
      border-bottom: 1px solid #f0e8f8;
      margin-bottom: 1.4rem;
    }

    .impact-beavy-avatar {
      width: 48px;
      height: 48px;
      object-fit: contain;
    }

    .impact-title {
      font-size: 1.15rem;
      font-weight: 800;
      color: #21133c;
    }

    .impact-sub {
      font-size: 0.78rem;
      color: #796b92;
    }

    .prediction-box {
      background: #faf7fd;
      border: 1px solid #ede3f7;
      border-radius: var(--radius-md);
      padding: 1.4rem;
      margin-bottom: 1.4rem;
    }

    .pred-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.4rem;
    }

    .pred-lbl {
      font-size: 0.88rem;
      font-weight: 700;
      color: #52426d;
    }

    .pred-val {
      font-size: 0.92rem;
      font-weight: 800;
      color: #21143a;
    }

    .pred-val.rank-1 {
      color: #dc2626;
      background: #fee2e2;
      padding: 0.2rem 0.6rem;
      border-radius: 6px;
    }

    .pred-desc {
      font-size: 0.78rem;
      color: #73648e;
      line-height: 1.45;
    }

    .tips-card {
      background: #fffbeb;
      border: 1px solid #fde68a;
      border-radius: var(--radius-md);
      padding: 1.2rem;
    }

    .tips-card h4 {
      font-size: 0.88rem;
      font-weight: 800;
      color: #92400e;
      margin-bottom: 0.35rem;
    }

    .tips-card p {
      font-size: 0.8rem;
      color: #78350f;
      line-height: 1.45;
    }

    @media (max-width: 960px) {
      .add-task-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script>
    // Category Selector
    const catPills = document.querySelectorAll('.cat-pill');
    catPills.forEach(p => {
      p.addEventListener('click', () => {
        catPills.forEach(c => c.classList.remove('active'));
        p.classList.add('active');
      });
    });

    // Difficulty Selector
    const diffPills = document.querySelectorAll('.diff-pill');
    diffPills.forEach(p => {
      p.addEventListener('click', () => {
        diffPills.forEach(d => d.classList.remove('active'));
        p.classList.add('active');
      });
    });

    // Duration Counter
    let dur = 2;
    const durVal = document.getElementById('dur-value');
    const btnInc = document.getElementById('btn-inc-dur');
    const btnDec = document.getElementById('btn-dec-dur');

    btnInc?.addEventListener('click', () => {
      dur += 0.5;
      if (durVal) durVal.textContent = String(dur);
    });

    btnDec?.addEventListener('click', () => {
      if (dur > 0.5) {
        dur -= 0.5;
        if (durVal) durVal.textContent = String(dur);
      }
    });

    // Form Submit
    document.getElementById('add-task-full-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const title = (document.getElementById('task-name') as HTMLInputElement)?.value;
      alert(`🎉 Tugas "${title}" berhasil disimpan dan dimasukkan ke kalender!`);
      window.location.href = '/prioritas';
    });
  </script>
</DashboardLayout>
