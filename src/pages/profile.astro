        grid-template-columns: 1fr;
      }
      .profile-header-row {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>

  <script>
    declare global {
      interface Window {
        jadwalinToast?: (title: string, msg: string, type?: 'success' | 'info' | 'warning' | 'error') => void;
      }
    }

    // Modal Helper
    const openModal = (id: string) => document.getElementById(id)?.classList.add('active');
    const closeModal = (id: string) => document.getElementById(id)?.classList.remove('active');

    // 1. Routine Add Modal
    document.getElementById('btn-add-routine')?.addEventListener('click', () => openModal('routine-modal'));
    document.getElementById('btn-close-routine-modal')?.addEventListener('click', () => closeModal('routine-modal'));
    document.getElementById('btn-cancel-routine')?.addEventListener('click', () => closeModal('routine-modal'));

    document.getElementById('btn-submit-routine')?.addEventListener('click', () => {
      const titleInput = document.getElementById('routine-input-title') as HTMLInputElement;
      const timeInput = document.getElementById('routine-input-time') as HTMLInputElement;
      const durInput = document.getElementById('routine-input-dur') as HTMLInputElement;
      const daysInput = document.getElementById('routine-input-days') as HTMLInputElement;

      const title = titleInput?.value.trim() || 'Rutinitas Baru';
      const time = timeInput?.value.trim() || '16.00';
      const dur = durInput?.value.trim() || '60 mnt';
      const days = daysInput?.value.trim() || 'Setiap Minggu';

      const newArticle = document.createElement('article');
      newArticle.className = 'routine-item-row';
      newArticle.setAttribute('data-title', title);
      newArticle.setAttribute('data-time', time);
      newArticle.setAttribute('data-dur', dur);
      newArticle.setAttribute('data-days', days);
      newArticle.innerHTML = `
        <div class="routine-time-box">
          <span class="routine-time-clock">${time}</span>
          <span class="routine-time-span">${dur}</span>
        </div>
        <div class="routine-info-box">
          <div class="routine-headline">
            <h3 class="routine-task-title">${title}</h3>
            <span class="routine-category-badge">Kustom</span>
          </div>
          <span class="routine-recurrence">${days}</span>
        </div>
        <div class="routine-actions-box">
          <button type="button" class="btn-routine-action" title="Kelola Jadwal" aria-label="Opsi ${title}" data-title="${title}">
            <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="1"></circle>
              <circle cx="19" cy="12" r="1"></circle>
              <circle cx="5" cy="12" r="1"></circle>
            </svg>
          </button>
        </div>
      `;

      attachRoutineAction(newArticle.querySelector('.btn-routine-action') as HTMLElement);
      document.getElementById('routine-list')?.prepend(newArticle);
      closeModal('routine-modal');
      window.jadwalinToast?.('Rutinitas Ditambahkan', `Rutinitas "${title}" berhasil dikunci di kalender.`, 'success');
      titleInput.value = '';
    });

    // 2. Password Modal
    document.getElementById('btn-change-pwd')?.addEventListener('click', () => openModal('pwd-modal'));
    document.getElementById('btn-close-pwd-modal')?.addEventListener('click', () => closeModal('pwd-modal'));
    document.getElementById('btn-cancel-pwd')?.addEventListener('click', () => closeModal('pwd-modal'));

    document.getElementById('form-change-pwd')?.addEventListener('submit', (e) => {
      e.preventDefault();
      closeModal('pwd-modal');
      window.jadwalinToast?.('Kata Sandi Diperbarui', 'Kata sandi Anda berhasil diubah dengan aman.', 'success');
    });

    // 3. Avatar Modal
    let selectedAvatar = 'D';
    document.getElementById('btn-edit-avatar')?.addEventListener('click', () => openModal('avatar-modal'));
    document.getElementById('btn-close-avatar-modal')?.addEventListener('click', () => closeModal('avatar-modal'));
    document.getElementById('btn-cancel-avatar')?.addEventListener('click', () => closeModal('avatar-modal'));

    const presetBtns = document.querySelectorAll('.preset-avatar-btn');
    presetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        presetBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        selectedAvatar = btn.getAttribute('data-preset') || 'D';
      });
    });

    document.getElementById('btn-save-avatar')?.addEventListener('click', () => {
      const display = document.getElementById('user-avatar-display');
      if (display) display.textContent = selectedAvatar;
      closeModal('avatar-modal');
      window.jadwalinToast?.('Foto Profil Diperbarui', `Avatar berhasil diganti dengan inisial ${selectedAvatar}.`, 'success');
    });

    // 5. Edit Routine Modal
    let activeRoutineRow: HTMLElement | null = null;
    const attachRoutineAction = (btn: HTMLElement) => {
      btn.addEventListener('click', () => {
        const row = btn.closest('.routine-item-row') as HTMLElement;
        activeRoutineRow = row;
        const title = row?.getAttribute('data-title') || 'Rutinitas';
        const time = row?.getAttribute('data-time') || '10.00';
        const dur = row?.getAttribute('data-dur') || '60 mnt';
        const days = row?.getAttribute('data-days') || 'Setiap hari';

        const titleEl = document.getElementById('edit-routine-title') as HTMLInputElement;
        const timeEl = document.getElementById('edit-routine-time') as HTMLInputElement;
        const durEl = document.getElementById('edit-routine-dur') as HTMLInputElement;
        const daysEl = document.getElementById('edit-routine-days') as HTMLInputElement;

        if (titleEl) titleEl.value = title;
        if (timeEl) timeEl.value = time;
        if (durEl) durEl.value = dur;
        if (daysEl) daysEl.value = days;

        openModal('edit-routine-modal');
      });
    };

    document.querySelectorAll('.btn-routine-action').forEach((btn) => attachRoutineAction(btn as HTMLElement));
    document.getElementById('btn-close-edit-routine-modal')?.addEventListener('click', () => closeModal('edit-routine-modal'));
    document.getElementById('btn-cancel-edit-routine')?.addEventListener('click', () => closeModal('edit-routine-modal'));

    document.getElementById('form-edit-routine')?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (activeRoutineRow) {
        const title = (document.getElementById('edit-routine-title') as HTMLInputElement).value;
        const time = (document.getElementById('edit-routine-time') as HTMLInputElement).value;
        const dur = (document.getElementById('edit-routine-dur') as HTMLInputElement).value;
        const days = (document.getElementById('edit-routine-days') as HTMLInputElement).value;

        activeRoutineRow.setAttribute('data-title', title);
        activeRoutineRow.setAttribute('data-time', time);
        activeRoutineRow.setAttribute('data-dur', dur);
        activeRoutineRow.setAttribute('data-days', days);

        const clock = activeRoutineRow.querySelector('.routine-time-clock');
        const span = activeRoutineRow.querySelector('.routine-time-span');
        const heading = activeRoutineRow.querySelector('.routine-task-title');
        const recur = activeRoutineRow.querySelector('.routine-recurrence');

        if (clock) clock.textContent = time;
        if (span) span.textContent = dur;
        if (heading) heading.textContent = title;
        if (recur) recur.textContent = days;

        closeModal('edit-routine-modal');
        window.jadwalinToast?.('Rutinitas Diperbarui', `Jadwal "${title}" berhasil disesuaikan.`, 'success');
      }
    });

    document.getElementById('btn-delete-routine')?.addEventListener('click', () => {
      if (activeRoutineRow) {
        const title = activeRoutineRow.getAttribute('data-title') || 'Rutinitas';
        activeRoutineRow.remove();
        closeModal('edit-routine-modal');
        window.jadwalinToast?.('Rutinitas Dihapus', `Aktivitas "${title}" dihapus dari jadwal terproteksi.`, 'info');
      }
    });

    // Save Preferences
    document.getElementById('btn-save-prefs')?.addEventListener('click', () => {
      window.jadwalinToast?.('Preferensi Tersimpan', 'Preferensi belajar dan jam aktif Beavy berhasil diperbarui.', 'success');
    });

    // Global ESC to close active modal
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document.querySelectorAll('.modal-backdrop-overlay.active').forEach(m => m.classList.remove('active'));
      }
    });

    // Sinkronisasi Data Profil dengan Pengguna Aktif
    import { getUserData } from '../utils/db';
    try {
      const rawUser = localStorage.getItem('jadwalin_current_user');
      if (rawUser) {
        const u = JSON.parse(rawUser);
        if (u?.name) {
          const nameEl = document.querySelector('.user-full-name');
          if (nameEl) nameEl.textContent = u.name;
          const avatarEl = document.getElementById('user-avatar-display');
          if (avatarEl) avatarEl.textContent = u.name.trim().charAt(0).toUpperCase();
        }
        if (u?.email) {
          const emailEl = document.querySelector('.user-email-text');
          if (emailEl) emailEl.textContent = u.email;

          // Perbarui statistik tugas aktif
          const isDemo = u.email.trim().toLowerCase() === 'daffaahmadalsch@student.ub.ac.id';
          const data = getUserData(u.email);
          const statUnits = document.querySelectorAll('.ambient-stats-grid .stat-unit .stat-number');
          if (statUnits.length >= 2) {
            if (!isDemo && data.tasks.length === 0) {
              statUnits[0].textContent = '0';
              statUnits[1].textContent = '0';
            } else if (!isDemo && data.tasks.length > 0) {
              statUnits[0].textContent = String(data.tasks.length);
              statUnits[1].textContent = String(data.tasks.filter(t => t.urgent).length);
            }
          }
        }
      }
    } catch(e) {}
  </script>
</DashboardLayout>
