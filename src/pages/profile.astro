---
// src/pages/profile.astro
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { Image } from 'astro:assets';
import mascotImg from '../assets/craiyon.png';

const recurringSchedules = [
  {
    id: 1,
    time: "10.00",
    duration: "120 mnt",
    title: "Fokus: Pemrograman Web dan API",
    days: "Senin, Rabu, Jumat",
    tag: "Akademik",
    active: true
  },
  {
    id: 2,
    time: "12.00",
    duration: "55 mnt",
    title: "Kuliah Basis Data",
    days: "Kamis",
    tag: "Kuliah",
    active: true
  },
  {
    id: 3,
    time: "19.00",
    duration: "30 mnt",
    title: "Olahraga Kardio dan Kebugaran",
    days: "Jumat, Sabtu",
    tag: "Kesehatan",
    active: true
  },
  {
    id: 4,
    time: "22.00",
    duration: "20 mnt",
    title: "Membaca Buku dan Refleksi",
    days: "Setiap hari",
    tag: "Personal",
    active: false
  }
];
---

<DashboardLayout title="Profil Pengguna" activeNav="profile">
  <div class="profile-page-layout">

    <!-- Top Editorial Header -->
    <header class="profile-header-row">
      <div class="header-titles">
        <h1 class="page-title">Profil Mahasiswa</h1>
        <p class="page-subtitle">Kelola jadwal rutin terproteksi, preferensi asistensi Beavy, dan keamanan akun Anda.</p>
      </div>

      <div class="header-actions">
        <button type="button" id="btn-add-routine" class="btn-primary-pill">
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          <span>Tambah Rutinitas</span>
        </button>
      </div>
    </header>

    <!-- 2-Column Grid -->
    <div class="profile-grid">
      
      <!-- Left Column: User Card & Routines -->
      <section class="profile-main-col">
        
        <!-- User Identity Card -->
        <div class="profile-surface user-card">
          <div class="user-row-header">
            <div class="avatar-wrap">
              <div class="avatar-circle">D</div>
              <button type="button" class="btn-avatar-edit" id="btn-edit-avatar" aria-label="Ganti foto profil">
                <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                  <circle cx="12" cy="13" r="4"></circle>
                </svg>
              </button>
            </div>

            <div class="user-meta">
              <div class="user-name-line">
                <h2 class="user-full-name">Daffa Ahmad Al Attas</h2>
                <span class="verified-tag">
                  <svg aria-hidden="true" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  Terverifikasi
                </span>
              </div>
              <p class="user-email-text">daffaahmadalsch@student.ub.ac.id</p>
              
              <div class="user-badges-row">
                <span class="meta-chip">Mahasiswa</span>
                <span class="meta-chip">Semester 5</span>
                <span class="focus-chip">
                  <svg aria-hidden="true" width="11" height="11" viewBox="0 0 24 24" fill="currentColor">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                  </svg>
                  Tingkat Fokus: Gold
                </span>
              </div>
            </div>
          </div>

          <!-- Ambient Stats Row -->
          <div class="ambient-stats-grid">
            <div class="stat-unit">
              <span class="stat-number">5</span>
              <span class="stat-label">Tugas Aktif</span>
            </div>
            <div class="stat-unit">
              <span class="stat-number text-urgent">2</span>
              <span class="stat-label">Mendekati Deadline</span>
            </div>
            <div class="stat-unit">
              <span class="stat-number text-accent">3</span>
              <span class="stat-label">Sesi Hari Ini</span>
            </div>
          </div>
        </div>

        <!-- Protected Routine Schedule -->
        <div class="profile-surface routine-section">
          <div class="section-header-block">
            <div>
              <h2 class="section-heading">Jadwal Rutin Terproteksi</h2>
              <p class="section-subheading">Aktivitas mingguan yang otomatis dikunci Beavy agar tidak tumpang tindih dengan tugas.</p>
            </div>
          </div>

          <div class="routine-items-list" id="routine-list">
            {recurringSchedules.map((item) => (
              <article class="routine-item-row" data-id={item.id}>
                <div class="routine-time-box">
                  <span class="routine-time-clock">{item.time}</span>
                  <span class="routine-time-span">{item.duration}</span>
                </div>

                <div class="routine-info-box">
                  <div class="routine-headline">
                    <h3 class="routine-task-title">{item.title}</h3>
                    <span class="routine-category-badge">{item.tag}</span>
                  </div>
                  <span class="routine-recurrence">{item.days}</span>
                </div>

                <div class="routine-actions-box">
                  <button type="button" class="btn-routine-action" title="Kelola Jadwal" aria-label={`Opsi untuk ${item.title}`} data-title={item.title}>
                    <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="1"></circle>
                      <circle cx="19" cy="12" r="1"></circle>
                      <circle cx="5" cy="12" r="1"></circle>
                    </svg>
                  </button>
                </div>
              </article>
            ))}
          </div>
        </div>

      </section>

      <!-- Right Column: Preferences & Security -->
      <aside class="profile-side-col">
        
        <!-- Beavy AI Habits & Settings -->
        <div class="profile-surface settings-card">
          <div class="settings-head-row">
            <div class="settings-avatar-wrap">
              <Image src={mascotImg} alt="Beavy" class="settings-avatar-img" />
            </div>
            <div>
              <h2 class="settings-heading">Preferensi Belajar Beavy</h2>
              <p class="settings-subheading">Sesuaikan cara AI menyusun jadwal harian Anda</p>
            </div>
          </div>

          <div class="settings-stack">
            <div class="pref-row">
              <div class="pref-meta">
                <strong class="pref-title">Jam Aktif Produktif</strong>
                <span class="pref-desc">Rentang waktu Anda bersedia belajar</span>
              </div>
              <span class="pref-pill">08.00 - 21.00</span>
            </div>

            <div class="pref-row">
              <div class="pref-meta">
                <strong class="pref-title">Jeda Istirahat (Buffer)</strong>
                <span class="pref-desc">Waktu jeda otomatis antar sesi tugas</span>
              </div>
              <span class="pref-pill">15 menit</span>
            </div>

            <div class="pref-row">
              <div class="pref-meta">
                <strong class="pref-title">Gaya Pengingat Beavy</strong>
                <span class="pref-desc">Nada komunikasi asistensi</span>
              </div>
              <span class="pref-pill">Tegas dan Solutif</span>
            </div>

            <div class="pref-row">
              <div class="pref-meta">
                <strong class="pref-title">Notifikasi Agenda Harian</strong>
                <span class="pref-desc">Kirim ringkasan jam 07.30 pagi</span>
              </div>
              <label class="switch-toggle" aria-label="Aktifkan notifikasi agenda harian">
                <input type="checkbox" checked id="toggle-notif" />
                <span class="toggle-slider"></span>
              </label>
            </div>
          </div>

          <button type="button" class="btn-save-prefs" id="btn-save-prefs">
            Simpan Perubahan
          </button>
        </div>

        <!-- Security & Account -->
        <div class="profile-surface security-card">
          <h2 class="security-heading">Keamanan dan Otentikasi</h2>
          
          <div class="security-links-stack">
            <button type="button" class="btn-sec-action" id="btn-change-pwd">
              <span class="sec-icon">
                <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
              </span>
              <span>Ganti Kata Sandi</span>
            </button>

            <button type="button" class="btn-sec-action" id="btn-face-id">
              <span class="sec-icon">
                <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 3H5a2 2 0 0 0-2 2v2"></path>
                  <path d="M17 3h2a2 2 0 0 1 2 2v2"></path>
                  <path d="M21 17v2a2 2 0 0 1-2 2h-2"></path>
                  <path d="M3 17v2a2 2 0 0 0 2 2h2"></path>
                  <circle cx="12" cy="12" r="3"></circle>
                </svg>
              </span>
              <span>Atur Verifikasi Wajah (Face ID)</span>
            </button>

            <a href="/login" class="btn-sec-action btn-sec-danger">
              <span class="sec-icon">
                <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                  <polyline points="16 17 21 12 16 7"></polyline>
                  <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
              </span>
              <span>Keluar dari Akun</span>
            </a>
          </div>
        </div>

      </aside>
    </div>

    <!-- Routine Modal -->
    <div id="routine-modal" class="modal-backdrop-overlay" style="display: none;">
      <div class="modal-container-card">
        <div class="modal-head-line">
          <h2 class="modal-dialog-title">Tambah Rutinitas Mingguan</h2>
          <button type="button" class="btn-modal-dismiss" id="btn-close-routine-modal" aria-label="Tutup jendela">
            <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        <p class="modal-context-desc">Rutinitas ini akan secara otomatis memblokir slot kalender Beavy agar tidak bentrok.</p>
        
        <div class="modal-fields-group">
          <div class="dialog-field">
            <label class="dialog-label" for="routine-input-title">Nama Rutinitas</label>
            <input type="text" id="routine-input-title" class="dialog-input" placeholder="Contoh: Belajar Bahasa Asing atau Olahraga" />
          </div>

          <div class="dialog-row-2">
            <div class="dialog-field">
              <label class="dialog-label" for="routine-input-time">Jam Mulai</label>
              <input type="text" id="routine-input-time" class="dialog-input" value="16.00" />
            </div>
            <div class="dialog-field">
              <label class="dialog-label" for="routine-input-dur">Durasi</label>
              <input type="text" id="routine-input-dur" class="dialog-input" value="60 mnt" />
            </div>
          </div>

          <div class="dialog-field">
            <label class="dialog-label" for="routine-input-days">Hari Pelaksanaan</label>
            <input type="text" id="routine-input-days" class="dialog-input" value="Senin, Kamis" />
          </div>
        </div>

        <div class="modal-footer-cluster">
          <button type="button" class="btn-cancel-dialog" id="btn-cancel-routine">Batal</button>
          <button type="button" class="btn-save-dialog" id="btn-submit-routine">Simpan Rutinitas</button>
        </div>
      </div>
    </div>

  </div>

  <style>
    /* =========================================================
       AWWWARDS EDITORIAL PROFILE: Minimalist, Flat, Tokenized
       ========================================================= */

    :root {
      --overlay-scrim: rgba(18, 10, 30, 0.4);
    }

    :focus-visible {
      outline: 2px solid var(--color-primary);
      outline-offset: 2px;
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }

    .profile-page-layout {
      max-width: 1180px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 2rem;
      padding-bottom: 3.5rem;
    }

    /* Header */
    .profile-header-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 1.5rem;
      padding: 1rem 0 0.5rem;
      border-bottom: 1px solid var(--color-border-subtle);
    }

    .page-title {
      font-size: 2.2rem;
      font-weight: 800;
      color: var(--color-text-main);
      letter-spacing: -0.03em;
      line-height: 1.15;
    }

    .page-subtitle {
      font-size: 0.92rem;
      color: var(--color-text-muted);
      margin-top: 0.4rem;
      line-height: 1.5;
    }

    .btn-primary-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.65rem 1.25rem;
      border-radius: var(--radius-full);
      border: 1px solid var(--color-border);
      background: var(--color-surface);
      color: var(--color-text-main);
      font-size: 0.84rem;
      font-weight: 700;
      cursor: pointer;
      box-shadow: var(--shadow-xs);
      transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    }

    .btn-primary-pill:hover {
      background: var(--color-primary-light);
      border-color: var(--color-border-focus);
      color: var(--color-primary);
    }

    /* Grid */
    .profile-grid {
      display: grid;
      grid-template-columns: 1.35fr 0.85fr;
      gap: 2.2rem;
      align-items: start;
    }

    .profile-main-col, .profile-side-col {
      display: flex;
      flex-direction: column;
      gap: 1.8rem;
    }

    /* Surfaces */
    .profile-surface {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
      padding: 2.2rem;
      box-shadow: var(--shadow-xs);
    }

    /* User Row */
    .user-row-header {
      display: flex;
      gap: 1.5rem;
      align-items: center;
      padding-bottom: 1.8rem;
      border-bottom: 1px solid var(--color-border-subtle);
    }

    .avatar-wrap {
      position: relative;
      flex-shrink: 0;
    }

    .avatar-circle {
      width: 74px;
      height: 74px;
      border-radius: 50%;
      background: var(--color-primary);
      color: var(--color-surface);
      font-family: var(--font-mono);
      font-size: 1.8rem;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: var(--shadow-sm);
    }

    .btn-avatar-edit {
      position: absolute;
      bottom: -2px;
      right: -2px;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      color: var(--color-text-muted);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: var(--shadow-xs);
      transition: color 0.15s ease, border-color 0.15s ease;
    }

    .btn-avatar-edit:hover {
      color: var(--color-primary);
      border-color: var(--color-primary);
    }

    .user-meta {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .user-name-line {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      flex-wrap: wrap;
    }

    .user-full-name {
      font-size: 1.35rem;
      font-weight: 800;
      color: var(--color-text-main);
      letter-spacing: -0.02em;
    }

    .verified-tag {
      display: inline-flex;
      align-items: center;
      gap: 0.3rem;
      font-size: 0.7rem;
      font-weight: 700;
      color: var(--color-primary-dark);
      background: var(--color-primary-light);
      border: 1px solid var(--color-border-focus);
      padding: 0.15rem 0.55rem;
      border-radius: var(--radius-full);
    }

    .user-email-text {
      font-size: 0.84rem;
      color: var(--color-text-muted);
      margin-bottom: 0.5rem;
    }

    .user-badges-row {
      display: flex;
      gap: 0.45rem;
      flex-wrap: wrap;
      align-items: center;
    }

    .meta-chip {
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--color-primary);
      background: var(--color-primary-light);
      padding: 0.2rem 0.65rem;
      border-radius: var(--radius-full);
      border: 1px solid var(--color-border-focus);
    }

    .focus-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--color-text-main);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      padding: 0.2rem 0.65rem;
      border-radius: var(--radius-full);
    }

    /* Ambient Stats Grid */
    .ambient-stats-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.2rem;
      padding-top: 1.4rem;
    }

    .stat-unit {
      text-align: center;
      padding: 0.85rem;
      background: var(--color-surface);
      border-radius: var(--radius-md);
      border: 1px solid var(--color-border-subtle);
    }

    .stat-number {
      font-family: var(--font-mono);
      font-size: 1.65rem;
      font-weight: 800;
      color: var(--color-text-main);
      display: block;
      line-height: 1.1;
    }

    .text-urgent {
      color: var(--color-text-main);
    }

    .text-accent {
      color: var(--color-primary-dark);
    }

    .stat-label {
      font-size: 0.74rem;
      font-weight: 600;
      color: var(--color-text-muted);
      margin-top: 0.25rem;
      display: block;
    }

    /* Routine Section */
    .section-header-block {
      margin-bottom: 1.4rem;
    }

    .section-heading {
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--color-text-main);
      letter-spacing: -0.01em;
    }

    .section-subheading {
      font-size: 0.8rem;
      color: var(--color-text-muted);
      margin-top: 0.2rem;
      line-height: 1.45;
    }

    .routine-items-list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .routine-item-row {
      display: flex;
      align-items: center;
      gap: 1.2rem;
      padding: 0.95rem 1.1rem;
      background: var(--color-surface);
      border: 1px solid var(--color-border-subtle);
      border-radius: var(--radius-md);
      transition: border-color 0.15s ease, background-color 0.15s ease;
    }

    .routine-item-row:hover {
      border-color: var(--color-border-focus);
      background: var(--color-primary-light);
    }

    .routine-time-box {
      min-width: 65px;
      display: flex;
      flex-direction: column;
    }

    .routine-time-clock {
      font-family: var(--font-mono);
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--color-text-main);
    }

    .routine-time-span {
      font-size: 0.7rem;
      font-weight: 600;
      color: var(--color-text-muted);
    }

    .routine-info-box {
      flex: 1;
    }

    .routine-headline {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin-bottom: 0.2rem;
      flex-wrap: wrap;
    }

    .routine-task-title {
      font-size: 0.92rem;
      font-weight: 800;
      color: var(--color-text-main);
    }

    .routine-category-badge {
      font-size: 0.68rem;
      font-weight: 700;
      padding: 0.15rem 0.5rem;
      border-radius: var(--radius-sm);
      background: var(--color-primary-light);
      color: var(--color-primary-dark);
      border: 1px solid var(--color-border-focus);
    }

    .routine-recurrence {
      font-size: 0.76rem;
      color: var(--color-text-muted);
    }

    .btn-routine-action {
      background: none;
      border: 1px solid transparent;
      color: var(--color-text-muted);
      padding: 0.35rem;
      border-radius: var(--radius-sm);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
    }

    .btn-routine-action:hover {
      background: var(--color-primary-light);
      color: var(--color-primary-dark);
      border-color: var(--color-border-focus);
    }

    /* Right Column Preferences */
    .settings-head-row {
      display: flex;
      align-items: center;
      gap: 0.9rem;
      padding-bottom: 1.2rem;
      border-bottom: 1px solid var(--color-border-subtle);
      margin-bottom: 1.2rem;
    }

    .settings-avatar-wrap {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--color-primary-light);
      border: 1px solid var(--color-border-focus);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .settings-avatar-img {
      width: 32px;
      height: 32px;
      object-fit: contain;
    }

    .settings-heading {
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--color-text-main);
      letter-spacing: -0.01em;
    }

    .settings-subheading {
      font-size: 0.76rem;
      color: var(--color-text-muted);
      margin-top: 0.1rem;
    }

    .settings-stack {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin-bottom: 1.4rem;
    }

    .pref-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.85rem 1rem;
      background: var(--color-surface);
      border: 1px solid var(--color-border-subtle);
      border-radius: var(--radius-md);
      transition: border-color 0.15s ease;
    }

    .pref-row:hover {
      border-color: var(--color-border-focus);
    }

    .pref-meta {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }

    .pref-title {
      font-size: 0.84rem;
      color: var(--color-text-main);
    }

    .pref-desc {
      font-size: 0.72rem;
      color: var(--color-text-muted);
    }

    .pref-pill {
      font-family: var(--font-mono);
      font-size: 0.76rem;
      font-weight: 700;
      color: var(--color-primary-dark);
      background: var(--color-primary-light);
      padding: 0.25rem 0.65rem;
      border-radius: var(--radius-full);
      border: 1px solid var(--color-border-focus);
      white-space: nowrap;
    }

    /* Switch */
    .switch-toggle {
      position: relative;
      display: inline-block;
      width: 40px;
      height: 22px;
      flex-shrink: 0;
    }

    .switch-toggle input {
      opacity: 0;
      width: 0;
      height: 0;
    }

    .toggle-slider {
      position: absolute;
      cursor: pointer;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: var(--color-border);
      border-radius: var(--radius-full);
      transition: background-color 0.2s ease;
    }

    .toggle-slider:before {
      position: absolute;
      content: "";
      height: 16px;
      width: 16px;
      left: 3px;
      bottom: 3px;
      background-color: var(--color-surface);
      border-radius: 50%;
      transition: transform 0.2s ease;
      box-shadow: var(--shadow-xs);
    }

    input:checked + .toggle-slider {
      background-color: var(--color-primary);
    }

    input:checked + .toggle-slider:before {
      transform: translateX(18px);
    }

    .btn-save-prefs {
      width: 100%;
      padding: 0.85rem;
      border-radius: var(--radius-full);
      border: none;
      background: var(--color-primary);
      color: var(--color-surface);
      font-weight: 700;
      font-size: 0.88rem;
      cursor: pointer;
      box-shadow: var(--shadow-sm);
      transition: background-color 0.15s ease, transform 0.15s ease;
    }

    .btn-save-prefs:hover {
      background: var(--color-primary-dark);
      transform: translateY(-1px);
    }

    /* Security */
    .security-heading {
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--color-text-main);
      margin-bottom: 1rem;
      letter-spacing: -0.01em;
    }

    .security-links-stack {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }

    .btn-sec-action {
      width: 100%;
      text-align: left;
      padding: 0.8rem 1rem;
      border-radius: var(--radius-md);
      border: 1px solid var(--color-border-subtle);
      background: var(--color-surface);
      font-size: 0.84rem;
      font-weight: 600;
      color: var(--color-text-main);
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
      transition: border-color 0.15s ease, background-color 0.15s ease;
    }

    .sec-icon {
      color: var(--color-primary);
      display: flex;
      align-items: center;
    }

    .btn-sec-action:hover {
      background: var(--color-primary-light);
      border-color: var(--color-border-focus);
    }

    .btn-sec-danger {
      color: var(--color-text-main);
      border-color: var(--color-border);
    }

    .btn-sec-danger .sec-icon {
      color: var(--color-text-muted);
    }

    .btn-sec-danger:hover {
      background: var(--color-primary-light);
      border-color: var(--color-primary);
    }

    /* Modal */
    .modal-backdrop-overlay {
      position: fixed;
      inset: 0;
      background: var(--overlay-scrim);
      backdrop-filter: blur(8px);
      z-index: 999;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
    }

    .modal-backdrop-overlay.active {
      display: flex !important;
    }

    .modal-container-card {
      background: var(--color-surface);
      border-radius: var(--radius-xl);
      padding: 2.2rem;
      max-width: 480px;
      width: 100%;
      box-shadow: var(--shadow-lg);
      border: 1px solid var(--color-border);
    }

    .modal-head-line {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.35rem;
    }

    .modal-dialog-title {
      font-size: 1.25rem;
      font-weight: 800;
      color: var(--color-text-main);
    }

    .btn-modal-dismiss {
      background: none;
      border: none;
      color: var(--color-text-muted);
      cursor: pointer;
      padding: 0.35rem;
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: color 0.15s ease;
    }

    .btn-modal-dismiss:hover {
      color: var(--color-text-main);
    }

    .modal-context-desc {
      font-size: 0.8rem;
      color: var(--color-text-muted);
      margin-bottom: 1.4rem;
      line-height: 1.45;
    }

    .modal-fields-group {
      display: flex;
      flex-direction: column;
      gap: 1.1rem;
      margin-bottom: 1.8rem;
    }

    .dialog-field {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .dialog-row-2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .dialog-label {
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--color-text-main);
    }

    .dialog-input {
      width: 100%;
      padding: 0.75rem 0.95rem;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      font-family: inherit;
      font-size: 0.88rem;
      color: var(--color-text-main);
      background: var(--color-surface);
    }

    .dialog-input:focus {
      outline: 2px solid var(--color-primary);
      outline-offset: 1px;
    }

    .modal-footer-cluster {
      display: flex;
      gap: 0.85rem;
    }

    .btn-cancel-dialog {
      flex: 1;
      padding: 0.75rem;
      border-radius: var(--radius-full);
      border: 1px solid var(--color-border);
      background: var(--color-surface);
      color: var(--color-text-muted);
      font-weight: 700;
      font-size: 0.88rem;
      cursor: pointer;
      transition: color 0.15s ease, border-color 0.15s ease;
    }

    .btn-cancel-dialog:hover {
      border-color: var(--color-border-focus);
      color: var(--color-text-main);
    }

    .btn-save-dialog {
      flex: 1.5;
      padding: 0.75rem;
      border-radius: var(--radius-full);
      border: none;
      background: var(--color-primary);
      color: var(--color-surface);
      font-weight: 700;
      font-size: 0.88rem;
      cursor: pointer;
      box-shadow: var(--shadow-sm);
      transition: background-color 0.15s ease;
    }

    .btn-save-dialog:hover {
      background: var(--color-primary-dark);
    }

    @media (max-width: 960px) {
      .profile-grid {
        grid-template-columns: 1fr;
      }
      .profile-header-row {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>

  <script>
    declare global {
      interface Window {
        jadwalinToast?: (title: string, msg: string, type?: 'success' | 'info' | 'warning' | 'error') => void;
      }
    }

    // Modal Routine Controls
    const modal = document.getElementById('routine-modal');
    const btnAddRoutine = document.getElementById('btn-add-routine');
    const btnCloseModal = document.getElementById('btn-close-routine-modal');
    const btnCancel = document.getElementById('btn-cancel-routine');
    const btnSubmit = document.getElementById('btn-submit-routine');
    const routineList = document.getElementById('routine-list');

    btnAddRoutine?.addEventListener('click', () => {
      modal?.classList.add('active');
    });

    const closeModal = () => modal?.classList.remove('active');
    btnCloseModal?.addEventListener('click', closeModal);
    btnCancel?.addEventListener('click', closeModal);

    btnSubmit?.addEventListener('click', () => {
      const titleInput = document.getElementById('routine-input-title') as HTMLInputElement;
      const timeInput = document.getElementById('routine-input-time') as HTMLInputElement;
      const durInput = document.getElementById('routine-input-dur') as HTMLInputElement;
      const daysInput = document.getElementById('routine-input-days') as HTMLInputElement;

      const title = titleInput?.value.trim() || 'Rutinitas Baru';
      const time = timeInput?.value.trim() || '16.00';
      const dur = durInput?.value.trim() || '60 mnt';
      const days = daysInput?.value.trim() || 'Setiap Minggu';

      const newArticle = document.createElement('article');
      newArticle.className = 'routine-item-row';
      newArticle.innerHTML = `
        <div class="routine-time-box">
          <span class="routine-time-clock">${time}</span>
          <span class="routine-time-span">${dur}</span>
        </div>
        <div class="routine-info-box">
          <div class="routine-headline">
            <h3 class="routine-task-title">${title}</h3>
            <span class="routine-category-badge">Kustom</span>
          </div>
          <span class="routine-recurrence">${days}</span>
        </div>
        <div class="routine-actions-box">
          <button type="button" class="btn-routine-action" title="Kelola Jadwal" aria-label="Opsi ${title}">
            <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="1"></circle>
              <circle cx="19" cy="12" r="1"></circle>
              <circle cx="5" cy="12" r="1"></circle>
            </svg>
          </button>
        </div>
      `;

      routineList?.prepend(newArticle);
      closeModal();
      window.jadwalinToast?.('Rutinitas Ditambahkan', `Rutinitas "${title}" berhasil dikunci di kalender.`, 'success');
      titleInput.value = '';
    });

    // Edit Avatar
    document.getElementById('btn-edit-avatar')?.addEventListener('click', () => {
      window.jadwalinToast?.('Ganti Foto Profil', 'Pilih berkas gambar foto profil baru (PNG atau JPG).', 'info');
    });

    // Save Preferences
    document.getElementById('btn-save-prefs')?.addEventListener('click', () => {
      window.jadwalinToast?.('Preferensi Tersimpan', 'Preferensi belajar dan jam aktif Beavy berhasil diperbarui.', 'success');
    });

    // Password & Face ID
    document.getElementById('btn-change-pwd')?.addEventListener('click', () => {
      window.jadwalinToast?.('Kata Sandi', 'Tautan pembaruan kata sandi telah dikirim ke email.', 'info');
    });

    document.getElementById('btn-face-id')?.addEventListener('click', () => {
      window.jadwalinToast?.('Face ID', 'Verifikasi wajah aktif untuk autentikasi kilat.', 'success');
    });

    // Routine Options Click
    document.querySelectorAll('.btn-routine-action').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const title = (e.currentTarget as HTMLElement).getAttribute('data-title') || 'Rutinitas';
        window.jadwalinToast?.('Jadwal Terproteksi', `Aktivitas "${title}" berada dalam perlindungan AI Beavy.`, 'info');
      });
    });
  </script>
</DashboardLayout>
