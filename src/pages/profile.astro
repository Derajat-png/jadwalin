---
// src/pages/profile.astro
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { Image } from 'astro:assets';
import mascotImg from '../assets/craiyon.png';

const recurringSchedules = [
  {
    id: 1,
    time: "10.00",
    duration: "120 mnt",
    title: "Fokus: Pemrograman Web dan API",
    days: "Senin, Rabu, Jumat",
    tag: "Akademik",
    active: true
  },
  {
    id: 2,
    time: "12.00",
    duration: "55 mnt",
    title: "Kuliah Basis Data",
    days: "Kamis",
    tag: "Kuliah",
    active: true
  },
  {
    id: 3,
    time: "19.00",
    duration: "30 mnt",
    title: "Olahraga Kardio dan Kebugaran",
    days: "Jumat, Sabtu",
    tag: "Kesehatan",
    active: true
  },
  {
    id: 4,
    time: "22.00",
    duration: "20 mnt",
    title: "Membaca Buku dan Refleksi",
    days: "Setiap hari",
    tag: "Personal",
    active: false
  }
];
---

<DashboardLayout title="Profil Pengguna" activeNav="profile">
  <div class="profile-page-layout">

    <!-- Top Editorial Header -->
    <header class="profile-header-row">
      <div class="header-titles">
        <h1 class="page-title">Profil Mahasiswa</h1>
        <p class="page-subtitle">Kelola jadwal rutin terproteksi, preferensi asistensi Beavy, dan keamanan akun Anda.</p>
      </div>

      <div class="header-actions">
        <button type="button" id="btn-add-routine" class="btn-primary-pill">
          <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"></line>
            <line x1="5" y1="12" x2="19" y2="12"></line>
          </svg>
          <span>Tambah Rutinitas</span>
        </button>
      </div>
    </header>

    <!-- 2-Column Grid -->
    <div class="profile-grid">
      
      <!-- Left Column: User Card & Routines -->
      <section class="profile-main-col">
        
        <!-- User Identity Card -->
        <div class="profile-surface user-card">
          <div class="user-row-header">
            <div class="avatar-wrap">
              <div class="avatar-circle" id="user-avatar-display">D</div>
              <button type="button" class="btn-avatar-edit" id="btn-edit-avatar" aria-label="Ganti foto profil">
                <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                  <circle cx="12" cy="13" r="4"></circle>
                </svg>
              </button>
            </div>

            <div class="user-meta">
              <div class="user-name-line">
                <h2 class="user-full-name">Daffa Ahmad Al Attas</h2>
                <span class="verified-tag">
                  <svg aria-hidden="true" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  Terverifikasi
                </span>
              </div>
              <p class="user-email-text">daffaahmadalsch@student.ub.ac.id</p>
              
              <div class="user-badges-row">
                <span class="meta-chip">Mahasiswa</span>
                <span class="meta-chip">Semester 5</span>
                <span class="focus-chip">
                  <svg aria-hidden="true" width="11" height="11" viewBox="0 0 24 24" fill="currentColor">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                  </svg>
                  Tingkat Fokus: Gold
                </span>
              </div>
            </div>
          </div>

          <!-- Ambient Stats Row -->
          <div class="ambient-stats-grid">
            <div class="stat-unit">
              <span class="stat-number">5</span>
              <span class="stat-label">Tugas Aktif</span>
            </div>
            <div class="stat-unit">
              <span class="stat-number text-urgent">2</span>
              <span class="stat-label">Mendekati Deadline</span>
            </div>
            <div class="stat-unit">
              <span class="stat-number text-accent">3</span>
              <span class="stat-label">Sesi Hari Ini</span>
            </div>
          </div>
        </div>

        <!-- Protected Routine Schedule -->
        <div class="profile-surface routine-section">
          <div class="section-header-block">
            <div>
              <h2 class="section-heading">Jadwal Rutin Terproteksi</h2>
              <p class="section-subheading">Aktivitas mingguan yang otomatis dikunci Beavy agar tidak tumpang tindih dengan tugas.</p>
            </div>
          </div>

          <div class="routine-items-list" id="routine-list">
            {recurringSchedules.map((item) => (
              <article class="routine-item-row" data-id={item.id} data-title={item.title} data-time={item.time} data-dur={item.duration} data-days={item.days}>
                <div class="routine-time-box">
                  <span class="routine-time-clock">{item.time}</span>
                  <span class="routine-time-span">{item.duration}</span>
                </div>

                <div class="routine-info-box">
                  <div class="routine-headline">
                    <h3 class="routine-task-title">{item.title}</h3>
                    <span class="routine-category-badge">{item.tag}</span>
                  </div>
                  <span class="routine-recurrence">{item.days}</span>
                </div>

                <div class="routine-actions-box">
                  <button type="button" class="btn-routine-action" title="Kelola Jadwal" aria-label={`Opsi untuk ${item.title}`} data-title={item.title}>
                    <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="1"></circle>
                      <circle cx="19" cy="12" r="1"></circle>
                      <circle cx="5" cy="12" r="1"></circle>
                    </svg>
                  </button>
                </div>
              </article>
            ))}
          </div>
        </div>

      </section>

      <!-- Right Column: Preferences & Security -->
      <aside class="profile-side-col">
        
        <!-- Beavy AI Habits & Settings -->
        <div class="profile-surface settings-card">
          <div class="settings-head-row">
            <div class="settings-avatar-wrap">
              <Image src={mascotImg} alt="Beavy" class="settings-avatar-img" />
            </div>
            <div>
              <h2 class="settings-heading">Preferensi Belajar Beavy</h2>
              <p class="settings-subheading">Sesuaikan cara AI menyusun jadwal harian Anda</p>
            </div>
          </div>

          <div class="settings-stack">
            <div class="pref-row">
              <div class="pref-meta">
                <strong class="pref-title">Jam Aktif Produktif</strong>
                <span class="pref-desc">Rentang waktu Anda bersedia belajar</span>
              </div>
              <span class="pref-pill">08.00 - 21.00</span>
            </div>

            <div class="pref-row">
              <div class="pref-meta">
                <strong class="pref-title">Jeda Istirahat (Buffer)</strong>
                <span class="pref-desc">Waktu jeda otomatis antar sesi tugas</span>
              </div>
              <span class="pref-pill">15 menit</span>
            </div>

            <div class="pref-row">
              <div class="pref-meta">
                <strong class="pref-title">Gaya Pengingat Beavy</strong>
                <span class="pref-desc">Nada komunikasi asistensi</span>
              </div>
              <span class="pref-pill">Tegas dan Solutif</span>
            </div>

            <div class="pref-row">
              <div class="pref-meta">
                <strong class="pref-title">Notifikasi Agenda Harian</strong>
                <span class="pref-desc">Kirim ringkasan jam 07.30 pagi</span>
              </div>
              <label class="switch-toggle" aria-label="Aktifkan notifikasi agenda harian">
                <input type="checkbox" checked id="toggle-notif" />
                <span class="toggle-slider"></span>
              </label>
            </div>
          </div>

          <button type="button" class="btn-save-prefs" id="btn-save-prefs">
            Simpan Perubahan
          </button>
        </div>

        <!-- Security & Account -->
        <div class="profile-surface security-card">
          <h2 class="security-heading">Keamanan dan Otentikasi</h2>
          
          <div class="security-links-stack">
            <button type="button" class="btn-sec-action" id="btn-change-pwd">
              <span class="sec-icon">
                <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
              </span>
              <span>Ganti Kata Sandi</span>
            </button>

            <a href="/login" class="btn-sec-action btn-sec-danger">
              <span class="sec-icon">
                <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                  <polyline points="16 17 21 12 16 7"></polyline>
                  <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
              </span>
              <span>Keluar dari Akun</span>
            </a>
          </div>
        </div>

      </aside>
    </div>

    <!-- 1. MODAL TAMBAH RUTINITAS -->
    <div id="routine-modal" class="modal-backdrop-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="modal-routine-title">
      <div class="modal-container-card">
        <div class="modal-head-line">
          <h2 class="modal-dialog-title" id="modal-routine-title">Tambah Rutinitas Mingguan</h2>
          <button type="button" class="btn-modal-dismiss" id="btn-close-routine-modal" aria-label="Tutup jendela">
            <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        <p class="modal-context-desc">Rutinitas ini akan secara otomatis memblokir slot kalender Beavy agar tidak bentrok.</p>
        
        <div class="modal-fields-group">
          <div class="dialog-field">
            <label class="dialog-label" for="routine-input-title">Nama Rutinitas</label>
            <input type="text" id="routine-input-title" class="dialog-input" placeholder="Contoh: Belajar Bahasa Asing atau Olahraga" />
          </div>

          <div class="dialog-row-2">
            <div class="dialog-field">
              <label class="dialog-label" for="routine-input-time">Jam Mulai</label>
              <input type="text" id="routine-input-time" class="dialog-input" value="16.00" />
            </div>
            <div class="dialog-field">
              <label class="dialog-label" for="routine-input-dur">Durasi</label>
              <input type="text" id="routine-input-dur" class="dialog-input" value="60 mnt" />
            </div>
          </div>

          <div class="dialog-field">
            <label class="dialog-label" for="routine-input-days">Hari Pelaksanaan</label>
            <input type="text" id="routine-input-days" class="dialog-input" value="Senin, Kamis" />
          </div>
        </div>

        <div class="modal-footer-cluster">
          <button type="button" class="btn-cancel-dialog" id="btn-cancel-routine">Batal</button>
          <button type="button" class="btn-save-dialog" id="btn-submit-routine">Simpan Rutinitas</button>
        </div>
      </div>
    </div>

    <!-- 2. MODAL GANTI KATA SANDI -->
    <div id="pwd-modal" class="modal-backdrop-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="modal-pwd-title">
      <div class="modal-container-card">
        <div class="modal-head-line">
          <h2 class="modal-dialog-title" id="modal-pwd-title">Perbarui Kata Sandi</h2>
          <button type="button" class="btn-modal-dismiss" id="btn-close-pwd-modal" aria-label="Tutup jendela">
            <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        <p class="modal-context-desc">Gunakan kombinasi minimal 8 karakter dengan huruf besar, angka, dan simbol unik.</p>
        
        <form id="form-change-pwd" class="modal-fields-group">
          <div class="dialog-field">
            <label class="dialog-label" for="pwd-current">Kata Sandi Saat Ini</label>
            <input type="password" id="pwd-current" required class="dialog-input" placeholder="Masukkan kata sandi lama" />
          </div>

          <div class="dialog-field">
            <label class="dialog-label" for="pwd-new">Kata Sandi Baru</label>
            <input type="password" id="pwd-new" required class="dialog-input" placeholder="Minimal 8 karakter" />
          </div>

          <div class="dialog-field">
            <label class="dialog-label" for="pwd-confirm">Konfirmasi Kata Sandi Baru</label>
            <input type="password" id="pwd-confirm" required class="dialog-input" placeholder="Ulangi kata sandi baru" />
          </div>

          <div class="modal-footer-cluster">
            <button type="button" class="btn-cancel-dialog" id="btn-cancel-pwd">Batal</button>
            <button type="submit" class="btn-save-dialog">Simpan Kata Sandi</button>
          </div>
        </form>
      </div>
    </div>

    <!-- 3. MODAL GANTI AVATAR / FOTO PROFIL -->
    <div id="avatar-modal" class="modal-backdrop-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="modal-avatar-title">
      <div class="modal-container-card">
        <div class="modal-head-line">
          <h2 class="modal-dialog-title" id="modal-avatar-title">Pilih Foto Profil</h2>
          <button type="button" class="btn-modal-dismiss" id="btn-close-avatar-modal" aria-label="Tutup jendela">
            <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        <p class="modal-context-desc">Gunakan inisial bawaan, pilih avatar mahasiswa, atau unggah foto dari komputer.</p>

        <div class="avatar-presets-grid">
          <button type="button" class="preset-avatar-btn active" data-preset="D">
            <span class="preset-circle c-purple">D</span>
            <span class="preset-name">Inisial</span>
          </button>
          <button type="button" class="preset-avatar-btn" data-preset="A">
            <span class="preset-circle c-amber">A</span>
            <span class="preset-name">Gold</span>
          </button>
          <button type="button" class="preset-avatar-btn" data-preset="B">
            <span class="preset-circle c-emerald">B</span>
            <span class="preset-name">Studi</span>
          </button>
          <button type="button" class="preset-avatar-btn" data-preset="M">
            <span class="preset-circle c-slate">M</span>
            <span class="preset-name">Minimal</span>
          </button>
        </div>

        <div class="avatar-upload-drop">
          <input type="file" id="avatar-file-input" style="display: none;" accept="image/png, image/jpeg" />
          <button type="button" class="btn-choose-photo" onclick="document.getElementById('avatar-file-input')?.click();">
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <circle cx="8.5" cy="8.5" r="1.5"></circle>
              <polyline points="21 15 16 10 5 21"></polyline>
            </svg>
            <span>Unggah Foto dari Komputer</span>
          </button>
        </div>

        <div class="modal-footer-cluster">
          <button type="button" class="btn-cancel-dialog" id="btn-cancel-avatar">Batal</button>
          <button type="button" class="btn-save-dialog" id="btn-save-avatar">Terapkan Foto</button>
        </div>
      </div>
    </div>

    <!-- 5. MODAL KELOLA / EDIT RUTINITAS -->
    <div id="edit-routine-modal" class="modal-backdrop-overlay" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="modal-edit-routine-title">
      <div class="modal-container-card">
        <div class="modal-head-line">
          <h2 class="modal-dialog-title" id="modal-edit-routine-title">Kelola Rutinitas</h2>
          <button type="button" class="btn-modal-dismiss" id="btn-close-edit-routine-modal" aria-label="Tutup jendela">
            <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        <p class="modal-context-desc">Sesuaikan rincian jadwal rutin ini atau hapus agar slot waktu kembali dibuka.</p>

        <form id="form-edit-routine" class="modal-fields-group">
          <div class="dialog-field">
            <label class="dialog-label" for="edit-routine-title">Nama Rutinitas</label>
            <input type="text" id="edit-routine-title" class="dialog-input" />
          </div>

          <div class="dialog-row-2">
            <div class="dialog-field">
              <label class="dialog-label" for="edit-routine-time">Jam Mulai</label>
              <input type="text" id="edit-routine-time" class="dialog-input" />
            </div>
            <div class="dialog-field">
              <label class="dialog-label" for="edit-routine-dur">Durasi</label>
              <input type="text" id="edit-routine-dur" class="dialog-input" />
            </div>
          </div>

          <div class="dialog-field">
            <label class="dialog-label" for="edit-routine-days">Hari</label>
            <input type="text" id="edit-routine-days" class="dialog-input" />
          </div>

          <div class="modal-footer-cluster">
            <button type="button" class="btn-danger-dialog" id="btn-delete-routine">Hapus Rutinitas</button>
            <button type="button" class="btn-cancel-dialog" id="btn-cancel-edit-routine">Batal</button>
            <button type="submit" class="btn-save-dialog">Simpan Perubahan</button>
          </div>
        </form>
      </div>
    </div>

  </div>

  <style>
    /* =========================================================
       AWWWARDS EDITORIAL PROFILE: Minimalist, Flat, Tokenized
       ========================================================= */

    :root {
      --overlay-scrim: rgba(18, 10, 30, 0.4);
    }

    :focus-visible {
      outline: 2px solid var(--color-primary);
      outline-offset: 2px;
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }

    .profile-page-layout {
      max-width: 1180px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 2rem;
      padding-bottom: 3.5rem;
    }

    /* Header */
    .profile-header-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 1.5rem;
      padding: 1rem 0 0.5rem;
      border-bottom: 1px solid var(--color-border-subtle);
    }

    .page-title {
      font-size: 2.2rem;
      font-weight: 800;
      color: var(--color-text-main);
      letter-spacing: -0.03em;
      line-height: 1.15;
    }

    .page-subtitle {
      font-size: 0.92rem;
      color: var(--color-text-muted);
      margin-top: 0.4rem;
      line-height: 1.5;
    }

    .btn-primary-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.65rem 1.25rem;
      border-radius: var(--radius-full);
      border: 1px solid var(--color-border);
      background: var(--color-surface);
      color: var(--color-text-main);
      font-size: 0.84rem;
      font-weight: 700;
      cursor: pointer;
      box-shadow: var(--shadow-xs);
      transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    }

    .btn-primary-pill:hover {
      background: var(--color-primary-light);
      border-color: var(--color-border-focus);
      color: var(--color-primary);
    }

    /* Grid */
    .profile-grid {
      display: grid;
      grid-template-columns: 1.35fr 0.85fr;
      gap: 2.2rem;
      align-items: start;
    }

    .profile-main-col, .profile-side-col {
      display: flex;
      flex-direction: column;
      gap: 1.8rem;
    }

    /* Surfaces */
    .profile-surface {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
      padding: 2.2rem;
      box-shadow: var(--shadow-xs);
    }

    /* User Row */
    .user-row-header {
      display: flex;
      gap: 1.5rem;
      align-items: center;
      padding-bottom: 1.8rem;
      border-bottom: 1px solid var(--color-border-subtle);
    }

    .avatar-wrap {
      position: relative;
      flex-shrink: 0;
    }

    .avatar-circle {
      width: 74px;
      height: 74px;
      border-radius: 50%;
      background: var(--color-primary);
      color: var(--color-surface);
      font-family: var(--font-mono);
      font-size: 1.8rem;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: var(--shadow-sm);
    }

    .btn-avatar-edit {
      position: absolute;
      bottom: -2px;
      right: -2px;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      color: var(--color-text-muted);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: var(--shadow-xs);
      transition: color 0.15s ease, border-color 0.15s ease;
    }

    .btn-avatar-edit:hover {
      color: var(--color-primary);
      border-color: var(--color-primary);
    }

    .user-meta {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .user-name-line {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      flex-wrap: wrap;
    }

    .user-full-name {
