---
// src/pages/profile.astro
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { Image } from 'astro:assets';
import mascotImg from '../assets/craiyon.png';

const recurringSchedules = [
  {
    time: "10.00",
    duration: "120 mnt",
    title: "Fokus: Pemrograman Web & API",
    days: "Senin, Rabu, Jumat",
    tag: "Akademik"
  },
  {
    time: "12.00",
    duration: "55 mnt",
    title: "Kuliah Basis Data",
    days: "Kamis",
    tag: "Kuliah"
  },
  {
    time: "19.00",
    duration: "30 mnt",
    title: "Olahraga Kardio / Gym",
    days: "Jumat, Sabtu",
    tag: "Kesehatan"
  },
  {
    time: "22.00",
    duration: "20 mnt",
    title: "Baca Buku / Refleksi Harian",
    days: "Setiap hari",
    tag: "Pengembangan Diri"
  }
];
---

<DashboardLayout title="Profil Pengguna" activeNav="profile">
  <div class="profile-page-wrap">
    <!-- Desktop 2-Column: User Info & Routine Schedules (Left) + Preferences & AI Tuning (Right) -->
    <div class="profile-desktop-grid">
      <!-- Left Column: User Card & Routine Schedule -->
      <div class="profile-main-col">
        <!-- User Profile Card (Figma Match) -->
        <div class="user-card-panel">
          <div class="uc-top">
            <div class="uc-avatar-wrap">
              <div class="uc-avatar-circle">D</div>
              <button class="btn-edit-avatar" title="Ganti Foto">📷</button>
            </div>

            <div class="uc-details">
              <h1 class="uc-name">Daffa Ahmad Al Attas</h1>
              <p class="uc-email">daffaahmadalsch@student.ub.ac.id</p>
              <div class="uc-roles">
                <span class="role-chip">Mahasiswa</span>
                <span class="role-chip">Semester 5</span>
                <span class="level-chip">⭐ Tingkat Fokus: Gold</span>
              </div>
            </div>
          </div>

          <!-- 3 Stats Counter from Figma Frame 156:138 -->
          <div class="uc-stats-row">
            <div class="uc-stat-box">
              <span class="uc-stat-val">5</span>
              <span class="uc-stat-lbl">Tugas Aktif</span>
            </div>
            <div class="uc-stat-box">
              <span class="uc-stat-val" style="color: #dc2626;">2</span>
              <span class="uc-stat-lbl">Mendekati...</span>
            </div>
            <div class="uc-stat-box">
              <span class="uc-stat-val" style="color: #d97706;">3</span>
              <span class="uc-stat-lbl">Sesi hari ini</span>
            </div>
          </div>
        </div>

        <!-- Jadwal Saya (Figma Frame 156:138) -->
        <div class="routine-panel">
          <div class="rp-header">
            <div>
              <h3 class="rp-title">Jadwal Rutin Saya</h3>
              <p class="rp-sub">Aktivitas berulang yang otomatis diproteksi oleh AI</p>
            </div>
            <button id="btn-add-routine" class="btn-add-routine">+ Tambah</button>
          </div>

          <div class="routine-list">
            {recurringSchedules.map((item) => (
              <div class="routine-row-card">
                <div class="rc-time-col">
                  <span class="rc-time">{item.time}</span>
                  <span class="rc-dur">{item.duration}</span>
                </div>

                <div class="rc-main-col">
                  <div class="rc-title-row">
                    <h4 class="rc-title">{item.title}</h4>
                    <span class="rc-tag">{item.tag}</span>
                  </div>
                  <span class="rc-days">{item.days}</span>
                </div>

                <div class="rc-action-col">
                  <button class="btn-routine-opt" title="Edit Jadwal">⚙️</button>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Right Column: Preferences, Habit & AI Tuning -->
      <div class="profile-side-col">
        <!-- Beavy AI Habits & Settings -->
        <div class="settings-card">
          <div class="sc-header">
            <Image src={mascotImg} alt="Beavy" class="sc-beavy-avatar" />
            <div>
              <h4 class="sc-title">Preferensi Belajar Beavy</h4>
              <p class="sc-desc">Sesuaikan cara AI menyusun jadwal harianmu</p>
            </div>
          </div>

          <div class="settings-form">
            <div class="setting-item">
              <div>
                <strong>Jam Aktif Produktif</strong>
                <p>Rentang waktu kamu bersedia belajar</p>
              </div>
              <span class="setting-badge">08.00 - 21.00</span>
            </div>

            <div class="setting-item">
              <div>
                <strong>Jeda Istirahat (Buffer)</strong>
                <p>Waktu jeda otomatis antar sesi</p>
              </div>
              <span class="setting-badge">15 menit</span>
            </div>

            <div class="setting-item">
              <div>
                <strong>Gaya Pengingat Beavy</strong>
                <p>Nada komunikasi AI saat mengingatkan</p>
              </div>
              <span class="setting-badge">Blak-blakan & Cepat</span>
            </div>

            <div class="setting-item">
              <div>
                <strong>Notifikasi WhatsApp / Telegram</strong>
                <p>Kirim jadwal harian tiap jam 07.30</p>
              </div>
              <input type="checkbox" checked style="accent-color: #8b5cf6; width: 18px; height: 18px;" />
            </div>
          </div>

          <div class="settings-action">
            <button class="btn-save-preferences" onclick="alert('Preferensi profil berhasil diperbarui!');">
              Simpan Perubahan
            </button>
          </div>
        </div>

        <!-- Account Security / Logout -->
        <div class="account-card">
          <h4 class="ac-title">Keamanan Akun</h4>
          <div class="ac-links">
            <button class="ac-btn" onclick="alert('Link ganti password telah dikirim ke email!');">Ganti Kata Sandi</button>
            <button class="ac-btn" onclick="alert('Verifikasi wajah sudah aktif.');">Atur Verifikasi Wajah (Face ID)</button>
            <a href="/login" class="ac-btn ac-danger">Keluar dari Akun</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    .profile-page-wrap {
      display: flex;
      flex-direction: column;
      gap: 1.8rem;
    }

    .profile-desktop-grid {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 1.8rem;
      align-items: start;
    }

    .profile-main-col, .profile-side-col {
      display: flex;
      flex-direction: column;
      gap: 1.6rem;
    }

    /* User Profile Card */
    .user-card-panel, .routine-panel, .settings-card, .account-card {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.9);
      border-radius: var(--radius-lg);
      padding: 1.8rem;
      box-shadow: var(--shadow-sm);
    }

    .uc-top {
      display: flex;
      gap: 1.4rem;
      align-items: center;
      padding-bottom: 1.6rem;
      border-bottom: 1px solid #f0e8f8;
    }

    .uc-avatar-wrap {
      position: relative;
    }

    .uc-avatar-circle {
      width: 76px;
      height: 76px;
      border-radius: 50%;
      background: linear-gradient(135deg, #a855f7, #6366f1);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 1.8rem;
      font-weight: 800;
      box-shadow: 0 8px 20px rgba(139, 92, 246, 0.25);
    }

    .btn-edit-avatar {
      position: absolute;
      bottom: 0;
      right: 0;
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background: white;
      border: 1px solid #e2d8ee;
      font-size: 0.75rem;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .uc-name {
      font-size: 1.45rem;
      font-weight: 800;
      color: #21133c;
    }

    .uc-email {
      font-size: 0.85rem;
      color: #796a92;
      margin-top: 0.15rem;
      margin-bottom: 0.6rem;
    }

    .uc-roles {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .role-chip {
      font-size: 0.72rem;
      font-weight: 700;
      color: #7c3aed;
      background: #ede9fe;
      padding: 0.2rem 0.6rem;
      border-radius: var(--radius-full);
    }

    .level-chip {
      font-size: 0.72rem;
      font-weight: 700;
      color: #b45309;
      background: #fef3c7;
      padding: 0.2rem 0.6rem;
      border-radius: var(--radius-full);
    }

    /* 3 Stats Row from Figma */
    .uc-stats-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
      padding-top: 1.4rem;
    }

    .uc-stat-box {
      text-align: center;
      padding: 0.8rem;
      background: #faf7fd;
      border-radius: var(--radius-md);
      border: 1px solid #eee7f7;
    }

    .uc-stat-val {
      font-size: 1.65rem;
      font-weight: 800;
      color: #20133a;
      display: block;
      line-height: 1.1;
    }

    .uc-stat-lbl {
      font-size: 0.75rem;
      font-weight: 600;
      color: #7e6f96;
    }

    /* Routine Schedules (Figma Match) */
    .rp-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.4rem;
    }

    .rp-title {
      font-size: 1.18rem;
      font-weight: 800;
      color: #21133c;
    }

    .rp-sub {
      font-size: 0.78rem;
      color: #7c6d94;
    }

    .btn-add-routine {
      background: #f3e8ff;
      color: #7c3aed;
      border: none;
      font-size: 0.82rem;
      font-weight: 700;
      padding: 0.45rem 0.95rem;
      border-radius: var(--radius-full);
      transition: background 0.2s;
    }

    .btn-add-routine:hover {
      background: #e9d5ff;
    }

    .routine-list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .routine-row-card {
      display: flex;
      align-items: center;
      gap: 1.2rem;
      padding: 0.95rem 1.1rem;
      background: #fbf9fe;
      border: 1px solid #ede5f8;
      border-radius: var(--radius-md);
      transition: transform 0.2s;
    }

    .routine-row-card:hover {
      transform: translateX(4px);
    }

    .rc-time-col {
      min-width: 60px;
      display: flex;
      flex-direction: column;
    }

    .rc-time {
      font-size: 1.05rem;
      font-weight: 800;
      color: #251740;
    }

    .rc-dur {
      font-size: 0.7rem;
      font-weight: 600;
      color: #8c7d9f;
    }

    .rc-main-col {
      flex: 1;
    }

    .rc-title-row {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin-bottom: 0.2rem;
    }

    .rc-title {
      font-size: 0.95rem;
      font-weight: 800;
      color: #22143b;
    }

    .rc-tag {
      font-size: 0.68rem;
      font-weight: 700;
      padding: 0.15rem 0.5rem;
      border-radius: 6px;
      background: #ede9fe;
      color: #7c3aed;
    }

    .rc-days {
      font-size: 0.76rem;
      color: #7c6d94;
    }

    .btn-routine-opt {
      background: none;
      border: none;
      font-size: 0.9rem;
      padding: 0.3rem;
      border-radius: 6px;
    }

    /* Settings & Preferences */
    .sc-header {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding-bottom: 1.2rem;
      border-bottom: 1px solid #f0e8f8;
      margin-bottom: 1.2rem;
    }

    .sc-beavy-avatar {
      width: 44px;
      height: 44px;
      object-fit: contain;
    }

    .sc-title {
      font-size: 1.05rem;
      font-weight: 800;
      color: #22143c;
    }

    .sc-desc {
      font-size: 0.76rem;
      color: #7a6c92;
    }

    .settings-form {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin-bottom: 1.4rem;
    }

    .setting-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.7rem 0.9rem;
      background: #fdfcff;
      border: 1px solid #ede6f6;
      border-radius: 10px;
    }

    .setting-item strong {
      font-size: 0.85rem;
      color: #24163d;
      display: block;
    }

    .setting-item p {
      font-size: 0.72rem;
      color: #837599;
    }

    .setting-badge {
      font-size: 0.78rem;
      font-weight: 700;
      color: #7c3aed;
      background: #ede9fe;
      padding: 0.25rem 0.65rem;
      border-radius: var(--radius-full);
    }

    .btn-save-preferences {
      width: 100%;
      padding: 0.8rem;
      border-radius: var(--radius-full);
      border: none;
      background: linear-gradient(135deg, #a855f7 0%, #8b5cf6 100%);
      color: white;
      font-weight: 700;
      font-size: 0.88rem;
      box-shadow: 0 6px 18px rgba(139, 92, 246, 0.3);
      transition: transform 0.2s;
    }

    .btn-save-preferences:hover {
      transform: translateY(-2px);
    }

    /* Account Links */
    .ac-title {
      font-size: 0.95rem;
      font-weight: 800;
      color: #22143c;
      margin-bottom: 0.9rem;
    }

    .ac-links {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .ac-btn {
      width: 100%;
      text-align: left;
      padding: 0.7rem 0.9rem;
      border-radius: 10px;
      border: 1px solid #ede6f6;
      background: #fdfcff;
      font-size: 0.82rem;
      font-weight: 600;
      color: #4b3d67;
      transition: all 0.2s;
      display: block;
    }

    .ac-btn:hover {
      background: #f3e8ff;
      border-color: #d8b4fe;
      color: #7c3aed;
    }

    .ac-danger {
      color: #dc2626 !important;
      border-color: #fee2e2 !important;
      background: #fff5f5 !important;
    }

    .ac-danger:hover {
      background: #fee2e2 !important;
    }

    @media (max-width: 960px) {
      .profile-desktop-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script>
    document.getElementById('btn-add-routine')?.addEventListener('click', () => {
      const title = prompt('Nama kegiatan rutin baru (contoh: Belajar Bahasa Inggris):');
      if (title) {
        alert(`Kegiatan rutin "${title}" berhasil ditambahkan dan disimpan!`);
      }
    });
  </script>
</DashboardLayout>
