---
// src/pages/prioritas.astro
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { Image } from 'astro:assets';
import mascotImg from '../assets/craiyon.png';

const initialTasks = [
  {
    id: 1,
    rank: 1,
    title: "Laporan Praktikum Pemrograman",
    category: "Kuliah",
    priority: "Kritis",
    priorityClass: "critical",
    deadline: "Hari ini, 17.00",
    duration: "2 jam",
    reason: "Tenggat dekat hari ini dan menjadi syarat untuk tugas praktikum berikutnya.",
    completed: false
  },
  {
    id: 2,
    rank: 2,
    title: "Slide Presentasi Kelompok",
    category: "Kuliah",
    priority: "Tinggi",
    priorityClass: "high",
    deadline: "Besok, 09.00",
    duration: "1.5 jam",
    reason: "Materi dibutuhkan kelompok sebelum gladi bersih presentasi.",
    completed: false
  },
  {
    id: 3,
    rank: 3,
    title: "Revisi Dokumen Klien",
    category: "Kerja",
    priority: "Sedang",
    priorityClass: "medium",
    deadline: "23 Okt, 15.00",
    duration: "1 jam",
    reason: "Revisi minor pada layout proposal, tenggat masih cukup longgar.",
    completed: false
  },
  {
    id: 4,
    rank: 4,
    title: "Belajar Ujian Basis Data",
    category: "Kuliah",
    priority: "Rendah",
    priorityClass: "low",
    deadline: "26 Okt, 08.00",
    duration: "2 jam",
    reason: "Materi dapat dicicil per bab setelah tugas-tugas mendesak terselesaikan.",
    completed: false
  }
];
---

<DashboardLayout title="Prioritas Tugas" activeNav="prioritas">
  <div class="sanctuary-wrap">

    <!-- 1. EDITORIAL HEADER -->
    <header class="priority-hero">
      <div class="hero-left">
        <h1 class="hero-statement">
          Kalkulasi urutan pengerjaan:<br />
          <span class="hero-highlight">Berdasarkan Urgensi & Energi Mental</span>
        </h1>
        <p class="hero-sub">
          Dihitung secara adaptif oleh AI untuk meminimalkan beban switching kognitif di antara tenggat akademik.
        </p>
      </div>

      <div class="hero-action-cluster">
        <button id="btn-reorder" class="btn-hero-reorder" type="button">
          <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
          <span>Kalkulasi Ulang AI</span>
        </button>
        <button type="button" class="btn-hero-add" onclick="(window).openQuickAddModal ? (window).openQuickAddModal() : window.location.href='/tambah-tugas';">
          <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          <span>Tambah Tugas</span>
        </button>
      </div>
    </header>

    <!-- 2. MAIN GRID: Ranked Tasks Flow (Left) + AI Logic & Matrix (Right) -->
    <div class="priority-grid">

      <!-- LEFT: Ranked Task Stack (Unnested Clean Rows) -->
      <section class="task-rank-surface">
        <div class="surface-header">
          <div>
            <h2 class="surface-title">Daftar Prioritas Terkini</h2>
            <p class="surface-caption">Selesaikan dari urutan nomor 1 untuk efisiensi puncak</p>
          </div>
          <span class="count-tag">4 Tugas Aktif</span>
        </div>

        <div class="rank-stack" id="priority-task-list">
          {initialTasks.map((task) => (
            <article class="rank-item" data-task-id={task.id}>
              <span class="rank-number">#{task.rank}</span>

              <div class="rank-content">
                <div class="rank-title-row">
                  <h3 class="task-title">{task.title}</h3>
                  <div style="display: flex; gap: 0.4rem; align-items: center;">
                    <span class={`priority-badge ${task.priorityClass}`}>{task.priority}</span>
                    <span class="category-chip">{task.category}</span>
                  </div>
                </div>
                <p class="task-reason">{task.reason}</p>

                <div class="task-meta-row">
                  <span class="meta-item">
                    <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    <span>{task.duration}</span>
                  </span>
                  <span class="meta-item">
                    <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line></svg>
                    <span>{task.deadline}</span>
                  </span>
                </div>
              </div>

              <div class="rank-action-col">
                <button type="button" class="btn-check-task" title="Selesaikan Tugas" aria-label="Tandai tugas selesai" onclick="
                  const item = this.closest('.rank-item');
                  item.classList.toggle('is-done');
                  (window).jadwalinToast('Tugas Selesai', 'Tugas berhasil dipindahkan ke riwayat.', 'success', {
                    label: 'Urungkan',
                    onClick: () => item.classList.toggle('is-done')
                  });
                ">
                  <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </button>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- RIGHT: AI Rationale & Focus Load -->
      <aside class="side-insights-col">

        <!-- AI Decision Explanation -->
        <div class="side-surface companion-insight">
          <div class="ci-head">
            <div class="ci-avatar-disc">
              <Image src={mascotImg} alt="Beavy" class="ci-avatar-img" />
            </div>
            <div>
              <h3 class="side-title">Pertimbangan Beavy AI</h3>
              <p class="ci-role">Logika Penentuan Prioritas</p>
            </div>
          </div>
          <p class="side-desc">
            <strong>Laporan Praktikum Pemrograman</strong> ditempatkan di posisi teratas karena tenggatnya berada dalam 28 jam ke depan dan menjadi prasyarat modul berikutnya.
          </p>
          <a href="/beavy-ai" class="link-editorial">Diskusikan dengan Beavy</a>
        </div>

        <!-- Cognitive Load Matrix -->
        <div class="side-surface load-matrix-card">
          <h3 class="side-title">Distribusi Beban Belajar</h3>
          <p class="side-desc">Estimasi alokasi waktu berdasarkan kategori tugas.</p>

          <div class="load-bars">
            <div class="load-row">
              <div class="load-meta">
                <span>Kuliah & Praktikum</span>
                <span class="load-val">5.5 Jam</span>
              </div>
              <div class="track"><div class="fill academic" style="width: 75%;"></div></div>
            </div>

            <div class="load-row">
              <div class="load-meta">
                <span>Pekerjaan & Sampingan</span>
                <span class="load-val">1.0 Jam</span>
              </div>
              <div class="track"><div class="fill work" style="width: 25%;"></div></div>
            </div>
          </div>
        </div>

      </aside>

    </div>

  </div>

  <style>
    /* =========================================================
       AWWWARDS EDITORIAL PRIORITY STYLES
       Spacious, Flat Surface, Editorial Typography
       ========================================================= */

    :focus-visible {
      outline: 2px solid var(--color-primary);
      outline-offset: 2px;
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }

    .sanctuary-wrap {
      max-width: 1240px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 2.2rem;
      padding-bottom: 3rem;
    }

    /* 1. EDITORIAL HEADER */
    .priority-hero {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 2rem;
      padding: 1.5rem 0 0.5rem;
      border-bottom: 1px solid var(--color-border-subtle);
    }

    .hero-statement {
      font-size: 2.2rem;
      font-weight: 800;
      color: var(--color-text-main);
      line-height: 1.2;
      letter-spacing: -0.025em;
    }

    .hero-highlight {
      color: var(--color-primary-dark);
    }

    .hero-sub {
      font-size: 0.95rem;
      color: var(--color-text-muted);
      line-height: 1.6;
      margin-top: 0.6rem;
      max-width: 650px;
    }

    .hero-action-cluster {
      display: flex;
      gap: 0.75rem;
      align-items: center;
      flex-shrink: 0;
    }

    .btn-hero-reorder {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--color-surface);
      color: var(--color-text-body);
      border: 1px solid var(--color-border);
      font-size: 0.88rem;
      font-weight: 600;
      padding: 0.8rem 1.2rem;
      border-radius: var(--radius-full);
      box-shadow: var(--shadow-xs);
      cursor: pointer;
      transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
    }

    .btn-hero-reorder:hover {
      border-color: var(--color-border-focus);
      transform: translateY(-2px);
    }

    .btn-hero-add {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--color-primary);
      color: var(--color-surface);
      border: none;
      font-size: 0.88rem;
      font-weight: 700;
      padding: 0.8rem 1.4rem;
      border-radius: var(--radius-full);
      box-shadow: var(--shadow-sm);
      cursor: pointer;
      transition: background-color 0.15s ease, transform 0.15s ease;
    }

    .btn-hero-add:hover {
      background: var(--color-primary-dark);
      transform: translateY(-2px);
    }

    /* 2. GRID */
    .priority-grid {
      display: grid;
      grid-template-columns: 1.4fr 0.8fr;
      gap: 2rem;
      align-items: start;
    }

    .task-rank-surface, .side-surface {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
      padding: 1.8rem;
      box-shadow: var(--shadow-xs);
    }

    .surface-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 1.6rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--color-border-subtle);
    }

    .surface-title {
      font-size: 1.25rem;
      font-weight: 800;
      color: var(--color-text-main);
    }

    .surface-caption {
      font-size: 0.8rem;
      color: var(--color-text-muted);
      margin-top: 0.2rem;
    }

    .count-tag {
      font-size: 0.74rem;
      font-weight: 700;
      color: var(--color-text-muted);
      background: var(--color-canvas);
      padding: 0.25rem 0.65rem;
      border-radius: var(--radius-full);
    }

    /* RANK STACK */
    .rank-stack {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .rank-item {
      display: flex;
      gap: 1.2rem;
      align-items: center;
      padding: 1.15rem 1.35rem;
      border-radius: var(--radius-lg);
      background: var(--color-surface-subtle);
      border: 1px solid var(--color-border-subtle);
      transition: border-color 0.15s ease, transform 0.15s ease, opacity 0.2s ease;
    }

    .rank-item:hover {
      border-color: var(--color-border-focus);
      transform: translateX(3px);
    }

    .rank-item.is-done {
      opacity: 0.45;
      filter: grayscale(50%);
    }

    .rank-badge-col {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.35rem;
      min-width: 50px;
    }

    .rank-number {
      font-family: var(--font-mono);
      font-size: 1.2rem;
      font-weight: 800;
      color: var(--color-text-main);
      line-height: 1;
    }

    .priority-badge {
      font-size: 0.68rem;
      font-weight: 700;
      padding: 0.15rem 0.45rem;
      border-radius: var(--radius-sm);
    }

    .priority-badge.critical {
      background: var(--color-danger-bg);
      color: var(--color-danger);
    }

    .priority-badge.high {
      background: var(--color-warning-bg);
      color: var(--color-warning);
    }

    .priority-badge.medium {
      background: var(--color-surface);
      color: var(--color-text-body);
      border: 1px solid var(--color-border);
    }

    .priority-badge.low {
      background: var(--color-surface);
      color: var(--color-text-muted);
      border: 1px solid var(--color-border);
    }

    .rank-content {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .rank-title-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .task-title {
      font-size: 0.98rem;
      font-weight: 800;
      color: var(--color-text-main);
    }

    .category-chip {
      font-size: 0.7rem;
      font-weight: 600;
      color: var(--color-text-muted);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      padding: 0.15rem 0.5rem;
      border-radius: var(--radius-full);
    }

    .task-reason {
      font-size: 0.8rem;
      color: var(--color-text-body);
      line-height: 1.45;
    }

    .task-meta-row {
      display: flex;
      gap: 1rem;
      margin-top: 0.3rem;
    }

    .meta-item {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.74rem;
      font-weight: 600;
      color: var(--color-text-muted);
    }

    .btn-check-task {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      border: 1px solid var(--color-border);
      background: var(--color-surface);
      color: var(--color-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
    }

    .btn-check-task:hover {
      background: var(--color-success);
      color: var(--color-surface);
      border-color: var(--color-success);
      transform: scale(1.08);
    }

    /* RIGHT COLUMN */
    .side-insights-col {
      display: flex;
      flex-direction: column;
      gap: 1.8rem;
    }

    .ci-head {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      margin-bottom: 0.8rem;
    }

    .ci-avatar-disc {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--color-primary-light);
      border: 1px solid var(--color-border-focus);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .ci-avatar-img {
      width: 30px;
      height: 30px;
      object-fit: contain;
    }

    .ci-role {
      font-size: 0.74rem;
      color: var(--color-text-muted);
      margin-top: 0.1rem;
    }

    .side-title {
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--color-text-main);
    }

    .side-desc {
      font-size: 0.8rem;
      color: var(--color-text-body);
      line-height: 1.5;
      margin-bottom: 1.1rem;
    }

    .link-editorial {
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--color-primary-dark);
      text-decoration: underline;
      text-underline-offset: 4px;
      transition: color 0.15s ease;
    }

    .link-editorial:hover {
      color: var(--color-primary);
    }

    /* Load Matrix */
    .load-bars {
      display: flex;
      flex-direction: column;
      gap: 0.95rem;
    }

    .load-row {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .load-meta {
      display: flex;
      justify-content: space-between;
      font-size: 0.76rem;
      font-weight: 600;
      color: var(--color-text-muted);
    }

    .load-val {
      font-family: var(--font-mono);
      font-weight: 700;
      color: var(--color-text-main);
    }

    .track {
      width: 100%;
      height: 6px;
      border-radius: var(--radius-full);
      background: var(--color-canvas);
      overflow: hidden;
    }

    .fill {
      height: 100%;
      border-radius: var(--radius-full);
    }

    .fill.academic { background: var(--color-primary); }
    .fill.work { background: var(--color-accent); }

    @media (max-width: 1040px) {
      .priority-grid {
        grid-template-columns: 1fr;
      }
      .priority-hero {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>

  <script>
    document.getElementById('btn-reorder')?.addEventListener('click', () => {
      (window as any).jadwalinToast('Kalkulasi Selesai', 'Urutan prioritas disesuaikan dengan tenggat terbaru.', 'info');
    });
  </script>
</DashboardLayout>
