---
// src/pages/prioritas.astro
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { Image } from 'astro:assets';
import mascotImg from '../assets/craiyon.png';

const initialTasks = [
  {
    id: 1,
    rank: 1,
    title: "Laporan Praktikum Pemrograman",
    category: "Kuliah",
    priority: "Kritis",
    priorityClass: "critical",
    deadline: "Hari ini, 17.00",
    duration: "2 jam",
    reason: "Tenggat dekat hari ini dan menjadi syarat untuk tugas praktikum berikutnya.",
    completed: false
  },
  {
    id: 2,
    rank: 2,
    title: "Slide Presentasi Kelompok",
    category: "Kuliah",
    priority: "Tinggi",
    priorityClass: "high",
    deadline: "Besok, 09.00",
    duration: "1.5 jam",
    reason: "Materi dibutuhkan kelompok sebelum gladi bersih presentasi.",
    completed: false
  },
  {
    id: 3,
    rank: 3,
    title: "Revisi Dokumen Klien",
    category: "Kerja",
    priority: "Sedang",
    priorityClass: "medium",
    deadline: "23 Okt, 15.00",
    duration: "1 jam",
    reason: "Revisi minor pada layout proposal, tenggat masih cukup longgar.",
    completed: false
  },
  {
    id: 4,
    rank: 4,
    title: "Belajar Ujian Basis Data",
    category: "Kuliah",
    priority: "Rendah",
    priorityClass: "low",
    deadline: "26 Okt, 08.00",
    duration: "2 jam",
    reason: "Materi dapat dicicil per bab setelah tugas-tugas mendesak terselesaikan.",
    completed: false
  }
];
---

<DashboardLayout title="Prioritas Tugas" activeNav="prioritas">
  <div class="priority-page-wrap">
    <!-- Header -->
    <div class="priority-header">
      <div>
        <h1 class="page-title">Prioritas Tugas</h1>
        <p class="page-subtitle">
          Urutan otomatis berdasarkan kalkulasi urgensi, beban kognitif, dan ketergantungan tugas.
        </p>
      </div>

      <div class="header-actions">
        <button id="btn-reorder" class="btn-reorder" type="button">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="9" x2="20" y2="9"></line><line x1="4" y1="15" x2="20" y2="15"></line><polyline points="10 5 6 9 10 13"></polyline><polyline points="14 19 18 15 14 11"></polyline></svg>
          <span>Kalkulasi Ulang AI</span>
        </button>
        <a href="/tambah-tugas" class="btn-primary-action">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          <span>Tambah Tugas</span>
        </a>
      </div>
    </div>

    <!-- Category Filter Tabs -->
    <div class="filters-bar">
      <button class="filter-tab active" data-category="all">Semua Kategori</button>
      <button class="filter-tab" data-category="Kuliah">Kuliah (3)</button>
      <button class="filter-tab" data-category="Kerja">Kerja (1)</button>
      <button class="filter-tab" data-category="Pribadi">Pribadi (0)</button>
    </div>

    <!-- 2-Column Desktop View: Priority List (Left) + AI Logic & Summary (Right) -->
    <div class="priority-grid">
      <!-- Left Column: The Task Cards -->
      <div class="task-list-col" id="tasks-container">
        {initialTasks.map((task) => (
          <div class={`priority-card priority-${task.priorityClass}`} data-category={task.category} data-id={task.id}>
            <div class="card-left-number">
              <span class="rank-number">{task.rank}</span>
            </div>

            <div class="card-main-body">
              <div class="card-header-line">
                <h3 class="task-title">{task.title}</h3>
                <div class="tags-group">
                  <span class="tag-category">{task.category}</span>
                  <span class={`tag-priority ${task.priorityClass}`}>{task.priority}</span>
                </div>
              </div>

              <div class="meta-line">
                <span class="meta-item">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                  {task.deadline}
                </span>
                <span class="meta-dot">•</span>
                <span class="meta-item">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 8v4l3 3"></path><circle cx="12" cy="12" r="9"></circle></svg>
                  {task.duration}
                </span>
              </div>

              <!-- AI Rationale Reason (Clean, non-slop layout) -->
              <div class="reason-box">
                <span class="reason-label">Saran Beavy:</span>
                <span class="reason-text">{task.reason}</span>
              </div>
            </div>

            <div class="card-right-action">
              <button class="btn-check-task" title="Tandai Selesai" aria-label="Tandai Selesai">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </button>
            </div>
          </div>
        ))}
      </div>

      <!-- Right Column: AI Explainer & Matrix Insight -->
      <div class="priority-insight-col">
        <div class="insight-box">
          <div class="insight-header">
            <div class="beavy-avatar-frame">
              <Image src={mascotImg} alt="Beavy" class="beavy-insight-avatar" />
            </div>
            <div>
              <h4 class="insight-title">Parameter Prioritas</h4>
              <p class="insight-subtitle">Algoritma Eisenhower & Beban Tugas</p>
            </div>
          </div>

          <div class="criteria-list">
            <div class="criterion-item">
              <span class="criterion-badge crit-1">1</span>
              <div>
                <strong>Tenggat Waktu Kritis</strong>
                <p>Tugas di bawah 24 jam otomatis ditempatkan di slot paling awal hari ini.</p>
              </div>
            </div>

            <div class="criterion-item">
              <span class="criterion-badge crit-2">2</span>
              <div>
                <strong>Ketergantungan Alur Kerja</strong>
                <p>Tugas yang menjadi syarat untuk tugas rekan tim dinaikkan bobot prioritasnya.</p>
              </div>
            </div>

            <div class="criterion-item">
              <span class="criterion-badge crit-3">3</span>
              <div>
                <strong>Tingkat Kesulitan</strong>
                <p>Dialokasikan khusus pada jam fokus produktif pengguna (10.00 - 12.00).</p>
              </div>
            </div>
          </div>

          <div class="insight-footer">
            <a href="/beavy-ai" class="btn-ask-ai-matrix">
              <span>Konsultasi Urutan Tugas dengan Beavy</span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
          </div>
        </div>

        <!-- Quick Matrix Stats -->
        <div class="matrix-stats-box">
          <h4 class="matrix-title">Komposisi Beban Minggu Ini</h4>
          <div class="stat-progress-item">
            <div class="stat-progress-label">
              <span>Akademik / Kuliah (3 tugas)</span>
              <span>75%</span>
            </div>
            <div class="bar-track"><div class="bar-fill" style="width: 75%; background: var(--color-primary);"></div></div>
          </div>

          <div class="stat-progress-item">
            <div class="stat-progress-label">
              <span>Pekerjaan / Tim (1 tugas)</span>
              <span>25%</span>
            </div>
            <div class="bar-track"><div class="bar-fill" style="width: 25%; background: #3b82f6;"></div></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    .priority-page-wrap {
      display: flex;
      flex-direction: column;
      gap: 1.6rem;
    }

    .priority-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .page-title {
      font-size: 1.85rem;
      font-weight: 800;
      color: var(--color-text-main);
      letter-spacing: -0.02em;
    }

    .page-subtitle {
      font-size: 0.88rem;
      color: var(--color-text-muted);
      margin-top: 0.25rem;
    }

    .header-actions {
      display: flex;
      gap: 0.75rem;
    }

    .btn-reorder {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.65rem 1.1rem;
      border-radius: var(--radius-md);
      border: 1px solid var(--color-border);
      background: #ffffff;
      color: var(--color-text-body);
      font-weight: 600;
      font-size: 0.82rem;
      transition: all 0.15s;
    }

    .btn-reorder:hover {
      background: var(--color-primary-light);
      border-color: var(--color-border-focus);
      color: var(--color-primary-dark);
    }

    .btn-primary-action {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.65rem 1.15rem;
      border-radius: var(--radius-md);
      border: none;
      background: var(--color-primary);
      color: white;
      font-weight: 700;
      font-size: 0.82rem;
      box-shadow: 0 2px 8px rgba(124, 58, 237, 0.25);
      transition: background 0.15s, transform 0.1s;
    }

    .btn-primary-action:hover {
      background: var(--color-primary-dark);
      transform: translateY(-1px);
    }

    /* Filters Bar */
    .filters-bar {
      display: flex;
      gap: 0.35rem;
      background: rgba(255, 255, 255, 0.7);
      backdrop-filter: blur(12px);
      padding: 0.3rem;
      border-radius: var(--radius-md);
      width: fit-content;
      border: 1px solid var(--color-border);
    }

    .filter-tab {
      padding: 0.45rem 1.1rem;
      border-radius: var(--radius-sm);
      border: none;
      background: none;
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--color-text-muted);
      transition: all 0.15s ease;
    }

    .filter-tab.active {
      background: #ffffff;
      color: var(--color-text-main);
      font-weight: 700;
      box-shadow: 0 1px 3px rgba(24, 18, 38, 0.08);
    }

    .filter-tab:hover:not(.active) {
      color: var(--color-text-main);
    }

    /* Grid */
    .priority-grid {
      display: grid;
      grid-template-columns: 1.35fr 0.85fr;
      gap: 1.8rem;
      align-items: start;
    }

    .task-list-col {
      display: flex;
      flex-direction: column;
      gap: 0.9rem;
    }

    /* Priority Card (Tactile, Crisp, Not AI Slop) */
    .priority-card {
      content-visibility: auto;
      contain-intrinsic-size: 0 110px;
      display: flex;
      align-items: center;
      gap: 1.2rem;
      background: #ffffff;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: 1.25rem 1.4rem;
      box-shadow: var(--shadow-xs);
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
    }

    .priority-card:hover {
      border-color: #d8b4fe;
      box-shadow: var(--shadow-sm);
      transform: translateY(-1px);
    }

    .priority-card.is-completed {
      opacity: 0.55;
      background: #fbfafc;
    }

    .priority-card.is-completed .task-title {
      text-decoration: line-through;
    }

    .card-left-number {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border-radius: var(--radius-md);
      background: #f6f2fc;
      border: 1px solid #ede4fa;
      flex-shrink: 0;
    }

    .rank-number {
      font-family: var(--font-mono);
      font-size: 1.1rem;
      font-weight: 800;
      color: var(--color-primary);
    }

    .card-main-body {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .card-header-line {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .task-title {
      font-size: 1rem;
      font-weight: 700;
      color: var(--color-text-main);
      line-height: 1.3;
    }

    .tags-group {
      display: flex;
      gap: 0.4rem;
    }

    .tag-category {
      background: #f4f0fa;
      color: var(--color-text-body);
      font-size: 0.7rem;
      font-weight: 600;
      padding: 0.2rem 0.55rem;
      border-radius: 6px;
    }

    .tag-priority {
      font-size: 0.7rem;
      font-weight: 700;
      padding: 0.2rem 0.6rem;
      border-radius: 6px;
    }

    .tag-priority.critical { background: #fee2e2; color: #b91c1c; }
    .tag-priority.high { background: #fef3c7; color: #b45309; }
    .tag-priority.medium { background: #e0f2fe; color: #0369a1; }
    .tag-priority.low { background: #ecfdf5; color: #047857; }

    .meta-line {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.78rem;
      color: var(--color-text-muted);
      font-weight: 500;
    }

    .meta-item {
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }

    .meta-dot {
      color: var(--color-text-subtle);
    }

    .reason-box {
      display: flex;
      align-items: baseline;
      gap: 0.45rem;
      background: #fbf9fe;
      border: 1px solid #f0eaf7;
      padding: 0.45rem 0.75rem;
      border-radius: var(--radius-sm);
      font-size: 0.78rem;
      margin-top: 0.25rem;
      line-height: 1.4;
    }

    .reason-label {
      font-weight: 700;
      color: var(--color-primary);
      flex-shrink: 0;
    }

    .reason-text {
      color: var(--color-text-body);
    }

    .card-right-action {
      flex-shrink: 0;
    }

    .btn-check-task {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      border: 1.5px solid #d4c8e7;
      background: white;
      color: #9283ab;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.15s ease;
    }

    .btn-check-task:hover {
      background: #10b981;
      border-color: #10b981;
      color: white;
      transform: scale(1.05);
    }

    /* Right Column Insights */
    .priority-insight-col {
      display: flex;
      flex-direction: column;
      gap: 1.4rem;
    }

    .insight-box, .matrix-stats-box {
      background: #ffffff;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      padding: 1.5rem;
      box-shadow: var(--shadow-xs);
    }

    .insight-header {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      padding-bottom: 1.1rem;
      border-bottom: 1px solid var(--color-border-subtle);
      margin-bottom: 1.1rem;
    }

    .beavy-avatar-frame {
      width: 40px;
      height: 40px;
      border-radius: var(--radius-md);
      background: #fbf8f2;
      border: 1px solid #f9e7c4;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .beavy-insight-avatar {
      width: 30px;
      height: 30px;
      object-fit: contain;
    }

    .insight-title {
      font-size: 0.98rem;
      font-weight: 800;
      color: var(--color-text-main);
    }

    .insight-subtitle {
      font-size: 0.75rem;
      color: var(--color-text-muted);
    }

    .criteria-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .criterion-item {
      display: flex;
      gap: 0.75rem;
    }

    .criterion-badge {
      width: 22px;
      height: 22px;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-mono);
      font-size: 0.72rem;
      font-weight: 700;
      color: white;
      flex-shrink: 0;
    }

    .crit-1 { background: #ef4444; }
    .crit-2 { background: #f59e0b; }
    .crit-3 { background: var(--color-primary); }

    .criterion-item strong {
      font-size: 0.82rem;
      color: var(--color-text-main);
      display: block;
      margin-bottom: 0.15rem;
    }

    .criterion-item p {
      font-size: 0.75rem;
      color: var(--color-text-muted);
      line-height: 1.4;
    }

    .insight-footer {
      margin-top: 1.2rem;
      padding-top: 1rem;
      border-top: 1px solid var(--color-border-subtle);
    }

    .btn-ask-ai-matrix {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      background: var(--color-primary-light);
      color: var(--color-primary-dark);
      font-size: 0.82rem;
      font-weight: 700;
      padding: 0.65rem 0.95rem;
      border-radius: var(--radius-md);
      transition: background 0.15s;
    }

    .btn-ask-ai-matrix:hover {
      background: #ede3ff;
    }

    /* Matrix Stats Box */
    .matrix-title {
      font-size: 0.92rem;
      font-weight: 800;
      color: var(--color-text-main);
      margin-bottom: 1rem;
    }

    .stat-progress-item {
      margin-bottom: 0.9rem;
    }

    .stat-progress-label {
      display: flex;
      justify-content: space-between;
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--color-text-body);
      margin-bottom: 0.35rem;
    }

    .bar-track {
      width: 100%;
      height: 6px;
      background: #f0ecf6;
      border-radius: var(--radius-full);
      overflow: hidden;
    }

    .bar-fill {
      height: 100%;
      border-radius: var(--radius-full);
    }

    @media (max-width: 1024px) {
      .priority-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script>
    // Category Filter
    const tabs = document.querySelectorAll('.filter-tab');
    const cards = document.querySelectorAll('.priority-card');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');

        const cat = tab.getAttribute('data-category');
        cards.forEach(card => {
          const cardCat = card.getAttribute('data-category');
          if (cat === 'all' || cardCat === cat) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });

    // Mark task done with Toast instead of alert()
    document.querySelectorAll('.btn-check-task').forEach(btn => {
      btn.addEventListener('click', function(this: HTMLButtonElement) {
        const card = this.closest('.priority-card') as HTMLElement;
        const title = card.querySelector('.task-title')?.textContent || 'Tugas';
        
        card.classList.toggle('is-completed');
        const isDone = card.classList.contains('is-completed');

        if (isDone) {
          this.style.background = '#10b981';
          this.style.color = '#ffffff';
          this.style.borderColor = '#10b981';
          (window as any).jadwalinToast('Tugas Diselesaikan', `"${title}" telah dipindahkan ke arsip selesai.`, 'success');
        } else {
          this.style.background = 'white';
          this.style.color = '#9283ab';
          this.style.borderColor = '#d4c8e7';
          (window as any).jadwalinToast('Tugas Dikembalikan', `"${title}" dikembalikan ke daftar aktif.`, 'info');
        }
      });
    });

    // Recalculate simulation with Toast
    const btnReorder = document.getElementById('btn-reorder');
    btnReorder?.addEventListener('click', () => {
      (window as any).jadwalinToast('Kalkulasi Selesai', 'AI Beavy telah memverifikasi seluruh tenggat waktu & buffer jadwal.', 'info');
    });
  </script>
</DashboardLayout>
