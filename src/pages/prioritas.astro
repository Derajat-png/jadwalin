---
// src/pages/prioritas.astro
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { Image } from 'astro:assets';
import mascotImg from '../assets/craiyon.png';

const initialTasks = [
  {
    id: 1,
    rank: 1,
    title: "Laporan Praktikum Pemrograman",
    category: "Kuliah",
    priority: "Kritis",
    priorityClass: "critical",
    deadline: "Hari ini, 17.00",
    duration: "2 jam",
    reason: "Tenggat dekat, jadi syarat tugas berikutnya.",
    completed: false
  },
  {
    id: 2,
    rank: 2,
    title: "Slide Presentasi Kelompok",
    category: "Kuliah",
    priority: "Tinggi",
    priorityClass: "high",
    deadline: "Besok, 09.00",
    duration: "1,5 jam",
    reason: "Tim menunggu materi untuk latihan bersama.",
    completed: false
  },
  {
    id: 3,
    rank: 3,
    title: "Revisi Dokumen Klien",
    category: "Kerja",
    priority: "Sedang",
    priorityClass: "medium",
    deadline: "23 Okt, 15.00",
    duration: "1 jam",
    reason: "Revisi ringan, tenggat masih cukup longgar.",
    completed: false
  },
  {
    id: 4,
    rank: 4,
    title: "Belajar Ujian Basis Data",
    category: "Kuliah",
    priority: "Rendah",
    priorityClass: "low",
    deadline: "26 Okt, 08.00",
    duration: "2 jam",
    reason: "Bisa dicicil setelah tugas mendesak selesai.",
    completed: false
  }
];
---

<DashboardLayout title="Prioritas Tugas" activeNav="prioritas">
  <div class="priority-page-wrap">
    <!-- Header -->
    <div class="priority-header">
      <div>
        <h1 class="page-title">Prioritas Tugas</h1>
        <p class="page-subtitle">
          Diurutkan berdasarkan urgensi, beban, kesulitan, dan ketergantungan oleh AI Beavy.
        </p>
      </div>

      <div class="header-actions">
        <button id="btn-reorder" class="btn-reorder" type="button">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="4" y1="9" x2="20" y2="9"></line><line x1="4" y1="15" x2="20" y2="15"></line><polyline points="10 5 6 9 10 13"></polyline><polyline points="14 19 18 15 14 11"></polyline></svg>
          <span>Ubah Urutan</span>
        </button>
        <button id="open-add-priority" class="btn-primary-action" type="button">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          <span>Tambah Prioritas</span>
        </button>
      </div>
    </div>

    <!-- Category Filter Tabs -->
    <div class="filters-bar">
      <button class="filter-tab active" data-category="all">Semua</button>
      <button class="filter-tab" data-category="Kuliah">Kuliah</button>
      <button class="filter-tab" data-category="Kerja">Kerja</button>
      <button class="filter-tab" data-category="Pribadi">Pribadi</button>
    </div>

    <!-- 2-Column Desktop View: Priority List (Left) + AI Logic & Summary (Right) -->
    <div class="priority-grid">
      <!-- Left Column: The Task Cards -->
      <div class="task-list-col" id="tasks-container">
        {initialTasks.map((task) => (
          <div class={`priority-card priority-${task.priorityClass}`} data-category={task.category} data-id={task.id}>
            <div class="card-left-number">
              <span class="rank-number">{task.rank}</span>
            </div>

            <div class="card-main-body">
              <div class="card-header-line">
                <h3 class="task-title">{task.title}</h3>
                <div class="tags-group">
                  <span class="tag-category">{task.category}</span>
                  <span class={`tag-priority ${task.priorityClass}`}>{task.priority}</span>
                </div>
              </div>

              <div class="meta-line">
                <span class="meta-item">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                  {task.deadline}
                </span>
                <span class="meta-dot">•</span>
                <span class="meta-item">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 8v4l3 3"></path><circle cx="12" cy="12" r="9"></circle></svg>
                  {task.duration}
                </span>
              </div>

              <!-- AI Rationale Reason -->
              <div class="reason-box">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#8b5cf6" stroke-width="2.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                <span>{task.reason}</span>
              </div>
            </div>

            <div class="card-right-action">
              <button class="btn-check-task" title="Tandai Selesai" aria-label="Tandai Selesai">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </button>
            </div>
          </div>
        ))}
      </div>

      <!-- Right Column: AI Explainer & Matrix Insight -->
      <div class="priority-insight-col">
        <div class="insight-box">
          <div class="insight-header">
            <Image src={mascotImg} alt="Beavy" class="beavy-insight-avatar" />
            <div>
              <h4 class="insight-title">Bagaimana AI Menentukan?</h4>
              <p class="insight-subtitle">Algoritma Eisenhower & Workload Analysis</p>
            </div>
          </div>

          <div class="criteria-list">
            <div class="criterion-item">
              <span class="criterion-badge crit-1">1</span>
              <div>
                <strong>Urgensi Waktu (Deadline)</strong>
                <p>Tugas dengan sisa waktu di bawah 24 jam otomatis diprioritaskan.</p>
              </div>
            </div>

            <div class="criterion-item">
              <span class="criterion-badge crit-2">2</span>
              <div>
                <strong>Ketergantungan Tugas</strong>
                <p>Jika tugas lain menunggu tugas ini selesai, bobot prioritas naik +40%.</p>
              </div>
            </div>

            <div class="criterion-item">
              <span class="criterion-badge crit-3">3</span>
              <div>
                <strong>Tingkat Kesulitan & Beban</strong>
                <p>Tugas sulit dialokasikan ke slot jam produktif utama (jam 10-12).</p>
              </div>
            </div>
          </div>

          <div class="insight-footer">
            <a href="/beavy-ai" class="btn-ask-ai-matrix">
              <span>Konsultasi Urutan dengan Beavy</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
          </div>
        </div>

        <!-- Quick Matrix Stats -->
        <div class="matrix-stats-box">
          <h4 class="matrix-title">Distribusi Kategori</h4>
          <div class="stat-progress-item">
            <div class="stat-progress-label">
              <span>Kuliah (3 tugas)</span>
              <span>75%</span>
            </div>
            <div class="bar-track"><div class="bar-fill" style="width: 75%; background: #8b5cf6;"></div></div>
          </div>

          <div class="stat-progress-item">
            <div class="stat-progress-label">
              <span>Kerja (1 tugas)</span>
              <span>25%</span>
            </div>
            <div class="bar-track"><div class="bar-fill" style="width: 25%; background: #3b82f6;"></div></div>
          </div>

          <div class="stat-progress-item">
            <div class="stat-progress-label">
              <span>Pribadi (0 tugas)</span>
              <span>0%</span>
            </div>
            <div class="bar-track"><div class="bar-fill" style="width: 0%; background: #10b981;"></div></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    .priority-page-wrap {
      display: flex;
      flex-direction: column;
      gap: 1.8rem;
    }

    .priority-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .page-title {
      font-size: 2.2rem;
      font-weight: 800;
      color: #201438;
      letter-spacing: -0.5px;
    }

    .page-subtitle {
      font-size: 0.95rem;
      color: #6c5f85;
      margin-top: 0.3rem;
    }

    .header-actions {
      display: flex;
      gap: 0.8rem;
    }

    .btn-reorder {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.75rem 1.2rem;
      border-radius: var(--radius-full);
      border: 1.5px solid #dcd3eb;
      background: rgba(255, 255, 255, 0.9);
      color: #554673;
      font-weight: 700;
      font-size: 0.88rem;
      transition: all 0.2s;
    }

    .btn-reorder:hover {
      background: white;
      border-color: #8b5cf6;
      color: #8b5cf6;
    }

    .btn-primary-action {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.75rem 1.4rem;
      border-radius: var(--radius-full);
      border: none;
      background: linear-gradient(135deg, #a855f7, #8b5cf6);
      color: white;
      font-weight: 700;
      font-size: 0.88rem;
      box-shadow: 0 6px 18px rgba(139, 92, 246, 0.35);
      transition: transform 0.2s;
    }

    .btn-primary-action:hover {
      transform: translateY(-2px);
    }

    /* Filters Bar */
    .filters-bar {
      display: flex;
      gap: 0.6rem;
      background: rgba(255, 255, 255, 0.6);
      padding: 0.4rem;
      border-radius: var(--radius-full);
      width: fit-content;
      border: 1px solid rgba(255, 255, 255, 0.8);
    }

    .filter-tab {
      padding: 0.55rem 1.4rem;
      border-radius: var(--radius-full);
      border: none;
      background: none;
      font-size: 0.88rem;
      font-weight: 700;
      color: #6f6288;
      transition: all 0.2s ease;
    }

    .filter-tab.active {
      background: #8b5cf6;
      color: white;
      box-shadow: 0 4px 12px rgba(139, 92, 246, 0.3);
    }

    .filter-tab:hover:not(.active) {
      color: #201438;
      background: rgba(255, 255, 255, 0.6);
    }

    /* Grid */
    .priority-grid {
      display: grid;
      grid-template-columns: 1.25fr 0.75fr;
      gap: 2rem;
      align-items: start;
    }

    .task-list-col {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    /* Priority Card */
    .priority-card {
      display: flex;
      align-items: center;
      gap: 1.4rem;
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(14px);
      border: 1px solid rgba(255, 255, 255, 0.9);
      border-radius: var(--radius-lg);
      padding: 1.4rem 1.6rem;
      box-shadow: 0 4px 20px rgba(70, 30, 110, 0.05);
      transition: transform 0.2s, box-shadow 0.2s;
      position: relative;
    }

    .priority-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 28px rgba(70, 30, 110, 0.1);
    }

    .card-left-number {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: #f4effc;
      flex-shrink: 0;
    }

    .rank-number {
      font-size: 1.35rem;
      font-weight: 800;
      color: #6d28d9;
    }

    .card-main-body {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .card-header-line {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .task-title {
      font-size: 1.12rem;
      font-weight: 800;
      color: #211539;
    }

    .tags-group {
      display: flex;
      gap: 0.4rem;
    }

    .tag-category {
      background: #f3f0f9;
      color: #64557f;
      font-size: 0.72rem;
      font-weight: 700;
      padding: 0.2rem 0.6rem;
      border-radius: 6px;
    }

    .tag-priority {
      font-size: 0.72rem;
      font-weight: 800;
      padding: 0.2rem 0.65rem;
      border-radius: 6px;
    }

    .tag-priority.critical {
      background: #fee2e2;
      color: #dc2626;
    }

    .tag-priority.high {
      background: #fef3c7;
      color: #d97706;
    }

    .tag-priority.medium {
      background: #e0f2fe;
      color: #0284c7;
    }

    .tag-priority.low {
      background: #f0fdf4;
      color: #16a34a;
    }

    .meta-line {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-size: 0.82rem;
      color: #796c92;
      font-weight: 600;
    }

    .meta-item {
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }

    .reason-box {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      background: #faf6ff;
      border: 1px solid #ede3fb;
      padding: 0.45rem 0.8rem;
      border-radius: 8px;
      font-size: 0.8rem;
      color: #554472;
      margin-top: 0.2rem;
    }

    .card-right-action {
      flex-shrink: 0;
    }

    .btn-check-task {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      border: 1.5px solid #d4c8e7;
      background: white;
      color: #9283ab;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
    }

    .btn-check-task:hover {
      background: #10b981;
      border-color: #10b981;
      color: white;
    }

    /* Right Column Insights */
    .priority-insight-col {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .insight-box, .matrix-stats-box {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.85);
      border-radius: var(--radius-lg);
      padding: 1.6rem;
      box-shadow: var(--shadow-sm);
    }

    .insight-header {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding-bottom: 1.2rem;
      border-bottom: 1px solid #f0e9f8;
      margin-bottom: 1.2rem;
    }

    .beavy-insight-avatar {
      width: 48px;
      height: 48px;
      object-fit: contain;
    }

    .insight-title {
      font-size: 1.05rem;
      font-weight: 800;
      color: #24163e;
    }

    .insight-subtitle {
      font-size: 0.78rem;
      color: #7b6e94;
    }

    .criteria-list {
      display: flex;
      flex-direction: column;
      gap: 1.1rem;
    }

    .criterion-item {
      display: flex;
      gap: 0.8rem;
    }

    .criterion-badge {
      width: 26px;
      height: 26px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.8rem;
      font-weight: 800;
      color: white;
      flex-shrink: 0;
    }

    .crit-1 { background: #ef4444; }
    .crit-2 { background: #f59e0b; }
    .crit-3 { background: #8b5cf6; }

    .criterion-item strong {
      font-size: 0.86rem;
      color: #271a42;
      display: block;
      margin-bottom: 0.15rem;
    }

    .criterion-item p {
      font-size: 0.76rem;
      color: #7a6c92;
      line-height: 1.4;
    }

    .insight-footer {
      margin-top: 1.4rem;
      padding-top: 1rem;
      border-top: 1px solid #f0e9f8;
    }

    .btn-ask-ai-matrix {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      background: #f5edff;
      color: #7c3aed;
      font-size: 0.85rem;
      font-weight: 700;
      padding: 0.75rem 1rem;
      border-radius: var(--radius-md);
      transition: background 0.2s;
    }

    .btn-ask-ai-matrix:hover {
      background: #ede0ff;
    }

    /* Matrix Stats Box */
    .matrix-title {
      font-size: 1rem;
      font-weight: 800;
      color: #23163c;
      margin-bottom: 1.2rem;
    }

    .stat-progress-item {
      margin-bottom: 1rem;
    }

    .stat-progress-label {
      display: flex;
      justify-content: space-between;
      font-size: 0.82rem;
      font-weight: 700;
      color: #554770;
      margin-bottom: 0.4rem;
    }

    .bar-track {
      width: 100%;
      height: 8px;
      background: #f0e8f8;
      border-radius: var(--radius-full);
      overflow: hidden;
    }

    .bar-fill {
      height: 100%;
      border-radius: var(--radius-full);
    }

    @media (max-width: 1024px) {
      .priority-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script>
    // Category Filter Functionality
    const tabs = document.querySelectorAll('.filter-tab');
    const cards = document.querySelectorAll('.priority-card');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');

        const cat = tab.getAttribute('data-category');
        cards.forEach(card => {
          const cardCat = card.getAttribute('data-category');
          if (cat === 'all' || cardCat === cat) {
            (card as HTMLElement).style.display = 'flex';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });

    // Mark task done
    document.querySelectorAll('.btn-check-task').forEach(btn => {
      btn.addEventListener('click', function(this: HTMLButtonElement) {
        const card = this.closest('.priority-card') as HTMLElement;
        if (card) {
          card.style.opacity = '0.5';
          card.style.textDecoration = 'line-through';
          this.style.background = '#10b981';
          this.style.color = '#ffffff';
          alert('Tugas ditandai selesai! Skor fokus bertambah +50 poin 🎉');
        }
      });
    });

    // Reorder button simulation
    const btnReorder = document.getElementById('btn-reorder');
    btnReorder?.addEventListener('click', () => {
      alert('Mode atur urutan aktif: Kamu bisa drag & drop prioritas tugas atau meminta Beavy AI untuk mengkalkulasi ulang secara otomatis!');
    });
  </script>
</DashboardLayout>
