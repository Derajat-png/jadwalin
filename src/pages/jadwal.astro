---
// src/pages/jadwal.astro
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { Image } from 'astro:assets';
import mascotImg from '../assets/craiyon.png';

const days = [
  { day: "Sen", date: "19", full: "Senin, 19 Okt", active: false },
  { day: "Sel", date: "20", full: "Selasa, 20 Okt", active: false },
  { day: "Rab", date: "21", full: "Rabu, 21 Okt", active: false },
  { day: "Kam", date: "22", full: "Kamis, 22 Okt", active: false },
  { day: "Jum", date: "23", full: "Jumat, 23 Okt", active: false },
  { day: "Sab", date: "24", full: "Sabtu, 24 Okt", active: true },
  { day: "Min", date: "25", full: "Minggu, 25 Okt", active: false }
];
---

<DashboardLayout title="Jadwal & Time Blocking" activeNav="jadwal">
  <div class="jadwal-page-wrap">
    <!-- Top Bar with Month & Summary Stats -->
    <div class="jadwal-header">
      <div>
        <h1 class="page-title">Kalender & Time-Blocking</h1>
        <span class="month-pill">Oktober 2026</span>
      </div>

      <!-- Quick Metrics from Figma -->
      <div class="stats-row">
        <div class="stat-pill pending-stat">
          <span class="stat-lbl">Tertunda</span>
          <span class="stat-val">2 Tugas</span>
        </div>
        <div class="stat-pill worktime-stat">
          <span class="stat-lbl">Kapasitas Kerja</span>
          <span class="stat-val">270 mnt</span>
        </div>
      </div>
    </div>

    <!-- Capacity Warning Bar from Figma -->
    <div class="alert-conflict-bar">
      <div class="alert-left">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2.2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
        <span><strong>Optimalisasi Kapasitas:</strong> 1 tugas melebihi slot waktu hari ini. Rekomendasi AI tersedia.</span>
      </div>
      <button id="btn-see-options" class="btn-alert-action">Terapkan Opsi AI</button>
    </div>

    <!-- Day Selector Strip (Figma Match, High Polish) -->
    <div class="days-strip">
      {days.map((item) => (
        <button class={`day-card ${item.active ? 'active' : ''}`} data-day={item.full}>
          <span class="day-name">{item.day}</span>
          <span class="day-number">{item.date}</span>
          <span class="active-indicator"></span>
        </button>
      ))}
    </div>

    <!-- Desktop 2-Column Schedule Grid: Time Blocks (Left) + Waktu Luang Management (Right) -->
    <div class="schedule-desktop-grid">
      <!-- Left Column: Detailed Time Schedule Blocks -->
      <div class="timeline-blocks-col">
        <div class="panel-card">
          <div class="panel-header">
            <div>
              <h3 class="panel-title">Sesi Terjadwal · <span id="active-day-label">Sabtu, 24 Okt</span></h3>
              <span class="panel-sub">Blok pengerjaan terstruktur</span>
            </div>
            <span class="badge-total-slots">4 Sesi Terdaftar</span>
          </div>

          <!-- Schedule Blocks List -->
          <div class="time-block-list">
            <!-- Block 1 -->
            <div class="time-block-card focus">
              <div class="block-time">
                <span class="time-range">10.00 - 12.00</span>
                <span class="duration-tag">120 mnt</span>
              </div>
              <div class="block-info">
                <div class="block-title-row">
                  <h4 class="block-title">Fokus: Pemrograman Web & API</h4>
                  <span class="chip-cat chip-akademik">Akademik</span>
                </div>
                <p class="block-notes">Implementasi endpoint auth dan validasi schema database.</p>
              </div>
              <div class="block-actions">
                <button class="btn-slot-done" title="Tandai Selesai" aria-label="Tandai selesai" onclick="markSlotDone(this, 'Fokus: Pemrograman Web & API')">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </button>
              </div>
            </div>

            <!-- Block 2 -->
            <div class="time-block-card class">
              <div class="block-time">
                <span class="time-range">15.00 - 16.30</span>
                <span class="duration-tag">90 mnt</span>
              </div>
              <div class="block-info">
                <div class="block-title-row">
                  <h4 class="block-title">Laporan Praktikum Pemrograman</h4>
                  <span class="chip-cat chip-akademik">Akademik</span>
                </div>
                <p class="block-notes">Tenggat hari ini jam 17.00. Analisis hasil pengujian algoritma.</p>
              </div>
              <div class="block-actions">
                <button class="btn-slot-done" title="Tandai Selesai" aria-label="Tandai selesai" onclick="markSlotDone(this, 'Laporan Praktikum')">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </button>
              </div>
            </div>

            <!-- Block 3 -->
            <div class="time-block-card work">
              <div class="block-time">
                <span class="time-range">19.00 - 20.00</span>
                <span class="duration-tag">60 mnt</span>
              </div>
              <div class="block-info">
                <div class="block-title-row">
                  <h4 class="block-title">Slide Presentasi Kelompok</h4>
                  <span class="chip-cat chip-kerja">Tim</span>
                </div>
                <p class="block-notes">Review deck presentasi dan sinkronisasi pembagian bab pembicara.</p>
              </div>
              <div class="block-actions">
                <button class="btn-slot-done" title="Tandai Selesai" aria-label="Tandai selesai" onclick="markSlotDone(this, 'Slide Presentasi Kelompok')">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </button>
              </div>
            </div>

            <!-- Block 4 -->
            <div class="time-block-card done">
              <div class="block-time">
                <span class="time-range">08.00 - 09.00</span>
                <span class="duration-tag">60 mnt</span>
              </div>
              <div class="block-info">
                <div class="block-title-row">
                  <h4 class="block-title" style="text-decoration: line-through; opacity: 0.65;">Riset Pasar & Referensi</h4>
                  <span class="chip-cat chip-done">Selesai</span>
                </div>
                <p class="block-notes">Benchmarking alur onboarding kompetitor selesai dirangkum.</p>
              </div>
              <div class="block-actions">
                <span class="badge-checked">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span>Selesai</span>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Waktu Luang Management (From Figma Frame 153:1004) -->
      <div class="waktu-luang-col">
        <div class="panel-card">
          <div class="panel-header">
            <div>
              <h3 class="panel-title">Waktu Luang Saya</h3>
              <span class="panel-sub">Slot kosong yang dialokasikan AI</span>
            </div>
            <button id="btn-add-slot" class="btn-text-link">+ Tambah Slot</button>
          </div>

          <!-- Slot list from Figma -->
          <div class="slot-chips-list" id="slot-list-container">
            <div class="slot-chip">
              <div class="slot-chip-info">
                <span class="slot-chip-time">08.00 - 10.00</span>
                <span class="slot-chip-tag">Pagi • 2 jam fokus</span>
              </div>
              <button class="btn-remove-slot" title="Hapus Slot" aria-label="Hapus slot waktu" onclick="this.closest('.slot-chip').remove(); (window).jadwalinToast('Slot Dihapus', 'Slot waktu pagi dihapus.', 'info');">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </div>

            <div class="slot-chip">
              <div class="slot-chip-info">
                <span class="slot-chip-time">15.00 - 17.30</span>
                <span class="slot-chip-tag">Sore • 2.5 jam fokus</span>
              </div>
              <button class="btn-remove-slot" title="Hapus Slot" aria-label="Hapus slot waktu" onclick="this.closest('.slot-chip').remove(); (window).jadwalinToast('Slot Dihapus', 'Slot sore dihapus.', 'info');">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </div>

            <div class="slot-chip">
              <div class="slot-chip-info">
                <span class="slot-chip-time">19.00 - 21.00</span>
                <span class="slot-chip-tag">Malam • 2 jam santai</span>
              </div>
              <button class="btn-remove-slot" title="Hapus Slot" aria-label="Hapus slot waktu" onclick="this.closest('.slot-chip').remove(); (window).jadwalinToast('Slot Dihapus', 'Slot malam dihapus.', 'info');">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </div>
          </div>

          <!-- Kegiatan Tetap from Figma -->
          <div class="fixed-routines-section">
            <h4 class="fixed-title">Kegiatan Terkunci (Non-Negotiable)</h4>
            
            <div class="routine-item">
              <div>
                <strong>Kuliah Basis Data</strong>
                <span>10.00 - 12.00 • Ruang Lab 3</span>
              </div>
              <span class="lock-badge">Terkunci</span>
            </div>

            <div class="routine-item">
              <div>
                <strong>Rapat Himpunan</strong>
                <span>13.00 - 14.30 • Google Meet</span>
              </div>
              <span class="lock-badge">Terkunci</span>
            </div>
          </div>

          <!-- Bottom Actions -->
          <div class="waktu-luang-footer">
            <button class="btn-outline-action" id="btn-copy-days">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <span>Salin Slot ke Hari Kerja (Sen - Jum)</span>
            </button>
            <button class="btn-save-schedule" id="btn-auto-schedule">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l2.4 7.2L22 12l-7.6 2.8L12 22l-2.8-7.2L2 12l7.2-2.8z"></path></svg>
              <span>Sinkronkan Kalender Otomatis</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    .jadwal-page-wrap {
      display: flex;
      flex-direction: column;
      gap: 1.6rem;
    }

    .jadwal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .page-title {
      font-size: 1.85rem;
      font-weight: 800;
      color: var(--color-text-main);
      display: inline-block;
      margin-right: 0.6rem;
      letter-spacing: -0.02em;
    }

    .month-pill {
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--color-primary);
      background: var(--color-primary-light);
      padding: 0.25rem 0.75rem;
      border-radius: var(--radius-full);
      display: inline-block;
      vertical-align: middle;
    }

    .stats-row {
      display: flex;
      gap: 0.75rem;
    }

    .stat-pill {
      background: #ffffff;
      border: 1px solid var(--color-border);
      padding: 0.6rem 1.1rem;
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-xs);
      display: flex;
      flex-direction: column;
      min-width: 110px;
    }

    .stat-lbl {
      font-size: 0.68rem;
      font-weight: 700;
      color: var(--color-text-muted);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .stat-val {
      font-family: var(--font-mono);
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--color-text-main);
      margin-top: 0.1rem;
    }

    .pending-stat .stat-val { color: #dc2626; }
    .worktime-stat .stat-val { color: var(--color-primary); }

    /* Alert Conflict Bar */
    .alert-conflict-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #ffffff;
      border: 1px solid #fde68a;
      border-left: 4px solid #f59e0b;
      border-radius: var(--radius-md);
      padding: 0.8rem 1.2rem;
      box-shadow: var(--shadow-xs);
      gap: 1rem;
      flex-wrap: wrap;
    }

    .alert-left {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-size: 0.85rem;
      color: #92400e;
    }

    .btn-alert-action {
      background: #d97706;
      color: white;
      border: none;
      font-size: 0.78rem;
      font-weight: 700;
      padding: 0.45rem 1rem;
      border-radius: var(--radius-sm);
      cursor: pointer;
      transition: background 0.15s;
    }

    .btn-alert-action:hover {
      background: #b45309;
    }

    /* Days Strip */
    .days-strip {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 0.65rem;
    }

    .day-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 0.75rem 0.5rem;
      background: #ffffff;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      transition: all 0.15s;
      position: relative;
      cursor: pointer;
    }

    .day-card:hover {
      border-color: var(--color-border-focus);
      transform: translateY(-1px);
    }

    .day-card.active {
      border-color: var(--color-primary);
      background: #f5f0ff;
    }

    .day-name {
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--color-text-muted);
      margin-bottom: 0.15rem;
    }

    .day-card.active .day-name {
      color: var(--color-primary);
    }

    .day-number {
      font-family: var(--font-mono);
      font-size: 1.25rem;
      font-weight: 800;
      color: var(--color-text-main);
    }

    .day-card.active .day-number {
      color: var(--color-primary);
    }

    .active-indicator {
      display: none;
      width: 4px;
      height: 4px;
      background: var(--color-primary);
      border-radius: 50%;
      margin-top: 0.25rem;
    }

    .day-card.active .active-indicator {
      display: block;
    }

    /* Grid Layout */
    .schedule-desktop-grid {
      display: grid;
      grid-template-columns: 1.35fr 0.85fr;
      gap: 1.8rem;
      align-items: start;
    }

    .panel-card {
      background: #ffffff;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
      padding: 1.6rem;
      box-shadow: var(--shadow-xs);
    }

    .panel-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 1.2rem;
    }

    .panel-title {
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--color-text-main);
    }

    .panel-sub {
      font-size: 0.75rem;
      color: var(--color-text-muted);
    }

    .badge-total-slots {
      background: var(--color-primary-light);
      color: var(--color-primary);
      font-size: 0.72rem;
      font-weight: 700;
      padding: 0.25rem 0.65rem;
      border-radius: var(--radius-full);
    }

    /* Time Block Cards */
    .time-block-list {
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
    }

    .time-block-card {
      content-visibility: auto;
      contain-intrinsic-size: 0 90px;
      display: flex;
      align-items: center;
      gap: 1.1rem;
      padding: 0.95rem 1.15rem;
      background: #fbf9fe;
      border: 1px solid var(--color-border-subtle);
      border-radius: var(--radius-md);
      transition: all 0.15s;
      position: relative;
    }

    .time-block-card:hover {
      border-color: #d8b4fe;
      transform: translateX(2px);
    }

    .time-block-card.focus { border-left: 3.5px solid var(--color-primary); }
    .time-block-card.class { border-left: 3.5px solid #3b82f6; }
    .time-block-card.work { border-left: 3.5px solid var(--color-accent); }
    .time-block-card.done { border-left: 3.5px solid #10b981; opacity: 0.65; }

    .block-time {
      display: flex;
      flex-direction: column;
      min-width: 90px;
    }

    .time-range {
      font-family: var(--font-mono);
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--color-text-main);
    }

    .duration-tag {
      font-size: 0.68rem;
      color: var(--color-text-subtle);
      font-weight: 600;
    }

    .block-info {
      flex: 1;
    }

    .block-title-row {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0.2rem;
    }

    .block-title {
      font-size: 0.92rem;
      font-weight: 700;
      color: var(--color-text-main);
    }

    .chip-cat {
      font-size: 0.65rem;
      font-weight: 700;
      padding: 0.15rem 0.5rem;
      border-radius: 4px;
    }

    .chip-akademik { background: #ede9fe; color: #7c3aed; }
    .chip-kerja { background: #fef3c7; color: #d97706; }
    .chip-done { background: #dcfce7; color: #15803d; }

    .block-notes {
      font-size: 0.75rem;
      color: var(--color-text-muted);
      line-height: 1.35;
    }

    .btn-slot-done {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      border: 1.5px solid #cfc2e5;
      background: white;
      color: var(--color-primary);
      font-weight: 700;
      font-size: 0.8rem;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.15s;
    }

    .btn-slot-done:hover {
      background: #10b981;
      border-color: #10b981;
      color: white;
    }

    .badge-checked {
      font-size: 0.72rem;
      font-weight: 700;
      color: #16a34a;
    }

    /* Waktu Luang Management */
    .btn-text-link {
      background: none;
      border: none;
      color: var(--color-primary);
      font-weight: 700;
      font-size: 0.8rem;
      cursor: pointer;
    }

    .btn-text-link:hover {
      text-decoration: underline;
    }

    .slot-chips-list {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      margin-bottom: 1.4rem;
    }

    .slot-chip {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #fbf9fe;
      border: 1px dashed var(--color-border);
      padding: 0.65rem 0.9rem;
      border-radius: var(--radius-md);
      transition: border-color 0.15s;
    }

    .slot-chip:hover {
      border-color: var(--color-border-focus);
    }

    .slot-chip-time {
      font-family: var(--font-mono);
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--color-text-main);
      display: block;
    }

    .slot-chip-tag {
      font-size: 0.7rem;
      color: var(--color-text-muted);
    }

    .btn-remove-slot {
      background: none;
      border: none;
      color: var(--color-text-subtle);
      font-size: 0.85rem;
      padding: 0.2rem;
      cursor: pointer;
    }

    .btn-remove-slot:hover {
      color: #dc2626;
    }

    /* Fixed Routines */
    .fixed-routines-section {
      border-top: 1px solid var(--color-border-subtle);
      padding-top: 1rem;
      margin-bottom: 1.4rem;
    }

    .fixed-title {
      font-size: 0.78rem;
      font-weight: 800;
      color: var(--color-text-main);
      margin-bottom: 0.6rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .routine-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.6rem 0.8rem;
      background: #fbfafc;
      border: 1px solid var(--color-border-subtle);
      border-radius: var(--radius-sm);
      margin-bottom: 0.45rem;
    }

    .routine-item strong {
      font-size: 0.82rem;
      color: var(--color-text-main);
      display: block;
    }

    .routine-item span {
      font-size: 0.72rem;
      color: var(--color-text-muted);
    }

    .lock-badge {
      font-size: 0.65rem !important;
      color: var(--color-text-muted) !important;
      background: #eee8f5;
      padding: 0.15rem 0.5rem;
      border-radius: 4px;
      font-weight: 600;
    }

    /* Bottom Actions */
    .waktu-luang-footer {
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }

    .btn-outline-action {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.65rem;
      border: 1px solid var(--color-border);
      background: white;
      color: var(--color-text-body);
      font-size: 0.8rem;
      font-weight: 600;
      border-radius: var(--radius-md);
      cursor: pointer;
      transition: all 0.15s;
    }

    .btn-outline-action:hover {
      border-color: var(--color-border-focus);
      color: var(--color-primary);
    }

    .btn-save-schedule {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.75rem;
      border: none;
      background: var(--color-primary);
      color: white;
      font-size: 0.84rem;
      font-weight: 700;
      border-radius: var(--radius-md);
      box-shadow: 0 2px 8px rgba(124, 58, 237, 0.25);
      cursor: pointer;
      transition: background 0.15s;
    }

    .btn-save-schedule:hover {
      background: var(--color-primary-dark);
    }

    @media (max-width: 1024px) {
      .schedule-desktop-grid {
        grid-template-columns: 1fr;
      }
      .days-strip {
        overflow-x: auto;
        padding-bottom: 0.4rem;
      }
    }
  </style>

  <script>
    // Day Selector
    const dayCards = document.querySelectorAll('.day-card');
    const activeDayLabel = document.getElementById('active-day-label');

    dayCards.forEach(card => {
      card.addEventListener('click', () => {
        dayCards.forEach(c => c.classList.remove('active'));
        card.classList.add('active');
        const fullDay = card.getAttribute('data-day');
        if (activeDayLabel && fullDay) {
          activeDayLabel.textContent = fullDay;
          (window as any).jadwalinToast('Jadwal Ditampilkan', `Beralih ke jadwal ${fullDay}.`, 'info');
        }
      });
    });

    (window as any).markSlotDone = (btn: HTMLElement, title: string) => {
      const card = btn.closest('.time-block-card') as HTMLElement;
      if (card) {
        card.classList.toggle('done');
        const isDone = card.classList.contains('done');
        if (isDone) {
          (window as any).jadwalinToast('Sesi Diselesaikan', `"${title}" selesai tepat waktu.`, 'success');
        }
      }
    };

    // Alert Options
    document.getElementById('btn-see-options')?.addEventListener('click', () => {
      (window as any).jadwalinToast('Optimalisasi Berhasil', 'Slide presentasi dipindahkan 30 menit lebih awal agar tidak tumpang tindih.', 'success');
    });

    // Add slot without prompt()
    document.getElementById('btn-add-slot')?.addEventListener('click', () => {
      const container = document.getElementById('slot-list-container');
      if (container) {
        const newSlot = document.createElement('div');
        newSlot.className = 'slot-chip';
        newSlot.innerHTML = `
          <div class="slot-chip-info">
            <span class="slot-chip-time">21.00 - 22.00</span>
            <span class="slot-chip-tag">Malam • 1 jam evaluasi</span>
          </div>
          <button class="btn-remove-slot" title="Hapus" aria-label="Hapus slot" onclick="this.closest('.slot-chip').remove(); (window).jadwalinToast('Slot Dihapus', 'Slot dihapus.', 'info');">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        `;
        container.appendChild(newSlot);
        (window as any).jadwalinToast('Slot Ditambahkan', 'Slot 21.00 - 22.00 ditambahkan ke ketersediaanmu.', 'success');
      }
    });

    // Copy to other days
    document.getElementById('btn-copy-days')?.addEventListener('click', () => {
      (window as any).jadwalinToast('Sinkronisasi Hari Kerja', 'Pola slot luang disalin ke Senin - Jumat.', 'success');
    });

    // Auto schedule
    document.getElementById('btn-auto-schedule')?.addEventListener('click', () => {
      (window as any).jadwalinToast('Kalender Tersinkron', 'Jadwal time-blocking pekan ini telah dikunci.', 'success');
    });
  </script>
</DashboardLayout>
