---
// src/pages/jadwal.astro
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { Image } from 'astro:assets';
import mascotImg from '../assets/craiyon.png';

const days = [
  { day: "Sen", date: "19", full: "Senin, 19 Okt", active: false },
  { day: "Sel", date: "20", full: "Selasa, 20 Okt", active: false },
  { day: "Rab", date: "21", full: "Rabu, 21 Okt", active: false },
  { day: "Kam", date: "22", full: "Kamis, 22 Okt", active: false },
  { day: "Jum", date: "23", full: "Jumat, 23 Okt", active: false },
  { day: "Sab", date: "24", full: "Sabtu, 24 Okt", active: true },
  { day: "Min", date: "25", full: "Minggu, 25 Okt", active: false }
];
---

<DashboardLayout title="Jadwal & Time Blocking" activeNav="jadwal">
  <div class="jadwal-page-wrap">
    <!-- Top Bar with Month & Summary Stats -->
    <div class="jadwal-header">
      <div>
        <h1 class="page-title">Jadwal Kalender</h1>
        <span class="month-pill">Oktober 2026</span>
      </div>

      <!-- Quick Metrics from Figma -->
      <div class="stats-row">
        <div class="stat-pill pending-stat">
          <span class="stat-lbl">Tertunda</span>
          <span class="stat-val">2 Tugas</span>
        </div>
        <div class="stat-pill worktime-stat">
          <span class="stat-lbl">Waktu kerja</span>
          <span class="stat-val">270 mnt</span>
        </div>
      </div>
    </div>

    <!-- Warning / Alert Bar from Figma -->
    <div class="alert-conflict-bar">
      <div class="alert-left">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#b45309" stroke-width="2.5"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
        <span><strong>Perhatian:</strong> 1 tugas tidak muat di slot waktu hari ini.</span>
      </div>
      <button id="btn-see-options" class="btn-alert-action">Lihat Opsi AI</button>
    </div>

    <!-- Day Selector Strip (Figma Match) -->
    <div class="days-strip">
      {days.map((item) => (
        <button class={`day-card ${item.active ? 'active' : ''}`} data-day={item.full}>
          <span class="day-name">{item.day}</span>
          <span class="day-number">{item.date}</span>
          {item.active && <span class="active-dot"></span>}
        </button>
      ))}
    </div>

    <!-- Desktop 2-Column Schedule Grid: Time Blocks (Left) + Waktu Luang Management (Right) -->
    <div class="schedule-desktop-grid">
      <!-- Left Column: Detailed Time Schedule Blocks -->
      <div class="timeline-blocks-col">
        <div class="panel-card">
          <div class="panel-header">
            <h3 class="panel-title">Jadwal Hari Ini · <span id="active-day-label">Sabtu, 24 Okt</span></h3>
            <span class="badge-total-slots">4 Sesi Terjadwal</span>
          </div>

          <!-- Schedule Blocks List -->
          <div class="time-block-list">
            <!-- Block 1 -->
            <div class="time-block-card focus">
              <div class="block-indicator"></div>
              <div class="block-time">
                <span class="time-range">10.00 - 12.00</span>
                <span class="duration-tag">120 mnt</span>
              </div>
              <div class="block-info">
                <div class="block-title-row">
                  <h4 class="block-title">Fokus: Pemrograman Web & API</h4>
                  <span class="chip-cat chip-akademik">Akademik</span>
                </div>
                <p class="block-notes">Implementasi endpoint auth dan database schema integration.</p>
              </div>
              <div class="block-actions">
                <button class="btn-slot-done" title="Selesai">✓</button>
              </div>
            </div>

            <!-- Block 2 -->
            <div class="time-block-card class">
              <div class="block-indicator"></div>
              <div class="block-time">
                <span class="time-range">15.00 - 16.30</span>
                <span class="duration-tag">90 mnt</span>
              </div>
              <div class="block-info">
                <div class="block-title-row">
                  <h4 class="block-title">Laporan Praktikum Pemrograman</h4>
                  <span class="chip-cat chip-akademik">Akademik</span>
                </div>
                <p class="block-notes">Tenggat dekat hari ini jam 17.00. Butuh fokus tanpa gangguan.</p>
              </div>
              <div class="block-actions">
                <button class="btn-slot-done">✓</button>
              </div>
            </div>

            <!-- Block 3 -->
            <div class="time-block-card work">
              <div class="block-indicator"></div>
              <div class="block-time">
                <span class="time-range">19.00 - 20.00</span>
                <span class="duration-tag">60 mnt</span>
              </div>
              <div class="block-info">
                <div class="block-title-row">
                  <h4 class="block-title">Slide Presentasi Kelompok</h4>
                  <span class="chip-cat chip-kerja">Kerja / Tim</span>
                </div>
                <p class="block-notes">Review deck Figma dan latihan alur presentasi.</p>
              </div>
              <div class="block-actions">
                <button class="btn-slot-done">✓</button>
              </div>
            </div>

            <!-- Block 4 -->
            <div class="time-block-card done">
              <div class="block-indicator"></div>
              <div class="block-time">
                <span class="time-range">08.00 - 09.00</span>
                <span class="duration-tag">60 mnt</span>
              </div>
              <div class="block-info">
                <div class="block-title-row">
                  <h4 class="block-title" style="text-decoration: line-through; opacity: 0.7;">Riset Pasar & Referensi Desain</h4>
                  <span class="chip-cat chip-done">Selesai</span>
                </div>
                <p class="block-notes">Benchmarking fitur kompetitor telah dirangkum ke Notion.</p>
              </div>
              <div class="block-actions">
                <span class="badge-checked">✓ Selesai</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Waktu Luang Management (From Figma Frame 153:1004) -->
      <div class="waktu-luang-col">
        <div class="panel-card">
          <div class="panel-header">
            <h3 class="panel-title">Waktu Luang Saya</h3>
            <button id="btn-add-slot" class="btn-text-link">+ Tambah Slot</button>
          </div>

          <p class="waktu-luang-desc">
            Slot kosong yang dapat digunakan AI Beavy untuk menyisipkan sesi belajar atau pengerjaan tugas.
          </p>

          <!-- Slot list from Figma -->
          <div class="slot-chips-list">
            <div class="slot-chip">
              <div class="slot-chip-info">
                <span class="slot-chip-time">08.00 - 10.00</span>
                <span class="slot-chip-tag">Pagi • 2 jam</span>
              </div>
              <button class="btn-remove-slot" title="Hapus">✕</button>
            </div>

            <div class="slot-chip">
              <div class="slot-chip-info">
                <span class="slot-chip-time">15.00 - 17.30</span>
                <span class="slot-chip-tag">Sore • 2.5 jam</span>
              </div>
              <button class="btn-remove-slot">✕</button>
            </div>

            <div class="slot-chip">
              <div class="slot-chip-info">
                <span class="slot-chip-time">19.00 - 21.00</span>
                <span class="slot-chip-tag">Malam • 2 jam</span>
              </div>
              <button class="btn-remove-slot">✕</button>
            </div>
          </div>

          <!-- Kegiatan Tetap from Figma -->
          <div class="fixed-routines-section">
            <h4 class="fixed-title">Kegiatan Tetap (Non-Negotiable)</h4>
            
            <div class="routine-item">
              <div>
                <strong>Kuliah Basis Data</strong>
                <span>10.00 - 12.00 • Ruang Lab 3</span>
              </div>
              <span class="lock-badge">🔒 Terkunci</span>
            </div>

            <div class="routine-item">
              <div>
                <strong>Rapat Himpunan</strong>
                <span>13.00 - 14.30 • Online Meet</span>
              </div>
              <span class="lock-badge">🔒 Terkunci</span>
            </div>
          </div>

          <!-- Bottom Actions -->
          <div class="waktu-luang-footer">
            <button class="btn-outline-action" id="btn-copy-days">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <span>Salin ke hari lain</span>
            </button>
            <button class="btn-save-schedule" id="btn-auto-schedule">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l2.4 7.2L22 12l-7.6 2.8L12 22l-2.8-7.2L2 12l7.2-2.8z"></path></svg>
              <span>Simpan & Buat Jadwal Otomatis</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    .jadwal-page-wrap {
      display: flex;
      flex-direction: column;
      gap: 1.6rem;
    }

    .jadwal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .page-title {
      font-size: 2.2rem;
      font-weight: 800;
      color: #201438;
      display: inline-block;
      margin-right: 0.8rem;
    }

    .month-pill {
      font-size: 0.85rem;
      font-weight: 700;
      color: #7c3aed;
      background: #ede9fe;
      padding: 0.35rem 0.85rem;
      border-radius: var(--radius-full);
      display: inline-block;
      vertical-align: middle;
    }

    .stats-row {
      display: flex;
      gap: 0.8rem;
    }

    .stat-pill {
      background: rgba(255, 255, 255, 0.9);
      border: 1px solid rgba(255, 255, 255, 0.9);
      padding: 0.6rem 1.2rem;
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      min-width: 110px;
    }

    .stat-lbl {
      font-size: 0.72rem;
      font-weight: 700;
      color: #7f7298;
      text-transform: uppercase;
    }

    .stat-val {
      font-size: 1.25rem;
      font-weight: 800;
      color: #23163d;
    }

    .pending-stat .stat-val { color: #dc2626; }
    .worktime-stat .stat-val { color: #8b5cf6; }

    /* Alert Conflict Bar */
    .alert-conflict-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: linear-gradient(135deg, #fef3c7 0%, #fffbeb 100%);
      border: 1.5px solid #fde68a;
      border-radius: var(--radius-md);
      padding: 0.85rem 1.4rem;
      box-shadow: 0 4px 14px rgba(245, 158, 11, 0.1);
    }

    .alert-left {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      font-size: 0.92rem;
      color: #92400e;
    }

    .btn-alert-action {
      background: #f59e0b;
      color: white;
      border: none;
      font-size: 0.82rem;
      font-weight: 700;
      padding: 0.5rem 1.1rem;
      border-radius: var(--radius-full);
      box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);
      transition: transform 0.2s;
    }

    .btn-alert-action:hover {
      transform: translateY(-2px);
    }

    /* Days Strip */
    .days-strip {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 0.8rem;
    }

    .day-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 0.9rem 0.5rem;
      background: rgba(255, 255, 255, 0.8);
      border: 1.5px solid rgba(255, 255, 255, 0.9);
      border-radius: var(--radius-md);
      transition: all 0.2s;
      position: relative;
    }

    .day-card:hover {
      background: white;
      transform: translateY(-3px);
      box-shadow: var(--shadow-sm);
    }

    .day-card.active {
      background: linear-gradient(135deg, #a855f7 0%, #8b5cf6 100%);
      border-color: #8b5cf6;
      box-shadow: 0 8px 20px rgba(139, 92, 246, 0.35);
    }

    .day-name {
      font-size: 0.82rem;
      font-weight: 700;
      color: #796c92;
      margin-bottom: 0.2rem;
    }

    .day-card.active .day-name {
      color: rgba(255, 255, 255, 0.85);
    }

    .day-number {
      font-size: 1.35rem;
      font-weight: 800;
      color: #251740;
    }

    .day-card.active .day-number {
      color: white;
    }

    .active-dot {
      width: 5px;
      height: 5px;
      background: white;
      border-radius: 50%;
      margin-top: 0.3rem;
    }

    /* Grid Layout */
    .schedule-desktop-grid {
      display: grid;
      grid-template-columns: 1.25fr 0.85fr;
      gap: 1.8rem;
      align-items: start;
    }

    .panel-card {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.9);
      border-radius: var(--radius-lg);
      padding: 1.8rem;
      box-shadow: var(--shadow-sm);
    }

    .panel-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.4rem;
    }

    .panel-title {
      font-size: 1.2rem;
      font-weight: 800;
      color: #21143a;
    }

    .badge-total-slots {
      background: #f3e8ff;
      color: #7c3aed;
      font-size: 0.78rem;
      font-weight: 700;
      padding: 0.25rem 0.7rem;
      border-radius: var(--radius-full);
    }

    /* Time Block Cards */
    .time-block-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .time-block-card {
      display: flex;
      align-items: center;
      gap: 1.2rem;
      padding: 1.1rem 1.3rem;
      background: #fbf9fe;
      border: 1px solid #ede5f8;
      border-radius: var(--radius-md);
      transition: transform 0.2s, box-shadow 0.2s;
      position: relative;
    }

    .time-block-card:hover {
      transform: translateX(4px);
      box-shadow: 0 6px 18px rgba(70, 30, 110, 0.06);
    }

    .time-block-card.focus { border-left: 5px solid #8b5cf6; }
    .time-block-card.class { border-left: 5px solid #3b82f6; }
    .time-block-card.work { border-left: 5px solid #f59e0b; }
    .time-block-card.done { border-left: 5px solid #10b981; opacity: 0.75; }

    .block-time {
      display: flex;
      flex-direction: column;
      min-width: 95px;
    }

    .time-range {
      font-size: 0.88rem;
      font-weight: 800;
      color: #2b1c48;
    }

    .duration-tag {
      font-size: 0.72rem;
      color: #87789f;
      font-weight: 600;
    }

    .block-info {
      flex: 1;
    }

    .block-title-row {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      margin-bottom: 0.25rem;
    }

    .block-title {
      font-size: 0.98rem;
      font-weight: 800;
      color: #23153c;
    }

    .chip-cat {
      font-size: 0.68rem;
      font-weight: 700;
      padding: 0.15rem 0.55rem;
      border-radius: 6px;
    }

    .chip-akademik { background: #ede9fe; color: #7c3aed; }
    .chip-kerja { background: #fef3c7; color: #d97706; }
    .chip-done { background: #dcfce7; color: #15803d; }

    .block-notes {
      font-size: 0.78rem;
      color: #76698f;
      line-height: 1.35;
    }

    .btn-slot-done {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      border: 1.5px solid #cfc2e5;
      background: white;
      color: #8b5cf6;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
    }

    .btn-slot-done:hover {
      background: #10b981;
      border-color: #10b981;
      color: white;
    }

    .badge-checked {
      font-size: 0.78rem;
      font-weight: 700;
      color: #16a34a;
    }

    /* Waktu Luang Management */
    .btn-text-link {
      background: none;
      border: none;
      color: #8b5cf6;
      font-weight: 700;
      font-size: 0.85rem;
    }

    .waktu-luang-desc {
      font-size: 0.82rem;
      color: #75678d;
      margin-bottom: 1.2rem;
      line-height: 1.4;
    }

    .slot-chips-list {
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
      margin-bottom: 1.6rem;
    }

    .slot-chip {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #f7f4fc;
      border: 1px dashed #d5c8ea;
      padding: 0.75rem 1rem;
      border-radius: var(--radius-md);
    }

    .slot-chip-time {
      font-size: 0.92rem;
      font-weight: 800;
      color: #271a41;
      display: block;
    }

    .slot-chip-tag {
      font-size: 0.72rem;
      color: #8b7d9f;
      font-weight: 600;
    }

    .btn-remove-slot {
      background: none;
      border: none;
      color: #b0a3c7;
      font-size: 0.9rem;
      padding: 0.3rem;
      border-radius: 6px;
    }

    .btn-remove-slot:hover {
      color: #dc2626;
      background: #fee2e2;
    }

    /* Fixed Routines */
    .fixed-routines-section {
      border-top: 1px solid #f0e8f8;
      padding-top: 1.2rem;
      margin-bottom: 1.6rem;
    }

    .fixed-title {
      font-size: 0.85rem;
      font-weight: 800;
      color: #3b2b5a;
      margin-bottom: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .routine-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.7rem 0.9rem;
      background: #fdfcff;
      border: 1px solid #ede7f6;
      border-radius: 10px;
      margin-bottom: 0.5rem;
    }

    .routine-item strong {
      font-size: 0.88rem;
      color: #22153b;
      display: block;
    }

    .routine-item span {
      font-size: 0.75rem;
      color: #7b6d95;
    }

    .lock-badge {
      font-size: 0.7rem !important;
      color: #6d5b88 !important;
      background: #ede9f4;
      padding: 0.25rem 0.6rem;
      border-radius: var(--radius-full);
      font-weight: 700;
    }

    /* Bottom Actions */
    .waktu-luang-footer {
      display: flex;
      flex-direction: column;
      gap: 0.7rem;
    }

    .btn-outline-action {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.75rem;
      border: 1.5px solid #cfc1e6;
      background: white;
      color: #5d4d7c;
      font-size: 0.85rem;
      font-weight: 700;
      border-radius: var(--radius-full);
      transition: all 0.2s;
    }

    .btn-outline-action:hover {
      border-color: #8b5cf6;
      color: #8b5cf6;
    }

    .btn-save-schedule {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      padding: 0.85rem;
      border: none;
      background: linear-gradient(135deg, #a855f7, #8b5cf6);
      color: white;
      font-size: 0.9rem;
      font-weight: 700;
      border-radius: var(--radius-full);
      box-shadow: 0 6px 18px rgba(139, 92, 246, 0.35);
      transition: transform 0.2s;
    }

    .btn-save-schedule:hover {
      transform: translateY(-2px);
    }

    @media (max-width: 1024px) {
      .schedule-desktop-grid {
        grid-template-columns: 1fr;
      }
      .days-strip {
        overflow-x: auto;
        padding-bottom: 0.5rem;
      }
    }
  </style>

  <script>
    // Day Selector
    const dayCards = document.querySelectorAll('.day-card');
    const activeDayLabel = document.getElementById('active-day-label');

    dayCards.forEach(card => {
      card.addEventListener('click', () => {
        dayCards.forEach(c => c.classList.remove('active'));
        card.classList.add('active');
        const fullDay = card.getAttribute('data-day');
        if (activeDayLabel && fullDay) {
          activeDayLabel.textContent = fullDay;
        }
      });
    });

    // Alert Options
    document.getElementById('btn-see-options')?.addEventListener('click', () => {
      alert('Saran Beavy AI: Pindahkan sesi "Slide Presentasi" 30 menit lebih awal atau pecah menjadi 2 sesi agar seluruh tugas muat tanpa lembur!');
    });

    // Add slot
    document.getElementById('btn-add-slot')?.addEventListener('click', () => {
      const slot = prompt('Masukkan rentang waktu luang baru (contoh: 13.00 - 14.30):');
      if (slot) {
        alert(`Slot luang "${slot}" berhasil ditambahkan ke kalender!`);
      }
    });

    // Copy to other days
    document.getElementById('btn-copy-days')?.addEventListener('click', () => {
      alert('Slot waktu luang berhasil disalin ke hari Senin - Jumat!');
    });

    // Auto schedule
    document.getElementById('btn-auto-schedule')?.addEventListener('click', () => {
      alert('Jadwal baru berhasil disusun otomatis dengan AI Beavy!');
    });
  </script>
</DashboardLayout>
