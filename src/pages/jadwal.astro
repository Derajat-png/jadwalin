---
// src/pages/jadwal.astro
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { Image } from 'astro:assets';
import mascotImg from '../assets/craiyon.png';

const days = [
  { day: "Sen", date: "19", full: "Senin, 19 Okt", active: false },
  { day: "Sel", date: "20", full: "Selasa, 20 Okt", active: false },
  { day: "Rab", date: "21", full: "Rabu, 21 Okt", active: false },
  { day: "Kam", date: "22", full: "Kamis, 22 Okt", active: false },
  { day: "Jum", date: "23", full: "Jumat, 23 Okt", active: false },
  { day: "Sab", date: "24", full: "Sabtu, 24 Okt", active: true },
  { day: "Min", date: "25", full: "Minggu, 25 Okt", active: false }
];
---

<DashboardLayout title="Jadwal : Time Blocking" activeNav="jadwal">
  <div class="sanctuary-wrap">

    <!-- 1. EDITORIAL HEADER -->
    <header class="schedule-hero">
      <div class="hero-left">
        <h1 class="hero-statement">
          Alokasi waktu & ritme harian:<br />
          <span class="hero-highlight">Sabtu, 24 Oktober 2026</span>
        </h1>
        <p class="hero-sub">
          Total <strong>270 menit</strong> sesi fokus aktif dengan jeda istirahat terproteksi untuk mencegah kelelahan kognitif.
        </p>
      </div>

      <div class="hero-right">
        <div class="ambient-pill">
          <span class="dot-indicator"></span>
          <span>Kapasitas Kerja Terkendali (94%)</span>
        </div>
      </div>
    </header>

    <!-- 2. CALENDAR DAYS STRIP -->
    <nav class="days-nav-strip" aria-label="Pilih Hari">
      {days.map((item) => (
        <button type="button" class={`day-item-btn ${item.active ? 'active' : ''}`} data-day={item.full} aria-pressed={item.active ? 'true' : 'false'}>
          <span class="day-code">{item.day}</span>
          <span class="day-num">{item.date}</span>
        </button>
      ))}
    </nav>

    <!-- 3. MAIN WORKSPACE GRID: Time Flow (Left) + Protected Leisure & Routines (Right) -->
    <div class="schedule-grid">

      <!-- LEFT: The Daily Time-Block Sequence -->
      <section class="flow-surface">
        <div class="surface-header">
          <div>
            <h2 class="surface-title">Urutan Sesi Hari Ini</h2>
            <p class="surface-caption">Blok fokus dioptimalkan berdasarkan kurva energi belajar</p>
          </div>
          <span class="count-tag">4 Blok Terjadwal</span>
        </div>

        <div class="blocks-sequence">
          <!-- Block 1 -->
          <article class="block-row active-block">
            <div class="block-time-col">
              <time class="time-range">10.00 - 12.00</time>
              <span class="time-badge">120 mnt</span>
            </div>
            <div class="block-card">
              <div class="block-head">
                <span class="category-chip academic">Akademik</span>
                <button type="button" class="btn-check-slot" title="Tandai Selesai" aria-label="Tandai sesi selesai" onclick="
                  const row = this.closest('.block-row');
                  row.classList.toggle('is-done');
                  (window).jadwalinToast('Sesi Selesai', 'Sesi pemrograman web telah dicatat.', 'success', {
                    label: 'Urungkan',
                    onClick: () => row.classList.toggle('is-done')
                  });
                ">
                  <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </button>
              </div>
              <h3 class="block-name">Fokus: Pemrograman Web & API</h3>
              <p class="block-notes">Implementasi endpoint auth JWT dan validasi schema database PostgreSQL.</p>
            </div>
          </article>

          <!-- Block 2 -->
          <article class="block-row">
            <div class="block-time-col">
              <time class="time-range">12.30 - 13.30</time>
              <span class="time-badge">60 mnt</span>
            </div>
            <div class="block-card break-card">
              <div class="block-head">
                <span class="category-chip break">Jeda Rehat</span>
              </div>
              <h3 class="block-name muted">Istirahat Siang & Makan</h3>
              <p class="block-notes">Rehat bebas layar untuk menjaga fokus dan energi mental sesi siang.</p>
            </div>
          </article>

          <!-- Block 3 -->
          <article class="block-row">
            <div class="block-time-col">
              <time class="time-range">15.00 - 16.30</time>
              <span class="time-badge">90 mnt</span>
            </div>
            <div class="block-card">
              <div class="block-head">
                <span class="category-chip academic">Praktikum</span>
                <button type="button" class="btn-check-slot" title="Tandai Selesai" aria-label="Tandai sesi selesai" onclick="
                  const row = this.closest('.block-row');
                  row.classList.toggle('is-done');
                  (window).jadwalinToast('Sesi Selesai', 'Sesi praktikum telah dicatat.', 'success', {
                    label: 'Urungkan',
                    onClick: () => row.classList.toggle('is-done')
                  });
                ">
                  <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </button>
              </div>
              <h3 class="block-name">Laporan Praktikum Sistem Informasi</h3>
              <p class="block-notes">Analisis query join relasional dan diagram alur data modul 3.</p>
            </div>
          </article>

          <!-- Block 4 -->
          <article class="block-row">
            <div class="block-time-col">
              <time class="time-range">19.00 - 20.00</time>
              <span class="time-badge">60 mnt</span>
            </div>
            <div class="block-card">
              <div class="block-head">
                <span class="category-chip collab">Kelompok</span>
                <button type="button" class="btn-check-slot" title="Tandai Selesai" aria-label="Tandai sesi selesai" onclick="
                  const row = this.closest('.block-row');
                  row.classList.toggle('is-done');
                  (window).jadwalinToast('Sesi Selesai', 'Sesi kelompok telah dicatat.', 'success', {
                    label: 'Urungkan',
                    onClick: () => row.classList.toggle('is-done')
                  });
                ">
                  <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </button>
              </div>
              <h3 class="block-name">Slide Presentasi Kelompok</h3>
              <p class="block-notes">Penyusunan materi slide presentasi akhir dan pembagian peran bicara.</p>
            </div>
          </article>
        </div>
      </section>

      <!-- RIGHT: Waktu Luang & Protected Routines -->
      <aside class="side-flow-col">

        <!-- Protected Leisure Surface -->
        <div class="side-surface leisure-box">
          <div class="side-surface-head">
            <h3 class="side-title">Slot Bebas Terproteksi</h3>
            <span class="time-avail-badge">120 Menit Tersedia</span>
          </div>
          <p class="side-desc">
            Slot waktu luang ini sengaja dikunci oleh AI Beavy agar Anda tetap memiliki ruang bernapas.
          </p>

          <div class="leisure-chips">
            <div class="l-chip">
              <span class="l-hour">13.30 - 14.30</span>
              <span class="l-tag">Olahraga Ringan</span>
            </div>
            <div class="l-chip">
              <span class="l-hour">17.30 - 18.30</span>
              <span class="l-tag">Waktu Bebas Sore</span>
            </div>
          </div>
        </div>

        <!-- Fixed Daily Routines -->
        <div class="side-surface routines-box">
          <h3 class="side-title">Rutinitas Harian Baku</h3>
          <p class="side-desc">Jadwal tetap yang tidak digeser oleh algoritma prioritas.</p>

          <ul class="routines-list">
            <li class="routine-row">
              <span class="routine-name">Kuliah Teori Pemrograman</span>
              <time class="routine-clock">07.30 - 09.30</time>
            </li>
            <li class="routine-row">
              <span class="routine-name">Praktikum Sistem Informasi</span>
              <time class="routine-clock">13.00 - 15.00</time>
            </li>
          </ul>
        </div>

        <!-- Beavy Calendar Advice -->
        <div class="side-surface companion-card">
          <div class="companion-head">
            <div class="companion-avatar-wrap">
              <Image src={mascotImg} alt="Beavy" class="c-avatar-img" />
            </div>
            <div>
              <h4 class="c-title">Keseimbangan Ritme</h4>
              <p class="c-desc">Kapasitas belajar Sabtu Anda berada di zona optimal. Tidak perlu lembur malam ini.</p>
            </div>
          </div>
        </div>

      </aside>

    </div>

  </div>

  <style>
    /* =========================================================
       AWWWARDS EDITORIAL TIME-BLOCKING STYLES
       Quiet, Structured, Unnested Container Layers
       ========================================================= */

    :focus-visible {
      outline: 2px solid var(--color-primary);
      outline-offset: 2px;
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }

    .sanctuary-wrap {
      max-width: 1240px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 2.2rem;
      padding-bottom: 3rem;
    }

    /* 1. EDITORIAL HEADER */
    .schedule-hero {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 2rem;
      padding: 1.5rem 0 0.5rem;
      border-bottom: 1px solid var(--color-border-subtle);
    }

    .hero-statement {
      font-size: 2.2rem;
      font-weight: 800;
      color: var(--color-text-main);
      line-height: 1.2;
      letter-spacing: -0.025em;
    }

    .hero-highlight {
      color: var(--color-primary-dark);
    }

    .hero-sub {
      font-size: 0.95rem;
      color: var(--color-text-muted);
      line-height: 1.6;
      margin-top: 0.6rem;
      max-width: 650px;
    }

    .ambient-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--color-text-muted);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      padding: 0.45rem 1rem;
      border-radius: var(--radius-full);
      box-shadow: var(--shadow-xs);
    }

    .dot-indicator {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--color-success);
    }

    /* 2. CALENDAR DAYS STRIP */
    .days-nav-strip {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 0.75rem;
    }

    .day-item-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 0.95rem 0.5rem;
      border-radius: var(--radius-lg);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      cursor: pointer;
      box-shadow: var(--shadow-xs);
      transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
    }

    .day-item-btn:hover {
      border-color: var(--color-border-focus);
      transform: translateY(-2px);
    }

    .day-item-btn.active {
      background: var(--color-primary-light);
      border-color: var(--color-primary);
    }

    .day-code {
      font-size: 0.76rem;
      font-weight: 600;
      color: var(--color-text-muted);
    }

    .day-item-btn.active .day-code {
      color: var(--color-primary-dark);
      font-weight: 700;
    }

    .day-num {
      font-family: var(--font-mono);
      font-size: 1.35rem;
      font-weight: 800;
      color: var(--color-text-main);
      margin-top: 0.2rem;
    }

    .day-item-btn.active .day-num {
      color: var(--color-primary-dark);
    }

    /* 3. ASYMMETRIC GRID */
    .schedule-grid {
      display: grid;
      grid-template-columns: 1.4fr 0.8fr;
      gap: 2rem;
      align-items: start;
    }

    .flow-surface, .side-surface {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
      padding: 1.8rem;
      box-shadow: var(--shadow-xs);
    }

    .surface-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 1.6rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--color-border-subtle);
    }

    .surface-title {
      font-size: 1.25rem;
      font-weight: 800;
      color: var(--color-text-main);
    }

    .surface-caption {
      font-size: 0.8rem;
      color: var(--color-text-muted);
      margin-top: 0.2rem;
    }

    .count-tag {
      font-size: 0.74rem;
      font-weight: 700;
      color: var(--color-text-muted);
      background: var(--color-canvas);
      padding: 0.25rem 0.65rem;
      border-radius: var(--radius-full);
    }

    /* TIME-BLOCKS SEQUENCE (ONE Containment Layer, Zero Clutter) */
    .blocks-sequence {
      display: flex;
      flex-direction: column;
      gap: 1.1rem;
    }

    .block-row {
      display: flex;
      gap: 1.2rem;
      transition: opacity 0.2s ease;
    }

    .block-row.is-done {
      opacity: 0.45;
      filter: grayscale(50%);
    }

    .block-time-col {
      min-width: 105px;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      padding-top: 0.35rem;
    }

    .time-range {
      font-family: var(--font-mono);
      font-size: 0.88rem;
      font-weight: 700;
      color: var(--color-text-main);
    }

    .time-badge {
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--color-text-muted);
      margin-top: 0.2rem;
    }

    .block-card {
      flex: 1;
      background: var(--color-surface-subtle);
      border: 1px solid var(--color-border-subtle);
      border-radius: var(--radius-lg);
      padding: 1.1rem 1.3rem;
      transition: border-color 0.15s ease, background-color 0.15s ease;
    }

    .active-block .block-card {
      background: var(--color-primary-light);
      border-color: var(--color-border-focus);
    }

    .break-card {
      background: transparent;
      border-style: dashed;
    }

    .block-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.5rem;
    }

    .category-chip {
      font-size: 0.7rem;
      font-weight: 700;
      padding: 0.2rem 0.55rem;
      border-radius: var(--radius-full);
    }

    .category-chip.academic {
      background: var(--color-surface);
      color: var(--color-primary-dark);
      border: 1px solid var(--color-border);
    }

    .category-chip.break {
      background: var(--color-surface);
      color: var(--color-text-muted);
      border: 1px solid var(--color-border);
    }

    .category-chip.collab {
      background: var(--color-warning-bg);
      color: var(--color-warning);
      border: 1px solid var(--color-warning-border);
    }

    .block-name {
      font-size: 0.98rem;
      font-weight: 800;
      color: var(--color-text-main);
      line-height: 1.3;
    }

    .block-name.muted {
      color: var(--color-text-muted);
      font-weight: 600;
    }

    .block-notes {
      font-size: 0.82rem;
      color: var(--color-text-body);
      line-height: 1.5;
      margin-top: 0.35rem;
    }

    .btn-check-slot {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      border: 1px solid var(--color-border);
      background: var(--color-surface);
      color: var(--color-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
    }

    .btn-check-slot:hover {
      background: var(--color-success);
      color: var(--color-surface);
      border-color: var(--color-success);
      transform: scale(1.08);
    }

    /* RIGHT COLUMN STACK */
    .side-flow-col {
      display: flex;
      flex-direction: column;
      gap: 1.8rem;
    }

    .side-surface-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.4rem;
    }

    .side-title {
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--color-text-main);
    }

    .side-desc {
      font-size: 0.78rem;
      color: var(--color-text-muted);
      line-height: 1.5;
      margin-bottom: 1.1rem;
    }

    .time-avail-badge {
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--color-success);
      background: var(--color-success-bg);
      padding: 0.2rem 0.55rem;
      border-radius: var(--radius-full);
    }

    .leisure-chips {
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }

    .l-chip {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.75rem 0.95rem;
      border-radius: var(--radius-md);
      background: var(--color-surface-subtle);
      border: 1px solid var(--color-border-subtle);
    }

    .l-hour {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--color-text-main);
    }

    .l-tag {
      font-size: 0.74rem;
      font-weight: 600;
      color: var(--color-text-muted);
    }

    /* Routines List */
    .routines-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }

    .routine-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.75rem 0.95rem;
      border-radius: var(--radius-md);
      background: var(--color-surface-subtle);
      border: 1px solid var(--color-border-subtle);
    }

    .routine-name {
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--color-text-main);
    }

    .routine-clock {
      font-family: var(--font-mono);
      font-size: 0.76rem;
      font-weight: 600;
      color: var(--color-text-muted);
    }

    /* Companion card */
    .companion-head {
      display: flex;
      align-items: center;
      gap: 0.9rem;
    }

    .companion-avatar-wrap {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: var(--color-primary-light);
      border: 1px solid var(--color-border-focus);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .c-avatar-img {
      width: 28px;
      height: 28px;
      object-fit: contain;
    }

    .c-title {
      font-size: 0.84rem;
      font-weight: 800;
      color: var(--color-text-main);
    }

    .c-desc {
      font-size: 0.74rem;
      color: var(--color-text-muted);
      line-height: 1.4;
      margin-top: 0.15rem;
    }

    @media (max-width: 1040px) {
      .schedule-grid {
        grid-template-columns: 1fr;
      }
      .schedule-hero {
        flex-direction: column;
        align-items: flex-start;
      }
      .days-nav-strip {
        overflow-x: auto;
        padding-bottom: 0.5rem;
      }
    }
  </style>
</DashboardLayout>
