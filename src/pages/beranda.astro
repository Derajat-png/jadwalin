---
// src/pages/beranda.astro
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { Image } from 'astro:assets';
import mascotImg from '../assets/craiyon.png';
---

<DashboardLayout title="Beranda" activeNav="beranda">
  <div class="dashboard-wrap">
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-text">
        <span class="hero-greeting">Selamat pagi</span>
        <h1 class="hero-title">Apa yang perlu kamu<br />kerjakan hari ini?</h1>
      </div>

      <!-- Quick Metrics Counter -->
      <div class="metrics-grid">
        <div class="metric-card active-tasks">
          <div class="metric-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
          </div>
          <div class="metric-info">
            <span class="metric-num">5</span>
            <span class="metric-label">Tugas aktif</span>
          </div>
        </div>

        <div class="metric-card urgent-tasks">
          <div class="metric-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          </div>
          <div class="metric-info">
            <span class="metric-num">2</span>
            <span class="metric-label">Mendekati deadline</span>
          </div>
        </div>

        <div class="metric-card today-sessions">
          <div class="metric-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
          </div>
          <div class="metric-info">
            <span class="metric-num">3</span>
            <span class="metric-label">Sesi hari ini</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Desktop 2-Column Core Layout -->
    <div class="desktop-main-grid">
      <!-- LEFT COLUMN: Prioritas Utama & Sesi -->
      <div class="left-col">
        <!-- Card 1: Prioritas Teratas (Figma Match) -->
        <div class="priority-highlight-card">
          <div class="card-top-row">
            <span class="kicker-tag">PRIORITAS TERATAS</span>
            <span class="badge-critical">Kritis</span>
          </div>

          <h2 class="task-highlight-title">Laporan Praktikum Pemrograman</h2>

          <div class="countdown-badge">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            <span>Sisa 1 hari 4 jam</span>
          </div>

          <p class="task-highlight-desc">
            Deadline paling dekat dan durasi paling panjang (estimasi 2 jam). Jadi syarat sebelum tugas proyek berikutnya!
          </p>

          <div class="card-footer-action">
            <a href="/prioritas" class="btn-highlight-action">
              <span>Mulai Kerjakan Sesi Ini</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
          </div>
        </div>

        <!-- Card 2: Beavy's AI Tip Card (Figma Match) -->
        <div class="beavy-recommendation-card">
          <div class="beavy-rec-header">
            <div class="beavy-avatar-frame">
              <Image src={mascotImg} alt="Beavy" class="beavy-rec-img" />
            </div>
            <div>
              <h3 class="beavy-rec-title">Tips dari Beavy nih!</h3>
              <p class="beavy-rec-text">
                Slot terbaikmu hari ini adalah <strong>jam 10.00 - 12.00</strong>.<br />
                Sangat cocok untuk tugas yang membutuhkan konsentrasi sulit.
              </p>
            </div>
          </div>
          <div class="beavy-rec-action">
            <a href="/beavy-ai" class="btn-ask-beavy-inline">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
              <span>Diskusi dengan Beavy</span>
            </a>
          </div>
        </div>

        <!-- Card 3: Sesi Berikutnya -->
        <div class="sessions-card">
          <div class="section-header-row">
            <h3 class="section-title">Sesi Berikutnya</h3>
            <a href="/jadwal" class="link-see-all">Lihat semua</a>
          </div>

          <div class="session-item active">
            <div class="time-block">
              <span class="session-time">10.00</span>
              <span class="session-duration">120 mnt</span>
            </div>
            <div class="session-detail">
              <span class="session-name">Fokus: Pemrograman Web & API</span>
              <span class="session-status start-soon">Mulai dalam 32 menit</span>
            </div>
            <div class="session-action">
              <button class="btn-check-session" title="Selesaikan Sesi">✓</button>
            </div>
          </div>

          <div class="session-item">
            <div class="time-block">
              <span class="session-time">15.00</span>
              <span class="session-duration">90 mnt</span>
            </div>
            <div class="session-detail">
              <span class="session-name">Laporan Praktikum Sistem Informasi</span>
              <span class="session-status upcoming">Siang nanti</span>
            </div>
            <div class="session-action">
              <button class="btn-check-session">✓</button>
            </div>
          </div>

          <div class="session-item">
            <div class="time-block">
              <span class="session-time">19.00</span>
              <span class="session-duration">60 mnt</span>
            </div>
            <div class="session-detail">
              <span class="session-name">Slide Presentasi Kelompok</span>
              <span class="session-status upcoming">Malam ini</span>
            </div>
            <div class="session-action">
              <button class="btn-check-session">✓</button>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: Aksi Cepat & Timeline Jadwal Hari Ini -->
      <div class="right-col">
        <!-- Aksi Cepat 4 Grid Buttons (Figma Match) -->
        <div class="quick-actions-card">
          <h3 class="section-title" style="margin-bottom: 1.2rem;">Aksi Cepat</h3>
          
          <div class="quick-actions-grid">
            <a href="/tambah-tugas" class="quick-action-btn action-add">
              <div class="qa-icon-wrap">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
              </div>
              <span class="qa-title">Tambah Tugas</span>
              <span class="qa-desc">Input manual</span>
            </a>

            <a href="/upload" class="quick-action-btn action-upload">
              <div class="qa-icon-wrap">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
              </div>
              <span class="qa-title">Upload Jadwal</span>
              <span class="qa-desc">PDF / Foto / AI</span>
            </a>

            <a href="/jadwal" class="quick-action-btn action-plan">
              <div class="qa-icon-wrap">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line></svg>
              </div>
              <span class="qa-title">Buat Jadwal</span>
              <span class="qa-desc">Time blocking</span>
            </a>

            <a href="/beavy-ai" class="quick-action-btn action-chat">
              <div class="qa-icon-wrap">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
              </div>
              <span class="qa-title">Tanya Beavy</span>
              <span class="qa-desc">Konsultasi AI</span>
            </a>
          </div>
        </div>

        <!-- Timeline Jadwal Hari Ini -->
        <div class="today-schedule-card">
          <div class="section-header-row">
            <h3 class="section-title">Timeline Hari Ini</h3>
            <span class="today-tag">Sabtu, 24 Okt</span>
          </div>

          <div class="timeline-container">
            <div class="timeline-slot done">
              <span class="timeline-hour">08:00</span>
              <div class="timeline-bar"></div>
              <div class="timeline-content">
                <h4>Persiapan & Daily Checkin</h4>
                <p>30 mnt • Selesai</p>
              </div>
            </div>

            <div class="timeline-slot current">
              <span class="timeline-hour">10:00</span>
              <div class="timeline-bar"></div>
              <div class="timeline-content">
                <h4>Fokus: Pemrograman Web & API</h4>
                <p>120 mnt • Sesi Produktif Utama</p>
              </div>
            </div>

            <div class="timeline-slot">
              <span class="timeline-hour">12:30</span>
              <div class="timeline-bar"></div>
              <div class="timeline-content">
                <h4>Istirahat Siang & Makan</h4>
                <p>60 mnt • Buffer Time</p>
              </div>
            </div>

            <div class="timeline-slot">
              <span class="timeline-hour">15:00</span>
              <div class="timeline-bar"></div>
              <div class="timeline-content">
                <h4>Praktikum Pemrograman</h4>
                <p>90 mnt • Akademik</p>
              </div>
            </div>

            <div class="timeline-slot">
              <span class="timeline-hour">19:00</span>
              <div class="timeline-bar"></div>
              <div class="timeline-content">
                <h4>Slide Presentasi Kelompok</h4>
                <p>60 mnt • Kolaborasi</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    .dashboard-wrap {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    /* Hero Section */
    .hero-section {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      flex-wrap: wrap;
      gap: 1.5rem;
    }

    .hero-greeting {
      font-size: 0.95rem;
      font-weight: 700;
      color: #8b5cf6;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      display: block;
      margin-bottom: 0.4rem;
    }

    .hero-title {
      font-size: 2.1rem;
      font-weight: 800;
      color: #201438;
      line-height: 1.25;
    }

    /* Metrics Grid */
    .metrics-grid {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .metric-card {
      display: flex;
      align-items: center;
      gap: 0.9rem;
      background: rgba(255, 255, 255, 0.88);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.8);
      padding: 0.85rem 1.4rem;
      border-radius: var(--radius-md);
      box-shadow: 0 4px 16px rgba(110, 50, 180, 0.05);
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .metric-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(110, 50, 180, 0.1);
    }

    .metric-icon {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .active-tasks .metric-icon {
      background: #ede9fe;
      color: #7c3aed;
    }

    .urgent-tasks .metric-icon {
      background: #fee2e2;
      color: #dc2626;
    }

    .today-sessions .metric-icon {
      background: #fef3c7;
      color: #d97706;
    }

    .metric-info {
      display: flex;
      flex-direction: column;
    }

    .metric-num {
      font-size: 1.55rem;
      font-weight: 800;
      color: #1f1435;
      line-height: 1.1;
    }

    .metric-label {
      font-size: 0.78rem;
      font-weight: 600;
      color: #7a6e92;
    }

    /* Desktop Main Grid */
    .desktop-main-grid {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 2rem;
      align-items: start;
    }

    .left-col, .right-col {
      display: flex;
      flex-direction: column;
      gap: 1.6rem;
    }

    /* Priority Highlight Card */
    .priority-highlight-card {
      background: linear-gradient(135deg, #ffffff 0%, #faf6fe 100%);
      border: 2px solid rgba(139, 92, 246, 0.2);
      border-radius: var(--radius-lg);
      padding: 1.8rem;
      box-shadow: var(--shadow-md);
      position: relative;
      overflow: hidden;
    }

    .priority-highlight-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 6px;
      height: 100%;
      background: linear-gradient(to bottom, #ef4444, #f59e0b);
    }

    .card-top-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.8rem;
    }

    .kicker-tag {
      font-size: 0.75rem;
      font-weight: 800;
      color: #8b5cf6;
      letter-spacing: 0.8px;
    }

    .badge-critical {
      background: #fee2e2;
      color: #dc2626;
      font-size: 0.72rem;
      font-weight: 800;
      padding: 0.25rem 0.65rem;
      border-radius: var(--radius-full);
      border: 1px solid rgba(220, 38, 38, 0.2);
    }

    .task-highlight-title {
      font-size: 1.45rem;
      font-weight: 800;
      color: #1e1336;
      margin-bottom: 0.8rem;
      line-height: 1.3;
    }

    .countdown-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: rgba(239, 68, 68, 0.1);
      color: #dc2626;
      font-size: 0.8rem;
      font-weight: 700;
      padding: 0.35rem 0.8rem;
      border-radius: var(--radius-full);
      margin-bottom: 0.9rem;
    }

    .task-highlight-desc {
      font-size: 0.9rem;
      color: #5c4e78;
      line-height: 1.5;
      margin-bottom: 1.5rem;
    }

    .btn-highlight-action {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      background: linear-gradient(135deg, #a855f7 0%, #8b5cf6 100%);
      color: white;
      font-weight: 700;
      font-size: 0.95rem;
      padding: 0.85rem 1.6rem;
      border-radius: var(--radius-full);
      box-shadow: 0 8px 20px rgba(139, 92, 246, 0.35);
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .btn-highlight-action:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 28px rgba(139, 92, 246, 0.45);
    }

    /* Beavy Recommendation Card */
    .beavy-recommendation-card {
      background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
      border: 1px solid rgba(245, 158, 11, 0.3);
      border-radius: var(--radius-lg);
      padding: 1.4rem 1.6rem;
      box-shadow: 0 8px 24px rgba(245, 158, 11, 0.08);
    }

    .beavy-rec-header {
      display: flex;
      gap: 1.2rem;
      align-items: center;
      margin-bottom: 1rem;
    }

    .beavy-avatar-frame {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.8);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 6px 14px rgba(245, 158, 11, 0.2);
      flex-shrink: 0;
    }

    .beavy-rec-img {
      width: 48px;
      height: 48px;
      object-fit: contain;
    }

    .beavy-rec-title {
      font-size: 1.05rem;
      font-weight: 800;
      color: #92400e;
      margin-bottom: 0.25rem;
    }

    .beavy-rec-text {
      font-size: 0.88rem;
      color: #78350f;
      line-height: 1.45;
    }

    .btn-ask-beavy-inline {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.85rem;
      font-weight: 700;
      color: #b45309;
      background: rgba(255, 255, 255, 0.85);
      padding: 0.5rem 1rem;
      border-radius: var(--radius-full);
      border: 1px solid rgba(245, 158, 11, 0.3);
      transition: all 0.2s;
    }

    .btn-ask-beavy-inline:hover {
      background: white;
      transform: translateX(3px);
    }

    /* Sesi Berikutnya Card */
    .sessions-card, .today-schedule-card, .quick-actions-card {
      background: rgba(255, 255, 255, 0.88);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.9);
      border-radius: var(--radius-lg);
      padding: 1.6rem;
      box-shadow: var(--shadow-sm);
    }

    .section-header-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.2rem;
    }

    .section-title {
      font-size: 1.15rem;
      font-weight: 800;
      color: #22163b;
    }

    .link-see-all {
      font-size: 0.82rem;
      font-weight: 700;
      color: #8b5cf6;
    }

    .link-see-all:hover {
      text-decoration: underline;
    }

    .session-item {
      display: flex;
      align-items: center;
      gap: 1.2rem;
      padding: 0.9rem 1rem;
      border-radius: var(--radius-md);
      background: #f9f7fd;
      border: 1px solid #eee7f7;
      margin-bottom: 0.75rem;
      transition: transform 0.2s ease;
    }

    .session-item.active {
      background: #f3e8ff;
      border-color: #d8b4fe;
    }

    .session-item:hover {
      transform: translateX(4px);
    }

    .time-block {
      display: flex;
      flex-direction: column;
      align-items: center;
      min-width: 55px;
    }

    .session-time {
      font-size: 1.05rem;
      font-weight: 800;
      color: #3b285f;
    }

    .session-duration {
      font-size: 0.7rem;
      color: #887a9e;
      font-weight: 600;
    }

    .session-detail {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .session-name {
      font-size: 0.92rem;
      font-weight: 700;
      color: #251740;
    }

    .session-status {
      font-size: 0.75rem;
      font-weight: 600;
    }

    .session-status.start-soon {
      color: #b45309;
    }

    .session-status.upcoming {
      color: #8a7b9f;
    }

    .btn-check-session {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      border: 1.5px solid #c4b5fd;
      background: white;
      color: #8b5cf6;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
    }

    .btn-check-session:hover {
      background: #8b5cf6;
      color: white;
      border-color: #8b5cf6;
    }

    /* Quick Actions 4 Grid */
    .quick-actions-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .quick-action-btn {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 1.2rem 1rem;
      border-radius: var(--radius-md);
      transition: transform 0.2s, box-shadow 0.2s;
      border: 1px solid transparent;
    }

    .quick-action-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 8px 20px rgba(139, 92, 246, 0.12);
    }

    .action-add {
      background: #f5f3ff;
      border-color: #ddd6fe;
    }
    .action-add .qa-icon-wrap { background: #8b5cf6; color: white; }

    .action-upload {
      background: #eff6ff;
      border-color: #bfdbfe;
    }
    .action-upload .qa-icon-wrap { background: #3b82f6; color: white; }

    .action-plan {
      background: #ecfdf5;
      border-color: #a7f3d0;
    }
    .action-plan .qa-icon-wrap { background: #10b981; color: white; }

    .action-chat {
      background: #fff7ed;
      border-color: #fed7aa;
    }
    .action-chat .qa-icon-wrap { background: #f97316; color: white; }

    .qa-icon-wrap {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 0.6rem;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
    }

    .qa-title {
      font-size: 0.88rem;
      font-weight: 700;
      color: #241740;
    }

    .qa-desc {
      font-size: 0.72rem;
      color: #8b7d9f;
      margin-top: 0.15rem;
    }

    /* Timeline Container */
    .today-tag {
      font-size: 0.8rem;
      font-weight: 700;
      color: #7c3aed;
      background: #ede9fe;
      padding: 0.3rem 0.7rem;
      border-radius: var(--radius-full);
    }

    .timeline-container {
      display: flex;
      flex-direction: column;
      gap: 1.2rem;
      margin-top: 0.5rem;
    }

    .timeline-slot {
      display: flex;
      align-items: center;
      gap: 1rem;
      position: relative;
    }

    .timeline-hour {
      font-size: 0.85rem;
      font-weight: 800;
      color: #4a3c63;
      min-width: 45px;
    }

    .timeline-bar {
      width: 4px;
      height: 44px;
      background: #e2d9ee;
      border-radius: 2px;
      position: relative;
    }

    .timeline-slot.done .timeline-bar {
      background: #10b981;
    }

    .timeline-slot.current .timeline-bar {
      background: #8b5cf6;
      box-shadow: 0 0 10px rgba(139, 92, 246, 0.5);
    }

    .timeline-content {
      flex: 1;
      padding: 0.6rem 0.9rem;
      border-radius: 10px;
      background: #fbf9fe;
      border: 1px solid #f0eaf7;
    }

    .timeline-slot.current .timeline-content {
