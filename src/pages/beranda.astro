---
// src/pages/beranda.astro
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { Image } from 'astro:assets';
import mascotImg from '../assets/craiyon.png';
---

<DashboardLayout title="Beranda" activeNav="beranda">
  <div class="dashboard-wrap">
    <!-- Hero Section -->
    <section class="hero-section">
      <div class="hero-text">
        <span class="hero-greeting">Selamat Pagi, Daffa</span>
        <h1 class="hero-title">Apa yang perlu kamu<br />fokuskan hari ini?</h1>
      </div>

      <!-- Quick Metrics Counter (Clean, Non-Slop) -->
      <div class="metrics-grid">
        <div class="metric-card active-tasks">
          <div class="metric-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
          </div>
          <div class="metric-info">
            <span class="metric-num">5</span>
            <span class="metric-label">Tugas aktif</span>
          </div>
        </div>

        <div class="metric-card urgent-tasks">
          <div class="metric-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          </div>
          <div class="metric-info">
            <span class="metric-num">2</span>
            <span class="metric-label">Mendekati deadline</span>
          </div>
        </div>

        <div class="metric-card today-sessions">
          <div class="metric-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
          </div>
          <div class="metric-info">
            <span class="metric-num">3</span>
            <span class="metric-label">Sesi hari ini</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Desktop 2-Column Core Layout -->
    <div class="desktop-main-grid">
      <!-- LEFT COLUMN: Prioritas Utama & Sesi -->
      <div class="left-col">
        <!-- Card 1: Prioritas Teratas (Cleaned up, no harsh neon glow) -->
        <div class="priority-highlight-card">
          <div class="card-top-row">
            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <span class="pulse-indicator"></span>
              <span class="status-live-label">Prioritas Hari Ini</span>
            </div>
            <span class="badge-critical">Kritis • #1</span>
          </div>

          <h2 class="task-highlight-title">Laporan Praktikum Pemrograman</h2>

          <div class="countdown-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            <span>Sisa 1 hari 4 jam (Tenggat: 17.00)</span>
          </div>

          <p class="task-highlight-desc">
            Deadline paling dekat dengan estimasi durasi 2 jam. Disarankan dikerjakan pada sesi fokus jam 10.00 sebelum tugas kelompok lainnya.
          </p>

          <div class="card-footer-action">
            <a href="/prioritas" class="btn-highlight-action">
              <span>Mulai Sesi Fokus (2 Jam)</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
          </div>
        </div>

        <!-- Card 2: Beavy's AI Tip Card (Crafted, restrained) -->
        <div class="beavy-recommendation-card">
          <div class="beavy-rec-header">
            <div class="beavy-avatar-frame">
              <Image src={mascotImg} alt="Beavy" class="beavy-rec-img" />
            </div>
            <div>
              <h3 class="beavy-rec-title">Insight Ritme Fokus</h3>
              <p class="beavy-rec-text">
                Berdasarkan riwayatmu, slot produktif terbaik adalah <strong>jam 10.00 - 12.00</strong>. Beavy sudah memblokir slot ini agar tidak bertabrakan dengan jadwal lain.
              </p>
            </div>
          </div>
          <div class="beavy-rec-action">
            <a href="/beavy-ai" class="btn-ask-beavy-inline">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
              <span>Diskusikan Jadwal dengan Beavy</span>
            </a>
          </div>
        </div>

        <!-- Card 3: Sesi Berikutnya -->
        <div class="sessions-card">
          <div class="section-header-row">
            <div>
              <h3 class="section-title">Sesi Terjadwal</h3>
              <span class="section-sub">3 sesi tersisa hari ini</span>
            </div>
            <a href="/jadwal" class="link-see-all">Kalender Lengkap →</a>
          </div>

          <div class="session-item active">
            <div class="time-block">
              <span class="session-time">10.00</span>
              <span class="session-duration">120 mnt</span>
            </div>
            <div class="session-detail">
              <span class="session-name">Fokus: Pemrograman Web & API</span>
              <span class="session-status start-soon">Mulai dalam 32 menit</span>
            </div>
            <div class="session-action">
              <button class="btn-check-session" title="Selesaikan Sesi" aria-label="Selesaikan sesi" onclick="
                const item = this.closest('.session-item');
                item.style.opacity = '0.45';
                item.style.filter = 'grayscale(60%)';
                (window).jadwalinToast('Sesi Ditandai Selesai', 'Sesi pemrograman telah dipindahkan ke riwayat.', 'success', {
                  label: 'Urungkan',
                  onClick: () => {
                    item.style.opacity = '1';
                    item.style.filter = 'none';
                  }
                });
              ">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </button>
            </div>
          </div>

          <div class="session-item">
            <div class="time-block">
              <span class="session-time">15.00</span>
              <span class="session-duration">90 mnt</span>
            </div>
            <div class="session-detail">
              <span class="session-name">Laporan Praktikum Sistem Informasi</span>
              <span class="session-status upcoming">Siang nanti</span>
            </div>
            <div class="session-action">
              <button class="btn-check-session" title="Selesaikan Sesi" aria-label="Selesaikan sesi" onclick="
                const item = this.closest('.session-item');
                item.style.opacity = '0.45';
                item.style.filter = 'grayscale(60%)';
                (window).jadwalinToast('Sesi Ditandai Selesai', 'Sesi laporan selesai.', 'success', {
                  label: 'Urungkan',
                  onClick: () => {
                    item.style.opacity = '1';
                    item.style.filter = 'none';
                  }
                });
              ">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </button>
            </div>
          </div>

          <div class="session-item">
            <div class="time-block">
              <span class="session-time">19.00</span>
              <span class="session-duration">60 mnt</span>
            </div>
            <div class="session-detail">
              <span class="session-name">Slide Presentasi Kelompok</span>
              <span class="session-status upcoming">Malam ini</span>
            </div>
            <div class="session-action">
              <button class="btn-check-session" title="Selesaikan Sesi" aria-label="Selesaikan sesi" onclick="
                const item = this.closest('.session-item');
                item.style.opacity = '0.45';
                item.style.filter = 'grayscale(60%)';
                (window).jadwalinToast('Sesi Ditandai Selesai', 'Sesi presentasi selesai.', 'success', {
                  label: 'Urungkan',
                  onClick: () => {
                    item.style.opacity = '1';
                    item.style.filter = 'none';
                  }
                });
              ">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: Aksi Cepat & Timeline Jadwal Hari Ini -->
      <div class="right-col">
        <!-- Aksi Cepat 4 Grid Buttons (Crisp Icons, No Slop) -->
        <div class="quick-actions-card">
          <h3 class="section-title" style="margin-bottom: 1rem;">Aksi Cepat</h3>
          
          <div class="quick-actions-grid">
            <button type="button" class="quick-action-btn action-add" onclick="(window).openQuickAddModal ? (window).openQuickAddModal() : window.location.href='/tambah-tugas';">
              <div class="qa-icon-wrap">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
              </div>
              <span class="qa-title">Tambah Tugas</span>
              <span class="qa-desc">Input modal cepat [N]</span>
            </button>

            <a href="/upload" class="quick-action-btn action-upload">
              <div class="qa-icon-wrap">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
              </div>
              <span class="qa-title">Upload Jadwal</span>
              <span class="qa-desc">Ekstraksi silabus / PDF</span>
            </a>

            <a href="/jadwal" class="quick-action-btn action-plan">
              <div class="qa-icon-wrap">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line></svg>
              </div>
              <span class="qa-title">Time Blocking</span>
              <span class="qa-desc">Atur alur harian</span>
            </a>

            <a href="/beavy-ai" class="quick-action-btn action-chat">
              <div class="qa-icon-wrap">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
              </div>
              <span class="qa-title">Tanya Beavy</span>
              <span class="qa-desc">Konsultasi prioritas</span>
            </a>
          </div>
        </div>

        <!-- Timeline Jadwal Hari Ini -->
        <div class="today-schedule-card">
          <div class="section-header-row">
            <div>
              <h3 class="section-title">Timeline Hari Ini</h3>
              <span class="section-sub">Sabtu, 24 Oktober 2026</span>
            </div>
            <span class="today-tag">On Track</span>
          </div>

          <div class="timeline-container">
            <div class="timeline-slot done">
              <span class="timeline-hour">08:00</span>
              <div class="timeline-bar"></div>
              <div class="timeline-content">
                <h4>Persiapan & Daily Check-in</h4>
                <p>30 mnt • Selesai tepat waktu</p>
              </div>
            </div>

            <div class="timeline-slot current">
              <span class="timeline-hour">10:00</span>
              <div class="timeline-bar"></div>
              <div class="timeline-content">
                <h4>Fokus: Pemrograman Web & API</h4>
                <p>120 mnt • Slot Produktif Utama</p>
              </div>
            </div>

            <div class="timeline-slot">
              <span class="timeline-hour">12:30</span>
              <div class="timeline-bar"></div>
              <div class="timeline-content">
                <h4>Istirahat Siang & Makan</h4>
                <p>60 mnt • Buffer Istirahat</p>
              </div>
            </div>

            <div class="timeline-slot">
              <span class="timeline-hour">15:00</span>
              <div class="timeline-bar"></div>
              <div class="timeline-content">
                <h4>Praktikum Pemrograman</h4>
                <p>90 mnt • Akademik</p>
              </div>
            </div>

            <div class="timeline-slot">
              <span class="timeline-hour">19:00</span>
              <div class="timeline-bar"></div>
              <div class="timeline-content">
                <h4>Slide Presentasi Kelompok</h4>
                <p>60 mnt • Kerja Tim</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    .dashboard-wrap {
      display: flex;
      flex-direction: column;
      gap: 1.8rem;
    }

    /* Hero Section */
    .hero-section {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      flex-wrap: wrap;
      gap: 1.2rem;
    }

    .hero-greeting {
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--color-primary);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      display: block;
      margin-bottom: 0.25rem;
    }

    .hero-title {
      font-size: 2rem;
      font-weight: 800;
      color: var(--color-text-main);
      line-height: 1.2;
      letter-spacing: -0.02em;
    }

    /* Metrics Grid */
    .metrics-grid {
      display: flex;
      gap: 0.8rem;
      flex-wrap: wrap;
    }

    .metric-card {
      display: flex;
      align-items: center;
      gap: 0.8rem;
      background: #ffffff;
      border: 1px solid var(--color-border);
      padding: 0.75rem 1.2rem;
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-xs);
      transition: border-color 0.15s, transform 0.15s;
    }

    .metric-card:hover {
      border-color: #d8b4fe;
      transform: translateY(-1px);
    }

    .metric-icon {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .active-tasks .metric-icon { background: #f5f0ff; color: var(--color-primary); }
    .urgent-tasks .metric-icon { background: #fee2e2; color: #dc2626; }
    .today-sessions .metric-icon { background: #fef3c7; color: #d97706; }

    .metric-info {
      display: flex;
      flex-direction: column;
    }

    .metric-num {
      font-family: var(--font-mono);
      font-size: 1.4rem;
      font-weight: 800;
      color: var(--color-text-main);
      line-height: 1.1;
    }

    .metric-label {
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--color-text-muted);
    }

    /* Desktop Main Grid */
    .desktop-main-grid {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 1.8rem;
      align-items: start;
    }

    .left-col, .right-col {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    /* Priority Highlight Card (Focus Sanctuary style, no harsh left-edge slop) */
    .priority-highlight-card {
      background: #ffffff;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
      padding: 1.6rem;
      box-shadow: var(--shadow-xs);
      position: relative;
      overflow: hidden;
    }

    .pulse-indicator {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--color-accent);
      display: inline-block;
    }

    .card-top-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.6rem;
    }

    .status-live-label {
      font-size: 0.78rem;
      font-weight: 700;
      color: var(--color-text-body);
      letter-spacing: -0.01em;
    }

    .badge-critical {
      background: var(--color-warning-bg);
      color: var(--color-warning);
      border: 1px solid rgba(217, 119, 6, 0.2);
      font-size: 0.72rem;
      font-weight: 700;
      padding: 0.2rem 0.6rem;
      border-radius: var(--radius-sm);
    }

    .task-highlight-title {
      font-size: 1.35rem;
      font-weight: 800;
      color: var(--color-text-main);
      margin-bottom: 0.6rem;
      line-height: 1.3;
    }

    .countdown-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background: #fef2f2;
      color: #b91c1c;
      font-size: 0.78rem;
      font-weight: 600;
      padding: 0.25rem 0.7rem;
      border-radius: 6px;
      margin-bottom: 0.8rem;
    }

    .task-highlight-desc {
      font-size: 0.88rem;
      color: var(--color-text-body);
      line-height: 1.5;
      margin-bottom: 1.3rem;
    }

    .btn-highlight-action {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: var(--color-primary);
      color: white;
      font-weight: 700;
      font-size: 0.88rem;
      padding: 0.75rem 1.4rem;
      border-radius: var(--radius-md);
      box-shadow: 0 2px 8px rgba(124, 58, 237, 0.25);
      transition: background 0.15s, transform 0.1s;
    }

    .btn-highlight-action:hover {
      background: var(--color-primary-dark);
      transform: translateY(-1px);
    }

    /* Beavy Recommendation Card */
    .beavy-recommendation-card {
      background: #ffffff;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
      padding: 1.4rem 1.6rem;
      box-shadow: var(--shadow-xs);
    }

    .beavy-rec-header {
      display: flex;
      gap: 1rem;
      align-items: center;
      margin-bottom: 0.9rem;
    }

    .beavy-avatar-frame {
      width: 44px;
      height: 44px;
      border-radius: var(--radius-md);
      background: #fbf8f2;
      border: 1px solid #faeccb;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .beavy-rec-img {
      width: 32px;
      height: 32px;
      object-fit: contain;
    }

    .beavy-rec-title {
      font-size: 0.98rem;
      font-weight: 800;
      color: var(--color-text-main);
      margin-bottom: 0.2rem;
    }

    .beavy-rec-text {
      font-size: 0.82rem;
      color: var(--color-text-body);
      line-height: 1.45;
    }

    .btn-ask-beavy-inline {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--color-primary);
      background: var(--color-primary-light);
      padding: 0.45rem 0.85rem;
      border-radius: var(--radius-sm);
      transition: background 0.15s;
    }

    .btn-ask-beavy-inline:hover {
      background: #ede3ff;
    }

    /* Sesi Berikutnya Card */
    .sessions-card, .today-schedule-card, .quick-actions-card {
      background: #ffffff;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
      padding: 1.5rem;
      box-shadow: var(--shadow-xs);
    }

    .section-header-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.1rem;
    }

    .section-title {
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--color-text-main);
    }

    .section-sub {
      font-size: 0.75rem;
      color: var(--color-text-muted);
    }

    .link-see-all {
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--color-primary);
    }

    .session-item {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0.85rem 1rem;
      border-radius: var(--radius-md);
      background: #fbf9fe;
      border: 1px solid var(--color-border-subtle);
      margin-bottom: 0.65rem;
      transition: all 0.15s;
    }

    .session-item.active {
      background: #f7f3fd;
      border-color: #ddd0f3;
    }

    .session-item:hover {
      transform: translateX(2px);
      border-color: #c4b5fd;
    }

    .time-block {
      display: flex;
      flex-direction: column;
      align-items: center;
      min-width: 50px;
    }

    .session-time {
      font-family: var(--font-mono);
      font-size: 0.95rem;
      font-weight: 800;
      color: var(--color-text-main);
    }

    .session-duration {
      font-size: 0.72rem;
      color: var(--color-text-muted);
      font-weight: 600;
    }

    .session-detail {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }

    .session-name {
      font-size: 0.88rem;
      font-weight: 700;
      color: var(--color-text-main);
    }

    .session-status {
      font-size: 0.72rem;
      font-weight: 600;
    }

    .session-status.start-soon { color: #b45309; }
    .session-status.upcoming { color: var(--color-text-muted); }

    .btn-check-session {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      border: 1.5px solid #d4c8e7;
      background: white;
      color: var(--color-primary);
      font-weight: 700;
      font-size: 0.8rem;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.15s;
    }

    .btn-check-session:hover {
      background: #10b981;
      color: white;
      border-color: #10b981;
    }

    /* Quick Actions 4 Grid */
    .quick-actions-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.8rem;
    }

    .quick-action-btn {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      padding: 1rem;
      border-radius: var(--radius-md);
      background: #ffffff;
