---
// src/pages/beranda.astro
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { Image } from 'astro:assets';
import mascotImg from '../assets/craiyon.png';
---

<DashboardLayout title="Beranda" activeNav="beranda">
  <div class="sanctuary-wrap">

    <!-- 1. EDITORIAL HERO: Calm, Spacious, Pointed -->
    <header class="sanctuary-hero">
      <div class="hero-primary">
        <h1 class="hero-statement">
          Fokus utama hari ini:<br />
          <span class="hero-task-name">Laporan Praktikum Pemrograman</span>
        </h1>
        <p class="hero-context">
          Sesi terdekat berdurasi <strong>2 jam</strong>, dialokasikan pada pukul <strong>10.00</strong> sebelum kelas praktikum sore.
        </p>
      </div>

      <div class="hero-action-cluster">
        <a href="/prioritas" class="btn-hero-focus">
          <span>Mulai Sesi Fokus</span>
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </a>
      </div>
    </header>

    <!-- 2. RESTRAINED AMBIENT METRICS (Understated, Not Loud KPI Tiles) -->
    <section class="ambient-strip">
      <div class="ambient-stat">
        <span class="stat-number">5</span>
        <span class="stat-tagline">Tugas aktif dalam antrean</span>
      </div>
      <div class="ambient-divider"></div>
      <div class="ambient-stat">
        <span class="stat-number">2</span>
        <span class="stat-tagline">Mendekati deadline 48 jam</span>
      </div>
      <div class="ambient-divider"></div>
      <div class="ambient-stat">
        <span class="stat-number">3</span>
        <span class="stat-tagline">Sesi fokus terjadwal hari ini</span>
      </div>
      <div class="ambient-divider"></div>
      <div class="ambient-companion-hint">
        <div class="hint-avatar">
          <Image src={mascotImg} alt="Beavy" class="hint-avatar-img" />
        </div>
        <div class="hint-text">
          <span class="hint-title">Ritme Alami Anda</span>
          <span class="hint-desc">Slot produktif jam 10.00 telah diproteksi oleh Beavy AI.</span>
        </div>
      </div>
    </section>

    <!-- 3. MAIN WORKSPACE: Asymmetric 65 / 35 Editorial Grid -->
    <div class="sanctuary-grid">

      <!-- LEFT COLUMN: The Integrated Daily Itinerary (Unified Schedule & Tasks) -->
      <section class="itinerary-surface">
        <div class="surface-header">
          <div>
            <h2 class="surface-title">Alur Fokus Harian</h2>
            <p class="surface-caption">Sabtu, 24 Oktober 2026 : Ritme berimbang akademik dan istirahat</p>
          </div>
          <a href="/jadwal" class="link-editorial">Buka Kalender</a>
        </div>

        <ol class="itinerary-timeline">
          <!-- Item 1: Done -->
          <li class="timeline-entry done">
            <div class="entry-time-col">
              <time class="time-clock">08.00</time>
              <span class="time-span">30 mnt</span>
            </div>
            <div class="entry-marker">
              <div class="marker-circle">
                <svg aria-hidden="true" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </div>
              <div class="marker-stem"></div>
            </div>
            <div class="entry-card clickable-entry" data-title="Persiapan & Daily Check-in" data-time="08.30" data-dur="30 mnt" data-desc="Evaluasi tugas harian dan pengecekan materi perkuliahan." data-tag="Rutinitas">
              <div class="entry-header-row">
                <h3 class="entry-title">Persiapan & Daily Check-in</h3>
                <span class="status-badge-soft">Selesai</span>
              </div>
              <p class="entry-desc">Evaluasi tugas harian dan pengecekan materi perkuliahan.</p>
            </div>
          </li>

          <!-- Item 2: Active / Current Focus -->
          <li class="timeline-entry active">
            <div class="entry-time-col">
              <time class="time-clock">10.00</time>
              <span class="time-span">120 mnt</span>
            </div>
            <div class="entry-marker">
              <div class="marker-circle pulse"></div>
              <div class="marker-stem"></div>
            </div>
            <div class="entry-card featured clickable-entry" data-title="Fokus: Pemrograman Web & API" data-time="10.00" data-dur="120 mnt" data-desc="Penyelesaian controller modul autentikasi dan pembuatan unit testing endpoint." data-tag="Akademik">
              <div class="entry-header-row">
                <div>
                  <span class="entry-kicker">Sedang Berlangsung</span>
                  <h3 class="entry-title">Fokus: Pemrograman Web & API</h3>
                </div>
                <button type="button" class="btn-check-editorial" title="Tandai Selesai" aria-label="Selesaikan sesi" onclick="
                  const entry = this.closest('.timeline-entry');
                  entry.classList.toggle('completed-client');
                  (window).jadwalinToast('Sesi Berhasil Direkam', 'Sesi pemrograman dicatat ke riwayat produktivitas.', 'success', {
                    label: 'Urungkan',
                    onClick: () => entry.classList.toggle('completed-client')
                  });
                ">
                  <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </button>
              </div>
              <p class="entry-desc">Penyelesaian controller modul autentikasi dan pembuatan unit testing endpoint.</p>
              <div class="entry-tags-row">
                <span class="tag-pill">Akademik</span>
                <span class="tag-pill">2 SKS Praktikum</span>
                <span class="tag-pill urgent">Tenggat 17.00</span>
              </div>
            </div>
          </li>

          <!-- Item 3: Buffer Break -->
          <li class="timeline-entry neutral">
            <div class="entry-time-col">
              <time class="time-clock">12.30</time>
              <span class="time-span">60 mnt</span>
            </div>
            <div class="entry-marker">
              <div class="marker-circle"></div>
              <div class="marker-stem"></div>
            </div>
            <div class="entry-card minimal clickable-entry" data-title="Istirahat Siang & Makan" data-time="12.30" data-dur="60 mnt" data-desc="Waktu rehat tanpa beban layar untuk mengembalikan ketajaman kognitif." data-tag="Jeda Otomatis">
              <div class="entry-header-row">
                <h3 class="entry-title muted-title">Istirahat Siang & Makan</h3>
                <span class="status-badge-neutral">Jeda Otomatis</span>
              </div>
              <p class="entry-desc">Waktu rehat tanpa beban layar untuk mengembalikan ketajaman kognitif.</p>
            </div>
          </li>

          <!-- Item 4: Upcoming Afternoon Session -->
          <li class="timeline-entry upcoming">
            <div class="entry-time-col">
              <time class="time-clock">15.00</time>
              <span class="time-span">90 mnt</span>
            </div>
            <div class="entry-marker">
              <div class="marker-circle"></div>
              <div class="marker-stem"></div>
            </div>
            <div class="entry-card">
              <div class="entry-header-row">
                <h3 class="entry-title">Laporan Praktikum Sistem Informasi</h3>
                <button type="button" class="btn-check-editorial" title="Tandai Selesai" aria-label="Selesaikan sesi" onclick="
                  const entry = this.closest('.timeline-entry');
                  entry.classList.toggle('completed-client');
                  (window).jadwalinToast('Sesi Ditandai Selesai', 'Sesi laporan telah dipindahkan ke riwayat.', 'success', {
                    label: 'Urungkan',
                    onClick: () => entry.classList.toggle('completed-client')
                  });
                ">
                  <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </button>
              </div>
              <p class="entry-desc">Menyusun bab hasil dan pembahasan query relational database PostgreSQL.</p>
              <div class="entry-tags-row">
                <span class="tag-pill">Praktikum</span>
                <span class="tag-pill">Slot Siang</span>
              </div>
            </div>
          </li>

          <!-- Item 5: Evening Session -->
          <li class="timeline-entry upcoming">
            <div class="entry-time-col">
              <time class="time-clock">19.00</time>
              <span class="time-span">60 mnt</span>
            </div>
            <div class="entry-marker">
              <div class="marker-circle"></div>
            </div>
            <div class="entry-card">
              <div class="entry-header-row">
                <h3 class="entry-title">Slide Presentasi Kelompok</h3>
                <button type="button" class="btn-check-editorial" title="Tandai Selesai" aria-label="Selesaikan sesi" onclick="
                  const entry = this.closest('.timeline-entry');
                  entry.classList.toggle('completed-client');
                  (window).jadwalinToast('Sesi Ditandai Selesai', 'Sesi presentasi selesai.', 'success', {
                    label: 'Urungkan',
                    onClick: () => entry.classList.toggle('completed-client')
                  });
                ">
                  <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </button>
              </div>
              <p class="entry-desc">Sinkronisasi diagram arsitektur sistem bersama anggota tim mata kuliah.</p>
              <div class="entry-tags-row">
                <span class="tag-pill">Kerja Kelompok</span>
                <span class="tag-pill">Malam</span>
              </div>
            </div>
          </li>
        </ol>
      </section>

      <!-- RIGHT COLUMN: Horizon Radar & Quick Intentions -->
      <aside class="horizon-surface">

        <!-- 1. Quick Intention Entry (Editorial Clean Bar) -->
        <div class="intention-card">
          <h3 class="side-surface-title">Aksi Langsung</h3>
          <p class="side-surface-desc">Tambahkan agenda atau konsultasikan prioritas beban belajar Anda.</p>
          
          <div class="action-stack">
            <button type="button" class="action-row-btn" onclick="(window).openQuickAddModal ? (window).openQuickAddModal() : window.location.href='/tambah-tugas';">
              <div class="action-icon-disc">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
              </div>
              <div class="action-meta">
                <span class="action-name">Tambah Tugas Baru</span>
                <span class="action-sub">Input cepat via dialog atau keyboard [N]</span>
              </div>
            </button>

            <a href="/upload" class="action-row-btn">
              <div class="action-icon-disc">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
              </div>
              <div class="action-meta">
                <span class="action-name">Ekstraksi Dokumen / Silabus</span>
                <span class="action-sub">AI membaca tenggat waktu dari PDF</span>
              </div>
            </a>

            <a href="/beavy-ai" class="action-row-btn">
              <div class="action-icon-disc">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
              </div>
              <div class="action-meta">
                <span class="action-name">Konsultasi bersama Beavy</span>
                <span class="action-sub">Diskusi penyesuaian beban minggu ini</span>
              </div>
            </a>
          </div>
        </div>

        <!-- 2. Deadline Horizon Card (Forward Look, Not Panic) -->
        <div class="horizon-card">
          <div class="horizon-header-row">
            <h3 class="side-surface-title">Radar Tenggat Mendatang</h3>
            <span class="horizon-badge">3 Hari ke Depan</span>
          </div>

          <ul class="horizon-list">
            <li class="horizon-item clickable-horizon" data-task="Laporan Praktikum Modul 4" data-course="Praktikum Pemrograman" data-time="Besok, 17.00">
              <div class="horizon-bullet danger"></div>
              <div class="horizon-info">
                <span class="horizon-course">Praktikum Pemrograman</span>
                <h4 class="horizon-task">Laporan Praktikum Modul 4</h4>
              </div>
              <time class="horizon-time">Besok, 17.00</time>
            </li>

            <li class="horizon-item">
              <div class="horizon-bullet warning"></div>
              <div class="horizon-info">
                <span class="horizon-course">Sistem Informasi</span>
                <h4 class="horizon-task">Laporan Perancangan Database</h4>
              </div>
              <time class="horizon-time">Senin, 23.59</time>
            </li>

            <li class="horizon-item">
              <div class="horizon-bullet neutral"></div>
              <div class="horizon-info">
                <span class="horizon-course">Kecerdasan Buatan</span>
                <h4 class="horizon-task">Slide Evaluasi Model Regresi</h4>
              </div>
              <time class="horizon-time">Selasa, 12.00</time>
            </li>
          </ul>
        </div>

      </aside>
    </div>

  </div>

  <style>
    /* =========================================================
       AWWWARDS-CALIBRE SANCTUARY DASHBOARD STYLES
       Minimal, Generous Whitespace, Deep Hierarchy, Editorial
       ========================================================= */

    :focus-visible {
      outline: 2px solid var(--color-primary);
      outline-offset: 2px;
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }

    .sanctuary-wrap {
      max-width: 1240px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 2.2rem;
      padding-bottom: 3rem;
    }

    /* 1. HERO STATEMENT */
    .sanctuary-hero {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 2rem;
      padding: 1.5rem 0 0.5rem;
      border-bottom: 1px solid var(--color-border-subtle);
    }

    .hero-primary {
      max-width: 700px;
    }

    .hero-statement {
      font-size: 2.4rem;
      font-weight: 800;
      color: var(--color-text-main);
      line-height: 1.18;
      letter-spacing: -0.03em;
    }

    .hero-task-name {
      color: var(--color-primary-dark);
      position: relative;
      display: inline-block;
    }

    .hero-context {
      font-size: 0.95rem;
      color: var(--color-text-muted);
      line-height: 1.6;
      margin-top: 0.8rem;
    }

    .hero-action-cluster {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.8rem;
      flex-shrink: 0;
    }

    .btn-hero-focus {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      background: var(--color-primary);
      color: var(--color-surface);
      font-size: 0.92rem;
      font-weight: 700;
      padding: 0.85rem 1.6rem;
      border-radius: var(--radius-full);
      box-shadow: var(--shadow-sm);
      transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }

    .btn-hero-focus:hover {
      background: var(--color-primary-dark);
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    .hero-countdown-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--color-text-muted);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      padding: 0.35rem 0.85rem;
      border-radius: var(--radius-full);
    }

    .pill-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--color-accent);
    }

    /* 2. RESTRAINED AMBIENT METRICS STRIP */
    .ambient-strip {
      display: flex;
      align-items: center;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
      padding: 1.25rem 2rem;
      box-shadow: var(--shadow-xs);
      gap: 2rem;
    }

    .ambient-stat {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .stat-number {
      font-family: var(--font-mono);
      font-size: 1.85rem;
      font-weight: 800;
      color: var(--color-text-main);
      line-height: 1;
    }

    .stat-tagline {
      font-size: 0.76rem;
      font-weight: 600;
      color: var(--color-text-muted);
    }

    .ambient-divider {
      width: 1px;
      height: 38px;
      background: var(--color-border);
    }

    .ambient-companion-hint {
      margin-left: auto;
      display: flex;
      align-items: center;
      gap: 0.9rem;
      padding-left: 1rem;
      border-left: 1px dashed var(--color-border);
    }

    .hint-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: var(--color-primary-light);
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--color-border-focus);
      flex-shrink: 0;
    }

    .hint-avatar-img {
      width: 26px;
      height: 26px;
      object-fit: contain;
    }

    .hint-text {
      display: flex;
      flex-direction: column;
    }

    .hint-title {
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--color-text-main);
    }

    .hint-desc {
      font-size: 0.74rem;
      color: var(--color-text-muted);
    }

    /* 3. ASYMMETRIC GRID */
    .sanctuary-grid {
      display: grid;
      grid-template-columns: 1.4fr 0.8fr;
      gap: 2rem;
      align-items: start;
    }

    /* Surface Cards */
    .itinerary-surface, .intention-card, .horizon-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
      padding: 1.8rem;
      box-shadow: var(--shadow-xs);
    }

    .surface-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 1.8rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--color-border-subtle);
    }

    .surface-title {
      font-size: 1.25rem;
      font-weight: 800;
      color: var(--color-text-main);
      letter-spacing: -0.01em;
    }

    .surface-caption {
      font-size: 0.8rem;
      color: var(--color-text-muted);
      margin-top: 0.2rem;
    }

    .link-editorial {
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--color-primary-dark);
      text-decoration: underline;
      text-underline-offset: 4px;
      transition: color 0.15s ease;
    }

    .link-editorial:hover {
      color: var(--color-primary);
    }

    /* TIMELINE ENTRIES */
    .itinerary-timeline {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 1.2rem;
      position: relative;
    }

    .timeline-entry {
      display: flex;
      gap: 1.2rem;
      position: relative;
      transition: opacity 0.25s ease;
    }

    .timeline-entry.completed-client {
      opacity: 0.45;
      filter: grayscale(40%);
    }

    .entry-time-col {
      min-width: 58px;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      padding-top: 0.35rem;
    }

    .time-clock {
      font-family: var(--font-mono);
      font-size: 0.95rem;
      font-weight: 800;
      color: var(--color-text-main);
      line-height: 1;
    }

    .time-span {
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--color-text-muted);
      margin-top: 0.25rem;
    }

    /* Marker Spine */
    .entry-marker {
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
      padding-top: 0.35rem;
    }

    .marker-circle {
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .timeline-entry.done .marker-circle {
      background: var(--color-success);
      border-color: var(--color-success);
      color: var(--color-surface);
    }

    .timeline-entry.active .marker-circle {
      background: var(--color-primary);
      border-color: var(--color-primary-light);
      box-shadow: 0 0 0 4px var(--color-primary-light);
    }

    .marker-stem {
      width: 2px;
      flex: 1;
      background: var(--color-border-subtle);
      margin-top: 4px;
    }

    /* Entry Content Card */
    .entry-card {
      flex: 1;
      background: var(--color-surface-subtle);
      border: 1px solid var(--color-border-subtle);
      border-radius: var(--radius-lg);
      padding: 1.15rem 1.35rem;
      transition: border-color 0.15s ease, background-color 0.15s ease;
    }

    .entry-card.featured {
      background: var(--color-primary-light);
      border-color: var(--color-border-focus);
    }

    .entry-card.minimal {
      background: transparent;
      border-style: dashed;
    }

    .entry-header-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 0.4rem;
    }

    .entry-kicker {
      font-size: 0.7rem;
      font-weight: 700;
      color: var(--color-primary-dark);
      display: block;
      margin-bottom: 0.15rem;
    }

    .entry-title {
      font-size: 1rem;
      font-weight: 800;
      color: var(--color-text-main);
      line-height: 1.3;
    }

    .muted-title {
      color: var(--color-text-muted);
      font-weight: 600;
    }

    .entry-desc {
      font-size: 0.82rem;
      color: var(--color-text-body);
      line-height: 1.5;
    }

    .entry-tags-row {
      display: flex;
      gap: 0.5rem;
      margin-top: 0.8rem;
    }

    .tag-pill {
      font-size: 0.7rem;
      font-weight: 600;
      padding: 0.2rem 0.6rem;
      border-radius: var(--radius-full);
      background: var(--color-surface);
      color: var(--color-text-body);
      border: 1px solid var(--color-border);
    }

