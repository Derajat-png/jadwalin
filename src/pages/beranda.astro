---
// src/pages/beranda.astro
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { Image } from 'astro:assets';
import mascotImg from '../assets/craiyon.png';

const HARI = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
const BULAN = [
  'Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni',
  'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'
];
const now = new Date();
const todayFormatted = `${HARI[now.getDay()]}, ${now.getDate()} ${BULAN[now.getMonth()]} ${now.getFullYear()}`;
---

<DashboardLayout title="Beranda" activeNav="beranda">
  <div class="sanctuary-wrap">

    <!-- 1. EDITORIAL HERO: Calm, Spacious, Pointed -->
    <header class="sanctuary-hero">
      <div class="hero-primary">
        <h1 class="hero-statement">
          Fokus utama hari ini:<br />
          <span class="hero-task-name">Laporan Praktikum Pemrograman</span>
        </h1>
        <p class="hero-context">
          Sesi terdekat berdurasi <strong>2 jam</strong>, dialokasikan pada pukul <strong>10.00</strong> sebelum kelas praktikum sore.
        </p>
      </div>

      <div class="hero-action-cluster">
        <a href="/prioritas" class="btn-hero-focus">
          <span>Mulai Sesi Fokus</span>
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </a>
      </div>
    </header>

    <!-- 2. RESTRAINED AMBIENT METRICS (Understated, Not Loud KPI Tiles) -->
    <section class="ambient-strip">
      <div class="ambient-stat">
        <span class="stat-number">5</span>
        <span class="stat-tagline">Tugas aktif dalam antrean</span>
      </div>
      <div class="ambient-divider"></div>
      <div class="ambient-stat">
        <span class="stat-number">2</span>
        <span class="stat-tagline">Mendekati deadline 48 jam</span>
      </div>
      <div class="ambient-divider"></div>
      <div class="ambient-stat">
        <span class="stat-number">3</span>
        <span class="stat-tagline">Sesi fokus terjadwal hari ini</span>
      </div>
      <div class="ambient-divider"></div>
      <div class="ambient-companion-hint">
        <div class="hint-avatar">
          <Image src={mascotImg} alt="Beavy" class="hint-avatar-img" />
        </div>
        <div class="hint-text">
          <span class="hint-title">Ritme Alami Anda</span>
          <span class="hint-desc">Slot produktif jam 10.00 telah diproteksi oleh Beavy AI.</span>
        </div>
      </div>
    </section>

    <!-- 3. MAIN WORKSPACE: Asymmetric 65 / 35 Editorial Grid -->
    <div class="sanctuary-grid">

      <!-- LEFT COLUMN: The Integrated Daily Itinerary (Unified Schedule & Tasks) -->
      <section class="itinerary-surface">
        <div class="surface-header">
          <div>
            <h2 class="surface-title">Alur Fokus Harian</h2>
            <p class="surface-caption" id="beranda-date-caption">{todayFormatted} : Ritme berimbang akademik dan istirahat</p>
          </div>
          <a href="/jadwal" class="link-editorial">Buka Kalender</a>
        </div>

        <!-- EMPTY STATE CONTAINER (Tampil jika akun baru / belum ada jadwal) -->
        <div id="empty-state-view" class="sanctuary-empty-state" style="display: none;">
          <div class="empty-icon-wrap">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
          </div>
          <h3 class="empty-title">Belum Ada Jadwal Hari Ini</h3>
          <p class="empty-subtitle">
            Alur fokus harianmu masih kosong karena akun baru terdaftar. Mulai harimu dengan menambahkan tugas pertamamu.
          </p>
          <div class="empty-btn-group">
            <button type="button" class="btn-empty-primary" onclick="(window).openQuickAddModal ? (window).openQuickAddModal() : window.location.href='/tambah-tugas';">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
              <span>Tambah Tugas Baru</span>
            </button>
            <a href="/upload" class="btn-empty-secondary">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
              <span>Upload Jadwal</span>
            </a>
          </div>
        </div>

        <ol class="itinerary-timeline" id="itinerary-timeline-list">
          <!-- Item 1: Done -->
          <li class="timeline-entry done">
            <div class="entry-time-col">
              <time class="time-clock">08.00</time>
              <span class="time-span">30 mnt</span>
            </div>
            <div class="entry-marker">
              <div class="marker-circle">
                <svg aria-hidden="true" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
              </div>
              <div class="marker-stem"></div>
            </div>
            <div class="entry-card clickable-entry" data-title="Persiapan & Daily Check-in" data-time="08.30" data-dur="30 mnt" data-desc="Evaluasi tugas harian dan pengecekan materi perkuliahan." data-tag="Rutinitas">
              <div class="entry-header-row">
                <h3 class="entry-title">Persiapan & Daily Check-in</h3>
                <span class="status-badge-soft">Selesai</span>
              </div>
              <p class="entry-desc">Evaluasi tugas harian dan pengecekan materi perkuliahan.</p>
            </div>
          </li>

          <!-- Item 2: Active / Current Focus -->
          <li class="timeline-entry active">
            <div class="entry-time-col">
              <time class="time-clock">10.00</time>
              <span class="time-span">120 mnt</span>
            </div>
            <div class="entry-marker">
              <div class="marker-circle pulse"></div>
              <div class="marker-stem"></div>
            </div>
            <div class="entry-card featured clickable-entry" data-title="Fokus: Pemrograman Web & API" data-time="10.00" data-dur="120 mnt" data-desc="Penyelesaian controller modul autentikasi dan pembuatan unit testing endpoint." data-tag="Akademik">
              <div class="entry-header-row">
                <div>
                  <span class="entry-kicker">Sedang Berlangsung</span>
                  <h3 class="entry-title">Fokus: Pemrograman Web & API</h3>
                </div>
                <button type="button" class="btn-check-editorial" title="Tandai Selesai" aria-label="Selesaikan sesi" onclick="
                  const entry = this.closest('.timeline-entry');
                  entry.classList.toggle('completed-client');
                  (window).jadwalinToast('Sesi Berhasil Direkam', 'Sesi pemrograman dicatat ke riwayat produktivitas.', 'success', {
                    label: 'Urungkan',
                    onClick: () => entry.classList.toggle('completed-client')
                  });
                ">
                  <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </button>
              </div>
              <p class="entry-desc">Penyelesaian controller modul autentikasi dan pembuatan unit testing endpoint.</p>
              <div class="entry-tags-row">
                <span class="tag-pill">Akademik</span>
                <span class="tag-pill">2 SKS Praktikum</span>
                <span class="tag-pill urgent">Tenggat 17.00</span>
              </div>
            </div>
          </li>

          <!-- Item 3: Buffer Break -->
          <li class="timeline-entry neutral">
            <div class="entry-time-col">
              <time class="time-clock">12.30</time>
              <span class="time-span">60 mnt</span>
            </div>
            <div class="entry-marker">
              <div class="marker-circle"></div>
              <div class="marker-stem"></div>
            </div>
            <div class="entry-card minimal clickable-entry" data-title="Istirahat Siang & Makan" data-time="12.30" data-dur="60 mnt" data-desc="Waktu rehat tanpa beban layar untuk mengembalikan ketajaman kognitif." data-tag="Jeda Otomatis">
              <div class="entry-header-row">
                <h3 class="entry-title muted-title">Istirahat Siang & Makan</h3>
                <span class="status-badge-neutral">Jeda Otomatis</span>
              </div>
              <p class="entry-desc">Waktu rehat tanpa beban layar untuk mengembalikan ketajaman kognitif.</p>
            </div>
          </li>

          <!-- Item 4: Upcoming Afternoon Session -->
          <li class="timeline-entry upcoming">
            <div class="entry-time-col">
              <time class="time-clock">15.00</time>
              <span class="time-span">90 mnt</span>
            </div>
            <div class="entry-marker">
              <div class="marker-circle"></div>
              <div class="marker-stem"></div>
            </div>
            <div class="entry-card">
              <div class="entry-header-row">
                <h3 class="entry-title">Laporan Praktikum Sistem Informasi</h3>
                <button type="button" class="btn-check-editorial" title="Tandai Selesai" aria-label="Selesaikan sesi" onclick="
                  const entry = this.closest('.timeline-entry');
                  entry.classList.toggle('completed-client');
                  (window).jadwalinToast('Sesi Ditandai Selesai', 'Sesi laporan telah dipindahkan ke riwayat.', 'success', {
                    label: 'Urungkan',
                    onClick: () => entry.classList.toggle('completed-client')
                  });
                ">
                  <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </button>
              </div>
              <p class="entry-desc">Menyusun bab hasil dan pembahasan query relational database PostgreSQL.</p>
              <div class="entry-tags-row">
                <span class="tag-pill">Praktikum</span>
                <span class="tag-pill">Slot Siang</span>
              </div>
            </div>
          </li>

          <!-- Item 5: Evening Session -->
          <li class="timeline-entry upcoming">
            <div class="entry-time-col">
              <time class="time-clock">19.00</time>
              <span class="time-span">60 mnt</span>
            </div>
            <div class="entry-marker">
              <div class="marker-circle"></div>
            </div>
            <div class="entry-card">
              <div class="entry-header-row">
                <h3 class="entry-title">Slide Presentasi Kelompok</h3>
                <button type="button" class="btn-check-editorial" title="Tandai Selesai" aria-label="Selesaikan sesi" onclick="
                  const entry = this.closest('.timeline-entry');
                  entry.classList.toggle('completed-client');
                  (window).jadwalinToast('Sesi Ditandai Selesai', 'Sesi presentasi selesai.', 'success', {
                    label: 'Urungkan',
                    onClick: () => entry.classList.toggle('completed-client')
                  });
                ">
                  <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </button>
              </div>
              <p class="entry-desc">Sinkronisasi diagram arsitektur sistem bersama anggota tim mata kuliah.</p>
              <div class="entry-tags-row">
                <span class="tag-pill">Kerja Kelompok</span>
                <span class="tag-pill">Malam</span>
              </div>
            </div>
          </li>
        </ol>
      </section>

      <!-- RIGHT COLUMN: Horizon Radar & Quick Intentions -->
      <aside class="horizon-surface">

        <!-- 1. Quick Intention Entry (Editorial Clean Bar) -->
        <div class="intention-card">
          <h3 class="side-surface-title">Aksi Langsung</h3>
          <p class="side-surface-desc">Tambahkan agenda atau konsultasikan prioritas beban belajar Anda.</p>
          
          <div class="action-stack">
            <button type="button" class="action-row-btn" onclick="(window).openQuickAddModal ? (window).openQuickAddModal() : window.location.href='/tambah-tugas';">
              <div class="action-icon-disc">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
              </div>
              <div class="action-meta">
                <span class="action-name">Tambah Tugas Baru</span>
                <span class="action-sub">Input cepat via dialog atau keyboard [N]</span>
              </div>
            </button>

            <a href="/upload" class="action-row-btn">
              <div class="action-icon-disc">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
              </div>
              <div class="action-meta">
                <span class="action-name">Ekstraksi Dokumen / Silabus</span>
                <span class="action-sub">AI membaca tenggat waktu dari PDF</span>
              </div>
            </a>

            <a href="/beavy-ai" class="action-row-btn">
              <div class="action-icon-disc">
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
              </div>
              <div class="action-meta">
                <span class="action-name">Konsultasi bersama Beavy</span>
                <span class="action-sub">Diskusi penyesuaian beban minggu ini</span>
              </div>
            </a>
          </div>
        </div>

        <!-- 2. Deadline Horizon Card (Forward Look, Not Panic) -->
        <div class="horizon-card">
          <div class="horizon-header-row">
            <h3 class="side-surface-title">Radar Tenggat Mendatang</h3>
            <span class="horizon-badge">3 Hari ke Depan</span>
          </div>

          <!-- EMPTY RADAR CONTAINER (Tampil jika akun baru / belum ada deadline) -->
          <div id="empty-horizon-view" class="empty-radar-card" style="display: none;">
            <div class="empty-radar-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <h4 class="empty-radar-heading">Bebas Tenggat Waktu</h4>
            <p class="empty-radar-text">Belum ada tugas atau deadline dalam radar 3 hari ke depan.</p>
          </div>

          <ul class="horizon-list" id="horizon-task-list">
            <li class="horizon-item clickable-horizon" data-task="Laporan Praktikum Modul 4" data-course="Praktikum Pemrograman" data-time="Besok, 17.00">
              <div class="horizon-bullet danger"></div>
              <div class="horizon-info">
                <span class="horizon-course">Praktikum Pemrograman</span>
                <h4 class="horizon-task">Laporan Praktikum Modul 4</h4>
              </div>
              <time class="horizon-time">Besok, 17.00</time>
            </li>

            <li class="horizon-item">
              <div class="horizon-bullet warning"></div>
              <div class="horizon-info">
                <span class="horizon-course">Sistem Informasi</span>
                <h4 class="horizon-task">Laporan Perancangan Database</h4>
              </div>
              <time class="horizon-time">Senin, 23.59</time>
            </li>

            <li class="horizon-item">
              <div class="horizon-bullet neutral"></div>
              <div class="horizon-info">
                <span class="horizon-course">Kecerdasan Buatan</span>
                <h4 class="horizon-task">Slide Evaluasi Model Regresi</h4>
              </div>
              <time class="horizon-time">Selasa, 12.00</time>
            </li>
          </ul>
        </div>

      </aside>
    </div>

  </div>

  <style>
    /* =========================================================
       AWWWARDS-CALIBRE SANCTUARY DASHBOARD STYLES
       Minimal, Generous Whitespace, Deep Hierarchy, Editorial
       ========================================================= */

    :focus-visible {
      outline: 2px solid var(--color-primary);
      outline-offset: 2px;
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }

    .sanctuary-wrap {
      max-width: 1240px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 2.2rem;
      padding-bottom: 3rem;
    }

    /* 1. HERO STATEMENT */
    .sanctuary-hero {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 2rem;
      padding: 1.5rem 0 0.5rem;
      border-bottom: 1px solid var(--color-border-subtle);
    }

    .hero-primary {
      max-width: 700px;
    }

    .hero-statement {
      font-size: 2.4rem;
      font-weight: 800;
      color: var(--color-text-main);
      line-height: 1.18;
      letter-spacing: -0.03em;
    }

    .hero-task-name {
      color: var(--color-primary-dark);
      position: relative;
      display: inline-block;
    }

    .hero-context {
      font-size: 0.95rem;
      color: var(--color-text-muted);
      line-height: 1.6;
      margin-top: 0.8rem;
    }

    .hero-action-cluster {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.8rem;
      flex-shrink: 0;
    }

    .btn-hero-focus {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      background: var(--color-primary);
      color: var(--color-surface);
      font-size: 0.92rem;
      font-weight: 700;
      padding: 0.85rem 1.6rem;
      border-radius: var(--radius-full);
      box-shadow: var(--shadow-sm);
      transition: background-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }

    .btn-hero-focus:hover {
      background: var(--color-primary-dark);
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
    }

    .hero-countdown-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--color-text-muted);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      padding: 0.35rem 0.85rem;
      border-radius: var(--radius-full);
    }

    .pill-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--color-accent);
    }

    /* 2. RESTRAINED AMBIENT METRICS STRIP */
    .ambient-strip {
      display: flex;
      align-items: center;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
      padding: 1.25rem 2rem;
      box-shadow: var(--shadow-xs);
      gap: 2rem;
    }

    .ambient-stat {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .stat-number {
      font-family: var(--font-mono);
      font-size: 1.85rem;
      font-weight: 800;
      color: var(--color-text-main);
      line-height: 1;
    }

    .stat-tagline {
      font-size: 0.76rem;
      font-weight: 600;
      color: var(--color-text-muted);
    }

    .ambient-divider {
      width: 1px;
      height: 38px;
      background: var(--color-border);
    }

    .ambient-companion-hint {
      margin-left: auto;
      display: flex;
      align-items: center;
      gap: 0.9rem;
      padding-left: 1rem;
      border-left: 1px dashed var(--color-border);
    }

    .hint-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: var(--color-primary-light);
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--color-border-focus);
      flex-shrink: 0;
    }

    .hint-avatar-img {
      width: 26px;
      height: 26px;
      object-fit: contain;
    }

    .hint-text {
      display: flex;
      flex-direction: column;
    }

    .hint-title {
      font-size: 0.8rem;
      font-weight: 700;
      color: var(--color-text-main);
    }

    .hint-desc {
      font-size: 0.74rem;
      color: var(--color-text-muted);
    }

    /* 3. ASYMMETRIC GRID */
    .sanctuary-grid {
      display: grid;
      grid-template-columns: 1.4fr 0.8fr;
      gap: 2rem;
      align-items: start;
    }

    /* Surface Cards */
    .itinerary-surface, .intention-card, .horizon-card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
      padding: 1.8rem;
      box-shadow: var(--shadow-xs);
    }

    .surface-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 1.8rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--color-border-subtle);
    }

    .surface-title {
      font-size: 1.25rem;
      font-weight: 800;
      color: var(--color-text-main);
      letter-spacing: -0.01em;
    }

    .surface-caption {
      font-size: 0.8rem;
      color: var(--color-text-muted);
      margin-top: 0.2rem;
    }

    .link-editorial {
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--color-primary-dark);
      text-decoration: underline;
      text-underline-offset: 4px;
      transition: color 0.15s ease;
    }

    .link-editorial:hover {
      color: var(--color-primary);
    }

    /* TIMELINE ENTRIES */
    .itinerary-timeline {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 1.2rem;
      position: relative;
    }

    .timeline-entry {
      display: flex;
      gap: 1.2rem;
      position: relative;
      transition: opacity 0.25s ease;
    }

    .timeline-entry.completed-client {
      opacity: 0.45;
      filter: grayscale(40%);
    }

    .entry-time-col {
      min-width: 58px;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      padding-top: 0.35rem;
    }

    .time-clock {
      font-family: var(--font-mono);
      font-size: 0.95rem;
      font-weight: 800;
      color: var(--color-text-main);
      line-height: 1;
    }

    .time-span {
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--color-text-muted);
      margin-top: 0.25rem;
    }

    /* Marker Spine */
    .entry-marker {
      display: flex;
      flex-direction: column;
      align-items: center;
      position: relative;
      padding-top: 0.35rem;
    }

    .marker-circle {
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: var(--color-surface);
      border: 2px solid var(--color-border);
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .timeline-entry.done .marker-circle {
      background: var(--color-success);
      border-color: var(--color-success);
      color: var(--color-surface);
    }

    .timeline-entry.active .marker-circle {
      background: var(--color-primary);
      border-color: var(--color-primary-light);
      box-shadow: 0 0 0 4px var(--color-primary-light);
    }

    .marker-stem {
      width: 2px;
      flex: 1;
      background: var(--color-border-subtle);
      margin-top: 4px;
    }

    /* Entry Content Card */
    .entry-card {
      flex: 1;
      background: var(--color-surface-subtle);
      border: 1px solid var(--color-border-subtle);
      border-radius: var(--radius-lg);
      padding: 1.15rem 1.35rem;
      transition: border-color 0.15s ease, background-color 0.15s ease;
    }

    .entry-card.featured {
      background: var(--color-primary-light);
      border-color: var(--color-border-focus);
    }

    .entry-card.minimal {
      background: transparent;
      border-style: dashed;
    }

    .entry-header-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 0.4rem;
    }

    .entry-kicker {
      font-size: 0.7rem;
      font-weight: 700;
      color: var(--color-primary-dark);
      display: block;
      margin-bottom: 0.15rem;
    }

    .entry-title {
      font-size: 1rem;
      font-weight: 800;
      color: var(--color-text-main);
      line-height: 1.3;
    }

    .muted-title {
      color: var(--color-text-muted);
      font-weight: 600;
    }

    .entry-desc {
      font-size: 0.82rem;
      color: var(--color-text-body);
      line-height: 1.5;
    }

    .entry-tags-row {
      display: flex;
      gap: 0.5rem;
      margin-top: 0.8rem;
    }

    .tag-pill {
      font-size: 0.7rem;
      font-weight: 600;
      padding: 0.2rem 0.6rem;
      border-radius: var(--radius-full);
      background: var(--color-surface);
      color: var(--color-text-body);
      border: 1px solid var(--color-border);
    }

    .tag-pill.urgent {
      background: var(--color-warning-bg);
      color: var(--color-warning);
      border-color: var(--color-warning-border);
      font-weight: 700;
    }

    .btn-check-editorial {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      border: 1px solid var(--color-border);
      background: var(--color-surface);
      color: var(--color-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
    }

    .btn-check-editorial:hover {
      background: var(--color-success);
      color: var(--color-surface);
      border-color: var(--color-success);
      transform: scale(1.08);
    }

    .status-badge-soft {
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--color-success);
      background: var(--color-success-bg);
      padding: 0.2rem 0.6rem;
      border-radius: var(--radius-full);
    }

    .status-badge-neutral {
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--color-text-muted);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      padding: 0.2rem 0.6rem;
      border-radius: var(--radius-full);
    }

    /* RIGHT COLUMN STACK */
    .horizon-surface {
      display: flex;
      flex-direction: column;
      gap: 1.8rem;
      background: transparent;
      border: none;
      padding: 0;
      box-shadow: none;
    }

    .side-surface-title {
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--color-text-main);
    }

    .side-surface-desc {
      font-size: 0.78rem;
      color: var(--color-text-muted);
      margin-top: 0.2rem;
      margin-bottom: 1.2rem;
    }

    /* Action Stack */
    .action-stack {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .action-row-btn {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0.85rem 1rem;
      background: var(--color-surface-subtle);
      border: 1px solid var(--color-border-subtle);
      border-radius: var(--radius-lg);
      text-align: left;
      cursor: pointer;
      width: 100%;
      transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
    }

    .action-row-btn:hover {
      background: var(--color-surface);
      border-color: var(--color-border-focus);
      transform: translateX(3px);
    }

    .action-icon-disc {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--color-primary-light);
      color: var(--color-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .action-meta {
      display: flex;
      flex-direction: column;
    }

    .action-name {
      font-size: 0.88rem;
      font-weight: 700;
      color: var(--color-text-main);
    }

    .action-sub {
      font-size: 0.72rem;
      color: var(--color-text-muted);
      margin-top: 0.1rem;
    }

    /* HORIZON LIST */
    .horizon-header-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.2rem;
    }

    .horizon-badge {
      font-size: 0.7rem;
      font-weight: 700;
      color: var(--color-text-muted);
      background: var(--color-canvas);
      padding: 0.2rem 0.55rem;
      border-radius: var(--radius-sm);
    }

    .horizon-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 0.9rem;
    }

    .horizon-item {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      padding: 0.75rem 0.85rem;
      border-radius: var(--radius-md);
      background: var(--color-surface-subtle);
      border: 1px solid var(--color-border-subtle);
    }

    .horizon-bullet {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }

    .horizon-bullet.danger { background: var(--color-danger); }
    .horizon-bullet.warning { background: var(--color-warning); }
    .horizon-bullet.neutral { background: var(--color-primary); }

    .horizon-info {
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .horizon-course {
      font-size: 0.7rem;
      font-weight: 600;
      color: var(--color-text-muted);
    }

    .horizon-task {
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--color-text-main);
    }

    .horizon-time {
      font-family: var(--font-mono);
      font-size: 0.74rem;
      font-weight: 600;
      color: var(--color-text-muted);
    }

    /* RESPONSIVE BREAKPOINTS */
    @media (max-width: 1040px) {
      .sanctuary-grid {
        grid-template-columns: 1fr;
      }
      .sanctuary-hero {
        flex-direction: column;
        align-items: flex-start;
      }
      .hero-action-cluster {
        align-items: flex-start;
      }
      .ambient-strip {
        flex-wrap: wrap;
        gap: 1.2rem;
      }
      .ambient-divider {
        display: none;
      }
      .ambient-companion-hint {
        margin-left: 0;
        padding-left: 0;
        border-left: none;
        width: 100%;
        border-top: 1px dashed var(--color-border);
        padding-top: 0.8rem;
      }
    }

    /* Sanctuary Empty State (Untuk Akun Baru / Jadwal Kosong) */
    .sanctuary-empty-state {
      background: linear-gradient(180deg, #ffffff 0%, #faf8fd 100%);
      border: 1.5px dashed rgba(139, 92, 246, 0.28);
      border-radius: var(--radius-lg);
      padding: 3.5rem 2rem 2.5rem;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 20px rgba(24, 18, 38, 0.03);
      transition: all 0.2s ease;
      margin-top: 0.5rem;
    }

    .empty-icon-wrap {
      width: 54px;
      height: 54px;
      border-radius: 16px;
      background: linear-gradient(135deg, #f5edfd 0%, #ecdcf9 100%);
      color: var(--color-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1.1rem;
      border: 1px solid rgba(124, 58, 237, 0.16);
      box-shadow: 0 4px 14px rgba(124, 58, 237, 0.1);
    }

    .empty-title {
      font-size: 1.4rem;
      font-weight: 800;
      color: var(--color-text-main);
      letter-spacing: -0.02em;
      margin-bottom: 0.6rem;
    }

    .empty-subtitle {
      font-size: 0.94rem;
      color: var(--color-text-body);
      max-width: 480px;
      line-height: 1.6;
      margin-bottom: 1.8rem;
    }

    .empty-btn-group {
      display: flex;
      gap: 0.85rem;
      flex-wrap: wrap;
      justify-content: center;
      margin-bottom: 1.6rem;
    }

    .btn-empty-primary {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
      color: #ffffff;
      padding: 0.85rem 1.65rem;
      border-radius: var(--radius-full);
      font-family: inherit;
      font-weight: 700;
      font-size: 0.92rem;
      border: none;
      cursor: pointer;
      box-shadow: 0 6px 18px rgba(124, 58, 237, 0.28);
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .btn-empty-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 24px rgba(124, 58, 237, 0.38);
    }

    .btn-empty-primary:active {
      transform: translateY(0);
    }

    .btn-empty-secondary {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      background: #ffffff;
      color: var(--color-text-main);
      padding: 0.85rem 1.65rem;
      border-radius: var(--radius-full);
      font-family: inherit;
      font-weight: 600;
      font-size: 0.92rem;
      border: 1px solid var(--color-border);
      text-decoration: none;
      cursor: pointer;
      box-shadow: 0 2px 8px rgba(24, 18, 38, 0.04);
      transition: all 0.2s ease;
    }

    .btn-empty-secondary:hover {
      background: #faf8fd;
      border-color: var(--color-primary);
      transform: translateY(-1px);
    }

    .empty-tip-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      background: rgba(124, 58, 237, 0.06);
      padding: 0.45rem 1rem;
      border-radius: var(--radius-full);
      font-size: 0.78rem;
      color: var(--color-text-muted);
    }

    .tip-badge {
      background: var(--color-primary);
      color: #ffffff;
      font-size: 0.68rem;
      font-weight: 700;
      padding: 0.15rem 0.5rem;
      border-radius: 999px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    /* Radar Empty State */
    .empty-radar-card {
      padding: 2.2rem 1.2rem;
      text-align: center;
      background: var(--color-surface-subtle);
      border-radius: var(--radius-md);
      border: 1px dashed var(--color-border);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
    }

    .empty-radar-icon {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: #ecfdf5;
      color: #059669;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 0.2rem;
    }

    .empty-radar-heading {
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--color-text-main);
    }

    .empty-radar-text {
      font-size: 0.82rem;
      color: var(--color-text-muted);
      max-width: 260px;
      line-height: 1.45;
    }
  </style>

  <script>
    import { getCurrentUser, getUserData } from '../utils/db';

    function syncSanctuaryData() {
      const user = getCurrentUser();
      if (!user || !user.email) return;

      const data = getUserData(user.email);
      const isDemo = user.email.trim().toLowerCase() === 'daffaahmadalsch@student.ub.ac.id';

      const statNumbers = document.querySelectorAll('.ambient-stat .stat-number');
      const hintDesc = document.querySelector('.hint-desc');
      const heroTaskName = document.querySelector('.hero-task-name');
      const heroContext = document.querySelector('.hero-context');
      const emptyStateView = document.getElementById('empty-state-view');
      const timelineOl = document.getElementById('itinerary-timeline-list');
      const emptyHorizonView = document.getElementById('empty-horizon-view');
      const horizonList = document.getElementById('horizon-task-list');

      // JIKA PENGGUNA BARU DAN DATA JADWAL MASIH KOSONG:
      if (!isDemo && data.schedules.length === 0 && data.tasks.length === 0) {
        // 1. Tampilkan Empty State, sembunyikan list mock
        if (emptyStateView) emptyStateView.style.display = 'flex';
        if (timelineOl) timelineOl.style.display = 'none';
        if (emptyHorizonView) emptyHorizonView.style.display = 'flex';
        if (horizonList) horizonList.style.display = 'none';

        // 2. Nolkan indikator ambient
        if (statNumbers.length >= 3) {
          statNumbers[0].textContent = '0';
          statNumbers[1].textContent = '0';
          statNumbers[2].textContent = '0';
        }
        if (hintDesc) {
          hintDesc.textContent = 'Beavy AI siap menyusun alur fokus saat agenda pertamamu ditambahkan.';
        }

        // 3. Perbarui Hero Section
        if (heroTaskName) {
          heroTaskName.textContent = 'Belum Ada Agenda Hari Ini';
        }
        if (heroContext) {
          heroContext.innerHTML = 'Selamat datang, <strong>' + (user.name || 'Sahabat Beavy') + '</strong>! Akun Anda baru terdaftar. Jadwal dan tugas masih bersih. Mulai atur harimu dengan menambahkan tugas baru di bawah.';
        }
      } else {
        // PENGGUNA YANG MEMILIKI DATA ATAU DEMO USER:
        if (emptyStateView) emptyStateView.style.display = 'none';
        if (timelineOl) timelineOl.style.display = 'block';
        if (emptyHorizonView) emptyHorizonView.style.display = 'none';
        if (horizonList) horizonList.style.display = 'flex';

        if (!isDemo) {
          // Akun baru yang sudah menambahkan tugas sendiri
          if (statNumbers.length >= 3) {
            statNumbers[0].textContent = String(data.tasks.length);
            statNumbers[1].textContent = String(data.tasks.filter(t => t.urgent).length);
            statNumbers[2].textContent = String(data.schedules.length);
          }

          if (heroTaskName && data.tasks[0]) {
            heroTaskName.textContent = data.tasks[0].title;
          }

          if (timelineOl && data.schedules.length > 0) {
            timelineOl.innerHTML = data.schedules.map((s, idx) => `
              <li class="timeline-entry ${s.status || 'upcoming'}">
                <div class="entry-time-col">
                  <time class="time-clock">${s.time}</time>
                  <span class="time-span">${s.duration}</span>
                </div>
                <div class="entry-marker">
                  <div class="marker-circle ${idx === 0 ? 'pulse' : ''}"></div>
                  <div class="marker-stem"></div>
                </div>
                <div class="entry-card">
                  <div class="entry-header-row">
                    <div>
                      ${idx === 0 ? '<span class="entry-kicker">Fokus Terjadwal</span>' : ''}
                      <h3 class="entry-title">${s.title}</h3>
                    </div>
                    <span class="status-badge-soft">${s.tag || 'Tugas'}</span>
                  </div>
                  <p class="entry-desc">${s.desc}</p>
                </div>
              </li>
            `).join('');
          }

          if (horizonList && data.tasks.length > 0) {
            horizonList.innerHTML = data.tasks.map(t => `
              <li class="horizon-item">
                <div class="horizon-bullet ${t.urgent ? 'danger' : 'neutral'}"></div>
                <div class="horizon-info">
                  <span class="horizon-course">${t.category || 'Umum'}</span>
                  <h4 class="horizon-task">${t.title}</h4>
                </div>
                <time class="horizon-time">${t.deadline || 'Hari ini'}</time>
              </li>
            `).join('');
          }
        }
      }
    }

    // Jalankan sinkronisasi saat halaman dimuat
    const clientNow = new Date();
    const HARI_STR = ['Minggu', 'Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'];
    const BULAN_STR = [
      'Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni',
      'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'
    ];
    const dateCaptionEl = document.getElementById('beranda-date-caption');
    if (dateCaptionEl) {
      dateCaptionEl.textContent = `${HARI_STR[clientNow.getDay()]}, ${clientNow.getDate()} ${BULAN_STR[clientNow.getMonth()]} ${clientNow.getFullYear()} : Ritme berimbang akademik dan istirahat`;
    }

    syncSanctuaryData();

    // Dengarkan pembaruan data jika tugas baru ditambahkan
    window.addEventListener('jadwalin-data-updated', syncSanctuaryData);
  </script>
</DashboardLayout>
