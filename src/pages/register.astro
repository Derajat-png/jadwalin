---
// src/pages/register.astro
import { Image } from 'astro:assets';
import logoImg from '../assets/jadwal.in.png';
import mascotImg from '../assets/craiyon.png';
import '../styles/tokens.css';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/jadwal.in.png" />
    <title>Daftar Akun Baru — Jadwal.in</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        min-height: 100vh;
        background: linear-gradient(135deg, #FDF4E7 0%, #E8D9F3 40%, #CFC4E8 75%, #EBDDF5 100%);
        color: #23163d;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
      }

      .auth-container {
        width: 100%;
        max-width: 1080px;
        background: rgba(255, 255, 255, 0.94);
        backdrop-filter: blur(24px);
        border: 1px solid rgba(226, 218, 238, 0.8);
        border-radius: 28px;
        box-shadow: 0 20px 48px rgba(24, 18, 38, 0.08), 0 4px 12px rgba(24, 18, 38, 0.04);
        display: grid;
        grid-template-columns: 1fr 1.2fr;
        overflow: hidden;
      }

      /* Left Side */
      .auth-visual-side {
        background: linear-gradient(145deg, #f5edfd 0%, #ecdcf9 50%, #f7effe 100%);
        padding: 3rem 2.5rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        border-right: 1px solid rgba(139, 92, 246, 0.12);
      }

      .brand-top {
        display: flex;
        align-items: center;
        gap: 0.8rem;
      }

      .logo-img {
        height: 52px;
        width: auto;
      }

      .visual-content {
        text-align: center;
        padding: 2rem 0;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .mascot-wrap {
        width: 190px;
        height: 190px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.8);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 12px 30px rgba(24, 18, 38, 0.06);
        margin-bottom: 1.4rem;
        border: 1px solid rgba(255, 255, 255, 0.9);
      }

      .mascot-img {
        width: 140px;
        height: auto;
        object-fit: contain;
      }

      .visual-title {
        font-size: 1.45rem;
        font-weight: 800;
        color: #1e1335;
        letter-spacing: -0.3px;
        margin-bottom: 0.5rem;
      }

      .visual-desc {
        font-size: 0.85rem;
        color: #64557f;
        line-height: 1.45;
        max-width: 300px;
      }

      .visual-quote-pill {
        background: rgba(255, 255, 255, 0.9);
        border: 1px solid rgba(139, 92, 246, 0.2);
        padding: 0.6rem 1rem;
        border-radius: 999px;
        font-size: 0.78rem;
        color: #7c3aed;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 0.55rem;
      }

      .quote-icon {
        color: #8b5cf6;
        display: flex;
        align-items: center;
      }

      /* Right Side: Register Form (Figma Match) */
      .auth-form-side {
        padding: 2.5rem 3.2rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .form-header {
        margin-bottom: 1.5rem;
      }

      .form-title {
        font-size: 1.75rem;
        font-weight: 800;
        color: #1e1335;
        letter-spacing: -0.3px;
      }

      .form-subtitle {
        font-size: 0.88rem;
        color: #796c92;
        margin-top: 0.25rem;
      }

      .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        margin-bottom: 0.95rem;
      }

      .form-label {
        font-size: 0.84rem;
        font-weight: 700;
        color: #3b2b57;
      }

      .form-input {
        width: 100%;
        padding: 0.78rem 1rem;
        border: 1.5px solid #ded5eb;
        border-radius: 12px;
        font-family: inherit;
        font-size: 0.92rem;
        color: #1e1335;
        background: #fdfcff;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
      }

      .form-input:focus {
        border-color: #8b5cf6;
        box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.12);
      }

      .form-grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.9rem;
      }

      .remember-wrap {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.82rem;
        color: #5d4e78;
        cursor: pointer;
        margin-bottom: 1.2rem;
      }

      .remember-wrap input {
        accent-color: #8b5cf6;
        width: 16px;
        height: 16px;
      }

      .btn-submit-register {
        width: 100%;
        padding: 0.9rem;
        border-radius: 999px;
        border: none;
        background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
        color: white;
        font-size: 0.98rem;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 4px 14px rgba(24, 18, 38, 0.12);
        transition: transform 0.2s, box-shadow 0.2s;
        margin-bottom: 1.2rem;
      }

      .btn-submit-register:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(24, 18, 38, 0.16);
      }

      .divider-line {
        display: flex;
        align-items: center;
        text-align: center;
        margin-bottom: 1.1rem;
        color: #9c8eaf;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.6px;
      }

      .divider-line::before, .divider-line::after {
        content: '';
        flex: 1;
        border-bottom: 1px solid #ebdff5;
      }

      .divider-line span {
        padding: 0 0.8rem;
      }

      .social-buttons-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.8rem;
        margin-bottom: 1.2rem;
      }

      .btn-social {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.7rem;
        border-radius: 12px;
        border: 1.5px solid #ded4eb;
        background: white;
        font-size: 0.85rem;
        font-weight: 700;
        color: #483963;
        cursor: pointer;
        transition: all 0.2s;
      }

      .btn-social:hover {
        border-color: #8b5cf6;
        background: #fbf9ff;
        transform: translateY(-1px);
      }

      .auth-switch-text {
        text-align: center;
        font-size: 0.85rem;
        color: #73648e;
      }

      .auth-switch-text a {
        color: #7c3aed;
        font-weight: 700;
        text-decoration: none;
      }

      .auth-switch-text a:hover {
        text-decoration: underline;
      }

      /* In-Page Toast */
      .auth-toast {
        position: fixed;
        bottom: 2rem;
        left: 50%;
        transform: translateX(-50%) translateY(30px);
        background: #1e1335;
        color: white;
        padding: 0.75rem 1.4rem;
        border-radius: 999px;
        font-size: 0.85rem;
        font-weight: 600;
        box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        opacity: 0;
        pointer-events: none;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        z-index: 1000;
      }

      .auth-toast.show {
        opacity: 1;
        transform: translateX(-50%) translateY(0);
      }

      @media (max-width: 860px) {
        .auth-container {
          grid-template-columns: 1fr;
        }
        .auth-visual-side {
          display: none;
        }
        .auth-form-side {
          padding: 2.2rem 1.8rem;
        }
        .form-grid-2 {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <div class="auth-container">
      <!-- 1. LEFT VISUAL SIDE -->
      <div class="auth-visual-side">
        <div class="brand-top">
          <a href="/">
            <Image src={logoImg} alt="Jadwal.in" class="logo-img" loading="eager" />
          </a>
        </div>

        <div class="visual-content">
          <div class="mascot-wrap">
            <Image src={mascotImg} alt="Beavy" class="mascot-img" loading="eager" />
          </div>
          <h2 class="visual-title">Mulai Bareng Beavy</h2>
          <p class="visual-desc">
            Gabung bersama ribuan mahasiswa yang harinya lebih teratur dan tenang berkat asisten jadwal cerdas.
          </p>
        </div>

        <div class="visual-quote-pill">
          <span class="quote-icon">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
          </span>
          <span>"Rencanakan hari ini, bebas stres besok!"</span>
        </div>
      </div>

      <!-- 2. RIGHT REGISTER FORM (Figma Frame 55:867) -->
      <div class="auth-form-side">
        <div class="form-header">
          <h1 class="form-title">Daftar Akun Baru</h1>
          <p class="form-subtitle">Buat akun Jadwal.in gratis dalam 1 menit</p>
        </div>

        <form id="register-form">
          <div class="form-group">
            <label class="form-label" for="username">Username / Nama Lengkap</label>
            <input type="text" id="username" class="form-input" placeholder="Nama Lengkapmu" required />
          </div>

          <div class="form-group">
            <label class="form-label" for="email">Email Kampus / Pribadi</label>
            <input type="email" id="email" class="form-input" placeholder="nama@student.ub.ac.id" required />
          </div>

          <div class="form-grid-2">
            <div class="form-group">
              <label class="form-label" for="password">Kata Sandi</label>
              <input type="password" id="password" class="form-input" placeholder="Minimal 8 karakter" required />
            </div>

            <div class="form-group">
              <label class="form-label" for="confirm-password">Konfirmasi Sandi</label>
              <input type="password" id="confirm-password" class="form-input" placeholder="Ulangi kata sandi" required />
            </div>
          </div>

          <label class="remember-wrap">
            <input type="checkbox" id="terms" required />
            <span>Saya setuju dengan Ketentuan Layanan & Kebijakan Privasi</span>
          </label>

          <button type="submit" class="btn-submit-register">
            Daftar Akun Baru
          </button>

          <div class="divider-line">
            <span>ATAU DAFTAR DENGAN</span>
          </div>

          <div class="social-buttons-grid">
            <button type="button" class="btn-social" id="btn-google-reg">
              <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#EA4335" d="M12 5c1.7 0 3 .7 3.9 1.5l2.9-2.9C17 1.9 14.7 1 12 1 7.5 1 3.7 3.6 1.9 7.3l3.7 2.9C6.5 7.4 9 5 12 5z"/><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.7-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.8-2.4 3.7l3.7 2.9c2.2-2 3.7-5 3.7-8.8z"/><path fill="#FBBC05" d="M5.6 14.8c-.2-.7-.4-1.5-.4-2.3 0-.8.1-1.6.4-2.3L1.9 7.3C.7 9.7 0 12.3 0 15.2c0 2.8.7 5.4 1.9 7.8l3.7-3.2z"/><path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3 0-5.5-2-6.4-4.8L1.9 17.6C3.7 21.4 7.5 24 12 24z"/></svg>
              <span>Google</span>
            </button>
            <button type="button" class="btn-social" id="btn-apple-reg">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.42c.64-.78 1.08-1.86.96-2.94-.93.04-2.05.62-2.72 1.4-.59.68-1.11 1.77-.97 2.83 1.04.08 2.09-.51 2.73-1.29z"/></svg>
              <span>Apple</span>
            </button>
          </div>

          <p class="auth-switch-text">
            Sudah punya akun? <a href="/login">Masuk di sini</a>
          </p>
        </form>
      </div>
    </div>

    <!-- Toast Component -->
    <div id="auth-toast" class="auth-toast"></div>

    <script>
      const form = document.getElementById('register-form');
      const authToast = document.getElementById('auth-toast');

      function showToast(msg: string) {
        if (!authToast) return;
        authToast.textContent = msg;
        authToast.classList.add('show');
        setTimeout(() => {
          authToast.classList.remove('show');
        }, 3200);
      }

      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        showToast('Akun berhasil dibuat! Mengalihkan ke Beranda...');
        setTimeout(() => {
          window.location.href = '/beranda';
        }, 900);
      });

      document.getElementById('btn-google-reg')?.addEventListener('click', () => {
        showToast('Mendaftarkan akun dengan Google SSO...');
        setTimeout(() => {
          window.location.href = '/beranda';
        }, 800);
      });

      document.getElementById('btn-apple-reg')?.addEventListener('click', () => {
        showToast('Mendaftarkan akun dengan Apple ID...');
        setTimeout(() => {
          window.location.href = '/beranda';
        }, 800);
      });
    </script>
  </body>
</html>
