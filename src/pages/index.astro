---
// src/pages/index.astro
import { Image } from 'astro:assets';
import logoImg from '../assets/jadwal.in.png';
import mascotImg from '../assets/craiyon.png';
import '../styles/tokens.css';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/jadwal.in.png" />
    <title>Jadwal.in — Asisten Jadwal Cerdas</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      ::selection {
        background: #ede9fe;
        color: #5b21b6;
      }

      :focus-visible {
        outline: 2px solid #7c3aed;
        outline-offset: 3px;
      }

      body {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        min-height: 100vh;
        background: linear-gradient(135deg, #FDF4E7 0%, #E8D9F3 40%, #CFC4E8 75%, #EBDDF5 100%);
        color: #251c3e;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
      }

      /* ====================================================
         1. LOADING SCREEN
         ==================================================== */
      #loading-screen {
        position: fixed;
        inset: 0;
        z-index: 999;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #CFC4E8 0%, #E8D9F3 50%, #EBDDF5 100%);
        transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.5s ease;
      }

      #loading-screen.hidden {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }

      .loading-logo {
        width: 250px;
        max-width: 75vw;
        height: auto;
        animation: pulseLogo 1.8s ease-in-out infinite;
      }

      @keyframes pulseLogo {
        0%, 100% {
          transform: scale(1);
          opacity: 0.95;
        }
        50% {
          transform: scale(1.04);
          opacity: 1;
        }
      }

      /* ====================================================
         2. ONBOARDING CONTAINER
         ==================================================== */
      .onboarding-wrapper {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 1.5rem 2rem 2rem;
        max-width: 1100px;
        margin: 0 auto;
      }

      /* Header */
      .onboarding-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        padding-bottom: 1rem;
      }

      .header-logo {
        height: 54px;
        width: auto;
        object-fit: contain;
      }

      .header-nav {
        display: flex;
        gap: 0.6rem;
        align-items: center;
      }

      .btn-skip {
        background: none;
        border: 1px solid transparent;
        color: #5c4d79;
        font-family: inherit;
        font-size: 0.92rem;
        font-weight: 700;
        cursor: pointer;
        padding: 0.55rem 0.95rem;
        min-height: 44px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: all 0.2s ease;
      }

      .btn-skip:hover {
        color: #6d28d9;
        background: rgba(255, 255, 255, 0.55);
        border-color: rgba(255, 255, 255, 0.8);
      }

      .btn-skip-primary {
        color: #6d28d9;
        background: rgba(255, 255, 255, 0.45);
      }

      /* Main Onboarding Layout (Desktop: 2 Columns Side-by-Side) */
      .onboarding-main {
        flex: 1;
        display: grid;
        grid-template-columns: 1.05fr 1fr;
        align-items: center;
        gap: 3.5rem;
        padding: 1.5rem 0;
      }

      /* Left Side: Illustration & Badges */
      .illustration-col {
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
      }

      .mascot-stage {
        position: relative;
        width: 380px;
        height: 380px;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      /* Circular Aura Ring */
      .aura-ring {
        position: absolute;
        width: 340px;
        height: 340px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.35);
        border: 2px solid rgba(255, 255, 255, 0.7);
        box-shadow: 0 10px 40px rgba(138, 92, 246, 0.08);
      }

      /* Mascot Image */
      .mascot-img {
        position: relative;
        z-index: 2;
        width: 250px;
        height: auto;
        filter: drop-shadow(0 15px 25px rgba(93, 44, 150, 0.15));
      }

      /* Floating Badge 1: Top-Right Sparkle */
      .badge-sparkle {
        position: absolute;
        top: 48px;
        right: 32px;
        z-index: 3;
        width: 44px;
        height: 44px;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        border: 1.5px solid rgba(255, 255, 255, 0.95);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #7c3aed;
        box-shadow: 0 8px 20px rgba(123, 66, 246, 0.14);
        animation: gentleBob 3.5s ease-in-out infinite 0.5s;
      }

      /* Floating Badge 2: Bottom-Left "Ada waktu buat kamu" */
      .badge-time {
        position: absolute;
        bottom: 58px;
        left: 20px;
        z-index: 3;
        display: flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.6rem 1.1rem;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(12px);
        border: 1.5px solid rgba(255, 255, 255, 0.95);
        border-radius: 999px;
        box-shadow: 0 8px 24px rgba(100, 70, 140, 0.12);
        transform: rotate(-3deg);
        animation: gentleBob 4.2s ease-in-out infinite;
        white-space: nowrap;
      }

      .badge-time svg {
        color: #7c3aed;
        flex-shrink: 0;
      }

      .badge-time span {
        font-size: 0.82rem;
        font-weight: 700;
        color: #3b2857;
      }

      @keyframes gentleBob {
        0%, 100% {
          transform: translateY(0px) rotate(-3deg);
        }
        50% {
          transform: translateY(-5px) rotate(-1.5deg);
        }
      }

      /* Right Side: The Onboarding Card */
      .card-col {
        display: flex;
        justify-content: center;
      }

      .onboarding-card {
        background: #ffffff;
        border: 1px solid rgba(226, 218, 238, 0.7);
        border-radius: 24px;
        padding: 2.8rem 2.4rem;
        box-shadow: 0 12px 36px rgba(93, 44, 150, 0.08);
        width: 100%;
        max-width: 460px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }

      /* Heading */
      .card-title {
        font-size: 1.85rem;
        font-weight: 800;
        line-height: 1.25;
        letter-spacing: -0.3px;
        color: #1e1335;
        margin-bottom: 0.9rem;
        text-wrap: balance;
      }

      /* Description */
      .card-desc {
        font-size: 0.95rem;
        line-height: 1.6;
        color: #55486d;
        margin-bottom: 2rem;
        min-height: 48px;
        text-wrap: pretty;
      }

      /* Pagination Dots with Accessible 44px Touch Targets (WCAG 2.5.8) */
      .dots-nav {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        margin-bottom: 1.8rem;
      }

      .dot {
        position: relative;
        width: 8px;
        height: 8px;
        min-width: 8px;
        border-radius: 50%;
        background: #c7b9dd;
        border: none;
        cursor: pointer;
        padding: 0;
        transition: width 0.25s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.25s ease;
      }

      /* 44px minimum hit target */
      .dot::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 44px;
        height: 44px;
      }

      .dot:hover {
        background: #9d8db8;
      }

      .dot.active {
        width: 26px;
        border-radius: 999px;
        background: #7c3aed;
      }

      .dot:focus-visible {
        outline: 2px solid #7c3aed;
        outline-offset: 4px;
      }

      /* Primary Button */
      .btn-primary {
        width: 100%;
        min-height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
        color: #ffffff;
        font-family: inherit;
        font-size: 1rem;
        font-weight: 700;
        padding: 0.85rem 1.8rem;
        border: none;
        border-radius: 999px;
        cursor: pointer;
        box-shadow: 0 8px 22px rgba(124, 58, 237, 0.28);
        transition: transform 0.2s, box-shadow 0.2s;
        margin-bottom: 1.2rem;
      }

      .btn-primary:hover {
        transform: translateY(-1px);
        box-shadow: 0 12px 26px rgba(124, 58, 237, 0.38);
      }

      .btn-primary:active {
        transform: translateY(0);
      }

      /* Footer Step Note - High Contrast (WCAG AA Compliant) */
      .step-footer {
        font-size: 0.82rem;
        color: #5e4f75;
        font-weight: 600;
      }

      /* ====================================================
         3. MOTION HARDENING (prefers-reduced-motion)
         ==================================================== */
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }

        .badge-sparkle,
        .badge-time,
        .loading-logo {
          animation: none !important;
        }

        #loading-screen {
          transition: none !important;
        }
      }

      /* ====================================================
         4. RESPONSIVE BREAKPOINT
         ==================================================== */
      @media (max-width: 820px) {
        .onboarding-wrapper {
          padding: 1.2rem 1.2rem 1.5rem;
        }

        .header-logo {
          height: 46px;
        }

        .onboarding-main {
          grid-template-columns: 1fr;
          gap: 1.5rem;
          padding: 0.5rem 0;
        }

        .mascot-stage {
          width: 290px;
          height: 290px;
        }

        .aura-ring {
          width: 260px;
          height: 260px;
        }

        .mascot-img {
          width: 200px;
        }

        .badge-sparkle {
          top: 25px;
          right: 18px;
          width: 38px;
          height: 38px;
        }

        .badge-time {
          bottom: 35px;
          left: 5px;
          padding: 0.45rem 0.85rem;
        }

        .badge-time span {
          font-size: 0.75rem;
        }

        .onboarding-card {
          border-radius: 20px;
          padding: 2.2rem 1.5rem;
          max-width: 100%;
        }

        .card-title {
          font-size: 1.55rem;
        }
      }
    </style>
  </head>
  <body>
    <!-- 1. LOADING SCREEN -->
    <div id="loading-screen" role="status" aria-label="Memuat aplikasi Jadwal.in">
      <Image src={logoImg} alt="jadwal.in" class="loading-logo" loading="eager" />
    </div>

    <!-- 2. ONBOARDING SECTION -->
    <div class="onboarding-wrapper">
      <!-- Header -->
      <header class="onboarding-header">
        <a href="/" aria-label="Beranda Jadwal.in">
          <Image src={logoImg} alt="jadwal.in" class="header-logo" loading="eager" />
        </a>
        <nav class="header-nav" aria-label="Navigasi cepat">
          <a href="/login" class="btn-skip btn-skip-primary">Masuk</a>
          <button id="btn-skip" class="btn-skip" type="button" aria-label="Lewati pengenalan dan buka beranda">Lewati</button>
        </nav>
      </header>

      <!-- Main Section (Desktop 2-Column / Mobile Stacked) -->
      <main class="onboarding-main">
        <!-- Left: Illustration -->
        <div class="illustration-col">
          <div class="mascot-stage">
            <!-- Halo Circle Aura -->
            <div class="aura-ring" aria-hidden="true"></div>

            <!-- Top-Right Sparkle Badge -->
            <div class="badge-sparkle" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2l2.4 7.2L22 12l-7.6 2.8L12 22l-2.8-7.2L2 12l7.2-2.8z"></path>
              </svg>
            </div>

            <!-- Mascot Beavy -->
            <Image 
              src={mascotImg} 
              alt="Maskot Beavy Asisten AI Jadwalin" 
              class="mascot-img" 
              loading="eager"
            />

            <!-- Bottom-Left Time Badge -->
            <div class="badge-time" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              <span id="badge-text">Ada waktu buat kamu</span>
            </div>
          </div>
        </div>

        <!-- Right: Content Card -->
        <div class="card-col">
          <div class="onboarding-card" aria-live="polite">
            <h1 id="card-title" class="card-title">
              Hai, aku Beavy<br />asisten AI untukmu
            </h1>

            <p id="card-desc" class="card-desc">
              Biar Beavy bantu atur tugas dan jadwalmu. Kamu tinggal fokus, satu per satu.
            </p>

            <!-- 3 Dots Indicator (Accessible Tablist) -->
            <div class="dots-nav" role="tablist" aria-label="Langkah pengenalan">
              <button class="dot active" role="tab" data-step="0" aria-selected="true" aria-label="Langkah 1 dari 3: Perkenalan Beavy"></button>
              <button class="dot" role="tab" data-step="1" aria-selected="false" aria-label="Langkah 2 dari 3: Penjadwalan Otomatis"></button>
              <button class="dot" role="tab" data-step="2" aria-selected="false" aria-label="Langkah 3 dari 3: Siap Mulai"></button>
            </div>

            <!-- Action Button -->
            <button id="btn-next" class="btn-primary" type="button" aria-controls="card-title card-desc">
              <span id="btn-text">Lanjut</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>

            <!-- Footnote Step Progress -->
            <p id="step-footer" class="step-footer" aria-atomic="true">
              1 dari 3 · Mulai pelan, jadi kebiasaan
            </p>
          </div>
        </div>
      </main>
    </div>

    <script>
      // 1. Loading screen auto fade-out
      window.addEventListener('DOMContentLoaded', () => {
        setTimeout(() => {
          const loadingScreen = document.getElementById('loading-screen');
          if (loadingScreen) {
            loadingScreen.classList.add('hidden');
            loadingScreen.setAttribute('aria-hidden', 'true');
          }
        }, 1200);
      });

      // 2. Data Onboarding 3 Langkah
      const steps = [
        {
          title: "Hai, aku Beavy<br />asisten AI untukmu",
          desc: "Biar Beavy bantu atur tugas dan jadwalmu. Kamu tinggal fokus, satu per satu.",
          badge: "Ada waktu buat kamu",
          button: "Lanjut",
          footer: "1 dari 3 · Mulai pelan, jadi kebiasaan"
        },
        {
          title: "Jadwalkan agenda & tugas secara otomatis",
          desc: "Atur prioritas harianmu tanpa ribet. Beavy siap mengingatkan setiap saat.",
          badge: "Produktif setiap hari",
          button: "Lanjut",
          footer: "2 dari 3 · Langkah demi langkah"
        },
        {
          title: "Siap wujudkan hari yang lebih teratur?",
          desc: "Semua jadwalmu rapi dalam satu tempat. Yuk mulai petualangan produktifmu!",
          badge: "Siap meluncur!",
          button: "Mulai Sekarang",
          footer: "3 dari 3 · Waktumu, kendalimu"
        }
      ];

      let currentStep = 0;

      const titleEl = document.getElementById('card-title');
      const descEl = document.getElementById('card-desc');
      const badgeTextEl = document.getElementById('badge-text');
      const btnTextEl = document.getElementById('btn-text');
      const footerEl = document.getElementById('step-footer');
      const dots = document.querySelectorAll('.dot');
      const btnNext = document.getElementById('btn-next');
      const btnSkip = document.getElementById('btn-skip');

      function renderStep(index: number) {
        currentStep = index;
        const data = steps[currentStep];

        if (titleEl) titleEl.innerHTML = data.title;
        if (descEl) descEl.textContent = data.desc;
        if (badgeTextEl) badgeTextEl.textContent = data.badge;
        if (btnTextEl) btnTextEl.textContent = data.button;
        if (footerEl) footerEl.textContent = data.footer;

        dots.forEach((dot, idx) => {
          if (idx === currentStep) {
            dot.classList.add('active');
            dot.setAttribute('aria-selected', 'true');
          } else {
            dot.classList.remove('active');
            dot.setAttribute('aria-selected', 'false');
          }
        });
      }

      btnNext?.addEventListener('click', () => {
        if (currentStep < steps.length - 1) {
          renderStep(currentStep + 1);
        } else {
          window.location.href = '/beranda';
        }
      });

      btnSkip?.addEventListener('click', () => {
        window.location.href = '/beranda';
      });

      dots.forEach((dot) => {
        dot.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const targetStep = Number(target.dataset.step) || 0;
          renderStep(targetStep);
        });

        // Keyboard arrow navigation
        dot.addEventListener('keydown', (e) => {
          const keyEvent = e as KeyboardEvent;
          if (keyEvent.key === 'ArrowRight' && currentStep < steps.length - 1) {
            renderStep(currentStep + 1);
            (dots[currentStep] as HTMLElement)?.focus();
          } else if (keyEvent.key === 'ArrowLeft' && currentStep > 0) {
            renderStep(currentStep - 1);
            (dots[currentStep] as HTMLElement)?.focus();
          }
        });
      });
    </script>
  </body>
</html>
