---
// src/pages/index.astro
import { Image } from 'astro:assets';
import logoImg from '../assets/jadwal.in.png';
import mascotImg from '../assets/craiyon.png';
import '../styles/tokens.css';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/jadwal.in.png" />
    <title>Jadwal.in — Asisten Jadwal Cerdas</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: var(--font-sans);
        min-height: 100vh;
        background-color: var(--color-canvas);
        background-image: 
          radial-gradient(at 0% 0%, rgba(232, 217, 243, 0.45) 0px, transparent 50%),
          radial-gradient(at 100% 0%, rgba(253, 244, 231, 0.55) 0px, transparent 50%),
          radial-gradient(at 50% 100%, rgba(207, 196, 232, 0.35) 0px, transparent 60%);
        background-attachment: fixed;
        color: var(--color-text-main);
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      /* ====================================================
         1. LOADING SCREEN
         ==================================================== */
      #loading-screen {
        position: fixed;
        inset: 0;
        z-index: 999;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #cfc4e8 0%, #e8d9f3 50%, #ebddf5 100%);
        transition: opacity 0.5s var(--ease-out-smooth), visibility 0.5s ease;
      }

      #loading-screen.hidden {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }

      .loading-logo {
        width: 250px;
        max-width: 75vw;
        height: auto;
        animation: pulseLogo 1.8s ease-in-out infinite;
      }

      @keyframes pulseLogo {
        0%, 100% {
          transform: scale(1);
          opacity: 0.95;
        }
        50% {
          transform: scale(1.04);
          opacity: 1;
        }
      }

      /* ====================================================
         2. ONBOARDING CONTAINER
         ==================================================== */
      .onboarding-wrapper {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 1.5rem 2rem 2.2rem;
        max-width: 1100px;
        margin: 0 auto;
      }

      /* Header */
      .onboarding-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        padding-bottom: 1rem;
      }

      .header-logo {
        height: 52px;
        width: auto;
        object-fit: contain;
      }

      .header-nav {
        display: flex;
        gap: 0.6rem;
        align-items: center;
      }

      .btn-skip {
        background: none;
        border: 1px solid transparent;
        color: var(--color-text-body);
        font-family: inherit;
        font-size: 0.92rem;
        font-weight: 700;
        cursor: pointer;
        padding: 0.55rem 1rem;
        min-height: 44px;
        border-radius: var(--radius-md);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: all 0.2s ease;
      }

      .btn-skip:hover {
        color: var(--color-primary-dark);
        background: rgba(255, 255, 255, 0.65);
        border-color: var(--color-border);
      }

      .btn-skip-primary {
        color: var(--color-primary-dark);
        background: rgba(255, 255, 255, 0.5);
      }

      /* Main Onboarding Layout (Desktop: 2 Columns Side-by-Side) */
      .onboarding-main {
        flex: 1;
        display: grid;
        grid-template-columns: 1.05fr 1fr;
        align-items: center;
        gap: 3.5rem;
        padding: 1.5rem 0;
      }

      /* Left Side: Illustration & Badges */
      .illustration-col {
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
      }

      .mascot-stage {
        position: relative;
        width: 380px;
        height: 380px;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      /* Circular Aura Ring */
      .aura-ring {
        position: absolute;
        width: 340px;
        height: 340px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.4);
        border: 2px solid rgba(255, 255, 255, 0.75);
        box-shadow: 0 10px 40px rgba(124, 58, 237, 0.08);
      }

      /* Mascot Image */
      .mascot-img {
        position: relative;
        z-index: 2;
        width: 250px;
        height: auto;
        filter: drop-shadow(0 15px 25px rgba(93, 44, 150, 0.16));
      }

      /* Floating Badge 1: Top-Right Sparkle */
      .badge-sparkle {
        position: absolute;
        top: 48px;
        right: 32px;
        z-index: 3;
        width: 44px;
        height: 44px;
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(12px);
        border: 1.5px solid rgba(255, 255, 255, 0.95);
        border-radius: var(--radius-md);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-primary);
        box-shadow: 0 8px 20px rgba(124, 58, 237, 0.12);
        animation: gentleBob 3.5s ease-in-out infinite 0.5s;
      }

      /* Floating Badge 2: Bottom-Left "Ada waktu buat kamu" */
      .badge-time {
        position: absolute;
        bottom: 58px;
        left: 20px;
        z-index: 3;
        display: flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.6rem 1.15rem;
        background: rgba(255, 255, 255, 0.94);
        backdrop-filter: blur(12px);
        border: 1.5px solid rgba(255, 255, 255, 0.95);
        border-radius: var(--radius-full);
        box-shadow: 0 8px 24px rgba(100, 70, 140, 0.12);
        transform: rotate(-3deg);
        animation: gentleBob 4.2s ease-in-out infinite;
        white-space: nowrap;
      }

      .badge-time svg {
        color: var(--color-primary);
        flex-shrink: 0;
      }

      .badge-time span {
        font-size: 0.82rem;
        font-weight: 700;
        color: var(--color-text-main);
      }

      @keyframes gentleBob {
        0%, 100% {
          transform: translateY(0px) rotate(-3deg);
        }
        50% {
          transform: translateY(-5px) rotate(-1.5deg);
        }
      }

      /* Right Side: The Onboarding Card */
      .card-col {
        display: flex;
        justify-content: center;
      }

      .onboarding-card {
        background: rgba(255, 255, 255, 0.96);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(226, 218, 238, 0.75);
        border-radius: var(--radius-xl);
        padding: 2.8rem 2.4rem;
        box-shadow: var(--shadow-md);
        width: 100%;
        max-width: 460px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }

      .card-content-wrap {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        transition: opacity 0.18s var(--ease-out-smooth), transform 0.18s var(--ease-out-smooth);
      }

      .card-content-wrap.transitioning {
        opacity: 0;
        transform: translateY(6px);
      }

      /* Heading */
      .card-title {
        font-size: 1.85rem;
        font-weight: 800;
        line-height: 1.25;
        letter-spacing: -0.025em;
        color: var(--color-text-main);
        margin-bottom: 0.85rem;
        text-wrap: balance;
        min-height: 72px;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      /* Description */
      .card-desc {
        font-size: 0.95rem;
        line-height: 1.6;
        color: var(--color-text-body);
        margin-bottom: 2rem;
        min-height: 50px;
        text-wrap: pretty;
      }

      /* Pagination Dots with Accessible 44px Touch Targets */
      .dots-nav {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        margin-bottom: 1.8rem;
      }

      .dot {
        position: relative;
        width: 8px;
        height: 8px;
        min-width: 8px;
        border-radius: 50%;
        background: #c7b9dd;
        border: none;
        cursor: pointer;
        padding: 0;
        transition: width 0.25s var(--ease-out-smooth), background-color 0.25s ease;
      }

      /* 44px touch area (WCAG 2.5.8) */
      .dot::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 44px;
        height: 44px;
      }

      .dot:hover {
        background: #9d8db8;
      }

      .dot.active {
        width: 26px;
        border-radius: var(--radius-full);
        background: var(--color-primary);
      }

      .dot:focus-visible {
        outline: 2px solid var(--color-primary);
        outline-offset: 4px;
      }

      /* Primary Button */
      .btn-primary {
        width: 100%;
        min-height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        background: linear-gradient(135deg, #8b5cf6 0%, var(--color-primary) 100%);
        color: #ffffff;
        font-family: inherit;
        font-size: 0.98rem;
        font-weight: 700;
        padding: 0.85rem 1.8rem;
        border: none;
        border-radius: var(--radius-full);
        cursor: pointer;
        box-shadow: 0 8px 22px rgba(124, 58, 237, 0.28);
        transition: transform 0.2s, box-shadow 0.2s;
        margin-bottom: 1.2rem;
      }

      .btn-primary:hover {
        transform: translateY(-1px);
        box-shadow: 0 12px 26px rgba(124, 58, 237, 0.38);
      }

      .btn-primary:active {
        transform: translateY(0);
      }

      /* Footer Step Note - High Contrast */
      .step-footer {
        font-size: 0.82rem;
        color: var(--color-text-muted);
        font-weight: 600;
      }

      /* ====================================================
         3. MOTION HARDENING (prefers-reduced-motion)
         ==================================================== */
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }

        .badge-sparkle,
        .badge-time,
        .loading-logo {
          animation: none !important;
        }

        #loading-screen {
          transition: none !important;
        }

        .card-content-wrap {
          transition: none !important;
        }
      }

      /* ====================================================
         4. RESPONSIVE BREAKPOINT
         ==================================================== */
      @media (max-width: 820px) {
        .onboarding-wrapper {
          padding: 1.2rem 1.2rem 1.5rem;
        }

        .header-logo {
          height: 46px;
        }

        .onboarding-main {
          grid-template-columns: 1fr;
          gap: 1.5rem;
          padding: 0.5rem 0;
        }

        .mascot-stage {
          width: 290px;
          height: 290px;
        }

        .aura-ring {
          width: 260px;
          height: 260px;
        }

        .mascot-img {
          width: 200px;
        }

        .badge-sparkle {
          top: 25px;
          right: 18px;
          width: 38px;
          height: 38px;
        }

        .badge-time {
          bottom: 35px;
          left: 5px;
          padding: 0.45rem 0.85rem;
        }

        .badge-time span {
          font-size: 0.75rem;
        }

        .onboarding-card {
          border-radius: var(--radius-lg);
          padding: 2.2rem 1.5rem;
          max-width: 100%;
        }

        .card-title {
          font-size: 1.55rem;
          min-height: 56px;
        }
      }
    </style>
  </head>
  <body>
    <!-- 1. LOADING SCREEN -->
    <div id="loading-screen" role="status" aria-label="Memuat aplikasi Jadwal.in">
      <Image src={logoImg} alt="jadwal.in" class="loading-logo" loading="eager" />
    </div>

    <!-- 2. ONBOARDING SECTION -->
    <div class="onboarding-wrapper">
      <!-- Header -->
      <header class="onboarding-header">
        <a href="/" aria-label="Beranda Jadwal.in">
          <Image src={logoImg} alt="jadwal.in" class="header-logo" loading="eager" />
        </a>
        <nav class="header-nav" aria-label="Navigasi cepat">
          <a href="/login" class="btn-skip btn-skip-primary">Masuk</a>
          <button id="btn-skip" class="btn-skip" type="button" aria-label="Lewati pengenalan dan masuk">Lewati</button>
        </nav>
      </header>

      <!-- Main Section (Desktop 2-Column / Mobile Stacked) -->
      <main class="onboarding-main">
        <!-- Left: Illustration -->
        <div class="illustration-col">
          <div class="mascot-stage">
            <!-- Halo Circle Aura -->
            <div class="aura-ring" aria-hidden="true"></div>

            <!-- Top-Right Sparkle Badge -->
            <div class="badge-sparkle" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2l2.4 7.2L22 12l-7.6 2.8L12 22l-2.8-7.2L2 12l7.2-2.8z"></path>
              </svg>
            </div>

            <!-- Mascot Beavy -->
            <Image 
              src={mascotImg} 
              alt="Maskot Beavy Asisten AI Jadwalin" 
              class="mascot-img" 
              loading="eager"
            />

            <!-- Bottom-Left Time Badge -->
            <div class="badge-time" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              <span id="badge-text">Ada waktu buat kamu</span>
            </div>
          </div>
        </div>

        <!-- Right: Content Card -->
        <div class="card-col">
          <div class="onboarding-card" aria-live="polite">
            <div id="card-content" class="card-content-wrap">
              <h1 id="card-title" class="card-title">
                Hai, aku Beavy<br />asisten AI untukmu
              </h1>

              <p id="card-desc" class="card-desc">
                Biar Beavy bantu atur tugas dan jadwalmu. Kamu tinggal fokus, satu per satu.
              </p>
            </div>

            <!-- 3 Dots Indicator (Accessible Tablist) -->
            <div class="dots-nav" role="tablist" aria-label="Langkah pengenalan">
              <button class="dot active" role="tab" data-step="0" aria-selected="true" aria-label="Langkah 1 dari 3: Perkenalan Beavy"></button>
              <button class="dot" role="tab" data-step="1" aria-selected="false" aria-label="Langkah 2 dari 3: Penjadwalan Otomatis"></button>
              <button class="dot" role="tab" data-step="2" aria-selected="false" aria-label="Langkah 3 dari 3: Siap Mulai"></button>
            </div>

            <!-- Action Button -->
            <button id="btn-next" class="btn-primary" type="button" aria-controls="card-title card-desc">
              <span id="btn-text">Lanjut</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>

            <!-- Footnote Step Progress -->
            <p id="step-footer" class="step-footer" aria-atomic="true">
              1 dari 3 · Mulai pelan, jadi kebiasaan
            </p>
          </div>
        </div>
      </main>
    </div>

    <script>
      // 1. Loading screen auto fade-out
      window.addEventListener('DOMContentLoaded', () => {
        setTimeout(() => {
          const loadingScreen = document.getElementById('loading-screen');
          if (loadingScreen) {
            loadingScreen.classList.add('hidden');
            loadingScreen.setAttribute('aria-hidden', 'true');
          }
        }, 1200);
      });

      // 2. Data Onboarding 3 Langkah
      const steps = [
        {
          title: "Hai, aku Beavy<br />asisten AI untukmu",
          desc: "Biar Beavy bantu atur tugas dan jadwalmu. Kamu tinggal fokus, satu per satu.",
          badge: "Ada waktu buat kamu",
          button: "Lanjut",
          footer: "1 dari 3 · Mulai pelan, jadi kebiasaan"
        },
        {
          title: "Jadwalkan agenda & tugas secara otomatis",
          desc: "Atur prioritas harianmu tanpa ribet. Beavy siap mengingatkan setiap saat.",
          badge: "Produktif setiap hari",
          button: "Lanjut",
          footer: "2 dari 3 · Langkah demi langkah"
        },
        {
          title: "Siap wujudkan hari yang lebih teratur?",
          desc: "Semua jadwalmu rapi dalam satu tempat. Yuk mulai petualangan produktifmu!",
          badge: "Siap meluncur!",
          button: "Mulai Sekarang",
          footer: "3 dari 3 · Waktumu, kendalimu"
        }
      ];

      let currentStep = 0;

      const cardContentEl = document.getElementById('card-content');
      const titleEl = document.getElementById('card-title');
      const descEl = document.getElementById('card-desc');
      const badgeTextEl = document.getElementById('badge-text');
      const btnTextEl = document.getElementById('btn-text');
      const footerEl = document.getElementById('step-footer');
      const dots = document.querySelectorAll('.dot');
      const btnNext = document.getElementById('btn-next');
      const btnSkip = document.getElementById('btn-skip');

      function renderStep(index: number) {
        currentStep = index;
        const data = steps[currentStep];

        // Smooth subtle text crossfade
        if (cardContentEl) {
          cardContentEl.classList.add('transitioning');
          setTimeout(() => {
            if (titleEl) titleEl.innerHTML = data.title;
            if (descEl) descEl.textContent = data.desc;
            if (badgeTextEl) badgeTextEl.textContent = data.badge;
            if (btnTextEl) btnTextEl.textContent = data.button;
            if (footerEl) footerEl.textContent = data.footer;
            cardContentEl.classList.remove('transitioning');
          }, 120);
        } else {
          if (titleEl) titleEl.innerHTML = data.title;
          if (descEl) descEl.textContent = data.desc;
          if (badgeTextEl) badgeTextEl.textContent = data.badge;
          if (btnTextEl) btnTextEl.textContent = data.button;
          if (footerEl) footerEl.textContent = data.footer;
        }

        dots.forEach((dot, idx) => {
          if (idx === currentStep) {
            dot.classList.add('active');
            dot.setAttribute('aria-selected', 'true');
          } else {
            dot.classList.remove('active');
            dot.setAttribute('aria-selected', 'false');
          }
        });
      }

      btnNext?.addEventListener('click', () => {
        if (currentStep < steps.length - 1) {
          renderStep(currentStep + 1);
        } else {
          window.location.href = '/login';
        }
      });

      btnSkip?.addEventListener('click', () => {
        window.location.href = '/login';
      });

      dots.forEach((dot) => {
        dot.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const targetStep = Number(target.dataset.step) || 0;
          renderStep(targetStep);
        });

        // Keyboard arrow navigation
        dot.addEventListener('keydown', (e) => {
          const keyEvent = e as KeyboardEvent;
          if (keyEvent.key === 'ArrowRight' && currentStep < steps.length - 1) {
            renderStep(currentStep + 1);
            (dots[currentStep] as HTMLElement)?.focus();
          } else if (keyEvent.key === 'ArrowLeft' && currentStep > 0) {
            renderStep(currentStep - 1);
            (dots[currentStep] as HTMLElement)?.focus();
          }
        });
      });
    </script>
  </body>
</html>
