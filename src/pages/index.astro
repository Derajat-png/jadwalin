---
// src/pages/index.astro
import { Image } from 'astro:assets';
import logoImg from '../assets/jadwal.in.png';
import mascotImg from '../assets/craiyon.png';
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/jadwal.in.png" />
    <title>Jadwal.in — Onboarding</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        min-height: 100vh;
        background: linear-gradient(135deg, #FDF4E7 0%, #E8D9F3 40%, #CFC4E8 75%, #EBDDF5 100%);
        color: #251c3e;
        overflow-x: hidden;
      }

      /* ====================================================
         1. LOADING SCREEN (Sederhana & Halus)
         ==================================================== */
      #loading-screen {
        position: fixed;
        inset: 0;
        z-index: 999;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #CFC4E8 0%, #E8D9F3 50%, #EBDDF5 100%);
        transition: opacity 0.7s ease, visibility 0.7s ease;
      }

      #loading-screen.hidden {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }

      .loading-logo {
        width: 250px;
        max-width: 75vw;
        height: auto;
        animation: pulseLogo 1.8s ease-in-out infinite;
      }

      @keyframes pulseLogo {
        0%, 100% {
          transform: scale(1);
          opacity: 0.95;
        }
        50% {
          transform: scale(1.04);
          opacity: 1;
        }
      }

      /* ====================================================
         2. ONBOARDING CONTAINER (Desktop & Mobile Layout)
         ==================================================== */
      .onboarding-wrapper {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 1.5rem 2rem 2rem;
        max-width: 1100px;
        margin: 0 auto;
      }

      /* Header */
      .onboarding-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        padding-bottom: 1rem;
      }

      .header-logo {
        height: 60px;
        width: auto;
        object-fit: contain;
      }

      .btn-skip {
        background: none;
        border: none;
        color: #5c4d79;
        font-family: inherit;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        padding: 0.5rem 0.8rem;
        border-radius: 8px;
        transition: color 0.2s, background 0.2s;
      }

      .btn-skip:hover {
        color: #7b42f6;
        background: rgba(255, 255, 255, 0.4);
      }

      /* Main Onboarding Layout (Desktop: 2 Columns Side-by-Side) */
      .onboarding-main {
        flex: 1;
        display: grid;
        grid-template-columns: 1.05fr 1fr;
        align-items: center;
        gap: 3.5rem;
        padding: 1.5rem 0;
      }

      /* Left Side: Illustration & Floating Chips */
      .illustration-col {
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
      }

      .mascot-stage {
        position: relative;
        width: 380px;
        height: 380px;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      /* Circular Aura Ring behind mascot */
      .aura-ring {
        position: absolute;
        width: 340px;
        height: 340px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.32);
        border: 2px solid rgba(255, 255, 255, 0.65);
        box-shadow: 0 10px 40px rgba(138, 92, 246, 0.08);
      }

      /* Mascot Image */
      .mascot-img {
        position: relative;
        z-index: 2;
        width: 250px;
        height: auto;
        filter: drop-shadow(0 15px 25px rgba(93, 44, 150, 0.15));
      }

      /* Floating Badge 1: Top-Right Sparkle */
      .badge-sparkle {
        position: absolute;
        top: 48px;
        right: 32px;
        z-index: 3;
        width: 44px;
        height: 44px;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(10px);
        border: 1.5px solid rgba(255, 255, 255, 0.9);
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #7b42f6;
        box-shadow: 0 8px 20px rgba(123, 66, 246, 0.14);
        animation: gentleBob 3.5s ease-in-out infinite 0.5s;
      }

      /* Floating Badge 2: Bottom-Left "Ada waktu buat kamu" */
      .badge-time {
        position: absolute;
        bottom: 58px;
        left: 20px;
        z-index: 3;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.55rem 1.05rem;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(12px);
        border: 1.5px solid rgba(255, 255, 255, 0.9);
        border-radius: 999px;
        box-shadow: 0 8px 24px rgba(100, 70, 140, 0.12);
        transform: rotate(-3.5deg);
        animation: gentleBob 4.2s ease-in-out infinite;
      }

      .badge-time svg {
        color: #7b42f6;
        flex-shrink: 0;
      }

      .badge-time span {
        font-size: 0.82rem;
        font-weight: 700;
        color: #4a356a;
        white-space: nowrap;
      }

      @keyframes gentleBob {
        0%, 100% {
          transform: translateY(0px) rotate(-3.5deg);
        }
        50% {
          transform: translateY(-5px) rotate(-2deg);
        }
      }

      /* Right Side: The Onboarding Card */
      .card-col {
        display: flex;
        justify-content: center;
      }

      .onboarding-card {
        background: #ffffff;
        border-radius: 36px;
        padding: 3rem 2.5rem;
        box-shadow: 0 20px 50px rgba(100, 70, 150, 0.1);
        width: 100%;
        max-width: 460px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
      }

      /* Kicker / Subtitle */
      .card-kicker {
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #7b42f6;
        margin-bottom: 0.9rem;
      }

      /* Heading */
      .card-title {
        font-size: 1.85rem;
        font-weight: 800;
        line-height: 1.25;
        color: #251c3e;
        margin-bottom: 0.9rem;
      }

      /* Description */
      .card-desc {
        font-size: 0.95rem;
        line-height: 1.6;
        color: #665b7d;
        margin-bottom: 2rem;
        min-height: 48px;
      }

      /* Pagination Dots */
      .dots-nav {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        margin-bottom: 1.8rem;
      }

      .dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #d8cce8;
        border: none;
        cursor: pointer;
        padding: 0;
        transition: all 0.25s ease;
      }

      .dot.active {
        width: 24px;
        border-radius: 999px;
        background: #8b5cf6;
      }

      /* Primary Button */
      .btn-primary {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        background: linear-gradient(135deg, #a855f7 0%, #8b5cf6 100%);
        color: #ffffff;
        font-family: inherit;
        font-size: 1.05rem;
        font-weight: 700;
        padding: 0.95rem 1.8rem;
        border: none;
        border-radius: 999px;
        cursor: pointer;
        box-shadow: 0 10px 24px rgba(139, 92, 246, 0.35);
        transition: transform 0.2s, box-shadow 0.2s;
        margin-bottom: 1.2rem;
      }

      .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 14px 28px rgba(139, 92, 246, 0.45);
      }

      .btn-primary:active {
        transform: translateY(0);
      }

      /* Footer Step Note */
      .step-footer {
        font-size: 0.8rem;
        color: #9e91b3;
        font-weight: 500;
      }

      /* ====================================================
         3. MOBILE RESPONSIVE LAYOUT (Mirip Persis Screenshot)
         ==================================================== */
      @media (max-width: 820px) {
        .onboarding-wrapper {
          padding: 1.2rem 1.2rem 1.5rem;
        }

        .header-logo {
          height: 48px;
        }

        .onboarding-main {
          grid-template-columns: 1fr;
          gap: 1.5rem;
          padding: 0.5rem 0;
        }

        .mascot-stage {
          width: 290px;
          height: 290px;
        }

        .aura-ring {
          width: 260px;
          height: 260px;
        }

        .mascot-img {
          width: 200px;
        }

        .badge-sparkle {
          top: 25px;
          right: 18px;
          width: 38px;
          height: 38px;
        }

        .badge-time {
          bottom: 35px;
          left: 5px;
          padding: 0.45rem 0.85rem;
        }

        .badge-time span {
          font-size: 0.75rem;
        }

        .onboarding-card {
          border-radius: 28px;
          padding: 2.2rem 1.5rem;
          max-width: 100%;
        }

        .card-title {
          font-size: 1.55rem;
        }
      }
    </style>
  </head>
  <body>
    <!-- 1. LOADING SCREEN -->
    <div id="loading-screen">
      <Image src={logoImg} alt="jadwal.in" class="loading-logo" loading="eager" />
    </div>

    <!-- 2. ONBOARDING SECTION -->
    <div class="onboarding-wrapper">
      <!-- Header -->
      <header class="onboarding-header">
        <Image src={logoImg} alt="jadwal.in" class="header-logo" loading="eager" />
        <div style="display: flex; gap: 0.6rem; align-items: center;">
          <a href="/login" class="btn-skip" style="color: #7c3aed;">Masuk</a>
          <button id="btn-skip" class="btn-skip" type="button">Lewati</button>
        </div>
      </header>

      <!-- Main Section (Desktop 2-Column / Mobile Stacked) -->
      <main class="onboarding-main">
        <!-- Left: Illustration -->
        <div class="illustration-col">
          <div class="mascot-stage">
            <!-- Halo Circle Aura -->
            <div class="aura-ring"></div>

            <!-- Top-Right Sparkle Badge -->
            <div class="badge-sparkle" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2l2.4 7.2L22 12l-7.6 2.8L12 22l-2.8-7.2L2 12l7.2-2.8z"></path>
              </svg>
            </div>

            <!-- Mascot Beavy -->
            <Image 
              src={mascotImg} 
              alt="Beavy Assistant AI" 
              class="mascot-img" 
              loading="eager"
            />

            <!-- Bottom-Left Time Badge -->
            <div class="badge-time">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              <span id="badge-text">Ada waktu buat kamu</span>
            </div>
          </div>
        </div>

        <!-- Right: Content Card -->
        <div class="card-col">
          <div class="onboarding-card">
            <span id="card-kicker" class="card-kicker">KENALAN DULU, YUK</span>
            
            <h1 id="card-title" class="card-title">
              Hai, aku Beavy<br />assistant AI untuk kamu
            </h1>

            <p id="card-desc" class="card-desc">
              Biar Beavy bantu atur tugas dan jadwalmu. Kamu tinggal fokus, satu per satu.
            </p>

            <!-- 3 Dots Indicator -->
            <div class="dots-nav" role="tablist" aria-label="Langkah Onboarding">
              <button class="dot active" data-step="0" aria-label="Langkah 1"></button>
              <button class="dot" data-step="1" aria-label="Langkah 2"></button>
              <button class="dot" data-step="2" aria-label="Langkah 3"></button>
            </div>

            <!-- Action Button -->
            <button id="btn-next" class="btn-primary" type="button">
              <span id="btn-text">Lanjut</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>

            <!-- Footnote -->
            <p id="step-footer" class="step-footer">
              1 dari 3 · Mulai pelan, jadi kebiasaan
            </p>
          </div>
        </div>
      </main>
    </div>

    <script>
      // 1. Loading screen auto fade-out setelah 1.5 detik
      window.addEventListener('DOMContentLoaded', () => {
        setTimeout(() => {
          const loadingScreen = document.getElementById('loading-screen');
          if (loadingScreen) {
            loadingScreen.classList.add('hidden');
          }
        }, 1500);
      });

      // 2. Data Onboarding 3 Langkah
      const steps = [
        {
          kicker: "KENALAN DULU, YUK",
          title: "Hai, aku Beavy<br />assistant AI untuk kamu",
          desc: "Biar Beavy bantu atur tugas dan jadwalmu. Kamu tinggal fokus, satu per satu.",
          badge: "Ada waktu buat kamu",
          button: "Lanjut",
          footer: "1 dari 3 · Mulai pelan, jadi kebiasaan"
        },
        {
          kicker: "ATUR WAKTU LEBIH CERDAS",
          title: "Jadwalkan agenda & tugas secara otomatis",
          desc: "Atur prioritas harianmu tanpa ribet. Beavy siap mengingatkan setiap saat.",
          badge: "Produktif setiap hari",
          button: "Lanjut",
          footer: "2 dari 3 · Langkah demi langkah"
        },
        {
          kicker: "MULAI SEKARANG",
          title: "Siap wujudkan hari yang lebih teratur?",
          desc: "Semua jadwalmu rapi dalam satu tempat. Yuk mulai petualangan produktifmu!",
          badge: "Siap meluncur!",
          button: "Mulai Sekarang",
          footer: "3 dari 3 · Waktumu, kendalimu"
        }
      ];

      let currentStep = 0;

      const kickerEl = document.getElementById('card-kicker');
      const titleEl = document.getElementById('card-title');
      const descEl = document.getElementById('card-desc');
      const badgeTextEl = document.getElementById('badge-text');
      const btnTextEl = document.getElementById('btn-text');
      const footerEl = document.getElementById('step-footer');
      const dots = document.querySelectorAll('.dot');
      const btnNext = document.getElementById('btn-next');
      const btnSkip = document.getElementById('btn-skip');

      function renderStep(index: number) {
        currentStep = index;
        const data = steps[currentStep];

        if (kickerEl) kickerEl.textContent = data.kicker;
        if (titleEl) titleEl.innerHTML = data.title;
        if (descEl) descEl.textContent = data.desc;
        if (badgeTextEl) badgeTextEl.textContent = data.badge;
        if (btnTextEl) btnTextEl.textContent = data.button;
        if (footerEl) footerEl.textContent = data.footer;

        dots.forEach((dot, idx) => {
          if (idx === currentStep) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      btnNext?.addEventListener('click', () => {
        if (currentStep < steps.length - 1) {
          renderStep(currentStep + 1);
        } else {
          window.location.href = '/beranda';
        }
      });

      btnSkip?.addEventListener('click', () => {
        window.location.href = '/beranda';
      });

      dots.forEach((dot) => {
        dot.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const targetStep = Number(target.dataset.step) || 0;
          renderStep(targetStep);
        });
      });
    </script>
  </body>
</html>
