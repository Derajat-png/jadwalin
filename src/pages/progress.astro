---
// src/pages/progress.astro
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { Image } from 'astro:assets';
import mascotImg from '../assets/craiyon.png';
---

<DashboardLayout title="Progres & Analisis" activeNav="progress">
  <div class="progress-page-wrap">
    <!-- Header -->
    <div class="progress-header">
      <div>
        <h1 class="page-title">Progres Produktivitas</h1>
        <p class="page-subtitle">
          Lacak kemajuan minggu ini dan atur tugas yang belum selesai agar tetap on-track.
        </p>
      </div>

      <!-- Biometric Verification Button from Figma -->
      <button id="btn-open-facescan" class="btn-facescan">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M7 3H5a2 2 0 0 0-2 2v2M17 3h2a2 2 0 0 1 2 2v2M7 21H5a2 2 0 0 1-2-2v-2M17 21h2a2 2 0 0 0 2-2v-2"></path><circle cx="12" cy="12" r="3"></circle><path d="M9 10h.01M15 10h.01"></path><path d="M9.5 15a3.5 3.5 0 0 0 5 0"></path></svg>
        <span>Verifikasi Fokus (Face Scan)</span>
      </button>
    </div>

    <!-- 3 Big Metric Cards from Figma -->
    <div class="progress-stats-grid">
      <div class="progress-stat-card done-stat">
        <div class="p-stat-icon">✓</div>
        <div class="p-stat-meta">
          <span class="p-stat-num">6</span>
          <span class="p-stat-label">Tugas Selesai</span>
        </div>
        <span class="p-stat-trend">+2 dari minggu lalu</span>
      </div>

      <div class="progress-stat-card working-stat">
        <div class="p-stat-icon">⏳</div>
        <div class="p-stat-meta">
          <span class="p-stat-num">2</span>
          <span class="p-stat-label">Sedang Dikerjakan</span>
        </div>
        <span class="p-stat-trend">Dalam progres aktif</span>
      </div>

      <div class="progress-stat-card pending-stat">
        <div class="p-stat-icon">⚠️</div>
        <div class="p-stat-meta">
          <span class="p-stat-num">2</span>
          <span class="p-stat-label">Tertunda</span>
        </div>
        <span class="p-stat-trend alert-trend">Perlu dijadwal ulang</span>
      </div>
    </div>

    <!-- Alert Re-schedule Card (From Figma Frame 57:3284) -->
    <div class="reschedule-alert-card">
      <div class="rac-content">
        <div class="rac-icon-wrap">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
        </div>
        <div>
          <h4 class="rac-title">2 tugas belum selesai sesuai rencana</h4>
          <p class="rac-desc">Atur ulang jadwal untuk kembali on-track tanpa membebani harimu.</p>
        </div>
      </div>
      <button id="btn-reschedule-now" class="btn-reschedule-action">Atur Ulang Jadwal</button>
    </div>

    <!-- Desktop 2-Column: Weekly Bar Chart (Left) + Task Progress Detail (Right) -->
    <div class="progress-desktop-grid">
      <!-- Left Column: Tugas Selesai Per Hari Chart -->
      <div class="chart-panel">
        <div class="panel-header">
          <div>
            <h3 class="panel-title">Tugas Selesai per Hari</h3>
            <span class="panel-sub">Minggu Ini (19 - 25 Okt 2026)</span>
          </div>
          <span class="chart-avg-badge">Rata-rata 1.4 tugas / hari</span>
        </div>

        <!-- CSS Bar Chart (Figma Match) -->
        <div class="bar-chart-container">
          <!-- Sen (2) -->
          <div class="bar-col">
            <span class="bar-val">2</span>
            <div class="bar-wrapper">
              <div class="bar-fill" style="height: 60%; background: #8b5cf6;"></div>
            </div>
            <span class="bar-day">Sen</span>
          </div>

          <!-- Sel (1) -->
          <div class="bar-col">
            <span class="bar-val">1</span>
            <div class="bar-wrapper">
              <div class="bar-fill" style="height: 35%; background: #8b5cf6;"></div>
            </div>
            <span class="bar-day">Sel</span>
          </div>

          <!-- Rab (3) -->
          <div class="bar-col">
            <span class="bar-val">3</span>
            <div class="bar-wrapper">
              <div class="bar-fill" style="height: 90%; background: #8b5cf6;"></div>
            </div>
            <span class="bar-day">Rab</span>
          </div>

          <!-- Kam (0) -->
          <div class="bar-col">
            <span class="bar-val">0</span>
            <div class="bar-wrapper">
              <div class="bar-fill" style="height: 5%; background: #e5dcf4;"></div>
            </div>
            <span class="bar-day">Kam</span>
          </div>

          <!-- Jum (2) -->
          <div class="bar-col">
            <span class="bar-val">2</span>
            <div class="bar-wrapper">
              <div class="bar-fill" style="height: 60%; background: #8b5cf6;"></div>
            </div>
            <span class="bar-day">Jum</span>
          </div>

          <!-- Sab (Current) -->
          <div class="bar-col active-today">
            <span class="bar-val">1</span>
            <div class="bar-wrapper">
              <div class="bar-fill" style="height: 40%; background: #f59e0b;"></div>
            </div>
            <span class="bar-day">Sab</span>
          </div>

          <!-- Min (0) -->
          <div class="bar-col">
            <span class="bar-val">-</span>
            <div class="bar-wrapper">
              <div class="bar-fill" style="height: 0%; background: #e5dcf4;"></div>
            </div>
            <span class="bar-day">Min</span>
          </div>
        </div>

        <div class="chart-legend">
          <span class="legend-item"><span class="legend-dot" style="background:#8b5cf6;"></span> Selesai</span>
          <span class="legend-item"><span class="legend-dot" style="background:#f59e0b;"></span> Hari ini</span>
          <span class="legend-item"><span class="legend-dot" style="background:#e5dcf4;"></span> Belum ada</span>
        </div>
      </div>

      <!-- Right Column: Detail Status Tugas (Figma Match) -->
      <div class="tasks-progress-panel">
        <h3 class="panel-title" style="margin-bottom: 1.2rem;">Detail Status Tugas Aktif</h3>

        <!-- Item 1: Rapat Tim Produk (Figma Match) -->
        <div class="progress-task-card">
          <div class="ptc-header">
            <div>
              <h4 class="ptc-title">Rapat Tim Produk</h4>
              <span class="ptc-meta">09:00 • Estimasi 1,5 jam</span>
            </div>
            <span class="status-pill status-working">Dikerjakan</span>
          </div>

          <div class="progress-bar-wrap">
            <div class="pb-label-row">
              <span class="pb-text">Kemajuan</span>
              <span class="pb-percent">67%</span>
            </div>
            <div class="pb-track">
              <div class="pb-fill" style="width: 67%; background: linear-gradient(90deg, #8b5cf6, #a855f7);"></div>
            </div>
            <span class="pb-actual-note">Aktual: 2 jam / Estimasi: 1,5 jam</span>
          </div>

          <div class="ptc-actions">
            <button class="btn-update-progress" onclick="alert('Progress diperbarui!');">Update</button>
            <button class="btn-finish-progress" onclick="alert('Tugas ditandai selesai!');">Tandai Selesai</button>
          </div>
        </div>

        <!-- Item 2: Laporan Mingguan (Figma Match) -->
        <div class="progress-task-card">
          <div class="ptc-header">
            <div>
              <h4 class="ptc-title">Laporan Mingguan</h4>
              <span class="ptc-meta">13:30 • Estimasi 45 menit</span>
            </div>
            <span class="status-pill status-working">Dikerjakan</span>
          </div>

          <div class="progress-bar-wrap">
            <div class="pb-label-row">
              <span class="pb-text">Kemajuan</span>
              <span class="pb-percent">82%</span>
            </div>
            <div class="pb-track">
              <div class="pb-fill" style="width: 82%; background: linear-gradient(90deg, #10b981, #059669);"></div>
            </div>
            <span class="pb-actual-note">Aktual: 40 mnt / Estimasi: 45 menit</span>
          </div>

          <div class="ptc-actions">
            <button class="btn-update-progress" onclick="alert('Progress diperbarui!');">Update</button>
            <button class="btn-finish-progress" onclick="alert('Tugas ditandai selesai!');">Tandai Selesai</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Face Scan Verification Modal (From Figma Frame 165:425 & 227:796) -->
  <div id="facescan-modal" class="modal-backdrop">
    <div class="facescan-box">
      <button id="close-facescan" class="btn-close-modal">✕</button>

      <div class="facescan-header">
        <h3 class="fs-title">Arahkan Wajah ke Kamera</h3>
        <p class="fs-desc">
          Pastikan wajahmu berada di dalam lingkaran dengan pencahayaan yang cukup dan tanpa penutup wajah untuk validasi fokus sesi.
        </p>
      </div>

      <!-- Circular Face Target Camera View -->
      <div class="face-target-circle">
        <div class="scanning-scanline"></div>
        <div class="camera-placeholder">
          <Image src={mascotImg} alt="Beavy" class="fs-beavy-guide" />
          <span class="fs-cam-text">Menyiapkan sensor...</span>
        </div>
      </div>

      <!-- 3 Criteria Checkpoints from Figma -->
      <div class="fs-criteria-list">
        <div class="fs-crit-item active">
          <span class="fs-crit-icon">✓</span>
          <span>Cahaya Cukup</span>
        </div>
        <div class="fs-crit-item active">
          <span class="fs-crit-icon">✓</span>
          <span>Buka Mata</span>
        </div>
        <div class="fs-crit-item active">
          <span class="fs-crit-icon">✓</span>
          <span>Wajah Rileks</span>
        </div>
      </div>

      <!-- Action Button -->
      <button id="btn-trigger-scan" class="btn-start-scan">
        <span id="scan-btn-label">Pindai Sekarang</span>
      </button>
    </div>
  </div>

  <style>
    .progress-page-wrap {
      display: flex;
      flex-direction: column;
      gap: 1.8rem;
    }

    .progress-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .page-title {
      font-size: 2.2rem;
      font-weight: 800;
      color: #201438;
      letter-spacing: -0.5px;
    }

    .page-subtitle {
      font-size: 0.95rem;
      color: #6c5f85;
      margin-top: 0.3rem;
    }

    .btn-facescan {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.75rem 1.4rem;
      border-radius: var(--radius-full);
      border: 1.5px solid #d8b4fe;
      background: white;
      color: #7c3aed;
      font-size: 0.88rem;
      font-weight: 700;
      box-shadow: 0 4px 12px rgba(139, 92, 246, 0.15);
      transition: all 0.2s;
    }

    .btn-facescan:hover {
      background: #f3e8ff;
      transform: translateY(-2px);
    }

    /* 3 Big Stats Grid */
    .progress-stats-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.2rem;
    }

    .progress-stat-card {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(14px);
      border: 1px solid rgba(255, 255, 255, 0.9);
      border-radius: var(--radius-lg);
      padding: 1.5rem;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .p-stat-icon {
      font-size: 1.3rem;
      margin-bottom: 0.2rem;
    }

    .p-stat-meta {
      display: flex;
      align-items: baseline;
      gap: 0.6rem;
    }

    .p-stat-num {
      font-size: 2.2rem;
      font-weight: 800;
      color: #1e1336;
      line-height: 1;
    }

    .p-stat-label {
      font-size: 0.92rem;
      font-weight: 700;
      color: #63537d;
    }

    .p-stat-trend {
      font-size: 0.76rem;
      font-weight: 600;
      color: #16a34a;
    }

    .alert-trend {
      color: #dc2626 !important;
    }

    /* Reschedule Alert Card */
    .reschedule-alert-card {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: linear-gradient(135deg, #fef2f2 0%, #fff5f5 100%);
      border: 1.5px solid #fecaca;
      border-radius: var(--radius-lg);
      padding: 1.2rem 1.6rem;
      box-shadow: 0 4px 14px rgba(220, 38, 38, 0.08);
      flex-wrap: wrap;
      gap: 1rem;
    }

    .rac-content {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .rac-icon-wrap {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: #fee2e2;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .rac-title {
      font-size: 1.05rem;
      font-weight: 800;
      color: #991b1b;
    }

    .rac-desc {
      font-size: 0.85rem;
      color: #7f1d1d;
      margin-top: 0.15rem;
    }

    .btn-reschedule-action {
      background: #dc2626;
      color: white;
      border: none;
      font-weight: 700;
      font-size: 0.88rem;
      padding: 0.75rem 1.4rem;
      border-radius: var(--radius-full);
      box-shadow: 0 6px 16px rgba(220, 38, 38, 0.3);
      transition: transform 0.2s;
    }

    .btn-reschedule-action:hover {
      transform: translateY(-2px);
    }

    /* Desktop 2-Column */
    .progress-desktop-grid {
      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      gap: 1.8rem;
      align-items: start;
    }

    .chart-panel, .tasks-progress-panel {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.9);
      border-radius: var(--radius-lg);
      padding: 1.8rem;
      box-shadow: var(--shadow-sm);
    }

    .panel-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 1.6rem;
    }

    .panel-title {
      font-size: 1.2rem;
      font-weight: 800;
      color: #21143a;
    }

    .panel-sub {
      font-size: 0.78rem;
      color: #786991;
    }

    .chart-avg-badge {
      font-size: 0.75rem;
      font-weight: 700;
      color: #7c3aed;
      background: #ede9fe;
      padding: 0.3rem 0.75rem;
      border-radius: var(--radius-full);
    }

    /* Bar Chart */
    .bar-chart-container {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      height: 220px;
      padding: 1rem 0;
      border-bottom: 1px solid #f0e9f8;
      gap: 1rem;
    }

    .bar-col {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.4rem;
      height: 100%;
      justify-content: flex-end;
    }

    .bar-val {
      font-size: 0.75rem;
      font-weight: 800;
      color: #63537d;
    }

    .bar-wrapper {
      width: 32px;
      height: 150px;
      background: #f7f3fd;
      border-radius: 8px 8px 0 0;
      display: flex;
      align-items: flex-end;
      overflow: hidden;
    }

    .bar-fill {
      width: 100%;
      border-radius: 8px 8px 0 0;
      transition: height 0.6s ease;
    }

    .bar-day {
      font-size: 0.8rem;
      font-weight: 700;
      color: #6f5f88;
    }

    .bar-col.active-today .bar-day {
      color: #d97706;
    }

    .chart-legend {
      display: flex;
      gap: 1.2rem;
      justify-content: center;
      margin-top: 1rem;
      font-size: 0.78rem;
      font-weight: 600;
      color: #685980;
    }

    .legend-item {
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    .legend-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
    }

    /* Task Progress Cards */
    .progress-task-card {
      background: #fbf9fe;
      border: 1px solid #eee5f8;
      border-radius: var(--radius-md);
      padding: 1.2rem;
      margin-bottom: 1rem;
    }

    .ptc-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 0.9rem;
    }

    .ptc-title {
      font-size: 1.02rem;
      font-weight: 800;
      color: #21133a;
    }

    .ptc-meta {
      font-size: 0.76rem;
      color: #82729a;
    }

    .status-pill {
      font-size: 0.72rem;
      font-weight: 800;
      padding: 0.2rem 0.65rem;
      border-radius: var(--radius-full);
    }

    .status-working {
      background: #fef3c7;
      color: #b45309;
    }

    .progress-bar-wrap {
      margin-bottom: 1rem;
    }

    .pb-label-row {
      display: flex;
      justify-content: space-between;
      font-size: 0.82rem;
      font-weight: 700;
      color: #51426d;
      margin-bottom: 0.35rem;
    }

    .pb-track {
      width: 100%;
      height: 8px;
      background: #ede6f6;
      border-radius: var(--radius-full);
      overflow: hidden;
      margin-bottom: 0.3rem;
    }

    .pb-fill {
      height: 100%;
      border-radius: var(--radius-full);
    }

    .pb-actual-note {
      font-size: 0.72rem;
      color: #87789f;
    }

    .ptc-actions {
      display: flex;
      gap: 0.6rem;
    }

    .btn-update-progress {
      flex: 1;
      padding: 0.55rem;
      border-radius: 8px;
      border: 1px solid #d4c7e7;
      background: white;
      font-weight: 700;
      font-size: 0.8rem;
      color: #594876;
    }

    .btn-finish-progress {
      flex: 1.2;
      padding: 0.55rem;
      border-radius: 8px;
      border: none;
      background: #8b5cf6;
      color: white;
      font-weight: 700;
      font-size: 0.8rem;
    }

    /* Face Scan Modal (From Figma Frame 165:425 & 227:796) */
    .facescan-box {
      background: white;
      border-radius: 28px;
      width: 100%;
      max-width: 440px;
      padding: 2.2rem 1.8rem;
      text-align: center;
      position: relative;
      box-shadow: var(--shadow-lg);
      animation: zoomIn 0.25s ease-out;
    }

    @keyframes zoomIn {
      from { transform: scale(0.9); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }

    .btn-close-modal {
      position: absolute;
      top: 1.2rem;
      right: 1.2rem;
      background: none;
      border: none;
      font-size: 1.2rem;
      color: #9d8fae;
    }

    .fs-title {
      font-size: 1.35rem;
      font-weight: 800;
      color: #21133a;
      margin-bottom: 0.5rem;
    }

    .fs-desc {
      font-size: 0.84rem;
      color: #695b82;
      line-height: 1.45;
      margin-bottom: 1.6rem;
    }

    .face-target-circle {
      width: 190px;
      height: 190px;
      border-radius: 50%;
      margin: 0 auto 1.6rem;
      border: 3px dashed #8b5cf6;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      background: #fbf9ff;
      overflow: hidden;
      box-shadow: 0 0 30px rgba(139, 92, 246, 0.15);
    }

    .scanning-scanline {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, transparent, #8b5cf6, transparent);
      box-shadow: 0 0 10px #8b5cf6;
      animation: scanSweep 2s ease-in-out infinite;
    }

    @keyframes scanSweep {
      0% { top: 10%; }
      50% { top: 90%; }
      100% { top: 10%; }
    }

    .camera-placeholder {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.4rem;
    }

    .fs-beavy-guide {
      width: 70px;
      height: 70px;
      object-fit: contain;
      opacity: 0.9;
    }

    .fs-cam-text {
      font-size: 0.75rem;
      font-weight: 700;
      color: #8b5cf6;
    }

    .fs-criteria-list {
      display: flex;
      justify-content: space-around;
      margin-bottom: 1.8rem;
      padding: 0.8rem;
      background: #f8f5fc;
      border-radius: var(--radius-md);
    }

    .fs-crit-item {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.78rem;
      font-weight: 700;
      color: #15803d;
    }

    .fs-crit-icon {
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: #dcfce7;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.7rem;
    }

    .btn-start-scan {
      width: 100%;
      padding: 0.95rem;
      border-radius: var(--radius-full);
      border: none;
      background: linear-gradient(135deg, #a855f7 0%, #8b5cf6 100%);
      color: white;
      font-size: 1rem;
      font-weight: 800;
      box-shadow: 0 8px 24px rgba(139, 92, 246, 0.35);
      transition: transform 0.2s;
    }

    .btn-start-scan:hover {
      transform: translateY(-2px);
    }

    @media (max-width: 960px) {
      .progress-stats-grid {
        grid-template-columns: 1fr;
      }
      .progress-desktop-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script>
    const modal = document.getElementById('facescan-modal');
    const openBtn = document.getElementById('btn-open-facescan');
    const closeBtn = document.getElementById('close-facescan');
    const triggerScanBtn = document.getElementById('btn-trigger-scan');
    const scanLabel = document.getElementById('scan-btn-label');

    openBtn?.addEventListener('click', () => modal?.classList.add('active'));
    closeBtn?.addEventListener('click', () => modal?.classList.remove('active'));
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) modal.classList.remove('active');
    });

    triggerScanBtn?.addEventListener('click', () => {
      if (scanLabel) scanLabel.textContent = 'Memproses... Mohon tunggu sebentar...';
      triggerScanBtn.style.opacity = '0.7';

      setTimeout(() => {
        alert('🎉 Wajah Terverifikasi! Selamat Datang. Sesi fokus kamu telah dicatat!');
        if (scanLabel) scanLabel.textContent = 'Pindai Sekarang';
        triggerScanBtn.style.opacity = '1';
        modal?.classList.remove('active');
      }, 1500);
    });

    document.getElementById('btn-reschedule-now')?.addEventListener('click', () => {
      alert('AI Beavy telah menggeser 2 tugas tertunda ke waktu luang hari Minggu pukul 14.00!');
    });
  </script>
</DashboardLayout>
