---
// src/pages/progress.astro
import DashboardLayout from '../layouts/DashboardLayout.astro';
import { Image } from 'astro:assets';
import mascotImg from '../assets/craiyon.png';
---

<DashboardLayout title="Progres & Analisis" activeNav="progress">
  <div class="sanctuary-wrap">

    <!-- 1. EDITORIAL HEADER -->
    <header class="progress-hero">
      <div class="hero-left">
        <h1 class="hero-statement">
          Evaluasi ritme & efisiensi:<br />
          <span class="hero-highlight">Pencapaian Pekan Ini</span>
        </h1>
        <p class="hero-sub">
          Ringkasan waktu belajar terpakai, tugas terselesaikan, dan prediksi ketepatan jadwal akademik.
        </p>
      </div>

      <div class="hero-right">
        <a href="/prioritas" class="btn-hero-action">
          <span>Masuk Sesi Fokus</span>
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </a>
      </div>
    </header>

    <!-- 2. AMBIENT PROGRESS KPI STRIP -->
    <section class="progress-strip">
      <div class="p-stat">
        <span class="stat-number">6</span>
        <span class="stat-tagline">Tugas selesai tepat waktu</span>
      </div>
      <div class="p-divider"></div>
      <div class="p-stat">
        <span class="stat-number">2</span>
        <span class="stat-tagline">Sedang aktif dikerjakan</span>
      </div>
      <div class="p-divider"></div>
      <div class="p-stat">
        <span class="stat-number">2</span>
        <span class="stat-tagline">Perlu penyesuaian slot waktu</span>
      </div>
      <div class="p-divider"></div>
      <div class="p-companion-hint">
        <span class="p-efficiency-label">Skor Efisiensi Belajar</span>
        <span class="p-efficiency-num">88%</span>
      </div>
    </section>

    <!-- 3. MAIN WORKSPACE GRID -->
    <div class="progress-grid">

      <!-- LEFT: Weekly Velocity Bar Visualization -->
      <section class="progress-surface">
        <div class="surface-header">
          <div>
            <h2 class="surface-title">Distribusi Waktu Belajar (Menit)</h2>
            <p class="surface-caption">Senin hingga Minggu : Rata-rata 180 menit/hari</p>
          </div>
          <span class="chart-badge">Pekan Berjalan</span>
        </div>

        <div class="bars-chart-flow">
          <div class="chart-column">
            <div class="bar-shell"><div class="bar-core" style="height: 65%;"></div></div>
            <span class="bar-day">Sen</span>
            <span class="bar-val">150m</span>
          </div>
          <div class="chart-column">
            <div class="bar-shell"><div class="bar-core" style="height: 85%;"></div></div>
            <span class="bar-day">Sel</span>
            <span class="bar-val">210m</span>
          </div>
          <div class="chart-column">
            <div class="bar-shell"><div class="bar-core" style="height: 70%;"></div></div>
            <span class="bar-day">Rab</span>
            <span class="bar-val">180m</span>
          </div>
          <div class="chart-column">
            <div class="bar-shell"><div class="bar-core" style="height: 95%;"></div></div>
            <span class="bar-day">Kam</span>
            <span class="bar-val">240m</span>
          </div>
          <div class="chart-column">
            <div class="bar-shell"><div class="bar-core" style="height: 50%;"></div></div>
            <span class="bar-day">Jum</span>
            <span class="bar-val">120m</span>
          </div>
          <div class="chart-column active-day">
            <div class="bar-shell"><div class="bar-core active" style="height: 100%;"></div></div>
            <span class="bar-day">Sab</span>
            <span class="bar-val">270m</span>
          </div>
          <div class="chart-column">
            <div class="bar-shell"><div class="bar-core projected" style="height: 40%;"></div></div>
            <span class="bar-day">Min</span>
            <span class="bar-val">90m</span>
          </div>
        </div>

        <!-- Task Completion Detail Stack -->
        <div class="task-progress-stack">
          <h3 class="inner-title">Tugas Dalam Pengerjaan Aktif</h3>
          
          <div class="progress-row">
            <div class="row-header">
              <span class="row-name">Fokus: Pemrograman Web & API</span>
              <span class="row-meta">65% Selesai : 75 / 120 mnt</span>
            </div>
            <div class="row-track"><div class="row-fill" style="width: 65%;"></div></div>
          </div>

          <div class="progress-row">
            <div class="row-header">
              <span class="row-name">Laporan Praktikum Sistem Informasi</span>
              <span class="row-meta">40% Selesai : 35 / 90 mnt</span>
            </div>
            <div class="row-track"><div class="row-fill" style="width: 40%;"></div></div>
          </div>
        </div>
      </section>

      <!-- RIGHT: AI Schedule Optimization & Advice -->
      <aside class="progress-side-col">

        <!-- Optimization Recommendation -->
        <div class="side-surface advice-card">
          <div class="advice-head">
            <div class="advice-avatar-disc">
              <Image src={mascotImg} alt="Beavy" class="advice-avatar-img" />
            </div>
            <div>
              <h3 class="side-title">Evaluasi Ritme Beavy</h3>
              <p class="advice-role">Rekomendasi Penyesuaian</p>
            </div>
          </div>
          <p class="side-desc">
            Ada 2 tugas yang melebihi estimasi awal karena kompleksitas debugging. Beavy menyarankan mengalihkan sesi reviu ke slot santai hari Minggu pukul 14.00.
          </p>
          <button id="btn-reschedule-now" type="button" class="btn-reschedule-editorial">
            Terapkan Penyesuaian AI
          </button>
        </div>

        <!-- Weekly Summary Metrics -->
        <div class="side-surface summary-card">
          <h3 class="side-title">Statistik Total Jam</h3>
          <p class="side-desc">Pencatatan waktu belajar mandiri di luar kelas.</p>

          <div class="summary-meta-grid">
            <div class="meta-box">
              <span class="meta-label">Total Fokus</span>
              <span class="meta-num">17.5 Jam</span>
            </div>
            <div class="meta-box">
              <span class="meta-label">Target Pekanan</span>
              <span class="meta-num">20 Jam</span>
            </div>
          </div>
        </div>

      </aside>

    </div>

  </div>

  <style>
    /* =========================================================
       AWWWARDS EDITORIAL PROGRESS & ANALYTICS STYLES
       Spacious, Flat Surface, Editorial Typography
       ========================================================= */

    :focus-visible {
      outline: 2px solid var(--color-primary);
      outline-offset: 2px;
    }

    @media (prefers-reduced-motion: reduce) {
      *, ::before, ::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }

    .sanctuary-wrap {
      max-width: 1240px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 2.2rem;
      padding-bottom: 3rem;
    }

    /* 1. HERO */
    .progress-hero {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 2rem;
      padding: 1.5rem 0 0.5rem;
      border-bottom: 1px solid var(--color-border-subtle);
    }

    .hero-statement {
      font-size: 2.2rem;
      font-weight: 800;
      color: var(--color-text-main);
      line-height: 1.2;
      letter-spacing: -0.025em;
    }

    .hero-highlight {
      color: var(--color-primary-dark);
    }

    .hero-sub {
      font-size: 0.95rem;
      color: var(--color-text-muted);
      line-height: 1.6;
      margin-top: 0.6rem;
      max-width: 650px;
    }

    .btn-hero-action {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      background: var(--color-primary);
      color: var(--color-surface);
      font-size: 0.9rem;
      font-weight: 700;
      padding: 0.85rem 1.5rem;
      border-radius: var(--radius-full);
      box-shadow: var(--shadow-sm);
      flex-shrink: 0;
      transition: background-color 0.15s ease, transform 0.15s ease;
    }

    .btn-hero-action:hover {
      background: var(--color-primary-dark);
      transform: translateY(-2px);
    }

    /* 2. AMBIENT STRIP */
    .progress-strip {
      display: flex;
      align-items: center;
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
      padding: 1.25rem 2rem;
      box-shadow: var(--shadow-xs);
      gap: 2rem;
    }

    .p-stat {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .stat-number {
      font-family: var(--font-mono);
      font-size: 1.85rem;
      font-weight: 800;
      color: var(--color-text-main);
      line-height: 1;
    }

    .stat-tagline {
      font-size: 0.76rem;
      font-weight: 600;
      color: var(--color-text-muted);
    }

    .p-divider {
      width: 1px;
      height: 38px;
      background: var(--color-border);
    }

    .p-companion-hint {
      margin-left: auto;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
    }

    .p-efficiency-label {
      font-size: 0.74rem;
      font-weight: 600;
      color: var(--color-text-muted);
    }

    .p-efficiency-num {
      font-family: var(--font-mono);
      font-size: 1.85rem;
      font-weight: 800;
      color: var(--color-success);
      line-height: 1;
      margin-top: 0.2rem;
    }

    /* 3. GRID */
    .progress-grid {
      display: grid;
      grid-template-columns: 1.4fr 0.8fr;
      gap: 2rem;
      align-items: start;
    }

    .progress-surface, .side-surface {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
      padding: 1.8rem;
      box-shadow: var(--shadow-xs);
    }

    .surface-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      margin-bottom: 1.8rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--color-border-subtle);
    }

    .surface-title {
      font-size: 1.25rem;
      font-weight: 800;
      color: var(--color-text-main);
    }

    .surface-caption {
      font-size: 0.8rem;
      color: var(--color-text-muted);
      margin-top: 0.2rem;
    }

    .chart-badge {
      font-size: 0.74rem;
      font-weight: 700;
      color: var(--color-text-muted);
      background: var(--color-canvas);
      padding: 0.25rem 0.65rem;
      border-radius: var(--radius-full);
    }

    /* BARS CHART FLOW */
    .bars-chart-flow {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      height: 200px;
      padding: 1rem 0.5rem 0.5rem;
      border-bottom: 1px solid var(--color-border-subtle);
      margin-bottom: 2rem;
      gap: 0.5rem;
    }

    .chart-column {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      height: 100%;
      justify-content: flex-end;
      gap: 0.4rem;
    }

    .bar-shell {
      width: 28px;
      height: 150px;
      background: var(--color-canvas);
      border-radius: var(--radius-sm);
      display: flex;
      align-items: flex-end;
      overflow: hidden;
    }

    .bar-core {
      width: 100%;
      background: var(--color-border-focus);
      border-radius: var(--radius-sm);
    }

    .bar-core.active {
      background: var(--color-primary);
    }

    .bar-core.projected {
      background: var(--color-border);
      border-top: 2px dashed var(--color-text-muted);
    }

    .bar-day {
      font-size: 0.76rem;
      font-weight: 700;
      color: var(--color-text-body);
    }

    .bar-val {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      color: var(--color-text-muted);
    }

    /* Task Progress Stack */
    .task-progress-stack {
      display: flex;
      flex-direction: column;
      gap: 1.2rem;
    }

    .inner-title {
      font-size: 1rem;
      font-weight: 800;
      color: var(--color-text-main);
    }

    .progress-row {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .row-header {
      display: flex;
      justify-content: space-between;
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--color-text-main);
    }

    .row-meta {
      font-size: 0.74rem;
      font-weight: 600;
      color: var(--color-text-muted);
    }

    .row-track {
      width: 100%;
      height: 8px;
      background: var(--color-canvas);
      border-radius: var(--radius-full);
      overflow: hidden;
    }

    .row-fill {
      height: 100%;
      background: var(--color-primary);
      border-radius: var(--radius-full);
    }

    /* RIGHT COLUMN */
    .progress-side-col {
      display: flex;
      flex-direction: column;
      gap: 1.8rem;
    }

    .advice-head {
      display: flex;
      align-items: center;
      gap: 0.85rem;
      margin-bottom: 0.8rem;
    }

    .advice-avatar-disc {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--color-primary-light);
      border: 1px solid var(--color-border-focus);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .advice-avatar-img {
      width: 30px;
      height: 30px;
      object-fit: contain;
    }

    .side-title {
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--color-text-main);
    }

    .advice-role {
      font-size: 0.74rem;
      color: var(--color-text-muted);
      margin-top: 0.1rem;
    }

    .side-desc {
      font-size: 0.8rem;
      color: var(--color-text-body);
      line-height: 1.5;
      margin-bottom: 1.2rem;
    }

    .btn-reschedule-editorial {
      width: 100%;
      padding: 0.8rem;
      border-radius: var(--radius-full);
      background: var(--color-primary);
      color: var(--color-surface);
      font-size: 0.88rem;
      font-weight: 700;
      border: none;
      cursor: pointer;
      box-shadow: var(--shadow-sm);
      transition: background-color 0.15s ease, transform 0.15s ease;
    }

    .btn-reschedule-editorial:hover {
      background: var(--color-primary-dark);
      transform: translateY(-2px);
    }

    /* Summary Meta Grid */
    .summary-meta-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .meta-box {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      background: var(--color-surface-subtle);
      border: 1px solid var(--color-border-subtle);
      border-radius: var(--radius-md);
      padding: 0.85rem 1rem;
    }

    .meta-label {
      font-size: 0.72rem;
      font-weight: 600;
      color: var(--color-text-muted);
    }

    .meta-num {
      font-family: var(--font-mono);
      font-size: 1.25rem;
      font-weight: 800;
      color: var(--color-text-main);
    }

    @media (max-width: 1040px) {
      .progress-grid {
        grid-template-columns: 1fr;
      }
      .progress-hero {
        flex-direction: column;
        align-items: flex-start;
      }
      .progress-strip {
        flex-wrap: wrap;
        gap: 1.2rem;
      }
      .p-divider {
        display: none;
      }
      .p-companion-hint {
        margin-left: 0;
        align-items: flex-start;
      }
    }
  </style>

  <script>
    document.getElementById('btn-reschedule-now')?.addEventListener('click', () => {
      (window as any).jadwalinToast('Jadwal Dioptimalkan', 'AI Beavy telah mengalokasikan 2 tugas ke hari Minggu pukul 14.00.', 'info');
    });
  </script>
</DashboardLayout>
