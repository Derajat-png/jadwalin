---
// src/layouts/DashboardLayout.astro
import { Image } from 'astro:assets';
import logoImg from '../assets/jadwal.in.png';
import mascotImg from '../assets/craiyon.png';
import '../styles/tokens.css';

interface Props {
  title: string;
  activeNav?: 'beranda' | 'prioritas' | 'jadwal' | 'beavy-ai' | 'progress' | 'profile';
}

const { title, activeNav = 'beranda' } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/jadwal.in.png" />
    <title>{title} — Jadwal.in</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="dns-prefetch" href="https://fonts.googleapis.com">
    <link rel="dns-prefetch" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      :root {
        --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
        --font-mono: 'JetBrains Mono', monospace;
        
        /* Refined Modern Palette (Anti-AI Slop: Subtle, High Contrast, Crisp) */
        --color-primary: #7c3aed;
        --color-primary-dark: #6324cc;
        --color-primary-light: #f5f0ff;
        --color-accent: #d97706;
        
        --color-canvas: #f8f7fb;
        --color-surface: #ffffff;
        --color-surface-elevated: #ffffff;
        
        --color-text-main: #181226;
        --color-text-body: #423859;
        --color-text-muted: #6e6484;
        --color-text-subtle: #988eaf;
        
        --color-border: #e9e4f0;
        --color-border-subtle: #f0ecf6;
        --color-border-focus: #c4b5fd;
        
        --shadow-xs: 0 1px 2px rgba(24, 18, 38, 0.04);
        --shadow-sm: 0 2px 8px rgba(24, 18, 38, 0.04), 0 1px 2px rgba(24, 18, 38, 0.02);
        --shadow-md: 0 8px 24px rgba(24, 18, 38, 0.06), 0 2px 6px rgba(24, 18, 38, 0.03);
        --shadow-lg: 0 16px 40px rgba(76, 29, 149, 0.08), 0 4px 12px rgba(24, 18, 38, 0.04);
        
        --radius-sm: 8px;
        --radius-md: 12px;
        --radius-lg: 18px;
        --radius-xl: 24px;
        --radius-full: 9999px;
      }

      body {
        font-family: var(--font-sans);
        background-color: var(--color-canvas);
        background-image: 
          radial-gradient(at 0% 0%, rgba(232, 217, 243, 0.35) 0px, transparent 50%),
          radial-gradient(at 100% 0%, rgba(253, 244, 231, 0.45) 0px, transparent 50%),
          radial-gradient(at 50% 100%, rgba(207, 196, 232, 0.25) 0px, transparent 60%);
        background-attachment: fixed;
        color: var(--color-text-main);
        min-height: 100vh;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      a {
        text-decoration: none;
        color: inherit;
      }

      button {
        font-family: inherit;
        cursor: pointer;
      }

      /* Custom Toast System (Replaces AI slop window.alert) */
      .toast-container {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 10px;
        pointer-events: none;
      }

      .toast-item {
        pointer-events: auto;
        min-width: 300px;
        max-width: 420px;
        background: #ffffff;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        padding: 14px 18px;
        box-shadow: 0 12px 32px rgba(24, 18, 38, 0.12), 0 2px 6px rgba(24, 18, 38, 0.04);
        display: flex;
        align-items: center;
        gap: 12px;
        animation: toastIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        transition: opacity 0.2s, transform 0.2s;
      }

      .toast-item.out {
        opacity: 0;
        transform: translateY(10px) scale(0.96);
      }

      .toast-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .toast-icon.success { background: #ecfdf5; color: #059669; }
      .toast-icon.info { background: #f5f3ff; color: #7c3aed; }
      .toast-icon.warning { background: #fffbeb; color: #d97706; }

      .toast-content {
        flex: 1;
      }

      .toast-title {
        font-size: 0.88rem;
        font-weight: 700;
        color: var(--color-text-main);
        line-height: 1.25;
      }

      .toast-action-btn {
        background: transparent;
        border: 1px solid var(--color-primary-dark);
        color: var(--color-primary-dark);
        font-family: inherit;
        font-size: 0.78rem;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: var(--radius-sm);
        cursor: pointer;
        transition: all 0.15s ease;
        white-space: nowrap;
        margin-left: auto;
      }

      .toast-action-btn:hover {
        background: var(--color-primary);
        color: #ffffff;
      }

      @keyframes toastIn {
        from { transform: translateY(16px) scale(0.95); opacity: 0; }
        to { transform: translateY(0) scale(1); opacity: 1; }
      }
    </style>
    <style>
      .app-container {
        display: flex;
        min-height: 100vh;
      }

      /* ====================================================
         DESKTOP SIDEBAR (Clean, Boutique Software Standard)
         ==================================================== */
      .sidebar {
        width: 260px;
        background: rgba(255, 255, 255, 0.82);
        backdrop-filter: blur(24px) saturate(160%);
        border-right: 1px solid rgba(233, 228, 240, 0.85);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 1.5rem 1.1rem;
        position: fixed;
        top: 0;
        bottom: 0;
        left: 0;
        z-index: 50;
      }

      .sidebar-brand {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.2rem 0.4rem 1.2rem;
        border-bottom: 1px solid var(--color-border-subtle);
        margin-bottom: 1.2rem;
      }

      .sidebar-logo {
        height: 44px;
        width: auto;
        object-fit: contain;
      }

      .version-tag {
        font-family: var(--font-mono);
        font-size: 0.65rem;
        font-weight: 700;
        color: var(--color-text-muted);
        background: #f4f0fa;
        padding: 0.2rem 0.5rem;
        border-radius: 6px;
      }

      .nav-group {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        flex: 1;
      }

      .nav-label {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--color-text-muted);
        padding: 0.4rem 0.75rem 0.25rem;
      }

      .nav-link {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        padding: 0.65rem 0.85rem;
        border-radius: var(--radius-md);
        font-size: 0.88rem;
        font-weight: 600;
        color: var(--color-text-body);
        transition: all 0.15s ease;
        position: relative;
      }

      .nav-link:hover {
        color: var(--color-text-main);
        background: rgba(124, 58, 237, 0.05);
      }

      .nav-link.active {
        color: var(--color-primary-dark);
        background: #f5f0ff;
        font-weight: 700;
      }

      .nav-link.active::before {
        content: '';
        position: absolute;
        left: 0;
        top: 8px;
        bottom: 8px;
        width: 3.5px;
        background: var(--color-primary);
        border-radius: 0 4px 4px 0;
      }

      .nav-link svg {
        flex-shrink: 0;
        color: var(--color-text-muted);
        transition: color 0.15s ease;
      }

      .nav-link.active svg {
        color: var(--color-primary);
      }

      /* Quick Actions in Sidebar */
      .sidebar-actions {
        padding: 0.9rem 0;
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
        border-top: 1px solid var(--color-border-subtle);
        margin-top: 0.8rem;
      }

      .btn-add-task {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: var(--color-primary);
        color: #ffffff;
        border: none;
        padding: 0.65rem 0.95rem;
        border-radius: var(--radius-md);
        font-size: 0.85rem;
        font-weight: 700;
        transition: background 0.15s ease, transform 0.1s ease;
        box-shadow: 0 2px 6px rgba(124, 58, 237, 0.25);
      }

      .btn-add-task:hover {
        background: var(--color-primary-dark);
        transform: translateY(-1px);
      }

      .btn-add-task .kbd-hint {
        font-family: var(--font-mono);
        font-size: 0.65rem;
        background: rgba(255, 255, 255, 0.2);
        padding: 0.15rem 0.4rem;
        border-radius: 4px;
      }

      .btn-upload-nav {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        background: rgba(255, 255, 255, 0.7);
        border: 1px solid var(--color-border);
        color: var(--color-text-body);
        padding: 0.6rem 0.95rem;
        border-radius: var(--radius-md);
        font-size: 0.82rem;
        font-weight: 600;
        transition: all 0.15s ease;
      }

      .btn-upload-nav:hover {
        background: #ffffff;
        color: var(--color-primary-dark);
        border-color: var(--color-border-focus);
      }

      /* User mini profile card */
      .sidebar-user {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.65rem 0.75rem;
        background: rgba(255, 255, 255, 0.65);
        border: 1px solid var(--color-border-subtle);
        border-radius: var(--radius-md);
        margin-top: 0.4rem;
        transition: background 0.15s;
      }

      .sidebar-user:hover {
        background: #ffffff;
      }

      .user-info-wrap {
        display: flex;
        align-items: center;
        gap: 0.65rem;
      }

      .user-avatar {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: linear-gradient(135deg, #7c3aed, #a855f7);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 700;
        font-size: 0.82rem;
      }

      .user-meta {
        display: flex;
        flex-direction: column;
      }

      .user-name {
        font-size: 0.82rem;
        font-weight: 700;
        color: var(--color-text-main);
        line-height: 1.2;
      }

      .user-role {
        font-size: 0.7rem;
        color: var(--color-text-muted);
      }

      .btn-logout {
        background: none;
        border: none;
        color: var(--color-text-subtle);
        padding: 0.3rem;
        border-radius: 6px;
        transition: color 0.15s, background 0.15s;
        display: flex;
      }

      .btn-logout:hover {
        color: #dc2626;
        background: #fee2e2;
      }

      /* ====================================================
         MAIN VIEWPORT AREA
         ==================================================== */
      .main-viewport {
        flex: 1;
        margin-left: 260px;
        padding: 1.5rem 2.8rem 3rem;
        max-width: 1400px;
        width: calc(100% - 260px);
      }

      /* Desktop Top Header Bar */
      .top-navbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.65rem 1.2rem;
        background: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(20px);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-xs);
        margin-bottom: 2rem;
      }

      .date-badge {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--color-text-body);
      }

      .date-badge svg {
        color: var(--color-text-muted);
      }

      .beavy-tip-pill {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        background: #fbf8f2;
        border: 1px solid #faeccb;
        padding: 0.35rem 0.85rem;
        border-radius: var(--radius-full);
        font-size: 0.78rem;
        color: #78350f;
        font-weight: 500;
        white-space: nowrap;
      }

      .top-right-group {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        margin-left: auto;
      }

      .beavy-tip-pill strong {
        font-weight: 700;
        color: #92400e;
      }

      .beavy-mini-avatar {
        width: 20px;
        height: 20px;
        object-fit: contain;
      }

      .top-actions {
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }

      .icon-btn {
        width: 36px;
        height: 36px;
        border-radius: var(--radius-md);
        border: 1px solid var(--color-border);
        background: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-text-body);
        transition: all 0.15s ease;
      }

      .icon-btn:hover {
        background: var(--color-primary-light);
        color: var(--color-primary-dark);
        border-color: var(--color-border-focus);
      }

      /* ====================================================
         MOBILE NAVIGATION BAR (Bottom Bar)
         ==================================================== */
      .mobile-bottom-bar {
        display: none;
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        height: 60px;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        border-top: 1px solid var(--color-border);
        z-index: 100;
        align-items: center;
        justify-content: space-around;
        padding: 0 0.5rem;
      }

      .mobile-nav-link {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.2rem;
        font-size: 0.65rem;
        font-weight: 700;
        color: var(--color-text-muted);
        padding: 0.35rem 0.6rem;
        border-radius: 8px;
      }

      .mobile-nav-link.active {
        color: var(--color-primary);
      }

      .mobile-top-header {
        display: none;
        align-items: center;
        justify-content: space-between;
        padding: 0.8rem 1rem;
        margin-bottom: 1rem;
      }

      .mobile-logo {
        height: 38px;
        width: auto;
      }

      /* Modal Global Quick Add */
      .modal-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(15, 10, 25, 0.4);
        backdrop-filter: blur(8px);
        z-index: 200;
        align-items: center;
        justify-content: center;
        padding: 1rem;
      }

      .modal-backdrop.active {
        display: flex;
      }

      .modal-box {
        background: #ffffff;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-xl);
        width: 100%;
        max-width: 480px;
        padding: 2rem;
        box-shadow: var(--shadow-lg);
        animation: scaleUp 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      }

      @keyframes scaleUp {
        from { transform: scale(0.96); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
      }

      /* Responsive rules */
      @media (max-width: 960px) {
        .sidebar {
          display: none;
        }

        .main-viewport {
          margin-left: 0;
          width: 100%;
          padding: 1rem 1.2rem 5rem;
        }

        .top-navbar {
          display: none;
        }

        .mobile-top-header {
          display: flex;
        }

        .mobile-bottom-bar {
          display: flex;
        }
      }
    </style>
  </head>
  <body>
    <div class="app-container">
      <!-- 1. DESKTOP SIDEBAR -->
      <aside class="sidebar">
        <div>
          <!-- Brand Logo -->
          <div class="sidebar-brand">
            <a href="/beranda">
              <Image src={logoImg} alt="Jadwal.in" class="sidebar-logo" loading="eager" />
            </a>
            <span class="version-tag">v1.0</span>
          </div>

          <!-- Navigation Links -->
          <nav class="nav-group">
            <span class="nav-label">Workspace</span>

            <a href="/beranda" data-astro-prefetch="hover" class={`nav-link ${activeNav === 'beranda' ? 'active' : ''}`}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
              </svg>
              <span>Beranda</span>
            </a>

            <a href="/prioritas" data-astro-prefetch="hover" class={`nav-link ${activeNav === 'prioritas' ? 'active' : ''}`}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
              </svg>
              <span>Prioritas</span>
            </a>

            <a href="/jadwal" data-astro-prefetch="hover" class={`nav-link ${activeNav === 'jadwal' ? 'active' : ''}`}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              <span>Jadwal</span>
            </a>

            <a href="/beavy-ai" data-astro-prefetch="hover" class={`nav-link ${activeNav === 'beavy-ai' ? 'active' : ''}`}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
              </svg>
              <span>Beavy AI</span>
            </a>

            <a href="/progress" data-astro-prefetch="hover" class={`nav-link ${activeNav === 'progress' ? 'active' : ''}`}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="20" x2="18" y2="10"></line>
                <line x1="12" y1="20" x2="12" y2="4"></line>
                <line x1="6" y1="20" x2="6" y2="14"></line>
              </svg>
              <span>Progres</span>
            </a>

            <a href="/profile" data-astro-prefetch="hover" class={`nav-link ${activeNav === 'profile' ? 'active' : ''}`}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              <span>Profil</span>
            </a>
          </nav>
        </div>

        <div>
          <!-- Quick Actions -->
          <div class="sidebar-actions">
            <button id="open-quick-add" class="btn-add-task" type="button">
              <span style="display: flex; align-items: center; gap: 0.5rem;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                <span>Tugas Baru</span>
              </span>
              <span class="kbd-hint">N</span>
            </button>

            <a href="/upload" class="btn-upload-nav">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
              <span>Upload Dokumen</span>
            </a>
          </div>

          <!-- User Card -->
          <div class="sidebar-user">
            <a href="/profile" class="user-info-wrap">
              <div class="user-avatar">D</div>
              <div class="user-meta">
                <span class="user-name">Daffa Ahmad</span>
                <span class="user-role">Mahasiswa</span>
              </div>
            </a>
            <a href="/login" class="btn-logout" title="Keluar">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
            </a>
          </div>
        </div>
      </aside>

      <!-- 2. MAIN VIEWPORT -->
      <main class="main-viewport">
        <!-- Mobile Header Bar -->
        <header class="mobile-top-header">
          <Image src={logoImg} alt="Jadwal.in" class="mobile-logo" />
          <div style="display: flex; gap: 0.5rem; align-items: center;">
            <a href="/upload" class="icon-btn" title="Upload">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
            </a>
            <a href="/profile" class="user-avatar" style="width: 30px; height: 30px; font-size: 0.75rem;">D</a>
          </div>
        </header>

        <!-- Desktop Top Header Bar -->
        <header class="top-navbar">
          <div class="date-badge">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span id="live-date">Sabtu, 24 Oktober 2026</span>
          </div>

          <div class="top-right-group">
            <div class="beavy-tip-pill">
              <Image src={mascotImg} alt="Beavy" class="beavy-mini-avatar" />
              <span><strong>Fokus Hari Ini:</strong> Slot terbaikmu jam 10.00 - 12.00 untuk Laporan Pemrograman.</span>
            </div>

            <div class="top-actions">
              <a href="/beavy-ai" class="icon-btn" title="Tanya Beavy AI">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
              </a>
              <a href="/upload" class="icon-btn" title="Upload Silabus / Jadwal">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
              </a>
            </div>
          </div>
        </header>

        <!-- Dynamic Content -->
        <slot />
      </main>

      <!-- 3. MOBILE BOTTOM BAR -->
      <nav class="mobile-bottom-bar">
        <a href="/beranda" class={`mobile-nav-link ${activeNav === 'beranda' ? 'active' : ''}`}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"></rect><rect x="14" y="3" width="7" height="7" rx="1.5"></rect><rect x="14" y="14" width="7" height="7" rx="1.5"></rect><rect x="3" y="14" width="7" height="7" rx="1.5"></rect></svg>
          <span>Beranda</span>
        </a>
        <a href="/prioritas" class={`mobile-nav-link ${activeNav === 'prioritas' ? 'active' : ''}`}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
          <span>Prioritas</span>
        </a>
        <a href="/jadwal" class={`mobile-nav-link ${activeNav === 'jadwal' ? 'active' : ''}`}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          <span>Jadwal</span>
        </a>
        <a href="/beavy-ai" class={`mobile-nav-link ${activeNav === 'beavy-ai' ? 'active' : ''}`}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
          <span>Beavy AI</span>
        </a>
        <a href="/progress" class={`mobile-nav-link ${activeNav === 'progress' ? 'active' : ''}`}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
          <span>Progres</span>
        </a>
      </nav>
    </div>

    <!-- Toast Container -->
    <div id="toast-root" class="toast-container"></div>

    <!-- Quick Add Task Modal -->
    <div id="quick-add-modal" class="modal-backdrop">
      <div class="modal-box">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
          <div>
            <h3 style="font-size: 1.15rem; font-weight: 800; color: #181226;">Tambah Tugas Baru</h3>
            <p style="font-size: 0.8rem; color: #6e6484; margin-top: 2px;">AI Beavy akan mengurutkan prioritasnya secara otomatis</p>
          </div>
          <button id="close-quick-add" type="button" aria-label="Tutup modal" style="background:none; border:none; color: var(--color-text-muted); cursor: pointer; padding: 6px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; transition: background 0.15s;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>

        <form id="form-quick-add" style="display: flex; flex-direction: column; gap: 1rem;">
          <div>
            <label style="font-size: 0.82rem; font-weight: 700; color: #423859; display: block; margin-bottom: 0.35rem;">Nama Tugas</label>
            <input type="text" id="task-title" required placeholder="Contoh: Laporan Praktikum Pemrograman" style="width: 100%; padding: 0.75rem 0.95rem; border: 1.5px solid #ded5eb; border-radius: 10px; font-family: inherit; font-size: 0.9rem; outline: none;" />
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem;">
            <div>
              <label style="font-size: 0.82rem; font-weight: 700; color: #423859; display: block; margin-bottom: 0.35rem;">Kategori</label>
              <select id="task-category" style="width: 100%; padding: 0.75rem 0.95rem; border: 1.5px solid #ded5eb; border-radius: 10px; font-family: inherit; font-size: 0.9rem; outline: none; background: white;">
                <option value="Kuliah">Kuliah</option>
                <option value="Kerja">Kerja</option>
                <option value="Pribadi">Pribadi</option>
              </select>
            </div>
            <div>
              <label style="font-size: 0.82rem; font-weight: 700; color: #423859; display: block; margin-bottom: 0.35rem;">Durasi</label>
              <select id="task-duration" style="width: 100%; padding: 0.75rem 0.95rem; border: 1.5px solid #ded5eb; border-radius: 10px; font-family: inherit; font-size: 0.9rem; outline: none; background: white;">
                <option value="60">1 Jam (60 mnt)</option>
                <option value="90">1.5 Jam (90 mnt)</option>
                <option value="120" selected>2 Jam (120 mnt)</option>
                <option value="180">3 Jam (180 mnt)</option>
              </select>
            </div>
          </div>

          <div>
            <label style="font-size: 0.82rem; font-weight: 700; color: #423859; display: block; margin-bottom: 0.35rem;">Tenggat Waktu</label>
            <input type="datetime-local" id="task-deadline" style="width: 100%; padding: 0.75rem 0.95rem; border: 1.5px solid #ded5eb; border-radius: 10px; font-family: inherit; font-size: 0.9rem; outline: none;" />
          </div>

          <div style="display: flex; gap: 0.75rem; margin-top: 0.6rem;">
            <button type="button" id="cancel-quick-add" style="flex: 1; padding: 0.75rem; border-radius: var(--radius-md); border: 1px solid #dcd5ea; background: white; font-weight: 600; font-size: 0.88rem; color: #5a4b77; cursor: pointer;">Batal</button>
            <button type="submit" style="flex: 1.4; padding: 0.75rem; border-radius: var(--radius-md); border: none; background: var(--color-primary); color: white; font-weight: 700; font-size: 0.88rem; cursor: pointer; box-shadow: 0 2px 8px rgba(124, 58, 237, 0.3);">Simpan Tugas</button>
          </div>
        </form>
      </div>
    </div>

    <script>
      // Global Toast Dispatcher with Optional Action (Undo Support)
      (window as any).jadwalinToast = (
        title: string, 
        message: string, 
        type: 'success' | 'info' | 'warning' = 'success',
        action?: { label: string; onClick: () => void }
      ) => {
        const root = document.getElementById('toast-root');
        if (!root) return;

        const toast = document.createElement('div');
        toast.className = 'toast-item';

        const iconSvg = type === 'success' 
          ? '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>'
          : type === 'warning'
          ? '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>'
          : '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>';

        toast.innerHTML = `
          <div class="toast-icon ${type}">${iconSvg}</div>
          <div class="toast-content">
            <div class="toast-title">${title}</div>
            <div class="toast-message">${message}</div>
          </div>
        `;

        let isDismissed = false;
        if (action) {
          const actionBtn = document.createElement('button');
          actionBtn.className = 'toast-action-btn';
          actionBtn.textContent = action.label;
          actionBtn.onclick = () => {
            isDismissed = true;
            action.onClick();
            toast.classList.add('out');
            setTimeout(() => toast.remove(), 250);
          };
          toast.appendChild(actionBtn);
        }

        root.appendChild(toast);

        setTimeout(() => {
          if (!isDismissed && toast.parentElement) {
            toast.classList.add('out');
            setTimeout(() => toast.remove(), 250);
          }
        }, 4200);
      };

      const modal = document.getElementById('quick-add-modal');
      const openBtn = document.getElementById('open-quick-add');
      const closeBtn = document.getElementById('close-quick-add');
      const cancelBtn = document.getElementById('cancel-quick-add');
      const form = document.getElementById('form-quick-add');

      function openModal() {
        modal?.classList.add('active');
        (document.getElementById('task-title') as HTMLInputElement)?.focus();
      }
      (window as any).openQuickAddModal = openModal;
      function closeModal() {
        modal?.classList.remove('active');
      }

      openBtn?.addEventListener('click', openModal);
      closeBtn?.addEventListener('click', closeModal);
      cancelBtn?.addEventListener('click', closeModal);
      modal?.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });

      // Keyboard Shortcut 'N' for New Task
      window.addEventListener('keydown', (e) => {
        if (e.key === 'n' && !['INPUT', 'TEXTAREA', 'SELECT'].includes((e.target as HTMLElement).tagName)) {
          e.preventDefault();
          openModal();
        }
        if (e.key === 'Escape' && modal?.classList.contains('active')) {
          closeModal();
        }
      });

      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        const title = (document.getElementById('task-title') as HTMLInputElement)?.value;
        (window as any).jadwalinToast('Tugas Berhasil Disimpan', `"${title}" telah dialokasikan ke prioritas AI.`, 'success');
        closeModal();
      });
    </script>
  </body>
</html>
