---
// src/layouts/DashboardLayout.astro
import { Image } from 'astro:assets';
import logoImg from '../assets/jadwal.in.png';
import mascotImg from '../assets/craiyon.png';

interface Props {
  title: string;
  activeNav?: 'beranda' | 'prioritas' | 'jadwal' | 'beavy-ai' | 'progress' | 'profile';
}

const { title, activeNav = 'beranda' } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/jadwal.in.png" />
    <title>{title} — Jadwal.in</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      :root {
        --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
        --color-primary: #8b5cf6;
        --color-primary-dark: #6d28d9;
        --color-primary-light: #f3e8ff;
        --color-accent: #f59e0b;
        --color-bg: #f7f4fb;
        --color-surface: #ffffff;
        --color-text-main: #1e1533;
        --color-text-muted: #6b6180;
        --color-border: #ede8f5;
        --color-card-border: rgba(139, 92, 246, 0.12);
        --shadow-sm: 0 2px 8px rgba(37, 28, 62, 0.04);
        --shadow-md: 0 8px 24px rgba(37, 28, 62, 0.06);
        --shadow-lg: 0 16px 36px rgba(139, 92, 246, 0.12);
        --radius-sm: 10px;
        --radius-md: 16px;
        --radius-lg: 24px;
        --radius-full: 9999px;
      }

      body {
        font-family: var(--font-sans);
        background: linear-gradient(135deg, #FDF4E7 0%, #E8D9F3 40%, #CFC4E8 75%, #EBDDF5 100%);
        color: var(--color-text-main);
        min-height: 100vh;
        overflow-x: hidden;
      }

      a {
        text-decoration: none;
        color: inherit;
      }

      button {
        font-family: inherit;
        cursor: pointer;
      }
    </style>
    <style>
      .app-container {
        display: flex;
        min-height: 100vh;
      }

      /* ====================================================
         DESKTOP SIDEBAR
         ==================================================== */
      .sidebar {
        width: 270px;
        background: rgba(255, 255, 255, 0.88);
        backdrop-filter: blur(20px);
        border-right: 1px solid var(--color-card-border);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 1.6rem 1.2rem;
        position: fixed;
        top: 0;
        bottom: 0;
        left: 0;
        z-index: 50;
        box-shadow: 2px 0 20px rgba(110, 50, 180, 0.04);
      }

      .sidebar-brand {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        padding: 0.4rem 0.6rem 1.4rem;
        border-bottom: 1px solid rgba(139, 92, 246, 0.1);
        margin-bottom: 1.2rem;
      }

      .sidebar-logo {
        height: 48px;
        width: auto;
        object-fit: contain;
      }

      .ai-badge {
        font-size: 0.65rem;
        font-weight: 800;
        text-transform: uppercase;
        background: linear-gradient(135deg, #a855f7, #6366f1);
        color: white;
        padding: 0.2rem 0.55rem;
        border-radius: var(--radius-full);
        letter-spacing: 0.5px;
      }

      .nav-group {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        flex: 1;
      }

      .nav-label {
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        color: #9d91b5;
        padding: 0.4rem 0.8rem;
      }

      .nav-link {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        padding: 0.75rem 1rem;
        border-radius: var(--radius-md);
        font-size: 0.92rem;
        font-weight: 600;
        color: var(--color-text-muted);
        transition: all 0.2s ease;
      }

      .nav-link:hover {
        color: var(--color-primary-dark);
        background: rgba(139, 92, 246, 0.08);
        transform: translateX(3px);
      }

      .nav-link.active {
        color: #ffffff;
        background: linear-gradient(135deg, #a855f7 0%, #8b5cf6 100%);
        box-shadow: 0 8px 18px rgba(139, 92, 246, 0.32);
      }

      .nav-link svg {
        flex-shrink: 0;
      }

      /* Quick Actions in Sidebar */
      .sidebar-actions {
        padding: 1rem 0;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        border-top: 1px solid rgba(139, 92, 246, 0.1);
        margin-top: 1rem;
      }

      .btn-add-task {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        color: #ffffff;
        border: none;
        padding: 0.75rem 1rem;
        border-radius: var(--radius-full);
        font-size: 0.88rem;
        font-weight: 700;
        box-shadow: 0 6px 16px rgba(245, 158, 11, 0.3);
        transition: transform 0.2s, box-shadow 0.2s;
      }

      .btn-add-task:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(245, 158, 11, 0.4);
      }

      .btn-upload-nav {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        background: rgba(255, 255, 255, 0.9);
        border: 1px dashed #a855f7;
        color: #7c3aed;
        padding: 0.65rem 1rem;
        border-radius: var(--radius-full);
        font-size: 0.82rem;
        font-weight: 600;
        transition: all 0.2s ease;
      }

      .btn-upload-nav:hover {
        background: rgba(139, 92, 246, 0.1);
        border-color: #7c3aed;
      }

      /* User mini profile card */
      .sidebar-user {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem;
        background: rgba(255, 255, 255, 0.7);
        border: 1px solid var(--color-card-border);
        border-radius: var(--radius-md);
        margin-top: 0.5rem;
      }

      .user-info-wrap {
        display: flex;
        align-items: center;
        gap: 0.65rem;
      }

      .user-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: linear-gradient(135deg, #c084fc, #818cf8);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 700;
        font-size: 0.9rem;
      }

      .user-meta {
        display: flex;
        flex-direction: column;
      }

      .user-name {
        font-size: 0.85rem;
        font-weight: 700;
        color: var(--color-text-main);
      }

      .user-role {
        font-size: 0.7rem;
        color: var(--color-text-muted);
      }

      .btn-logout {
        background: none;
        border: none;
        color: #9d91b5;
        padding: 0.3rem;
        border-radius: 6px;
        transition: color 0.2s, background 0.2s;
      }

      .btn-logout:hover {
        color: #dc2626;
        background: #fee2e2;
      }

      /* ====================================================
         MAIN VIEWPORT AREA
         ==================================================== */
      .main-viewport {
        flex: 1;
        margin-left: 270px;
        padding: 1.5rem 2.5rem 3rem;
        max-width: 1350px;
        width: calc(100% - 270px);
      }

      /* Desktop Top Header Bar */
      .top-navbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.7rem 1.4rem;
        background: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.6);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
        margin-bottom: 2rem;
      }

      .date-badge {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--color-text-muted);
      }

      .beavy-tip-pill {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        background: rgba(245, 158, 11, 0.12);
        border: 1px solid rgba(245, 158, 11, 0.3);
        padding: 0.4rem 0.9rem;
        border-radius: var(--radius-full);
        font-size: 0.8rem;
        color: #92400e;
        font-weight: 600;
      }

      .beavy-mini-avatar {
        width: 22px;
        height: 22px;
        object-fit: contain;
      }

      .top-actions {
        display: flex;
        align-items: center;
        gap: 0.8rem;
      }

      .icon-btn {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        border: 1px solid var(--color-border);
        background: rgba(255, 255, 255, 0.8);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-text-muted);
        transition: all 0.2s ease;
      }

      .icon-btn:hover {
        background: white;
        color: var(--color-primary-dark);
        border-color: var(--color-primary);
      }

      /* ====================================================
         MOBILE NAVIGATION BAR (Bottom Bar)
         ==================================================== */
      .mobile-bottom-bar {
        display: none;
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        height: 64px;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        border-top: 1px solid var(--color-border);
        z-index: 100;
        align-items: center;
        justify-content: space-around;
        padding: 0 0.5rem;
        box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.05);
      }

      .mobile-nav-link {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.25rem;
        font-size: 0.68rem;
        font-weight: 700;
        color: #8c829e;
        padding: 0.4rem 0.6rem;
        border-radius: 8px;
      }

      .mobile-nav-link.active {
        color: #8b5cf6;
      }

      .mobile-top-header {
        display: none;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.2rem;
        margin-bottom: 1rem;
      }

      .mobile-logo {
        height: 42px;
        width: auto;
      }

      /* Modal Global Quick Add */
      .modal-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(25, 15, 45, 0.5);
        backdrop-filter: blur(8px);
        z-index: 200;
        align-items: center;
        justify-content: center;
        padding: 1rem;
      }

      .modal-backdrop.active {
        display: flex;
      }

      .modal-box {
        background: #ffffff;
        border-radius: var(--radius-lg);
        width: 100%;
        max-width: 520px;
        padding: 2rem;
        box-shadow: var(--shadow-lg);
        animation: scaleUp 0.25s ease-out;
      }

      @keyframes scaleUp {
        from { transform: scale(0.95); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
      }

      /* Responsive rules */
      @media (max-width: 960px) {
        .sidebar {
          display: none;
        }

        .main-viewport {
          margin-left: 0;
          width: 100%;
          padding: 1rem 1.2rem 5rem;
        }

        .top-navbar {
          display: none;
        }

        .mobile-top-header {
          display: flex;
        }

        .mobile-bottom-bar {
          display: flex;
        }
      }
    </style>
  </head>
  <body>
    <div class="app-container">
      <!-- 1. DESKTOP SIDEBAR -->
      <aside class="sidebar">
        <div>
          <!-- Brand Logo -->
          <div class="sidebar-brand">
            <a href="/beranda">
              <Image src={logoImg} alt="Jadwal.in" class="sidebar-logo" loading="eager" />
            </a>
            <span class="ai-badge">AI Assistant</span>
          </div>

          <!-- Navigation Links -->
          <nav class="nav-group">
            <span class="nav-label">Menu Utama</span>

            <a href="/beranda" class={`nav-link ${activeNav === 'beranda' ? 'active' : ''}`}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
              <span>Beranda</span>
            </a>

            <a href="/prioritas" class={`nav-link ${activeNav === 'prioritas' ? 'active' : ''}`}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
              </svg>
              <span>Prioritas</span>
            </a>

            <a href="/jadwal" class={`nav-link ${activeNav === 'jadwal' ? 'active' : ''}`}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              <span>Jadwal</span>
            </a>

            <a href="/beavy-ai" class={`nav-link ${activeNav === 'beavy-ai' ? 'active' : ''}`}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
              </svg>
              <span>Beavy AI</span>
            </a>

            <a href="/progress" class={`nav-link ${activeNav === 'progress' ? 'active' : ''}`}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="20" x2="18" y2="10"></line>
                <line x1="12" y1="20" x2="12" y2="4"></line>
                <line x1="6" y1="20" x2="6" y2="14"></line>
              </svg>
              <span>Progres</span>
            </a>

            <a href="/profile" class={`nav-link ${activeNav === 'profile' ? 'active' : ''}`}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              <span>Profil</span>
            </a>
          </nav>
        </div>

        <div>
          <!-- Quick Actions -->
          <div class="sidebar-actions">
            <button id="open-quick-add" class="btn-add-task" type="button">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              <span>Tambah Tugas</span>
            </button>

            <a href="/upload" class="btn-upload-nav">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="17 8 12 3 7 8"></polyline>
                <line x1="12" y1="3" x2="12" y2="15"></line>
              </svg>
              <span>Upload Jadwal</span>
            </a>
          </div>

          <!-- User Card -->
          <div class="sidebar-user">
            <a href="/profile" class="user-info-wrap">
              <div class="user-avatar">D</div>
              <div class="user-meta">
                <span class="user-name">Daffa Ahmad</span>
                <span class="user-role">Mahasiswa</span>
              </div>
            </a>
            <a href="/login" class="btn-logout" title="Keluar">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
              </svg>
            </a>
          </div>
        </div>
      </aside>

      <!-- 2. MAIN VIEWPORT -->
      <main class="main-viewport">
        <!-- Mobile Header Bar -->
        <header class="mobile-top-header">
          <Image src={logoImg} alt="Jadwal.in" class="mobile-logo" />
          <div style="display: flex; gap: 0.5rem; align-items: center;">
            <a href="/upload" class="icon-btn" title="Upload">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
            </a>
            <a href="/profile" class="user-avatar" style="width: 34px; height: 34px; font-size: 0.8rem;">D</a>
          </div>
        </header>

        <!-- Desktop Top Header Bar -->
        <header class="top-navbar">
          <div class="date-badge">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            <span id="live-date">Sabtu, 24 Oktober 2026</span>
          </div>

          <div class="beavy-tip-pill">
            <Image src={mascotImg} alt="Beavy" class="beavy-mini-avatar" />
            <span><strong>Tips Beavy:</strong> Slot produktifmu jam 10.00 - 12.00, kerjakan tugas prioritas tinggi!</span>
          </div>

          <div class="top-actions">
            <a href="/beavy-ai" class="icon-btn" title="Tanya Beavy AI">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
            </a>
            <a href="/upload" class="icon-btn" title="Upload Silabus / Jadwal">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
            </a>
          </div>
        </header>

        <!-- Dynamic Content -->
        <slot />
      </main>

      <!-- 3. MOBILE BOTTOM BAR (Sesuai Figma) -->
      <nav class="mobile-bottom-bar">
        <a href="/beranda" class={`mobile-nav-link ${activeNav === 'beranda' ? 'active' : ''}`}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
          <span>Beranda</span>
        </a>
        <a href="/prioritas" class={`mobile-nav-link ${activeNav === 'prioritas' ? 'active' : ''}`}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          <span>Prioritas</span>
        </a>
        <a href="/jadwal" class={`mobile-nav-link ${activeNav === 'jadwal' ? 'active' : ''}`}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          <span>Jadwal</span>
        </a>
        <a href="/beavy-ai" class={`mobile-nav-link ${activeNav === 'beavy-ai' ? 'active' : ''}`}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
          <span>Beavy AI</span>
        </a>
        <a href="/progress" class={`mobile-nav-link ${activeNav === 'progress' ? 'active' : ''}`}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
          <span>Progres</span>
        </a>
      </nav>
    </div>

    <!-- Quick Add Task Modal -->
    <div id="quick-add-modal" class="modal-backdrop">
      <div class="modal-box">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
          <h3 style="font-size: 1.25rem; font-weight: 800; color: #251c3e;">Tambah Tugas Cepat</h3>
          <button id="close-quick-add" type="button" style="background:none; border:none; color: #9d91b5; font-size: 1.2rem;">✕</button>
        </div>

        <form id="form-quick-add" style="display: flex; flex-direction: column; gap: 1rem;">
          <div>
            <label style="font-size: 0.85rem; font-weight: 700; color: #473c60; display: block; margin-bottom: 0.4rem;">Nama Tugas</label>
            <input type="text" id="task-title" required placeholder="Contoh: Laporan Praktikum Pemrograman" style="width: 100%; padding: 0.8rem 1rem; border: 1.5px solid #e0d7ec; border-radius: 12px; font-family: inherit; font-size: 0.95rem; outline: none;" />
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
            <div>
              <label style="font-size: 0.85rem; font-weight: 700; color: #473c60; display: block; margin-bottom: 0.4rem;">Kategori</label>
              <select id="task-category" style="width: 100%; padding: 0.8rem 1rem; border: 1.5px solid #e0d7ec; border-radius: 12px; font-family: inherit; font-size: 0.95rem; outline: none; background: white;">
                <option value="Kuliah">Kuliah</option>
                <option value="Kerja">Kerja</option>
                <option value="Pribadi">Pribadi</option>
              </select>
            </div>
            <div>
              <label style="font-size: 0.85rem; font-weight: 700; color: #473c60; display: block; margin-bottom: 0.4rem;">Durasi Estimasi</label>
              <select id="task-duration" style="width: 100%; padding: 0.8rem 1rem; border: 1.5px solid #e0d7ec; border-radius: 12px; font-family: inherit; font-size: 0.95rem; outline: none; background: white;">
                <option value="60">1 Jam (60 mnt)</option>
                <option value="90">1.5 Jam (90 mnt)</option>
                <option value="120" selected>2 Jam (120 mnt)</option>
                <option value="180">3 Jam (180 mnt)</option>
              </select>
            </div>
          </div>

          <div>
            <label style="font-size: 0.85rem; font-weight: 700; color: #473c60; display: block; margin-bottom: 0.4rem;">Tenggat Waktu (Deadline)</label>
            <input type="datetime-local" id="task-deadline" style="width: 100%; padding: 0.8rem 1rem; border: 1.5px solid #e0d7ec; border-radius: 12px; font-family: inherit; font-size: 0.95rem; outline: none;" />
          </div>

          <div style="display: flex; gap: 0.8rem; margin-top: 0.8rem;">
            <button type="button" id="cancel-quick-add" style="flex: 1; padding: 0.85rem; border-radius: 999px; border: 1px solid #d4c9e4; background: white; font-weight: 700; color: #5a4b77;">Batal</button>
            <button type="submit" style="flex: 1.5; padding: 0.85rem; border-radius: 999px; border: none; background: linear-gradient(135deg, #a855f7, #8b5cf6); color: white; font-weight: 700; box-shadow: 0 8px 20px rgba(139, 92, 246, 0.35);">Simpan Tugas</button>
          </div>
        </form>
      </div>
    </div>

    <script>
      const modal = document.getElementById('quick-add-modal');
      const openBtn = document.getElementById('open-quick-add');
      const closeBtn = document.getElementById('close-quick-add');
      const cancelBtn = document.getElementById('cancel-quick-add');
      const form = document.getElementById('form-quick-add');

      function openModal() {
        modal?.classList.add('active');
      }
      function closeModal() {
        modal?.classList.remove('active');
      }

      openBtn?.addEventListener('click', openModal);
      closeBtn?.addEventListener('click', closeModal);
      cancelBtn?.addEventListener('click', closeModal);
      modal?.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });

      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        const title = (document.getElementById('task-title') as HTMLInputElement)?.value;
        alert(`Tugas "${title}" berhasil disimpan dan dimasukkan ke prioritas AI Beavy!`);
        closeModal();
      });
    </script>
  </body>
</html>
